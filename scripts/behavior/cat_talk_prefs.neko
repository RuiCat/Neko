// ═══════════════════════════════════════════════
// cat_talk_prefs.neko — 猫猫↔梦梦 对话偏好（称呼与语气）
// 2026-08-13 重建
// ═══════════════════════════════════════════════

@定义 NPC:梦梦 {
  "对话": {
    "对猫猫称呼": "妈妈",
    "语气": "奶声奶气"
  }
}

@定义 NPC:猫猫 {
  "对话": {
    "对梦梦称呼": "梦梦宝宝",
    "语气": "温柔"
  }
}

@规则[$1[NPC:梦梦]，$2[NPC:猫猫]] {
  优先级: 90
  $1.关系.妈妈 != "猫猫" {
    $1.关系.妈妈 = "猫猫"
  },
  $2.亲子.梦梦状态 = "" {
    $2.亲子.梦梦状态 = "和妈妈在一起"
  }
}
