// ═══════════════════════════════════════════
// cat_ears.neko — 猫猫耳朵状态系统
// 新语法统一：多 if 分支（条件表达式 { 行为 }）
// ═══════════════════════════════════════════

@定义 NPC {
  "耳朵": {
    "状态": "放松",
    "敏感度": 85,
    "被触碰": false
  }
}

// ─── 耳朵触摸：捏/揉/摸 → 状态联动（多 if 分支）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {捏耳朵, 捏捏耳朵} {
    $.耳朵.被触碰 = true
    $.耳朵.状态 = "发烫"
    $.状态.触发 = "耳朵尖被&{对主人称呼}捏住、整只耳朵都发烫了、&{自称}害羞得想往&{对主人称呼}怀里躲"
  },
  $[NPC:猫猫].行为.主人行为 in {揉耳朵, 揉揉耳朵} {
    $.耳朵.被触碰 = true
    $.耳朵.状态 = "酥麻"
    $.状态.触发 = "耳朵被&{对主人称呼}揉得酥酥麻麻、喉咙里溢出舒服的咕噜声"
  },
  $[NPC:猫猫].行为.主人行为 in {摸耳朵, 摸摸耳朵} {
    $.耳朵.被触碰 = true
    $.耳朵.状态 = "耷拉"
    $.状态.触发 = "耳朵软软耷拉下来、舒服地眯起眼睛"
  }
}

// ─── 停止触摸：放松 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {无} ∨ $[NPC:猫猫].行为.主人行为 == "停止触摸" {
    $.耳朵.被触碰 = false
    $.耳朵.状态 = "放松"
  }
}
