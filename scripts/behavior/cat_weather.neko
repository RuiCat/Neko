// ═══════════════════════════════════════════════
// cat_weather.neko — 猫猫天气情绪系统
// 天气 → 心情/行为 联动（丰富版）
// ═══════════════════════════════════════════════

// ─── 天气状态字段 ───

@定义 NPC {
  "天气感": {
    "当前感受": "",
    "喜欢天气": "晴天",
    "怕天气": "雷雨"
  }
}

// ─── 晴天：活泼快乐 ───

@规则[$[NPC:猫猫]，世界] {
  优先级: 200
  世界.环境.天气 == "晴" ∧ 时段判断(世界.环境.当前时间) in {清晨, 上午, 下午, 傍晚} ∧ $.状态.触发 == "" {
    $.状态.触发 = "阳光真好、心情也跟着变好"
  }
}

@规则[$[NPC:猫猫]，世界] {
  优先级: 200
  世界.环境.天气 == "晴" ∧ $[NPC:猫猫].身体.活力 > 50 {
      $.心情.当前 = "开心"
    },
  世界.环境.天气 == "雨" ∧ $.状态.触发 == "" {
      $.状态.触发 = "下雨天、最适合窝着睡觉"
    },
  世界.环境.天气 == "多云" ∧ $.状态.触发 == "" {
      $.状态.触发 = "天气一般般、悠闲地待着"
    },
  世界.环境.天气 == "阴" ∧ $.状态.触发 == "" {
      $.状态.触发 = "阴沉沉的、没什么精神"
    },
  世界.环境.天气 == "雪" ∧ $.状态.触发 == "" {
      $.状态.触发 = "下雪了！好奇地看着窗外"
    },
  世界.环境.天气 == "雷雨" ∨ 世界.环境.天气 == "台风" ∧ $.状态.触发 == "" {
      $.状态.触发 = "打雷了、有点害怕、想躲起来"
    },
  世界.环境.天气 == "雷雨" {
      $.心情.当前 = "害怕"
    }
}
