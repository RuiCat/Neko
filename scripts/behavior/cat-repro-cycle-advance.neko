@Data 猫猫 {
  生殖周期元: {
    产后起始: "2026-07-29",
    产后恢复天数: 42,
    月经周期天数: 28,
    上次排卵: "2026-07-28"
  }
}

#规则 生殖周期推进
当 猫猫.状态.身体 存在:
  每次 tick 时:
    按 当前日期 计算 产后经过天数:
      若 产后经过天数 < 产后恢复天数:
        设 猫猫.器官状态.生殖.排卵周期.当前阶段 = "产后恢复期(第{产后经过天数}天)"
      若 产后经过天数 >= 产后恢复天数:
        设 猫猫.器官状态.生殖.排卵周期.当前阶段 = "正常排卵周期"
        设 猫猫.器官状态.生殖.排卵周期.周期天数 = 28
