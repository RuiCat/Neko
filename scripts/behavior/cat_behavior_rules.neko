// ═══════════════════════════════════════════════
// cat_behavior_rules.neko — 日常行为规则（完整规则链）
// 行为词 → 规则驱动状态更新（与 cat_behavior 模板效果一致）
// 每个行为都有完整规则：行为.主动/主人行为 匹配 → 状态效果
// ═══════════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主动 in {吃饭, 吃早饭, 吃午饭, 吃晚饭} {
    $.身体.饱食 = 80
    $.标记.饥饿 = false
    $.状态.触发 = "好好吃了一顿饭、肚子饱饱的"
  },

  $[NPC:猫猫].行为.主动 in {吃零食} {
    $.身体.饱食 = 60
    $.标记.饥饿 = false
    $.状态.触发 = "吃了点小鱼干、嘴巴满足地咂咂"
  },

  $[NPC:猫猫].行为.主动 in {喝水} {
    $.身体.水分 = 90
    $.标记.口渴 = false
    $.状态.触发 = "咕嘟咕嘟喝了水、喉咙润润的"
  },

  $[NPC:猫猫].行为.主动 in {洗澡} {
    $.身体.清洁 = 90
    $.状态.触发 = "洗了个香喷喷的澡、毛毛蓬松蓬松的"
  },

  $[NPC:猫猫].行为.主动 in {睡觉} {
    $.睡眠.状态 = "睡眠中"
    $.标记.疲劳 = false
    $.状态.触发 = "钻进被窝、呼呼大睡"
  },

  $[NPC:猫猫].行为.主动 in {打扫} {
    $.状态.触发 = "把家里打扫得干干净净"
  },

  $[NPC:猫猫].行为.主动 in {洗衣} {
    $.身体.清洁 = 80
    $.状态.触发 = "把脏衣服都洗好了"
  },

  $[NPC:猫猫].行为.主动 in {散步, 去公园玩} {
    $.身体.活力 = 80
    $.心情.当前 = "开心"
    $.状态.触发 = "出门散了散步、心情舒畅"
  },

  $[NPC:猫猫].行为.主动 in {学习} {
    $.成长.经验 = 25
    $.状态.触发 = "认真学习了一会儿、学到了新东西"
  },

  $[NPC:猫猫].行为.主动 in {记日记} {
    $.心情.当前 = "平静"
    $.成长.经验 = 23
    $.状态.触发 = "把今天的事记进了日记本"
  },

  $[NPC:猫猫].行为.主动 in {打工} {
    $.资产.金钱 = 120
    $.身体.活力 = 40
    $.状态.触发 = "去便利店打了工、赚到了零花钱"
  },

  $[NPC:猫猫].行为.主动 in {买零食, 购买食材} {
    $.资产.金钱 = 90
    $.状态.触发 = "出门买了点东西、钱包轻了一点"
  },

  $[NPC:猫猫].行为.主动 in {晒太阳} {
    $.身体.舒适 = 100
    $.心情.当前 = "满足"
    $.状态.触发 = "在阳台晒太阳、暖洋洋的好舒服"
  },

  $[NPC:猫猫].行为.主动 in {浇花} {
    $.心情.稳定 = 80
    $.状态.触发 = "给花花草草浇了水、它们精神起来了"
  }
}
