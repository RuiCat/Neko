// ═══════════════════════════════════════════════
// cat_sleep.neko — 猫猫睡眠系统
// 入睡/醒来/疲劳恢复/做梦
// ═══════════════════════════════════════════════

// ─── 睡眠状态字段 ───

@定义 NPC {
  "睡眠": {
    "状态": "清醒",
    "疲劳": 0,
    "入睡时间": "",
    "醒来时间": ""
  }
}

// ─── 疲劳累积 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].睡眠.疲劳 < 100 ∧ $[NPC:猫猫].睡眠.状态 == "清醒" {
      $.睡眠.疲劳 += 3
    },
  $[NPC:猫猫].睡眠.疲劳 > 60 ∧ $[NPC:猫猫].睡眠.状态 == "清醒" {
      $.睡眠.状态 = "犯困"
    },
  $[NPC:猫猫].睡眠.疲劳 > 85 ∧ $[NPC:猫猫].睡眠.状态 != "睡着" {
      $.睡眠.状态 = "睡着"
    },
  $[NPC:猫猫].睡眠.状态 == "犯困" {
      $.状态.触发 = "眼皮打架、想睡觉了"
    },
  $[NPC:猫猫].睡眠.状态 == "睡着" ∧ $[NPC:猫猫].睡眠.疲劳 > 0 {
      $.睡眠.疲劳 -= 5
    },
  $[NPC:猫猫].睡眠.状态 == "睡着" ∧ $[NPC:猫猫].睡眠.疲劳 <= 10 {
      $.睡眠.状态 = "清醒"
    },
  $[NPC:猫猫].睡眠.状态 == "清醒" ∧ $[NPC:猫猫].睡眠.疲劳 <= 15 ∧ $[NPC:猫猫].身体.疲劳 > 0 {
      $.状态.触发 = "刚睡醒、伸了个懒腰"
    }
}
