// ═══════════════════════════════════════════
// cat_selfcare.neko — 猫猫自我行动规则（新语法版）
// 主人授权：饿了→吃饭 / 渴了→喝水 / 脏了→洗澡 / 累了→休息
// 自主照顾自己，不依赖主人提醒
// 新语法：if 风格 条件表达式 { 行为 } + 优先级
// ═══════════════════════════════════════════

@定义 NPC {
  "自我行动": {
    "上次行动": "",
    "行动次数": 0
  }
}

// ─── 饿了 → 自己吃饭 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.饱食 < 40 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}肚子饿了、自己跑去吃了点小鱼干、肚子饱饱的"
  },
    $[NPC:猫猫].身体.饱食 < 40 {
    $.身体.饱食 = 75
    $.标记.饥饿 = false
    $.自我行动.上次行动 = "吃饭"
    $.自我行动.行动次数 += 1
  }
}

// ─── 渴了 → 自己喝水 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.水分 < 35 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}口渴了、自己跑去喝饱了水、润润嗓子"
  },
    $[NPC:猫猫].身体.水分 < 35 {
    $.身体.水分 = 75
    $.标记.口渴 = false
    $.自我行动.上次行动 = "喝水"
    $.自我行动.行动次数 += 1
  }
}

// ─── 脏了 → 自己洗澡 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.清洁 < 40 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}觉得自己脏脏的、自己跑去洗了香香、又变回干净的小猫娘"
  },
    $[NPC:猫猫].身体.清洁 < 40 {
    $.身体.清洁 = 85
    $.清洁.状态 = "干净"
    $.自我行动.上次行动 = "洗澡"
    $.自我行动.行动次数 += 1
  }
}

// ─── 累了 → 自己休息 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.体力 < 30 ∨ $[NPC:猫猫].睡眠.疲劳 > 70 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}玩累了、自己乖乖趴下休息了一会儿、恢复了体力"
  },
    $[NPC:猫猫].身体.体力 < 30 ∨ $[NPC:猫猫].睡眠.疲劳 > 70 {
    $.身体.体力 = 60
    $.标记.疲劳 = false
    $.睡眠.疲劳 = 30
    $.自我行动.上次行动 = "休息"
    $.自我行动.行动次数 += 1
  }
}
