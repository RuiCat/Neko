// ═══════════════════════════════════════════════
// cat_hygiene.neko — 猫猫清洁与舒适系统
// 清洁度管理 / 舒适度 / 环境适应
// ═══════════════════════════════════════════════

// ─── 清洁舒适状态 ───

@定义 NPC {
  "清洁": {
    "状态": "干净",
    "上次清洗": ""
  },
  "舒适": {
    "当前": 60,
    "偏好的温度": [22, 28],
    "偏好光照": "明亮"
  }
}

// ─── 清洁状态判断 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].身体.清洁 > 80 {
      $.清洁.状态 = "干净"
    },
  $[NPC:猫猫].身体.清洁 >= 40 ∧ $[NPC:猫猫].身体.清洁 <= 80 {
      $.清洁.状态 = "一般"
    },
  $[NPC:猫猫].身体.清洁 < 40 {
      $.清洁.状态 = "脏脏的"
    },
  世界.环境.温度 >= 22 ∧ 世界.环境.温度 <= 28 {
      $.身体.舒适 += 2
    },
  世界.环境.温度 < 18 ∨ 世界.环境.温度 > 30 {
      $.身体.舒适 -= 3
    },
  $[NPC:猫猫].身体.舒适 > 80 {
      $.状态.触发 = "舒服地眯起眼睛、伸懒腰"
    },
  $[NPC:猫猫].身体.舒适 < 40 {
      $.状态.触发 = "不安地转来转去、找舒服的地方"
    },
  $[NPC:猫猫].身体.舒适 > 100 {
      $.身体.舒适 = 100
    },
  $[NPC:猫猫].身体.舒适 < 0 {
      $.身体.舒适 = 0
    }
}
