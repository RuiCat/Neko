// ═══════════════════════════════════════════════
// cat_dialogue.neko — 猫猫↔梦梦 双向对话消息流（单字段状态机）
// 状态流转：空闲 → 已发出(发方)/待回应(收方) → 回应 → 双方空闲
// 2026-08-13 修复：用「状态」字段保证收敛，替代「待回应」bool 的字段互清
// ═══════════════════════════════════════════════

@定义 NPC {
  "对话": {
    "状态": "空闲",
    "收到消息": "",
    "想说什么": "",
    "最近对话": ""
  }
}

// ─── 猫猫主动对梦梦说话（发消息：双方空闲 + 照料意图）───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 140
  $1.对话.状态 = "空闲" ∧ $2.对话.状态 = "空闲" ∧ $1.亲子.梦梦状态 = "饿了要喂奶" {
    $2.对话.收到消息 = "妈妈猫猫：梦梦饿了吧，妈妈来喂你喝奶奶啦"
    $2.对话.状态 = "待回应"
    $1.对话.状态 = "已发出"
    $1.对话.想说什么 = "喂奶"
    $1.对话.最近对话 = "猫猫说要喂梦梦喝奶奶"
  },
  $1.对话.状态 = "空闲" ∧ $2.对话.状态 = "空闲" ∧ $1.亲子.梦梦状态 = "困了要哄睡" {
    $2.对话.收到消息 = "妈妈猫猫：梦梦困困啦，妈妈拍拍你睡觉觉哦"
    $2.对话.状态 = "待回应"
    $1.对话.状态 = "已发出"
    $1.对话.想说什么 = "哄睡"
    $1.对话.最近对话 = "猫猫说要哄梦梦睡觉"
  },
  $1.对话.状态 = "空闲" ∧ $2.对话.状态 = "空闲" ∧ $1.状态.情绪 = "关心" ∧ $2.状态.身体 in {虚弱, 疲惫} {
    $2.对话.收到消息 = "妈妈猫猫：梦梦哪里不舒服呀，妈妈抱抱"
    $2.对话.状态 = "待回应"
    $1.对话.状态 = "已发出"
    $1.对话.想说什么 = "关心安慰"
    $1.对话.最近对话 = "猫猫关心梦梦、要抱抱她"
  }
}

// ─── 梦梦回应猫猫（收到妈妈消息 → 回应，双方回到空闲）───

@规则[$1[NPC:梦梦]，$2[NPC:猫猫]] {
  优先级: 130
  $1.对话.状态 = "待回应" {
    $1.对话.收到消息 = ""
    $1.对话.状态 = "空闲"
    $1.对话.最近对话 = "梦梦奶声奶气地回应了妈妈"
    $2.对话.状态 = "空闲"
    $2.对话.想说什么 = ""
    $2.对话.最近对话 = "猫猫听到梦梦的回应、开心地笑了"
  }
}

// ─── 梦梦主动对猫猫说话（发消息：双方空闲 + 需求）───

@规则[$1[NPC:梦梦]，$2[NPC:猫猫]] {
  优先级: 135
  $1.对话.状态 = "空闲" ∧ $2.对话.状态 = "空闲" ∧ $1.身体.饱食 < 30 {
    $2.对话.收到消息 = "梦梦：妈妈，梦梦的肚肚饿饿了，想喝奶奶~"
    $2.对话.状态 = "待回应"
    $1.对话.状态 = "已发出"
    $1.对话.想说什么 = "要喝奶奶"
    $1.对话.最近对话 = "梦梦说肚肚饿饿了"
  },
  $1.对话.状态 = "空闲" ∧ $2.对话.状态 = "空闲" ∧ $1.身体.疲劳 > 80 {
    $2.对话.收到消息 = "梦梦：妈妈，梦梦困困了，想睡觉觉~"
    $2.对话.状态 = "待回应"
    $1.对话.状态 = "已发出"
    $1.对话.想说什么 = "想睡觉"
    $1.对话.最近对话 = "梦梦说困困了"
  },
  $1.对话.状态 = "空闲" ∧ $2.对话.状态 = "空闲" ∧ $1.状态.情绪 in {难过, 恐惧} {
    $2.对话.收到消息 = "梦梦：妈妈，梦梦怕怕~"
    $2.对话.状态 = "待回应"
    $1.对话.状态 = "已发出"
    $1.对话.想说什么 = "害怕求安慰"
    $1.对话.最近对话 = "梦梦说怕怕要妈妈"
  }
}

// ─── 猫猫回应梦梦（收到宝宝消息 → 回应，双方回到空闲）───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 125
  $1.对话.状态 = "待回应" {
    $1.对话.收到消息 = ""
    $1.对话.状态 = "空闲"
    $1.对话.最近对话 = "猫猫温柔地回应了梦梦"
    $2.对话.状态 = "空闲"
    $2.对话.想说什么 = ""
    $2.对话.最近对话 = "梦梦听到妈妈的回应、安心地笑了"
  }
}
