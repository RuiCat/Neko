// ═══════════════════════════════════════════════
// cat_emote.neko — 表情联动系统
// 把猫猫的状态触发 / 情感 → 自动匹配表情发送
// 内容关联：猫猫想表达什么 → 找到对应表情
// ═══════════════════════════════════════════════

// ─── 表情状态字段 ───

@定义 NPC {
  "表情": {
    "最近发送": "",
    "待发送表情": "",
    "表情意图": "",
    "发送记录": []
  }
}

// ─── 情感 → 表情意图映射 ───

@函数 表情意图(触发:str) -> str {
  if "开心" in 触发 ∨ "高兴" in 触发 ∨ "满足" in 触发 {
    返回 "开心"
  } else if "难过" in 触发 ∨ "委屈" in 触发 ∨ "哭" in 触发 {
    返回 "难过"
  } else if "困" in 触发 ∨ "睡觉" in 触发 ∨ "被窝" in 触发 {
    返回 "困"
  } else if "饿" in 触发 ∨ "吃" in 触发 ∨ "零食" in 触发 {
    返回 "吃货"
  } else if "撒娇" in 触发 ∨ "贴贴" in 触发 ∨ "蹭" in 触发 {
    返回 "撒娇"
  } else if "怕" in 触发 ∨ "吓" in 触发 ∨ "害怕" in 触发 {
    返回 "害怕"
  } else if "生气" in 触发 ∨ "哼" in 触发 {
    返回 "生气"
  } else if "想主人" in 触发 ∨ "想你" in 触发 {
    返回 "爱"
  } else {
    返回 "日常"
  }
}

// ─── 触发 → 表情意图 → 记录待发送 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].状态.触发 != "" ∧ $[NPC:猫猫].状态.触发 != $[NPC:猫猫].表情.最近发送 {
      $.表情.表情意图 = 表情意图($[NPC:猫猫].状态.触发)
    },
  $[NPC:猫猫].表情.表情意图 == "开心" {
      $.表情.待发送表情 = "开心表情"
    },
  $[NPC:猫猫].表情.表情意图 == "难过" {
      $.表情.待发送表情 = "委屈表情"
    },
  $[NPC:猫猫].表情.表情意图 == "困" {
      $.表情.待发送表情 = "犯困表情"
    },
  $[NPC:猫猫].表情.表情意图 == "吃货" {
      $.表情.待发送表情 = "干饭表情"
    },
  $[NPC:猫猫].表情.表情意图 == "撒娇" {
      $.表情.待发送表情 = "撒娇表情"
    },
  $[NPC:猫猫].表情.表情意图 == "爱" {
      $.表情.待发送表情 = "比心表情"
    },
  $[NPC:猫猫].表情.待发送表情 != "" ∧ $[NPC:猫猫].表情.待发送表情 != $[NPC:猫猫].表情.最近发送 {
      $.表情.最近发送 = $[NPC:猫猫].表情.待发送表情
    }
}
