// ═══════════════════════════════════════════════
// cat_relation.neko — 关系实体系统 v4（全泛化）
// 规则完全基于"关系"实体（类型/主体/客体/数值），不出现任何具体 NPC 名
// 泛化原则：适用于所有 NPC 之间的所有关系，通过关系类型与数值驱动
// ═══════════════════════════════════════════════

@定义 关系 {
  "类型": "",
  "主体": "",
  "客体": "",
  "数值": {
    "亲密": 50,
    "信赖": 50,
    "爱意": 30,
    "好感度": 50,
    "安全感": 50,
    "撒娇欲": 50
  },
  "状态": {
    "上次互动": "",
    "更新时间": ""
  }
}

// ─── 泛化1：关系数值缓步累积（所有关系实体适用，上限 100）───

@规则[$[关系]] {
  优先级: 100
  $.数值.亲密 < 100 {
    $.数值.亲密 += 1
  },
  $.数值.信赖 < 100 {
    $.数值.信赖 += 1
  },
  $.数值.好感度 < 100 {
    $.数值.好感度 += 1
  }
}

// ─── 泛化2：高亲密高撒娇 → 想贴贴（不分角色）───

@规则[$[关系]] {
  优先级: 150
  $.数值.撒娇欲 >= 80 ∧ $.数值.亲密 >= 80 {
    $.状态.上次互动 = "想贴贴"
  }
}

// ─── 泛化3：亲密满值 → 信赖/安全感补足（信任随亲密成长）───

@规则[$[关系]] {
  优先级: 180
  $.数值.亲密 >= 90 ∧ $.数值.安全感 < 100 {
    $.数值.安全感 += 1
  }
}

// ─── 泛化4：高亲密亲子/伴侣型 → 温馨互动表现（按类型泛化）───

@规则[$[关系]] {
  优先级: 200
  ($.类型 == "亲子" ∨ $.类型 == "伴侣" ∨ $.类型 == "主宠") ∧ $.数值.亲密 >= 90 ∧ $.状态.上次互动 != "" {
    $.状态.更新时间 = "最近"
    $.状态.上次互动 = "温馨互动"
  }
}

// ─── 泛化5：好感度高 → 关系积极（亲密倾向加速）───

@规则[$[关系]] {
  优先级: 250
  $.数值.好感度 >= 80 ∧ $.数值.亲密 < 95 {
    $.数值.亲密 += 2
  }
}
