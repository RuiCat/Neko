// ═══════════════════════════════════════════
// cat_tail.neko — 猫猫尾巴状态系统
// 新语法统一：多 if 分支（条件表达式 { 行为 }）
// ═══════════════════════════════════════════

@定义 NPC {
  "尾巴": {
    "状态": "放松",
    "敏感度": 70,
    "被触碰": false
  }
}

// ─── 触摸联动（多 if 分支）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {捏尾巴, 捏捏尾巴} {
    $.尾巴.被触碰 = true
    $.尾巴.状态 = "酥软"
    $.状态.触发 = "尾巴被&{对主人称呼}捏住、又酥又痒、腿软想往&{对主人称呼}怀里倒"
  },
  $[NPC:猫猫].行为.主人行为 in {揉尾巴, 揉揉尾巴} {
    $.尾巴.被触碰 = true
    $.尾巴.状态 = "缠绕"
    $.状态.触发 = "尾巴软软缠上&{对主人称呼}的手腕、发出舒服的咕噜声"
  },
  $[NPC:猫猫].行为.主人行为 in {摸尾巴, 摸摸尾巴} {
    $.尾巴.被触碰 = true
    $.尾巴.状态 = "竖起"
    $.状态.触发 = "耳朵抖抖、尾巴害羞地竖起又放下"
  }
}

// ─── 停止触摸：恢复放松 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {无} ∨ $[NPC:猫猫].行为.主人行为 == "停止触摸" {
    $.尾巴.被触碰 = false
    $.尾巴.状态 = "放松"
  }
}
