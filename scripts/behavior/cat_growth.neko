// ═══════════════════════════════════════════
// cat_growth.neko v2 — 属性成长系统（补全版）
// 借鉴 RPG Maker：经验/等级/特性 + 属性联动行为
// 体质→体力上限 / 魅力→撒娇加成 / 敏捷→行动效率
// ═══════════════════════════════════════════

@定义 NPC {
  "成长": {
    "经验": 0,
    "等级": 1,
    "等级上限": 99
  },
  "特性": {
    "体质": 1,
    "魅力": 1,
    "敏捷": 1,
    "感知": 1
  }
}

// ─── 互动积累经验 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.互动次数 > 20 {
    $.成长.经验 += 1
  },
  $[NPC:猫猫].行为.互动次数 > 50 {
    $.成长.经验 += 2
  },
  $[NPC:猫猫].行为.互动次数 > 100 {
    $.成长.经验 += 3
  }
}

// ─── 升级判定：经验 → 等级 → 随机属性成长 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].成长.经验 >= 100 ∧ $[NPC:猫猫].成长.等级 < $[NPC:猫猫].成长.等级上限 {
    $.成长.等级 += 1
    $.成长.经验 = 0
    $.特性.体质 += 1
    $.状态.触发 = "&{自称}升级了！等级&{成长.等级}、体质增强(&{特性.体质})"
  },
  $[NPC:猫猫].成长.经验 >= 150 ∧ $[NPC:猫猫].成长.等级 >= $[NPC:猫猫].成长.等级上限 {
    $.成长.经验 = 150
    $.状态.触发 = "等级已满……&{自称}已是最高等级、但成长永无止境"
  }
}

// ─── 特性联动行为（属性影响表现）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].特性.体质 >= 5 {
    $.身体.体力上限 = 120
    $.状态.触发 = "体质强化、&{自称}的体力上限提升了！"
  },
  $[NPC:猫猫].特性.魅力 >= 5 {
    $.关系.撒娇加成 = 1.5
    $.状态.触发 = "魅力绽放、&{自称}撒娇的威力提升了！"
  },
  $[NPC:猫猫].特性.敏捷 >= 5 {
    $.行为.行动效率 = 1.5
    $.状态.触发 = "身手敏捷、&{自称}行动更利索了！"
  }
}

// ─── 升级带来的属性成长（每级附加）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].成长.等级 % 5 == 0 ∧ $[NPC:猫猫].成长.等级 > 1 {
    $.特性.魅力 += 1
  },
  $[NPC:猫猫].成长.等级 % 3 == 0 ∧ $[NPC:猫猫].成长.等级 > 1 {
    $.特性.敏捷 += 1
  }
}

// ─── 特性联动扩展（Phase 3）───

// 感知特性：预知/察觉（感知≥5 → 提前察觉危险）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].特性.感知 >= 5 {
    $.标记.预知危险 = true
    $.状态.触发 = "感知敏锐、&{自称}提前察觉到不对劲的气息"
  },
  $[NPC:猫猫].特性.感知 >= 3 {
    $.标记.敏锐 = true
  }
}

// 敏捷特性：行动效率提升（互斥分档）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].特性.敏捷 >= 5 {
    $.行为.行动效率 = 2.0
  },
  $[NPC:猫猫].特性.敏捷 >= 3 ∧ $[NPC:猫猫].特性.敏捷 < 5 {
    $.行为.行动效率 = 1.3
  }
}

// 特性组合：特殊能力（体质+魅力 → 治愈光环）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].特性.体质 >= 5 ∧ $[NPC:猫猫].特性.魅力 >= 3 {
    $.特性.治愈光环 = true
    $.状态.触发 = "体质与魅力的结合……&{自称}散发出治愈的温暖气息"
  },
  $[NPC:猫猫].特性.魅力 >= 5 ∧ $[NPC:猫猫].特性.敏捷 >= 3 {
    $.特性.魅惑步法 = true
    $.状态.触发 = "魅力与敏捷的结合……&{自称}的步伐带着诱人的韵律"
  },
  $[NPC:猫猫].特性.感知 >= 5 ∧ $[NPC:猫猫].特性.敏捷 >= 5 {
    $.特性.猎手直觉 = true
    $.状态.触发 = "感知与敏捷的结合……&{自称}拥有猎手般的直觉"
  }
}

// 等级解锁新行为
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].成长.等级 >= 5 {
    $.行为.解锁技能 = "高阶撒娇"
  },
  $[NPC:猫猫].成长.等级 >= 10 {
    $.行为.解锁技能 = "猫娘秘术"
  },
  $[NPC:猫猫].成长.等级 >= 20 {
    $.行为.解锁技能 = "守护结界"
  }
}
