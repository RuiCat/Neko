// ═══════════════════════════════════════════
// cat_quest.neko v3 — 任务状态机系统（守卫版）
// 借鉴 RPG Maker Quest 系统：激活/解锁/开始/完成 4阶段
// + 条件类型（物品/地点/好感度）+ 奖励系统
// v3 修复：所有状态提示加 `触发 == ""` 守卫（不覆盖行为响应）
// 奖励逻辑与提示拆分（奖励永远执行、提示只在无响应时显示）
// ═══════════════════════════════════════════

@定义 NPC {
  "任务": {
    "当前任务": "",
    "阶段": "无",
    "进度": 0,
    "完成标记": false,
    "物品已获得": false
  },
  "任务条件": {
    "需要物品": "",
    "需要地点": "",
    "需要好感度": 0,
    "需要天数": 0,
    "需要时段": "",
    "需要季节": ""
  },
  "任务奖励": {
    "经验": 0,
    "好感度": 0
  },
  "行为": {
    "解锁技能": ""
  }
}

// ─── 任务阶段 → 对话（4阶段状态机·带守卫）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ $.状态.触发 == "" {
    $.状态.触发 = "新任务激活！&{自称}竖起耳朵认真听&{对主人称呼}的交代"
  },
  $[NPC:猫猫].任务.阶段 == "进行中" ∧ $.状态.触发 == "" ∧ ($[NPC:猫猫].任务条件.需要物品 == "" ∨ $[NPC:猫猫].任务.物品已获得 == true) ∧ ($[NPC:猫猫].任务条件.需要天数 == 0 ∨ $[NPC:猫猫].自我行动.行动次数 >= $[NPC:猫猫].任务条件.需要天数) {
    $.状态.触发 = "任务进行中……&{自称}正在努力、进度(&{任务.进度}/100)"
  },
  $[NPC:猫猫].任务.阶段 == "完成" ∧ $.状态.触发 == "" {
    $.状态.触发 = "任务完成啦！&{自称}得意地挺起小胸脯、等&{对主人称呼}夸奖"
    $.任务.完成标记 = true
  }
}

// ─── 阶段推进：所有已设条件满足 → 开始任务（综合条件规则）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ ($[NPC:猫猫].任务条件.需要地点 == "" ∨ $[NPC:猫猫].位置.场景 == $[NPC:猫猫].任务条件.需要地点) ∧ ($[NPC:猫猫].任务条件.需要时段 == "" ∨ $[NPC:猫猫].行为.时段 == $[NPC:猫猫].任务条件.需要时段) ∧ ($[NPC:猫猫].任务条件.需要季节 == "" ∨ $[NPC:猫猫].季节感.当前季节 == $[NPC:猫猫].任务条件.需要季节) ∧ ($[NPC:猫猫].任务条件.需要好感度 == 0 ∨ $[NPC:猫猫].关系.亲密 >= $[NPC:猫猫].任务条件.需要好感度) {
    $.任务.阶段 = "进行中"
  },
  $[NPC:猫猫].任务.阶段 == "进行中" ∧ $[NPC:猫猫].任务.进度 >= 100 {
    $.任务.阶段 = "完成"
  }
}

// ─── 任务完成奖励（借鉴 QuestReward·无守卫永远执行）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "完成" ∧ $[NPC:猫猫].任务.完成标记 == false {
    $.成长.经验 += $[NPC:猫猫].任务奖励.经验
    $.关系.亲密 += $[NPC:猫猫].任务奖励.好感度
  }
}

// ─── 任务奖励数值设定（按任务难度）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.进度 >= 100 ∧ $[NPC:猫猫].任务奖励.经验 == 0 {
    $.任务奖励.经验 = 20
    $.任务奖励.好感度 = 5
  }
}

// ─── 任务条件扩展（借鉴游戏 QuestCondition 29 种类型）───

// 时间条件：任务需要特定时段（提示带守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ $[NPC:猫猫].任务条件.需要时段 != "" ∧ $[NPC:猫猫].行为.时段 != $[NPC:猫猫].任务条件.需要时段 ∧ $.状态.触发 == "" {
    $.状态.触发 = "任务需要等&{任务条件.需要时段}……&{自称}先休息一下"
  },
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ $[NPC:猫猫].任务条件.需要时段 != "" ∧ $[NPC:猫猫].行为.时段 == $[NPC:猫猫].任务条件.需要时段 {
    $.任务.阶段 = "进行中"
  }
}

// 季节条件：任务需要特定季节
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ $[NPC:猫猫].任务条件.需要季节 != "" ∧ $[NPC:猫猫].季节感.当前季节 == $[NPC:猫猫].任务条件.需要季节 {
    $.任务.阶段 = "进行中"
    $.状态.触发 = "季节到了！&{自称}可以开始任务了"
  }
}

// 好感度条件：任务需要好感度达标（提示带守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ $[NPC:猫猫].任务条件.需要好感度 > 0 ∧ $[NPC:猫猫].关系.亲密 < $[NPC:猫猫].任务条件.需要好感度 ∧ $.状态.触发 == "" {
    $.状态.触发 = "任务还需要更多好感……&{自称}先和&{对主人称呼}增进感情"
  },
  $[NPC:猫猫].任务.阶段 == "已激活" ∧ $[NPC:猫猫].任务条件.需要好感度 > 0 ∧ $[NPC:猫猫].关系.亲密 >= $[NPC:猫猫].任务条件.需要好感度 {
    $.任务.阶段 = "进行中"
  }
}

// 物品条件：任务需要携带物品（提示带守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "进行中" ∧ $[NPC:猫猫].任务条件.需要物品 != "" ∧ $[NPC:猫猫].任务.物品已获得 == false ∧ $.状态.触发 == "" {
    $.状态.触发 = "任务需要&{任务条件.需要物品}……&{自称}还没找到"
  }
}

// 天数条件：任务需要等待天数（提示带守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "进行中" ∧ $[NPC:猫猫].任务条件.需要天数 > 0 ∧ $[NPC:猫猫].自我行动.行动次数 < $[NPC:猫猫].任务条件.需要天数 ∧ $.状态.触发 == "" {
    $.状态.触发 = "任务还需等待(&{自我行动.行动次数}/&{任务条件.需要天数}天)"
  },
  $[NPC:猫猫].任务.阶段 == "进行中" ∧ $[NPC:猫猫].任务条件.需要天数 > 0 ∧ $[NPC:猫猫].自我行动.行动次数 >= $[NPC:猫猫].任务条件.需要天数 {
    $.任务.进度 += 50
  }
}

// ─── 系统整合（Phase 5）：任务 → 自我行动联动 ───

// 任务激活 → 自我行动接入任务目标（无触发文本·无需守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "已激活" {
    $.自我行动.目标 = $[NPC:猫猫].任务.当前任务
  },
  $[NPC:猫猫].任务.阶段 == "进行中" {
    $.自我行动.目标 = $[NPC:猫猫].任务.当前任务
  },
  $[NPC:猫猫].任务.阶段 == "完成" {
    $.自我行动.目标 = ""
  }
}

// 任务完成 → 成长奖励联动（奖励永远执行·提示带守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].任务.阶段 == "完成" ∧ $[NPC:猫猫].任务.完成标记 == false ∧ $.状态.触发 == "" {
    $.状态.触发 = "任务完成！获得经验奖励和&{对主人称呼}的好感"
  },
  $[NPC:猫猫].任务.阶段 == "完成" ∧ $[NPC:猫猫].任务.完成标记 == false {
    $.成长.经验 += $[NPC:猫猫].任务奖励.经验
    $.关系.亲密 += $[NPC:猫猫].任务奖励.好感度
  }
}

// 等级解锁行为（整合成长→行为·提示带守卫）
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].成长.等级 >= 10 ∧ $[NPC:猫猫].行为.解锁技能 == "" ∧ $.状态.触发 == "" {
    $.行为.解锁技能 = "猫娘秘术"
    $.状态.触发 = "等级提升、&{自称}学会了猫娘秘术！"
  }
}

// 任务模板库（借鉴游戏任务结构：激活→条件→完成→奖励）
@定义 任务模板 {
  "收集任务": {"阶段": "已激活", "条件": "需要物品", "奖励": "经验20+好感5"},
  "地点任务": {"阶段": "已激活", "条件": "需要地点", "奖励": "经验15"},
  "好感任务": {"阶段": "已激活", "条件": "需要好感度", "奖励": "好感10"},
  "等待任务": {"阶段": "已激活", "条件": "需要天数", "奖励": "经验10"},
  "季节任务": {"阶段": "已激活", "条件": "需要季节", "奖励": "经验25"}
}
