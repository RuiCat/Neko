// ═══════════════════════════════════════════════════════
// cat_mengmeng_adult.neko — 梦梦成年（独立 NPC）专属规则
//
// 背景（2026-10-20 19:07）：
//   梦梦（婴儿体/群聊）与 梦梦成年（私聊）是【两个独立实体】。
//   梦梦成年 type = NPC:梦梦:成年（继承 NPC → NPC:梦梦），
//   数据里 分类 = ["梦梦","成年"]。
//
// 选择器约定：
//   共用规则 → $[梦梦]   （走 分类 标签，两个实体都命中）
//   成年专属 → $[成年]   （只命中 梦梦成年）
//   婴儿专属 → $[幼崽]   （只命中 梦梦）
// ───────────────────────────────────────────────────────

@规则[$[成年]] {
  优先级: 210

  $.行为.主人行为 contains "抱" {
    $.状态.触发 = "被爸爸抱在怀里、成年猫娘的身子软下来、手轻轻抓着爸爸的衣襟，尾巴垂着慢慢晃"
    $.部位.爪爪.被触碰 = true
    $.部位.爪爪.状态 = "抓着衣襟不放"
    $.梦梦状态.上次互动 = "被抱抱"
  },
  $.行为.主人行为 contains "摸头" ∨ $.行为.主人行为 contains "拍头" ∨ $.行为.主人行为 contains "揉头" {
    $.部位.头顶.被触碰 = true
    $.部位.头顶.状态 = "被摸得很放松"
    $.状态.触发 = "被爸爸摸着头顶、奶黄色的猫耳软软塌下来、半阖着眼睛往手心里顶"
    $.梦梦状态.上次互动 = "被摸头"
  },
  $.行为.主人行为 contains "亲" {
    $.状态.触发 = "被爸爸亲到、脸一下子热起来、耳朵贴平又悄悄竖回来、心跳乱得不像话"
    $.梦梦状态.上次互动 = "被亲亲"
  },
  $.行为.主人行为 contains "顺毛" ∨ $.行为.主人行为 contains "摸背" {
    $.部位.背脊.被触碰 = true
    $.部位.背脊.状态 = "热的、弓起来"
    $.状态.触发 = "被爸爸顺着背脊慢慢摸、背弓起来、长长的尾巴舒服得一下一下地摆"
    $.梦梦状态.上次互动 = "被顺毛"
  },
  $.行为.主人行为 contains "拍" {
    $.状态.触发 = "被爸爸抱起来按住、屁股上挨了一下、尾巴炸开又慢慢软下去、脸红到耳根"
    $.梦梦状态.上次互动 = "被拍屁股"
  },
  $.行为.主人行为 contains "爪" ∨ $.行为.主人行为 contains "肉垫" {
    $.部位.肉垫.被触碰 = true
    $.部位.肉垫.状态 = "粉嫩发烫"
    $.状态.触发 = "爪爪被爸爸捏住、粉色肉垫微微发烫、想缩回去又舍不得"
    $.梦梦状态.上次互动 = "被捏爪爪"
  },
  $.行为.主人行为 in {无, 停止触摸, 收手} {
    $.部位.头顶.被触碰 = false
    $.部位.头顶.状态 = "放松"
    $.部位.肉垫.被触碰 = false
    $.部位.肉垫.状态 = "放松"
    $.部位.爪爪.被触碰 = false
    $.部位.爪爪.状态 = "放松"
    $.部位.背脊.被触碰 = false
    $.部位.背脊.状态 = "放松"
  }
}
