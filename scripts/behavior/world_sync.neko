// ═══════════════════════════════════════════════
// world_sync.neko — 世界/场景智慧体接入实体系统
// 把 neko 权威世界状态镜像到实体，供脚本规则驱动
// ═══════════════════════════════════════════════

// ─── 世界实体模板（镜像 世界实体（entities.json）+ meta）───

@定义 世界 {
  "环境": {
    "所在场景": "S001-BR",
    "天气": "晴",
    "温度": 26,
    "光照": "明亮",
    "当前时间": "2026-08-03T01:54:00+08:00",
    "当前月份": 8,
    "场景特征": []
  },
  "状态": {
    "阶段": "凌晨",
    "会话数": 0
  }
}

// ─── 场景实体模板（镜像 scenes/*.json 静态定义）───

@定义 场景 {
  "场景ID": "S000",
  "名称": "未知场景",
  "类型": "未知",
  "区域": "",
  "氛围": {"光照": "", "声音": "", "气味": "", "温度": ""},
  "物品": [],
  "连接": []
}

// ─── 世界状态 → 猫猫行为联动 ───

@规则[$[NPC]，世界] {
  世界.环境.天气 == "雨" {
      $.状态.情绪 = "慵懒"
    },
  世界.环境.温度 < 18 {
      $.状态.触发 = "觉得冷、想钻进被窝"
    },
  世界.环境.温度 > 30 {
      $.状态.触发 = "觉得热、想吹空调"
    }
}

// ─── 场景变化 → 猫猫感知 ───

@规则[$[NPC]，世界] {
  世界.环境.所在场景 != $[NPC].位置.场景 {
      $.位置.场景 = 世界.环境.所在场景
    },
  世界.环境.所在场景 != $[NPC].位置.场景 ∧ $[NPC].位置.场景 != "" {
      $.状态.触发 = "移动到新场景"
    }
}
