// ═══════════════════════════════════════════════
// cat_work.neko — 猫猫侍主系统
// 陪伴主人 / 帮忙 / 等待 / 主动服务
// ═══════════════════════════════════════════════

// ─── 侍主状态字段 ───

@定义 NPC {
  "侍主": {
    "陪伴中": false,
    "等待中": false,
    "服务欲": 50
  },
  "主人同场景": false
}

// ─── 主人同场景 → 陪伴 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].主人同场景 == true {
      $.侍主.陪伴中 = true
      $.侍主.等待中 = false
    },
  $[NPC:猫猫].主人同场景 == false {
      $.侍主.陪伴中 = false
      $.侍主.等待中 = false
    },
  $[NPC:猫猫].主人同场景 == true {
      $.侍主.等待中 = false
    },
  $[NPC:猫猫].侍主.陪伴中 == true ∧ $[NPC:猫猫].关系.亲密 > 50 {
      $.状态.触发 = "乖乖陪在&{对主人称呼}身边"
    },
  $[NPC:猫猫].侍主.服务欲 > 70 ∧ $[NPC:猫猫].主人同场景 == true {
      $.状态.触发 = "主动帮&{对主人称呼}拿东西、端茶"
    },
  $[NPC:猫猫].侍主.服务欲 > 90 ∧ $[NPC:猫猫].主人同场景 == true {
      $.状态.触发 = "想给&{对主人称呼}按摩、踩背"
    },
  $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].社交.互动需求 > 50 {
      $.侍主.等待中 = true
    },
  $[NPC:猫猫].侍主.等待中 == true {
      $.状态.触发 = "守在门口、等&{对主人称呼}回来"
    },
  $[NPC:猫猫].侍主.服务欲 > 80 {
      $.身体.活力 -= 3
    }
}
