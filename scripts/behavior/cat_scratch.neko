// ═══════════════════════════════════════════
// cat_scratch.neko — 猫猫挠痒痒行为系统
// 行为补全：挠下巴/挠肚子/挠痒痒 → 状态联动
// 新语法：多 if 分支（条件表达式 { 行为 }）
// ═══════════════════════════════════════════

@定义 NPC {
  "挠痒": {
    "状态": "待挠",
    "部位": "",
    "舒服度": 0
  }
}

// ─── 挠痒：下巴/肚子/背 → 状态联动（多 if 分支）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {挠下巴, 挠挠下巴} ∨ $[NPC:猫猫].行为.主人行为 in {挠挠} {
      $.挠痒.状态 = "眯眼"
      $.挠痒.部位 = "下巴"
      $.挠痒.舒服度 = 60
      $.状态.触发 = "被挠下巴、舒服地眯起眼睛、咕噜咕噜响"
    },
    $[NPC:猫猫].行为.主人行为 in {挠肚子, 揉揉肚子, 揉肚} ∨ $[NPC:猫猫].行为.主人行为 in {揉肚子} {
      $.挠痒.状态 = "翻肚皮"
      $.挠痒.部位 = "肚子"
      $.挠痒.舒服度 = 80
      $.状态.触发 = "被挠肚子、四脚朝天翻肚皮、爪子开心地抓空气"
    },
    $[NPC:猫猫].行为.主人行为 in {挠痒痒, 挠挠背} ∨ $[NPC:猫猫].行为.主人行为 in {挠背} {
      $.挠痒.状态 = "配合"
      $.挠痒.部位 = "背"
      $.挠痒.舒服度 = 50
      $.状态.触发 = "被挠痒痒、扭来扭去配合、尾巴翘得老高"
    },
  $[NPC:猫猫].行为.主人行为 in {无} ∨ $[NPC:猫猫].行为.主人行为 == "停止触摸" {
      $.挠痒.状态 = "待挠"
      $.挠痒.部位 = ""
      $.挠痒.舒服度 = 0
    }
}
