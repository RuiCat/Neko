// ═══════════════════════════════════════════════════════
// cat_touch_mengmeng.neko — 梦梦触摸响应补全 v2
//
// 病因诊断（2026-10-20）：
//   ① cat_mengmeng.neko 的摸头分支词表只有 {摸梦梦, 摸摸梦梦, 摸头梦梦}
//      → 主人说「摸摸头」时命中不了（in 是集合精确比对）
//   ② 主人行为是复合串「摸头、揉小腹、抱着不放开」时必然不匹配
//   ③ 于是梦梦的「状态.触发」被 cat_scene_autonomy.neko（p95，按场景无条件覆写）
//      抢走，变成「在客厅窝在沙发上…看电视」（2026-10-20 tick 实测确认 r_53c7cb45）
//
// v2 修正（相对 v1）：
//   条件左侧统一改写为 `$`：compiler 会重写成 {e}.xxx。
//   v1 用 $[NPC:梦梦].行为.主人行为 —— 重写后一旦落进「默认挂身体分组」分支，
//   会变成 {e}.身体.主人行为（不存在）→ 条件恒 False → 整条规则静默失效。
//   用 `$` 是编译器最短路路径，最稳。
//
// 优先级 210 > 场景 95：低优先先执行、高优先覆盖，场景描述先写、触摸响应后写。
// ═══════════════════════════════════════════════════════

@规则[$[NPC:梦梦]] {
  优先级: 210

  // ── 被抱 / 被搂住 ──
  $.行为.主人行为 contains "抱" {
    $.状态.触发 = "被爸爸抱在怀里、整只小猫软下来、爪子轻轻抓着爸爸的衣襟"
    $.部位.爪爪.被触碰 = true
    $.部位.爪爪.状态 = "抓着衣襟不放"
    $.梦梦状态.上次互动 = "被抱抱"
  },
  // ── 顺毛 / 摸背脊 ──
  $.行为.主人行为 contains "顺毛" ∨ $.行为.主人行为 contains "摸背" {
    $.部位.背脊.被触碰 = true
    $.部位.背脊.状态 = "热的"
    $.状态.触发 = "被爸爸顺着背脊慢慢摸、背弓起来、尾巴舒服得一下一下地摆"
    $.梦梦状态.上次互动 = "被顺毛"
  },
  // ── 摸耳朵 / 揉耳朵 ──
  $.行为.主人行为 contains "摸耳" ∨ $.行为.主人行为 contains "揉耳" {
    $.耳朵.被触碰 = true
    $.耳朵.状态 = "软趴趴发烫"
    $.状态.触发 = "耳朵被爸爸捏住、奶黄色的耳朵抖了一下就软软塌下来、整个人都酥了"
    $.梦梦状态.上次互动 = "被摸耳朵"
  },
  // ── 捏爪爪 / 揉肉垫 ──
  $.行为.主人行为 contains "爪" ∨ $.行为.主人行为 contains "肉垫" {
    $.部位.爪爪.被触碰 = true
    $.部位.爪爪.状态 = "害羞地想缩"
    $.部位.肉垫.被触碰 = true
    $.部位.肉垫.状态 = "粉嫩发烫"
    $.状态.触发 = "爪爪被爸爸捏住、粉色肉垫微微发烫、害羞得想缩回去又舍不得"
    $.梦梦状态.上次互动 = "被捏爪爪"
  },
  // ── 摸头 / 拍头 / 揉头顶（放在最后：复合串里最想让这一条说话）──
  $.行为.主人行为 contains "摸头" ∨ $.行为.主人行为 contains "拍头" ∨ $.行为.主人行为 contains "揉头" {
    $.部位.头顶.被触碰 = true
    $.部位.头顶.状态 = "被摸得很放松"
    $.状态.触发 = "被爸爸摸着头顶、奶黄色的猫耳软软地塌下来、眯起琥珀金的眼睛往手心里蹭"
    $.梦梦状态.上次互动 = "被摸头"
  },
  // ── 捏脸 / 摸脸颊 ──
  $.行为.主人行为 contains "脸" {
    $.部位.脸颊.被触碰 = true
    $.部位.脸颊.状态 = "烫的、往手心蹭"
    $.状态.触发 = "脸颊被爸爸捧住、忍不住把脸埋进大手心里蹭、喉咙里滚出细细的咕噜声"
    $.梦梦状态.上次互动 = "被摸脸"
  },
  // ── 手离开：部位复位 ──
  $.行为.主人行为 in {无, 停止触摸, 收手} {
    $.部位.头顶.被触碰 = false
    $.部位.头顶.状态 = "放松"
    $.部位.肉垫.被触碰 = false
    $.部位.肉垫.状态 = "放松"
    $.部位.爪爪.被触碰 = false
    $.部位.爪爪.状态 = "放松"
    $.部位.脸颊.被触碰 = false
    $.部位.脸颊.状态 = "放松"
    $.部位.背脊.被触碰 = false
    $.部位.背脊.状态 = "放松"
  }
}
