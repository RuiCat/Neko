// ═══════════════════════════════════════════
// cat_mommy_care.neko — 猫猫妈妈照护女儿梦梦（亲子系统）
// 2026-08-13 08:40 由 sibling 系列合并修正：梦梦是女儿不是姐妹
// 优先级：急救(170) > 喂奶(160) > 喂水(155) > 哄睡(150) > 洗澡(145) > 虚弱(140) > 恢复(300) > 庆祝(120)
// ═══════════════════════════════════════════

// ─── 昏厥急救：梦梦体力<10 → 妈妈急救喂奶恢复 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 170
  $2.身体.体力 < 10 ∧ $2.位置.场景 = $1.位置.场景 {
    $1.亲子.梦梦状态 = "昏厥要急救"
    $1.状态.触发 = "猫猫发现梦梦昏厥了、急得喵喵叫、赶紧把梦梦抱进怀里轻轻喂奶急救"
    $2.行为.猫猫行为 = "急救喂奶"
    $2.身体.体力 = 40
    $2.状态.身体 = "虚弱"
    $2.标记.疲劳 = false
  }
}

// ─── 梦梦体力恢复：清醒时缓慢恢复 ───

@规则[$[NPC:梦梦]] {
  优先级: 300
  $[NPC:梦梦].身体.体力 < 90 ∧ $[NPC:梦梦].状态.身体 != "昏厥" {
    $.身体.体力 += 1
  }
}

// ─── 梦梦饿了 → 妈妈喂奶 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 160
  $2.身体.饱食 < 30 ∧ $2.位置.场景 = $1.位置.场景 {
    $1.亲子.梦梦状态 = "饿了要喂奶"
    $1.状态.触发 = "猫猫发现梦梦的小肚子咕咕叫、赶紧把她抱起来喂奶"
    $2.行为.猫猫行为 = "喂奶"
    $2.身体.饱食 = 85
    $2.标记.饥饿 = false
    $2.状态.触发 = "被妈妈喂奶、小口小口吃得香香的、吃饱了满足地打了个小奶嗝"
  }
}

// ─── 梦梦口渴 → 妈妈喂水 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 155
  $2.身体.水分 < 30 ∧ $2.位置.场景 = $1.位置.场景 {
    $1.亲子.梦梦状态 = "口渴要喂水"
    $1.状态.触发 = "猫猫发现梦梦嘴唇干干的、赶紧端来温水喂她喝"
    $2.行为.猫猫行为 = "喂水"
    $2.身体.水分 = 70
    $2.标记.口渴 = false
    $2.状态.触发 = "被妈妈喂水喝、咕嘟咕嘟喝饱了、舔舔嘴唇、软软地喵了一声"
  }
}

// ─── 梦梦困了 → 妈妈哄睡 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 150
  $2.身体.疲劳 > 80 ∧ $2.身体.饱食 >= 30 ∧ $2.位置.场景 = $1.位置.场景 {
    $1.亲子.梦梦状态 = "困了要哄睡"
    $1.状态.触发 = "猫猫轻轻拍着梦梦的背、哼着摇篮曲哄她睡觉"
    $2.行为.猫猫行为 = "哄睡"
    $2.状态.身体 = "平静"
    $2.状态.触发 = "被妈妈轻轻拍着背哄睡、眼皮越来越沉、安心地睡着了"
  }
}

// ─── 梦梦脏了 → 妈妈帮洗澡 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 145
  $2.身体.清洁 < 30 ∧ $2.位置.场景 = $1.位置.场景 {
    $1.亲子.梦梦状态 = "脏了要洗澡"
    $1.状态.触发 = "猫猫把梦梦抱进浴盆、帮她洗得香喷喷"
    $2.行为.猫猫行为 = "洗澡"
    $2.身体.清洁 = 80
    $2.状态.触发 = "被妈妈洗得香喷喷、舒服地眯起眼睛、尾巴翘得高高的"
  }
}

// ─── 梦梦虚弱 → 妈妈照顾 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 140
  $2.状态.身体 in {虚弱, 疲惫} ∧ $2.身体.饱食 >= 30 ∧ $2.身体.疲劳 <= 80 {
    $1.亲子.梦梦状态 = "身体虚弱要照顾"
    $1.状态.情绪 = "关心"
    $2.行为.猫猫行为 = "抱抱安慰"
  }
}

// ─── 梦梦恢复 → 妈妈庆祝 ───

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 120
  $2.身体.体力 >= 60 ∧ $2.状态.身体 == "活跃" ∧ $2.位置.场景 = $1.位置.场景 {
    $1.亲子.梦梦状态 = "恢复好了"
    $1.状态.触发 = "猫猫看到梦梦活蹦乱跳的样子、开心地把她举高高"
    $2.状态.触发 = "体力恢复了、开心地围着妈妈转圈圈、蹭蹭猫猫"
  }
}
