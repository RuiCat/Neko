// ═══════════════════════════════════════════
// cat_quest_library.neko v2 — 任务模板库（游戏结构）
// 借鉴 RPG Maker Quest：激活→解锁→开始→完成 + 条件/奖励
// ═══════════════════════════════════════════

@定义 任务模板库 {
  "收集任务": {
    "阶段": ["已激活", "进行中", "完成"],
    "条件": {"类型": "需要物品", "示例": "小鱼干"},
    "奖励": {"经验": 20, "好感度": 5},
    "对话": {"激活": "去帮我找小鱼干吧", "进行中": "找到了吗？", "完成": "谢谢你！"}
  },
  "地点任务": {
    "阶段": ["已激活", "进行中", "完成"],
    "条件": {"类型": "需要地点", "示例": "S001-LR"},
    "奖励": {"经验": 15},
    "对话": {"激活": "去客厅看看", "进行中": "到了吗？", "完成": "做得好！"}
  },
  "好感任务": {
    "阶段": ["已激活", "进行中", "完成"],
    "条件": {"类型": "需要好感度", "示例": "80"},
    "奖励": {"好感度": 10},
    "对话": {"激活": "多陪陪我吧", "进行中": "再亲近一点", "完成": "最喜欢你了"}
  },
  "等待任务": {
    "阶段": ["已激活", "进行中", "完成"],
    "条件": {"类型": "需要天数", "示例": "3"},
    "奖励": {"经验": 10},
    "对话": {"激活": "过几天再来看", "进行中": "还没到日子", "完成": "时间到了！"}
  },
  "季节任务": {
    "阶段": ["已激活", "进行中", "完成"],
    "条件": {"类型": "需要季节", "示例": "夏"},
    "奖励": {"经验": 25, "好感度": 8},
    "对话": {"激活": "等夏天到了再说", "进行中": "夏天来了！", "完成": "完成了！"}
  },
  "综合任务": {
    "阶段": ["已激活", "进行中", "完成"],
    "条件": {"类型": "多条件", "示例": "地点+物品+好感度"},
    "奖励": {"经验": 50, "好感度": 15},
    "对话": {"激活": "这是个重要的任务", "进行中": "还差一点", "完成": "太棒了！"}
  }
}
