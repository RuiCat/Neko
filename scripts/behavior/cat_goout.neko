// ═══════════════════════════════════════════
// cat_goout.neko — 猫猫外出行为系统
// 行为补全：出去玩 → 兴奋出门；玩累回家 → 乖乖回家
// ═══════════════════════════════════════════

// ─── 出去玩：兴奋冲到门口 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {出去玩} {
      $.状态.触发 = "&{对主人称呼}带&{自称}出去玩、&{自称}兴奋得原地转圈圈、尾巴翘得老高、第一个冲到门口"
    },
  $[NPC:猫猫].行为.主人行为 in {回家} ∨ $[NPC:猫猫].行为.主人行为 in {玩累了回家} {
      $.状态.触发 = "玩累了、&{自称}乖乖跟着&{对主人称呼}回家、路上打着小哈欠、到家就窝进沙发打盹"
    }
}
