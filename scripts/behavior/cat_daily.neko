// ═══════════════════════════════════════════════
// cat_daily.neko — 猫猫时间作息系统
// 根据世界时间驱动：清醒/睡觉/活动周期
// ═══════════════════════════════════════════════

// ─── 作息状态字段 ───

@定义 NPC {
  "作息": {
    "阶段": "清醒",
    "上次睡觉": "",
    "睡醒时间": ""
  }
}

// ─── 时间解析函数：判断当前时段 ───

@函数 时段判断(时间:str) -> str {
  小时 = int(时间[11:13])
  if 小时 >= 6 ∧ 小时 < 10 { 返回 "清晨" }
  else if 小时 >= 10 ∧ 小时 < 14 { 返回 "上午" }
  else if 小时 >= 14 ∧ 小时 < 18 { 返回 "下午" }
  else if 小时 >= 18 ∧ 小时 < 22 { 返回 "傍晚" }
  else if 小时 >= 22 { 返回 "深夜" }
  else { 返回 "凌晨" }
}

// ─── 时段规则 ───

@规则[$[NPC:猫猫]，世界] {
  优先级: 200
  时段判断(世界.环境.当前时间) == "深夜" ∧ $.状态.触发 == "" {
      $.状态.触发 = "困了、想睡觉"
    },
  时段判断(世界.环境.当前时间) == "凌晨" ∧ $.状态.触发 == "" {
      $.状态.触发 = "在睡梦中、蜷着尾巴呼呼大睡"
    },
  时段判断(世界.环境.当前时间) == "清晨" ∧ $.状态.触发 == "" {
      $.状态.触发 = "刚睡醒、伸懒腰"
    },
  时段判断(世界.环境.当前时间) == "下午" ∧ $.状态.触发 == "" {
      $.状态.触发 = "午后有点犯困、想晒太阳"
    },
  时段判断(世界.环境.当前时间) == "傍晚" ∧ $.状态.触发 == "" {
      $.状态.触发 = "精神好、想和&{对主人称呼}玩"
    }
}

// ─── 体力恢复：清醒时缓慢恢复（高优先级=安全等级判定后执行，下轮生效）───

@规则[$[NPC:猫猫]] {
  优先级: 300
  $[NPC:猫猫].身体.体力 < 90 ∧ $[NPC:猫猫].状态.身体 != "昏厥" {
    $.身体.体力 += 1
  }
}

// ─── 清洁度缓慢下降（需要洗澡）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].身体.清洁 > 20 {
    $.身体.清洁 -= 1
  },
  $[NPC:猫猫].身体.清洁 > 20 {
      $.身体.清洁 -= 1
  },
  $[NPC:猫猫].身体.清洁 < 30 ∧ $.状态.触发 == "" {
      $.状态.触发 = "想洗澡、想舔毛"
  }
}