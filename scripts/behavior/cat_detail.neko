// ═══════════════════════════════════════════════
// cat_detail.neko — 猫猫细节行为优化 v1
// 基于完整状态的精细行为联动
// ═══════════════════════════════════════════════

@定义 NPC {
  "状态": {
    "当前情绪": "平静",
    "情绪强度[int,min:0,max:10]": 3,
    "情绪稳定性": "平稳"
  }
}

// ─── 撒娇行为（撒娇欲 + 亲密驱动）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].关系.撒娇欲 > 80 ∧ $[NPC:猫猫].关系.亲密 > 80 ∧ $.状态.触发 == "" {
      $.状态.触发 = "蹭蹭&{对主人称呼}怀里、发出咕噜咕噜声"
    },
  $[NPC:猫猫].关系.撒娇欲 > 60 ∧ $[NPC:猫猫].关系.亲密 > 70 ∧ $[NPC:猫猫].状态.情绪 == "开心" ∧ $.状态.触发 == "" {
      $.状态.触发 = "用脑袋蹭&{对主人称呼}手、尾巴轻轻摇晃"
    },
  $[NPC:猫猫].侍主.陪伴中 == true ∧ $[NPC:猫猫].身体.舒适 > 80 ∧ $.状态.触发 == "" {
      $.状态.触发 = "乖乖窝在&{对主人称呼}身边、眯着眼睛很满足"
    },
  $[NPC:猫猫].侍主.陪伴中 == true ∧ $[NPC:猫猫].标记.想撒娇 == true ∧ $.状态.触发 == "" {
      $.状态.触发 = "往&{对主人称呼}怀里钻、想被抱着"
    },
  $[NPC:猫猫].心情.当前 == "开心" ∧ $[NPC:猫猫].心情.强度 > 60 ∧ $.状态.触发 == "" {
      $.状态.触发 = "开心地哼着小曲、尾巴尖都在愉悦"
    },
  $[NPC:猫猫].心情.当前 == "满足" ∧ $.状态.触发 == "" {
      $.状态.触发 = "满足地呼噜呼噜、耳朵舒服地耷拉着"
    },
  $[NPC:猫猫].作息.阶段 == "清醒" ∧ $[NPC:猫猫].行为.互动次数 < 5 {
      $.行为.互动次数 += 1
    }
}

// ─── 天气感受（季节联动）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].季节感.当前季节 == "冬" ∧ $[NPC:猫猫].天气感.喜欢天气 == "晴天" ∧ $.状态.触发 == "" {
    $.状态.触发 = "冬天的晴天最适合晒太阳了喵~"
  }
}

// ─── 情绪强度自稳 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].状态.情绪强度 > 8 {
    $.状态.情绪强度 = 8
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].状态.情绪强度 < 1 ∧ $[NPC:猫猫].状态.情绪 == "平静" {
    $.状态.情绪强度 = 3
  },
  $[NPC:猫猫].状态.情绪强度 > 8 {
      $.状态.情绪强度 = 8
    },
  $[NPC:猫猫].状态.情绪强度 < 1 ∧ $[NPC:猫猫].状态.情绪 == "平静" {
      $.状态.情绪强度 = 3
    }
}