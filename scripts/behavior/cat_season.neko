// ═══════════════════════════════════════════════
// cat_season.neko — 猫猫季节系统
// 四季变化 / 季节行为 / 换毛（新语法：多 if 分支）
// ═══════════════════════════════════════════════

// ─── 季节状态字段 ───

@定义 NPC {
  "季节感": {
    "当前季节": "夏",
    "换毛中": false,
    "季节偏好": "秋"
  }
}

// ─── 季节判断函数 ───

@函数 季节判断(月份:int) -> str {
  if 月份 >= 3 ∧ 月份 <= 5 { 返回 "春" }
  else if 月份 >= 6 ∧ 月份 <= 8 { 返回 "夏" }
  else if 月份 >= 9 ∧ 月份 <= 11 { 返回 "秋" }
  else { 返回 "冬" }
}

// ─── 季节同步（按月比较·多 if 分支）───

@规则[$[NPC:猫猫]，世界] {
  优先级: 200
  世界.环境.当前月份 >= 3 ∧ 世界.环境.当前月份 <= 5 ∧ $[NPC:猫猫].季节感.当前季节 != "春" {
      $.季节感.当前季节 = "春"
    },
    世界.环境.当前月份 >= 6 ∧ 世界.环境.当前月份 <= 8 ∧ $[NPC:猫猫].季节感.当前季节 != "夏" {
      $.季节感.当前季节 = "夏"
    },
    世界.环境.当前月份 >= 9 ∧ 世界.环境.当前月份 <= 11 ∧ $[NPC:猫猫].季节感.当前季节 != "秋" {
      $.季节感.当前季节 = "秋"
    },
    (世界.环境.当前月份 <= 2 ∨ 世界.环境.当前月份 >= 12) ∧ $[NPC:猫猫].季节感.当前季节 != "冬" {
      $.季节感.当前季节 = "冬"
    },
  $[NPC:猫猫].季节感.当前季节 == "春" ∧ $.状态.触发 == "" {
      $.状态.触发 = "春天到了、闻到花香"
    },
    $[NPC:猫猫].季节感.当前季节 == "夏" ∧ $.状态.触发 == "" {
      $.状态.触发 = "夏天好热、想找凉快的地方"
    },
    $[NPC:猫猫].季节感.当前季节 == "秋" ∧ $.状态.触发 == "" {
      $.状态.触发 = "秋天凉爽、适合晒太阳打盹"
    },
    $[NPC:猫猫].季节感.当前季节 == "冬" ∧ $.状态.触发 == "" {
      $.状态.触发 = "冬天好冷、想钻进暖和的被窝"
    },
  $[NPC:猫猫].季节感.当前季节 == "春" ∨ $[NPC:猫猫].季节感.当前季节 == "秋" ∧ $.状态.触发 == "" {
      $.季节感.换毛中 = true
      $.状态.触发 = "换毛期、掉毛有点多"
    },
    $[NPC:猫猫].季节感.当前季节 == "夏" ∨ $[NPC:猫猫].季节感.当前季节 == "冬" {
      $.季节感.换毛中 = false
    }
}
