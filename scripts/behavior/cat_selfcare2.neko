// ═══════════════════════════════════════════
// cat_selfcare2.neko — 猫猫自主行动规则·第二批
// 自主娱乐/梳毛/睡眠/运动/安全/巡护/探索/待命/整理/情绪
// ═══════════════════════════════════════════

@定义 NPC {
  "自我行动2": {
    "上次行动": "",
    "行动次数": 0
  }
}

// ─── 无聊 → 自己找乐子 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].心情.当前 == "无聊" ∨ ($[NPC:猫猫].社交.互动需求 < 20 ∧ $[NPC:猫猫].身体.活力 > 50) ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}觉得有点无聊、自己叼出玩具玩了起来、自得其乐"
  },
    $[NPC:猫猫].心情.当前 == "无聊" ∨ ($[NPC:猫猫].社交.互动需求 < 20 ∧ $[NPC:猫猫].身体.活力 > 50) {
    $.玩耍.乐趣值 = 70
    $.自我行动2.上次行动 = "自己玩"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 毛乱了 → 自己梳毛 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.清洁 < 60 ∧ $[NPC:猫猫].身体.清洁 > 40 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}发现自己的毛有点乱、认认真真舔毛梳毛、把毛理顺了"
  },
    $[NPC:猫猫].身体.清洁 < 60 ∧ $[NPC:猫猫].身体.清洁 > 40 {
    $.身体.清洁 = 70
    $.自我行动2.上次行动 = "梳毛"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 困了 → 自己睡觉 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].睡眠.疲劳 > 65 ∧ $[NPC:猫猫].身体.体力 > 35 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}困意上来了、自己钻进小窝里、团成一团睡了个午觉"
  },
    $[NPC:猫猫].睡眠.疲劳 > 65 ∧ $[NPC:猫猫].身体.体力 > 35 {
    $.睡眠.疲劳 = 40
    $.睡眠.状态 = "睡着"
    $.自我行动2.上次行动 = "午睡"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 活力低 → 自己活动 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.活力 < 20 ∧ $[NPC:猫猫].身体.体力 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}觉得自己太懒了、自己伸伸懒腰蹦蹦跳跳活动了一下"
  },
    $[NPC:猫猫].身体.活力 < 20 ∧ $[NPC:猫猫].身体.体力 > 50 {
    $.身体.活力 = 50
    $.自我行动2.上次行动 = "活动筋骨"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 害怕 → 自己躲到安全处 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].器官状态.R18G伤害.恐惧程度 > 80 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}有点害怕、自己钻到桌子底下躲好、等心情平复"
  },
    $[NPC:猫猫].器官状态.R18G伤害.恐惧程度 > 80 {
    $.器官状态.R18G伤害.恐惧程度 = 50
    $.自我行动2.上次行动 = "躲起来"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 好奇心 → 自己探索 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].探索.好奇心 > 85 ∧ $[NPC:猫猫].身体.活力 > 40 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}好奇心大发、自己把房间每个角落都嗅了一遍、满足地甩甩尾巴"
  },
    $[NPC:猫猫].探索.好奇心 > 85 ∧ $[NPC:猫猫].身体.活力 > 40 {
    $.探索.好奇心 = 60
    $.自我行动2.上次行动 = "探索"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 巡逻领地 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.活力 > 60 ∧ 时段判断(世界.环境.当前时间) == "清晨" ∧ $.状态.触发 == "" {
    $.状态.触发 = "清晨&{自称}精神好、自己在家里巡逻一圈、检查每个角落都很安全"
  },
    $[NPC:猫猫].身体.活力 > 60 ∧ 时段判断(世界.环境.当前时间) == "清晨" {
    $.自我行动2.上次行动 = "巡逻"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 等主人 → 安静待命 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].行为.主人同场景 == false ∧ $[NPC:猫猫].社交.互动需求 < 60 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{对主人称呼}不在家、&{自称}趴在窗台上安静地等&{对主人称呼}、偶尔看看窗外"
  },
    $[NPC:猫猫].行为.主人同场景 == false ∧ $[NPC:猫猫].社交.互动需求 < 60 {
    $.自我行动2.上次行动 = "安静待命"
  }
}

// ─── 整理小窝 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.清洁 > 70 ∧ $[NPC:猫猫].位置.场景 == "S001-BR" ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}把自己的小窝整理得干干净净、踩了踩确定舒适才满意"
  },
    $[NPC:猫猫].身体.清洁 > 70 ∧ $[NPC:猫猫].位置.场景 == "S001-BR" {
    $.自我行动2.上次行动 = "整理窝"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 心情低落 → 自我调节 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].心情.当前 == "低落" ∨ $[NPC:猫猫].心情.当前 == "难过" ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}心情有点低落、自己晒了会儿太阳、慢慢打起精神"
  },
    $[NPC:猫猫].心情.当前 == "低落" ∨ $[NPC:猫猫].心情.当前 == "难过" {
    $.心情.当前 = "平静"
    $.自我行动2.上次行动 = "自我调节"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 吃饱喝足 → 自我清洁 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    $[NPC:猫猫].身体.饱食 > 80 ∧ $[NPC:猫猫].身体.水分 > 80 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}吃饱喝足、自己舔舔嘴擦擦脸、优雅地收拾干净"
  },
    $[NPC:猫猫].身体.饱食 > 80 ∧ $[NPC:猫猫].身体.水分 > 80 {
    $.自我行动2.上次行动 = "饭后清理"
    $.自我行动2.行动次数 += 1
  }
}

// ─── 深夜 → 自己入睡 ───

@规则[$[NPC:猫猫]] {
  优先级: 300
    时段判断(世界.环境.当前时间) == "深夜" ∧ $[NPC:猫猫].睡眠.状态 != "睡着" ∧ $.状态.触发 == "" {
    $.状态.触发 = "夜深了、&{自称}打了个哈欠、自己缩进被窝里乖乖睡着了"
  },
    时段判断(世界.环境.当前时间) == "深夜" ∧ $[NPC:猫猫].睡眠.状态 != "睡着" {
    $.睡眠.状态 = "睡着"
    $.睡眠.疲劳 = 20
    $.自我行动2.上次行动 = "入睡"
    $.自我行动2.行动次数 += 1
  }
}
