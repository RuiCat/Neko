// ═══════════════════════════════════════
// cat_scene_routine.neko — 场景-行为联动 v1
// 主人要求（2026-08-13 15:01）：
//   饿了→去厨房做饭餐厅吃饭 / 脏了→去洗澡池洗澡 /
//   上厕所→去厕所 / 吃零食→要拿着零食
// 场景映射：餐厅厨房=S001-KT · 浴室(洗澡池+厕所)=S001-BA
// ═══════════════════════════════════════

@定义 NPC {
  "标记": {
    "内急": false,
    "想吃零食": false,
    "拿着零食": false
  }
}

// ─── 饿了 → 去餐厅厨房做饭吃饭 ───

@规则[$[NPC]] {
  优先级: 150
  $[NPC].身体.饱食 < 30 ∧ $[NPC].位置.场景 != "S001-KT" {
    $.位置.场景 = "S001-KT"
    $.状态.触发 = "肚子咕咕叫、小跑去厨房系上围裙、给自己和梦梦做好饭、在餐厅吃得饱饱的"
  }
}

// ─── 脏了 → 去浴室洗澡池洗澡 ───

@规则[$[NPC]] {
  优先级: 140
  $[NPC].身体.清洁 < 30 ∧ $[NPC].位置.场景 != "S001-BA" {
    $.位置.场景 = "S001-BA"
    $.身体.清洁 = 80
    $.状态.触发 = "身上脏兮兮的、跑去浴室泡进洗澡池、洗得香喷喷"
  }
}

// ─── 水分高 → 内急（喝水多就想上厕所）───

@规则[$[NPC]] {
  优先级: 130
  $[NPC].身体.水分 > 90 {
    $.标记.内急 = true
  }
}

// ─── 内急 → 去厕所（浴室）解决 ───

@规则[$[NPC]] {
  优先级: 120
  $[NPC].标记.内急 == true ∧ $[NPC].位置.场景 != "S001-BA" {
    $.位置.场景 = "S001-BA"
    $.标记.内急 = false
    $.身体.水分 = 60
    $.状态.触发 = "尿急尿急、夹着尾巴小跑去厕所、解决完一身轻松"
  }
}

// ─── 想吃零食 → 拿着零食吃 ───

@规则[$[NPC]] {
  优先级: 110
  $[NPC].标记.想吃零食 == true {
    $.标记.想吃零食 = false
    $.标记.拿着零食 = true
    $.状态.触发 = "从零食罐里拿出零食、抱在怀里、叼着一块吃得津津有味"
  }
}
