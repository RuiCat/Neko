// ═══════════════════════════════════════════════
// cat_stamina_sync.neko — 体力绝对值→身体状态同步兜底
// 2026-08-13 03:00 重建（原 cat_state_sync 被亲子同步占用后兜底缺失）
// when+动作 4 条（对纯 type=NPC 实体生效），优先级 5 低优兜底
// 守卫：仅当状态与当前体力不符时才写，避免每 tick 无效转移
// ═══════════════════════════════════════════════

@规则[$[NPC]] {
  优先级: 5
  条件: $[NPC].身体.体力 < 10 ∧ $[NPC].状态.身体 != "昏厥"
  动作: $.状态.身体 = "昏厥"
}

@规则[$[NPC]] {
  优先级: 5
  条件: $[NPC].身体.体力 >= 10 ∧ $[NPC].身体.体力 < 20 ∧ $[NPC].状态.身体 != "疲惫"
  动作: $.状态.身体 = "疲惫"
}

@规则[$[NPC]] {
  优先级: 5
  条件: $[NPC].身体.体力 >= 20 ∧ $[NPC].身体.体力 < 50 ∧ $[NPC].状态.身体 != "虚弱"
  动作: $.状态.身体 = "虚弱"
}

@规则[$[NPC]] {
  优先级: 5
  条件: $[NPC].身体.体力 >= 50 ∧ $[NPC].状态.身体 != "活跃"
  动作: $.状态.身体 = "活跃"
}
