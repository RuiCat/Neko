// ═══════════════════════════════════════════════
// cat_play.neko — 猫猫玩耍系统
// 活力消耗 / 玩具互动 / 游戏乐趣
// ═══════════════════════════════════════════════

// ─── 玩耍状态字段 ───

@定义 NPC {
  "玩耍": {
    "乐趣值": 60,
    "想玩": false,
    "玩过": []
  }
}

// ─── 活力充足 → 想玩 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].身体.活力 > 60 ∧ $[NPC:猫猫].身体.疲劳 < 40 {
      $.玩耍.想玩 = true
    },
  $[NPC:猫猫].身体.活力 < 30 ∨ $[NPC:猫猫].身体.疲劳 > 60 {
      $.玩耍.想玩 = false
    },
  $[NPC:猫猫].玩耍.想玩 == true {
      $.状态.触发 = "精力旺盛、想玩逗猫棒"
    },
  $[NPC:猫猫].玩耍.想玩 == true {
      $.身体.活力 -= 5
    },
  $[NPC:猫猫].玩耍.想玩 == true {
      $.玩耍.乐趣值 += 5
    },
  $[NPC:猫猫].玩耍.乐趣值 > 100 {
      $.玩耍.乐趣值 = 100
    },
  $[NPC:猫猫].身体.活力 < 20 {
      $.状态.触发 = "玩累了、趴下喘气"
    }
}
