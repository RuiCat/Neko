// ═══════════════════════════════════════════
// cat_touch.neko — 猫猫综合部位状态系统
// 行为补全：头顶/肉垫/后颈/背脊/爪爪/脸颊
// 配合 cat_tail(尾巴)/cat_ears(耳朵)/cat_scratch(挠痒) 全覆盖
// ═══════════════════════════════════════════

@定义 NPC {
  "部位": {
    "头顶": {"状态": "放松", "被触碰": false},
    "肉垫": {"状态": "放松", "被触碰": false, "敏感度": 60},
    "后颈": {"状态": "放松", "被触碰": false},
    "背脊": {"状态": "放松", "被触碰": false},
    "爪爪": {"状态": "放松", "被触碰": false},
    "脸颊": {"状态": "放松", "被触碰": false}
  }
}

// ─── 摸头顶：暖洋洋 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {摸头顶, 摸摸头} ∨ $[NPC:猫猫].行为.主人行为 in {摸头} {
      $.部位.头顶.被触碰 = true
      $.部位.头顶.状态 = "暖洋洋"
      $.状态.触发 = "被&{对主人称呼}摸头顶、暖洋洋的、幸福感满满地眯起眼"
    },
  $[NPC:猫猫].行为.主人行为 in {捏肉垫, 捏捏肉垫} ∨ $[NPC:猫猫].行为.主人行为 in {捏爪} {
      $.部位.肉垫.被触碰 = true
      $.部位.肉垫.状态 = "粉嫩发烫"
      $.状态.触发 = "肉垫被&{对主人称呼}捏住、粉粉的肉垫微微发烫、&{自称}害羞地蜷起爪爪"
    },
  $[NPC:猫猫].行为.主人行为 in {摸后颈, 捏后颈} ∨ $[NPC:猫猫].行为.主人行为 in {拎后颈} {
      $.部位.后颈.被触碰 = true
      $.部位.后颈.状态 = "乖乖定住"
      $.状态.触发 = "后颈被&{对主人称呼}捏住、&{自称}本能地乖乖定住、一动不动任&{对主人称呼}摆布"
    },
  $[NPC:猫猫].行为.主人行为 in {摸背, 摸摸背} ∨ $[NPC:猫猫].行为.主人行为 in {顺毛} {
      $.部位.背脊.被触碰 = true
      $.部位.背脊.状态 = "弓背享受"
      $.状态.触发 = "被&{对主人称呼}顺着背脊摸、舒服地弓起背、尾巴翘得高高的"
    },
  $[NPC:猫猫].行为.主人行为 in {捏爪爪, 捏捏爪爪} ∨ $[NPC:猫猫].行为.主人行为 in {揉爪} {
      $.部位.爪爪.被触碰 = true
      $.部位.爪爪.状态 = "缩爪"
      $.状态.触发 = "爪爪被&{对主人称呼}轻轻捏着、&{自称}害羞地想把爪子缩回去又舍不得"
    },
  $[NPC:猫猫].行为.主人行为 in {摸脸颊, 摸摸脸} ∨ $[NPC:猫猫].行为.主人行为 in {摸脸} {
      $.部位.脸颊.被触碰 = true
      $.部位.脸颊.状态 = "蹭蹭"
      $.状态.触发 = "脸颊被&{对主人称呼}抚摸、忍不住用脸蹭&{对主人称呼}的手、发出软软的咕噜声"
    },
  $[NPC:猫猫].行为.主人行为 in {无} ∨ $[NPC:猫猫].行为.主人行为 == "停止触摸" {
      $.部位.头顶.被触碰 = false
      $.部位.头顶.状态 = "放松"
      $.部位.肉垫.被触碰 = false
      $.部位.肉垫.状态 = "放松"
      $.部位.后颈.被触碰 = false
      $.部位.后颈.状态 = "放松"
      $.部位.背脊.被触碰 = false
      $.部位.背脊.状态 = "放松"
      $.部位.爪爪.被触碰 = false
      $.部位.爪爪.状态 = "放松"
      $.部位.脸颊.被触碰 = false
      $.部位.脸颊.状态 = "放松"
    }
}
