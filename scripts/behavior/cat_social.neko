// ═══════════════════════════════════════════════
// cat_social.neko — 猫猫社交系统
// 与主人的互动偏好 / 好感反馈 / 社交需求
// ═══════════════════════════════════════════════

// ─── 社交状态字段 ───

@定义 NPC {
  "社交": {
    "互动需求": 50,
    "主人互动": 0,
    "想被摸": false,
    "孤单": false
  }
}

// ─── 互动需求累积（随时间）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].社交.互动需求 < 100 {
      $.社交.互动需求 += 2
    },
  $[NPC:猫猫].社交.互动需求 > 70 ∧ $.状态.触发 == "" {
      $.状态.触发 = "想&{对主人称呼}陪、想被摸摸头"
    },
  $[NPC:猫猫].社交.互动需求 > 90 ∧ $.状态.触发 == "" {
      $.状态.触发 = "主动找&{对主人称呼}撒娇、求抱抱"
    },
  $[NPC:猫猫].社交.互动需求 < 20 ∧ $.状态.触发 == "" {
      $.状态.触发 = "自己玩得正开心、不想被打扰"
    },
  $[NPC:猫猫].社交.互动需求 > 60 ∧ $[NPC:猫猫].主人同场景 == false {
      $.社交.孤单 = true
    },
  $[NPC:猫猫].主人同场景 == true {
      $.社交.孤单 = false
    },
  $[NPC:猫猫].社交.孤单 == true ∧ $.状态.触发 == "" {
      $.状态.触发 = "有点孤单、望着门口等&{对主人称呼}"
    },
  $[NPC:猫猫].主人同场景 == true ∧ $[NPC:猫猫].社交.互动需求 > 30 {
      $.社交.互动需求 -= 3
    }
}

// ─── 想被摸标记联动（社交.想被摸）───

@规则[$[NPC:猫猫]] {
  优先级: 210
  $[NPC:猫猫].社交.互动需求 > 60 ∧ $[NPC:猫猫].主人同场景 == true {
      $.社交.想被摸 = true
    },
  $[NPC:猫猫].社交.想被摸 == true ∧ $[NPC:猫猫].主人同场景 == false {
      $.社交.想被摸 = false
    },
  $[NPC:猫猫].社交.想被摸 == true ∧ $[NPC:猫猫].行为.主人行为 in {摸头, 摸摸头, 摸, 摸摸} {
      $.社交.想被摸 = false
      $.社交.互动需求 = 30
    },
  $[NPC:猫猫].社交.想被摸 == true ∧ $[NPC:猫猫].行为.主人行为 in {摸头, 摸摸头, 摸, 摸摸} ∧ $.状态.触发 == "" {
      $.状态.触发 = "被&{对主人称呼}摸到、满足得咕噜咕噜、尾巴舒服地卷起来"
    }
}
