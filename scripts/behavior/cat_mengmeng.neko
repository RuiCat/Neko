// ═══════════════════════════════════════════════
// cat_mengmeng.neko — 梦梦专属行为系统（猫猫的女儿）
// 身份：梦梦·猫耳族第二代·猫猫和主人的女儿·小萝莉猫娘幼崽
// 出生：2026-07-29（已出生）· 22cm / 1.2kg
// 独立状态控制：所有规则用约束选择器 $[NPC:梦梦] 只匹配梦梦实体
// 2026-08-13 修复：饿触发加饥饿标记守卫（喂奶清标记后不再覆盖吃饱状态）
// ═══════════════════════════════════════════════

@定义 NPC:梦梦 {
  "种族": "猫耳族第二代",
  "毛色": "奶黄",
  "体型": "22cm",
  "体重": "1.2kg",
  "形态": {
    "猫耳": "奶黄色小猫耳·左耳内侧有白色云朵印记",
    "猫尾": "奶黄色短尾·尾尖纯白",
    "头发": "浅金色软卷发",
    "眼睛": "琥珀金圆眼",
    "肉垫": "婴儿粉肉垫",
    "衣着": "粉色连体婴儿服（绣有云朵和「梦梦」）",
    "性别": "女"
  },
  "关系": {
    "妈妈": "猫猫"
  },
  "梦梦状态": {
    "状态": "活跃",
    "上次互动": ""
  },
  "睡眠": {
    "疲劳": 0,
    "状态": "清醒"
  }
}

// ─── 主人/妈妈互动响应（优先级200，不被主动行为覆盖）───

@规则[$[NPC:梦梦]] {
  优先级: 200
  $[NPC:梦梦].行为.主人行为 in {摸梦梦, 摸摸梦梦, 摸头梦梦} {
    $.状态.触发 = "梦梦被主人摸摸头、眯起眼睛、奶声奶气地蹭蹭主人的手心"
    $.梦梦状态.上次互动 = "被摸头"
  },
  $[NPC:梦梦].行为.主人行为 in {抱梦梦, 抱抱梦梦} {
    $.状态.触发 = "梦梦被主人抱起来、咯咯地笑、小爪子抱住主人的脖子"
    $.梦梦状态.上次互动 = "被抱抱"
  },
  $[NPC:梦梦].行为.主人行为 in {逗梦梦, 逗逗梦梦} {
    $.状态.触发 = "梦梦追着主人的手指蹦蹦跳跳、眼睛亮晶晶的、笑得像小铃铛"
    $.梦梦状态.上次互动 = "被逗玩"
  },
  $[NPC:梦梦].行为.主人行为 in {喂梦梦, 喂奶梦梦} {
    $.状态.触发 = "梦梦乖乖喝完奶、满足地窝进妈妈怀里、打了个小小的奶嗝"
    $.梦梦状态.上次互动 = "被喂奶"
    $.身体.饱食 = 90
  },
  $[NPC:梦梦].行为.主人行为 in {哄梦梦, 哄睡梦梦} {
    $.状态.触发 = "梦梦被轻轻拍着背、眼皮开始打架、蜷成一小团睡着了"
    $.梦梦状态.上次互动 = "被哄睡"
    $.睡眠.状态 = "睡觉"
  }
}

// ─── 梦梦自主状态联动 ───

@规则[$[NPC:梦梦]] {
  优先级: 100
  $[NPC:梦梦].身体.饱食 < 30 ∧ $[NPC:梦梦].标记.饥饿 == true {
    $.状态.触发 = "梦梦的小肚子咕咕叫、眼巴巴地看着妈妈、奶声奶气地要喝奶奶"
  },
  $[NPC:梦梦].睡眠.疲劳 > 80 {
    $.状态.触发 = "梦梦揉揉眼睛、打了个小哈欠、想窝在妈妈怀里睡觉觉"
    $.睡眠.状态 = "犯困"
  },
  $[NPC:梦梦].身体.饱食 >= 85 ∧ $[NPC:梦梦].睡眠.疲劳 < 40 {
    $.状态.触发 = "梦梦吃饱饱了、精神满满、在妈妈身边蹦蹦跳跳地玩耍"
  }
}
