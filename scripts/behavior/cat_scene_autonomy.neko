// ═══════════════════════════════════════
// cat_scene_autonomy.neko — 场景行为自主性 v1
// 目标：脚本自动驱动场景行为，无需手动搬位置
// 机制：
//   ① 世界时间驱动场景切换（白天客厅/夜晚卧室）→ scene_move 跟随规则自动带动 NPC
//   ② NPC 场景内自主行为（按所在场景生成行为触发）
// ═══════════════════════════════════════

// ─── ① 时间驱动场景切换（世界）───

@规则[$[世界]] {
  优先级: 80
  $[世界].状态.阶段 in {清晨, 上午, 中午, 下午, 傍晚} ∧ $[世界].环境.所在场景 != "S001-LR" ∧ $[世界].环境.所在场景 != "S001-KT" {
    $.环境.所在场景 = "S001-LR"
  }
}

@规则[$[世界]] {
  优先级: 80
  $[世界].状态.阶段 in {夜晚, 深夜} ∧ $[世界].环境.所在场景 != "S001-BR" {
    $.环境.所在场景 = "S001-BR"
  }
}

// ─── ② NPC 场景内自主行为（按位置）───

@规则[$[NPC]] {
  优先级: 95
  $[NPC].位置.场景 == "S001-LR" {
    $.状态.触发 = "在客厅窝在沙发上、抱着浅蓝毛毯、尾巴惬意地搭着看电视"
  },
  $[NPC].位置.场景 == "S001-BR" {
    $.状态.触发 = "在卧室窝进软软的被窝里、蜷成一团、舒服地打盹"
  },
  $[NPC].位置.场景 == "S001-BL" {
    $.状态.触发 = "在阳台晒太阳、眯着眼睛、尾巴尖晒得暖洋洋的"
  },
  $[NPC].位置.场景 == "S001-KT" {
    $.状态.触发 = "在厨房蹲在小碗边、闻着饭菜香、乖乖等着开饭"
  },
  $[NPC].位置.场景 == "S001-ST" {
    $.状态.触发 = "在阳台/露台吹吹风、看着远处的景色、心情舒畅"
  }
}
