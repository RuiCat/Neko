// ═══════════════════════════════════════════════
// cat_behavior.neko — 行为执行模板 v4（完整生活行为）
// 所有行为通过脚本命令逐步执行（cat_do 工具）
// 食物链：购买食材(便利店/蔬果店) → 做饭(厨房) → 吃饭(厨房)
// 经济链：打工赚钱 → 花钱买东西
// 前置校验：有钱才能买、有食材才能做、有食物才能吃
// ═══════════════════════════════════════════════

@定义 行为模板 {
  // ─── 食物链 ───

  "购买食材": {
    "场景": "S008",
    "需要物品": [],
    "花费": 10,
    "产出": {"类型": "素材", "名称": "食材", "描述": "新鲜蔬菜和肉"},
    "步骤": ["出门去便利店", "挑选新鲜食材", "付钱结账"],
    "效果": {}
  },
