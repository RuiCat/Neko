// ═══════════════════════════════════════════════════
// 猫猫人格×行为基线联动 v1.0
// 让五维人格真正"渗透"进日常行为字段：
//   高外向 → 撒娇倾向基线拉高
//   高开放 → 好奇心基线拉高
//   高宜人 → 信赖下限保障
//   低神经质 → 心情稳定下限保障（情绪稳）
//   高神经质 → 心情稳定上限钳制（容易波动）
//   高尽责 → 行动效率保障
// 规则全部为"钳制式"（只在低于/高于阈值时修正），不与其他规则冲突
// ═══════════════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 205
  $[NPC:猫猫].人格.外向性 >= 70 ∧ $[NPC:猫猫].行为.撒娇倾向 < 70 {
      $.行为.撒娇倾向 = 70
    },
  $[NPC:猫猫].人格.开放性 >= 80 ∧ $[NPC:猫猫].探索.好奇心 < 80 {
      $.探索.好奇心 = 80
    },
  $[NPC:猫猫].人格.宜人性 >= 85 ∧ $[NPC:猫猫].关系.信赖 < 80 {
      $.关系.信赖 = 80
    },
  $[NPC:猫猫].人格.神经质 < 40 ∧ $[NPC:猫猫].心情.稳定 < 60 {
      $.心情.稳定 = 60
    },
  $[NPC:猫猫].人格.神经质 >= 60 ∧ $[NPC:猫猫].心情.稳定 > 40 {
      $.心情.稳定 = 40
    },
  $[NPC:猫猫].人格.尽责性 >= 70 ∧ $[NPC:猫猫].行为.行动效率 < 1.2 {
      $.行为.行动效率 = 1.2
    }
}
