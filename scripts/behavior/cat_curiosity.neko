// ═══════════════════════════════════════════════
// cat_curiosity.neko — 猫猫探索与好奇心系统
// 新场景探索 / 好奇心驱动 / 发现记录
// ═══════════════════════════════════════════════

// ─── 探索状态字段 ───

@定义 NPC {
  "探索": {
    "已探索场景": [],
    "好奇心": 60,
    "最近发现": ""
  }
}

// ─── 新场景探索：世界场景变化时记录 ───

@规则[$[NPC:猫猫]，世界] {
  世界.环境.所在场景 != $[NPC:猫猫].位置.场景 ∧ $[NPC:猫猫].探索.好奇心 > 40 {
    $.探索.最近发现 = "发现了新地方"
  }
}

// ─── 好奇心驱动行为 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].探索.好奇心 > 70 {
      $.状态.触发 = "好奇地东张西望、想到处探索"
    },
  $[NPC:猫猫].探索.好奇心 < 20 {
      $.状态.触发 = "对周围没兴趣、只想窝着"
    },
  $[NPC:猫猫].身体.清洁 > 60 {
      $.探索.好奇心 += 2
    },
  $[NPC:猫猫].身体.舒适 < 30 {
      $.探索.好奇心 -= 2
    }
}
