// ═══════════════════════════════════════════════
// cat_log.neko — 猫猫事件日志系统
// 记录重要触发 / 最近经历 / 记忆痕迹
// ═══════════════════════════════════════════════

// ─── 日志状态 ───

@定义 NPC {
  "记忆": {
    "最近事件": [],
    "最近场景": "",
    "上次互动": "",
    "记忆条数": 0
  }
}

// ─── 触发记录：行为触发时记录 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].状态.触发 != "" ∧ $[NPC:猫猫].状态.触发 != $[NPC:猫猫].记忆.上次互动 {
    $.记忆.上次互动 = $[NPC:猫猫].状态.触发
  }
}

// ─── 场景记忆：记录到过的场景 ───

@规则[$[NPC:猫猫]，世界] {
  世界.环境.所在场景 != $[NPC:猫猫].位置.场景 {
    $.记忆.最近场景 = 世界.环境.所在场景
  }
}

// ─── 记忆条数更新 ───

@规则[$[NPC:猫猫]] {
  $[NPC:猫猫].记忆.最近事件 != [] {
      $.记忆.记忆条数 = 1
    },
  $[NPC:猫猫].记忆.记忆条数 > 20 {
      $.记忆.记忆条数 = 1
    }
}
