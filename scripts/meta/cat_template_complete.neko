// ═══════════════════════════════════════════════════
// cat_template_complete.neko — NPC 模板字段完整性补全
// 发现: 位置/标记/心情/伤害/器官状态 被规则高频引用(89次)
//       但 NPC 模板未声明 → 新实体无法继承(cat_work类隐患)
// 修复: 补全字段结构到模板(实例优先,模板回退,不影响现有数据)
// ═══════════════════════════════════════════════════

@定义 NPC {
  "自称": "猫猫",
  "对主人称呼": "主人",
  "标记": {
    "疲劳": false,
    "饥饿": false,
    "疼痛": false
  },
  "位置": {
    "场景": "S001-LR"
  },
  "心情": {
    "当前": "平静"
  },
  "伤害": {
    "出血": 0
  },
  "器官状态": {
    "基础生理": {
      "湿润度": {"value": 60, "level": "正常"},
      "收缩状态": {"value": 50, "level": "正常"},
      "疼痛程度": {"value": 0, "level": "无痛"},
      "快感程度": {"value": 0, "level": "平静"},
      "体力值": {"value": 80, "level": "充沛"},
      "阴道紧致度": {"value": 80, "level": "紧致"},
      "宫颈管径": {"value": 0, "level": "闭合"}
    },
    "生殖": {
      "受精状态": {"value": false},
      "怀孕状态": {"value": false},
      "受孕体质": {"value": true},
      "排卵周期": {
        "当前阶段": "正常周期",
        "周期天数": 28,
        "上次排卵": ""
      }
    },
    "R18G伤害": {
      "伤害程度": {"value": 0, "level": "完好"},
      "出血程度": {"value": 0, "level": "无"},
      "恐惧程度": 0,
      "创伤累积": {"value": 0, "level": "无创伤"},
      "服从程度": {"value": 100, "level": "绝对服从"}
    },
    "扩展心理": {
      "兴奋度": {"value": 0, "level": "平静"},
      "信任度": {"value": 0, "level": "未知"},
      "爱意程度": {"value": 0, "level": "未知"},
      "羞耻感": {"value": 0, "level": "无"},
      "疲劳度": {"value": 0, "level": "精神饱满"},
      "成瘾度": {"value": 0, "level": "无"},
      "幸福感": {"value": 0, "level": "平静"},
      "抗拒度": {"value": 0, "level": "接受"},
      "期待度": {"value": 0, "level": "平静"},
      "满足度": {"value": 0, "level": "平静"}
    },
    "体液追踪": {
      "阴道内精液": {"ml": 0, "maxMl": 15},
      "子宫内精液": {"ml": 0, "maxMl": 8},
      "直肠内精液": {"ml": 0, "maxMl": 10},
      "口腔内精液": {"ml": 0, "maxMl": 5},
      "爱液分泌": {"ml": 0}
    },
    "外翻层级": 0
  }
}
