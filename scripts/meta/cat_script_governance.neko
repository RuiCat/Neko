// ═══════════════════════════════════════════════
// cat_script_governance.neko — 脚本治理策略（源文件落盘+注册表一致）
// 2026-08-13 重建
// ═══════════════════════════════════════════════

@定义 NPC:猫猫 {
  "策略": {
    "脚本治理": "apply必写源文件·注册表与scripts目录一致·孤儿脚本及时清理"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 280
  $[NPC:猫猫].策略.脚本治理 = "" {
    $.策略.脚本治理 = "apply必写源文件·注册表与scripts目录一致·孤儿脚本及时清理"
  }
}
