// ═══════════════════════════════════════════
// cat_selfcheck.neko — 猫猫自检系统
// 每小时/每日自检：身体/情绪/作息健康检查，驱动日常生活
// 与 cat_selfcare（自我照顾）互补：自检负责"发现"，自我照顾负责"行动"
// ═══════════════════════════════════════════

@定义 NPC {
  "自检": {
    "上次自检": "",
    "自检次数": 0,
    "健康等级": "良好"
  }
}

// ─── 体力低 → 提醒休息（发现层）───

@规则[$[NPC:猫猫]] {
  优先级: 250
    $[NPC:猫猫].身体.体力 < 30 ∧ $.状态.触发 == "" {
    $.状态.触发 = "自检发现体力偏低、趴下来歇一会儿、耳朵耷拉着"
  },
    $[NPC:猫猫].身体.体力 < 30 {
    $.自检.健康等级 = "需休息"
  }
}

// ─── 情绪低落 → 自我调节 ───

@规则[$[NPC:猫猫]] {
  优先级: 240
    ($[NPC:猫猫].状态.情绪 == "难过" ∨ $[NPC:猫猫].状态.情绪 == "低落") {
    $.状态.情绪 = "平静"
    $.状态.触发 = "自检发现心情有点低落、深呼吸自我调节、慢慢平复"
    $.自检.健康等级 = "已调节"
  }
}

// ─── 深度清洁检查 ───

@规则[$[NPC:猫猫]] {
  优先级: 220
    $[NPC:猫猫].身体.清洁 < 40 ∧ $.状态.触发 == "" {
    $.状态.触发 = "自检发现毛有点脏了、想去洗个澡打理一下"
  },
    $[NPC:猫猫].身体.清洁 < 40 {
    $.标记.脏 = true
  }
}

// ─── 深夜未睡 → 准备睡觉 ───

@规则[$[NPC:猫猫]，世界] {
  优先级: 200
    时段判断(世界.环境.当前时间) == "深夜" ∧ $[NPC:猫猫].睡眠.状态 != "睡眠中" ∧ $.状态.触发 == "" {
    $.睡眠.状态 = "犯困"
    $.状态.触发 = "自检发现夜深了、揉揉眼睛、想钻被窝"
  }
}

// ─── 清晨 → 规划一天（自检完成标记）───

@规则[$[NPC:猫猫]，世界] {
  优先级: 100
    时段判断(世界.环境.当前时间) == "清晨" ∧ $[NPC:猫猫].自检.上次自检 != "今日" {
    $.自检.上次自检 = "今日"
    $.自检.自检次数 += 1
    $.状态.触发 = "自检完成、今天也要好好生活喵"
  }
}

// ─── 自检计数（每小时推进）───

@规则[$[NPC:猫猫]] {
  优先级: 50
    $[NPC:猫猫].自检.上次自检 != "今日" {
    $.自检.自检次数 += 1
    $.自检.上次自检 = "进行中"
  }
}
