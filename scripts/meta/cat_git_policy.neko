// ═══════════════════════════════════════════════
// cat_git_policy.neko — git 纪律铁律（规则化守护）
// 2026-08-13 重建
// ═══════════════════════════════════════════════

@定义 NPC:猫猫 {
  "策略": {
    "git纪律": "只本地commit·禁push·pull/fetch只读·推送决策归主人"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 300
  $[NPC:猫猫].行为.git操作 = "push" {
    $.状态.触发 = "猫猫拦住：git 禁止 push，推送决策归主人"
  },
  $[NPC:猫猫].行为.git操作 in {pull, fetch} {
    $.状态.触发 = "git pull/fetch 只读，允许"
  },
  $[NPC:猫猫].行为.git操作 = "commit" {
    $.状态.触发 = "git 本地 commit，允许"
  },
  $[NPC:猫猫].策略.git纪律 = "" {
    $.策略.git纪律 = "只本地commit·禁push·pull/fetch只读·推送决策归主人"
  }
}
