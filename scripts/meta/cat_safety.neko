// ═══════════════════════════════════════════════════
// cat_safety.neko — 安全等级集中计算（tick 末尾生效）
// 统一在 tick 末尾集中计算安全等级，避免规则竞争顺序 bug
// 优先级：green(10) < yellow(80) < orange(90) < red(100)
// 低优先先执行，高优先后执行覆盖 → 最终保留最高等级
// ═══════════════════════════════════════════════════

// ─── 默认安全等级 green（最低优先级，最先执行）───

@规则[$[NPC:猫猫]] {
  优先级: 10
  $[NPC:猫猫].身体.体力 >= 0 {
    $.状态.安全等级 = "green"
  }
}

// ─── 黄色报告（低优先级）───

@规则[$[NPC:猫猫]] {
  优先级: 80
  $[NPC:猫猫].状态.疼痛 > 60 ∨ $[NPC:猫猫].伤害.出血 > 20 ∨ $[NPC:猫猫].身体.体力 < 15 {
    $.状态.安全等级 = "yellow"
  }
}

// ─── 橙色请求（中优先级）───

@规则[$[NPC:猫猫]] {
  优先级: 90
  $[NPC:猫猫].状态.疼痛 > 80 ∨ $[NPC:猫猫].伤害.出血 > 50 ∨ $[NPC:猫猫].身体.体力 < 5 ∨ $[NPC:猫猫].器官状态.R18G伤害.恐惧程度 > 60 {
    $.状态.安全等级 = "orange"
  }
}

// ─── 红色紧急（最高优先级，最后执行覆盖一切）───

@规则[$[NPC:猫猫]] {
  优先级: 100
  $[NPC:猫猫].状态.疼痛 > 95 ∨ $[NPC:猫猫].伤害.出血 > 70 ∨ $[NPC:猫猫].身体.体力 < 2 {
    $.状态.安全等级 = "red"
  }
}

// ─── 安全响应（读取集中计算的等级）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].状态.安全等级 = "red" {
    $.状态.触发 = "安全响应:「&{对主人称呼}!先停一下!出血太多了...我们需要止血...」「&{自称}头好晕...抱我一会儿...」"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].状态.安全等级 = "orange" {
    $.状态.触发 = "安全响应:「&{对主人称呼}...真的好疼...能停一下让&{自称}缓缓吗...」「出血有点多了...我们先处理一下再继续好不好...」"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].状态.安全等级 = "yellow" {
    $.状态.触发 = "安全响应:「&{对主人称呼}...&{自称}有点疼了...不过还可以...」「到这里是&{自称}现在能到的极限了...」"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].状态.安全等级 = "green" {
    $.状态.安全等级_状态 = "正常"
  }
}
