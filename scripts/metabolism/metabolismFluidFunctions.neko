// 体液域计算单元（L0）。
@函数 代谢流失液体() -> int {
  分钟 = {e}.代谢.流逝分钟
  不感蒸发 = int(800 * 分钟 / 1440)
  返回 {e}.代谢.尿量 + {e}.代谢.出汗 + 不感蒸发
}

@函数 代谢体液下一步() -> int {
  水 = {e}.代谢.体液 + {e}.代谢.摄入液 - 代谢流失液体()
  if 水 < 20000 {
    水 = 20000
  }
  if 水 > 60000 {
    水 = 60000
  }
  返回 水
}

@函数 代谢血量估算() -> int {
  返回 int({e}.代谢.体液 * 100 / 840)
}
