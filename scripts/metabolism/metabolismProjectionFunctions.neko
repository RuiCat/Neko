// 0–100 投影计算单元（L5）。代谢是唯一真值，这里只做刻度映射。
@函数 代谢投影体力() -> int {
  能量分 = {e}.代谢.能量储备 * 40 / 100000
  血糖分 = {e}.代谢.血糖 * 20 / 140
  体液分 = {e}.代谢.体液 * 20 / 42000
  温差 = {e}.代谢.体温 - 368
  if 温差 < 0 {
    温差 = 0 - 温差
  }
  体温分 = 20 - 温差 * 2
  if 体温分 < 0 {
    体温分 = 0
  }
  总 = 能量分 + 血糖分 + 体液分 + 体温分
  if 总 > 100 {
    总 = 100
  }
  if 总 < 0 {
    总 = 0
  }
  返回 int(总)
}

@函数 代谢投影饱食() -> int {
  饱 = {e}.代谢.胃内容 * 100 / 1500
  if 饱 > 100 {
    饱 = 100
  }
  返回 int(饱)
}

@函数 代谢投影水分() -> int {
  水 = {e}.代谢.体液 * 100 / 42000
  if 水 > 100 {
    水 = 100
  }
  返回 int(水)
}

@函数 代谢投影饥饿() -> int {
  返回 100 - 代谢投影饱食()
}

@函数 代谢投影口渴() -> int {
  返回 100 - 代谢投影水分()
}
