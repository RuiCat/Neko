// ═══════════════════════════════════════
// rule_threshold.neko — 阈值效应/恐惧放大日志规则（逻辑层）
// 原 @data triggers.阈值效应日志 + 恐惧放大日志 → #规则
// 引擎按条件匹配，命中即输出对应日志（供 LLM 与系统日志参考）
// ═══════════════════════════════════════

// #NPC:猫猫阈值日志
// #世界观:CatWorld-OS — 阈值效应判定逻辑

// ─── 疼痛阈值效应日志（原 triggers.阈值效应日志）───

@规则[$[NPC:猫猫]] {
  状态.疼痛>80 {
      $.状态.触发 = "阈值日志:⚠️ 疼痛>80，快感转为负值"
    },
  状态.疼痛>60 {
      $.状态.触发 = "阈值日志:⚠️ 疼痛>60，快感增益×0.4"
    },
  状态.疼痛>40 {
      $.状态.触发 = "阈值日志:⚠️ 疼痛>40，快感增益×0.7"
    },
  状态.恐惧>90 {
      $.状态.触发 = "恐惧日志:⚠️ 恐惧{value}%，所有负面×1.6"
    }
}
