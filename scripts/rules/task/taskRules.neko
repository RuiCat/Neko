// 任务规则（规则库 L14，8800–8899）：角色无关的任务状态机。
// 任务定义是规则（本文件的写法），不是 @实例；状态字段来自 任务状态 内核。
// 动作值不要写 `$.路径`（会被当字面量写入），用 taskFunctions.neko 里的函数返回值。

@规则[$[任务状态]] {
  优先级: 8800
  id: tkStart
  $.任务.当前 != "" ∧ $.任务.阶段 = "未激活" {
    $.任务.阶段 = "进行中"
  }
}

@规则[$[任务状态]] {
  优先级: 8810
  id: tkFinish
  $.任务.进度 >= 100 ∧ $.任务.阶段 = "进行中" {
    $.任务.阶段 = "完成"
  }
}

@规则[$[任务状态]] {
  优先级: 8820
  id: tkReward
  $.任务.阶段 = "完成" ∧ $.任务.完成标记 = false {
    $.任务.完成标记 = true
    $.任务.结果 = "完成"
    $.成长.经验 = 任务经验下一步()
  }
}
