// ═══════════════════════════════════════
// rule_master_behavior.neko — 主人行为修正规则（逻辑层）
// 原 @data 情境修正因子.主人行为修正 文本 → #规则
// 变量: 主人行为（抚摸/夸奖/忙碌/严厉/出门）
// ═══════════════════════════════════════

// #NPC:猫猫主人行为修正
// #世界观:CatWorld-OS — 主人行为对行为偏向的修正逻辑

@规则[$[NPC:猫猫]] {
  主人行为 in {抚摸} {
      $.状态.触发 = "情境修正:撒娇+15,傲娇-20"
    },
  主人行为 in {夸奖} {
      $.状态.触发 = "情境修正:害羞度+10,傲娇+20"
    },
  主人行为 in {忙碌} {
      $.状态.触发 = "情境修正:撒娇+10,黏人+15,主动+10"
    },
  主人行为 in {严厉} {
      $.状态.触发 = "情境修正:恐惧程度+15,撒娇-30,服从+20"
    },
  主人行为 in {出门} {
      $.状态.触发 = "情境修正:黏人+30,撒娇+20,安全感-15"
    }
}
