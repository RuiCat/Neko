// ═══════════════════════════════════════
// rule_situation_rules.neko — 情境修正规则（逻辑层）
// 场景/时段/天气 → 行为偏向修正（原 @data 情境修正因子 文本）
// ═══════════════════════════════════════

// #NPC:猫猫情境修正
// #世界观:CatWorld-OS — 情境对行为偏向的修正逻辑

// ─── 场景修正（子场景完整枚举——场景码保留后缀，规则侧显式列出以保持覆盖）───

// S001（家·公寓）含字母后缀子场景
@规则[$[NPC:猫猫]] {
  当前场景 in {S001,S001-BA,S001-BL,S001-BR,S001-GN,S001-KT,S001-LR,S001-ST} {
      $.状态.触发 = "情境修正:撒娇+10,坦率+10,傲娇-5"
    },
  当前场景 in {S020,S020-1,S020-2,S020-3,S020-4,S020-5,S030,S030-1,S030-2,S030-3,S040,S040-1,S040-2,S040-3,S070,S070-1,S070-2} {
      $.状态.触发 = "情境修正:撒娇-20,黏人+15,好奇+10,坦率-15"
    },
  当前场景 in {S009,S101,S102} {
      $.状态.触发 = "情境修正:好奇+20,撒娇-5,兴奋度+10"
    },
  当前场景 in {S007} {
      $.状态.触发 = "情境修正:坦率+10,黏人-10,主动-10"
    },
  当前场景 in {S060,S060-1,S060-3,S060-4} {
      $.状态.触发 = "情境修正:坦率+15,撒娇+5,傲娇-15"
    },
  当前场景 in {S060-2} {
      $.状态.触发 = "情境修正:恐惧程度+10,黏人+20,撒娇+10"
    },
  时间 in {早晨} {
      $.状态.触发 = "情境修正:主动-10,坦率+15,好奇-20"
    },
  时间 in {午前} {
      $.状态.触发 = "情境修正:好奇+10"
    },
  时间 in {午后} {
      $.状态.触发 = "情境修正:撒娇+10"
    },
  时间 in {傍晚} {
      $.状态.触发 = "情境修正:黏人+15"
    },
  时间 in {夜间} {
      $.状态.触发 = "情境修正:坦率+10,撒娇+10,好奇-10"
    },
  时间 in {深夜} {
      $.状态.触发 = "情境修正:坦率+20,黏人+15,主动-10"
    },
  天气 in {晴天} {
      $.状态.触发 = "情境修正:好奇+10,兴奋度+5"
    },
  天气 in {阴天} {
      $.状态.触发 = "情境修正:撒娇+5,黏人+10"
    },
  天气 in {雨天} {
      $.状态.触发 = "情境修正:黏人+20,撒娇+15,好奇-20"
    },
  天气 in {雪天} {
      $.状态.触发 = "情境修正:好奇+15,黏人+10"
    },
  天气 in {梅雨季} {
      $.状态.触发 = "情境修正:黏人+25,撒娇+20"
    }
}
