// ═══════════════════════════════════════
// rule_event_rules.neko — 事件触发规则（逻辑层）
// 所有事件触发条件由 #规则 表达（不再是 @data 带逻辑）
// 数据（触发名/效果/日志）在 @data 实体表/位置数据 中
// ═══════════════════════════════════════

// #NPC:猫猫事件规则
// #世界观:CatWorld-OS — 事件触发逻辑

// ─── R18 高潮机制（细分 5 种类型·优先级：子宫>阴道>阴蒂>乳头>多重）───

@规则[$[NPC:猫猫]] {
  状态.快感>95 ∧ 状态.兴奋>95 ∧ 状态.适应>=600 {
      $.状态.触发 = "触发:子宫高潮 @效果:满足度+50,幸福感+35,爱意+25,期待+30,体力-25,成瘾度+5"
    },
  状态.快感>95 ∧ 状态.兴奋>90 ∧ 状态.收缩>4 {
      $.状态.触发 = "触发:阴道高潮 @效果:满足度+40,幸福感+30,爱意+20,期待+25,收缩状态-2,体力-15"
    },
  状态.快感>95 ∧ 状态.兴奋>90 {
      $.状态.触发 = "触发:阴蒂高潮 @效果:满足度+25,幸福感+20,爱意+15,期待+10,体力-8"
    },
  状态.兴奋>85 {
      $.状态.触发 = "触发:乳头高潮 @效果:满足度+15,幸福感+10,爱意+10,体力-5"
    },
  状态.兴奋>90 ∧ 状态.快感>85 ∧ 状态.收缩>3 ∧ 身体.体力>15 {
      $.状态.触发 = "触发:多重高潮 @效果:满足度+60,幸福感+40,成瘾度+10,体力-35"
    },
  状态.服从>80 ∧ 状态.疼痛>60 {
      $.状态.触发 = "触发:斯德哥尔摩 @效果:成瘾度+20,服从+15"
    },
  状态.恐惧>80 ∧ 伤害.伤害>40 ∧ 伤害.创伤>300 {
      $.状态.触发 = "触发:心理崩溃 @效果:恐惧=100,创伤+100,抗拒=100"
    },
  当前场景=S001-KT ∧ 时间 in {早晨,中午,傍晚} ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:厨房香气"
    },
  当前场景=S001-KT ∧ 时间 in {深夜} ∧ 身体.饱食<30 ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:深夜觅食"
    },
  当前场景=S001-BR ∧ 关系.亲密>=60 ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:卧室归属感"
    },
  当前场景=S001-BL ∧ 天气 in {晴天,多云,阴天} ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:阳台风景"
    },
  当前场景=S001-BA ∧ 时间 in {晚间,深夜} ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:浴室水声"
    },
  当前场景=S005 ∧ 时间 in {傍晚,夜间} ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:河畔萤火虫"
    },
  当前场景=S020 ∧ 时间 in {白天,傍晚} ∧ $.状态.触发 == "" {
      $.状态.触发 = "场景事件:商店街喧嚣"
    }
}
