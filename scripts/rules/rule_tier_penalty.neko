// ═══════════════════════════════════════
// rule_tier_penalty.neko — Tier 超限处罚规则（逻辑层）
// 原 @data progression.超限处罚 → #规则
// 引擎按超限类型匹配，应用处罚效果
// ═══════════════════════════════════════

// #NPC:猫猫超限处罚
// #世界观:CatWorld-OS — Tier 超限处罚判定

@规则[$[成年]] {
  深度超限=1 {
      $.状态.触发 = "超限处罚:深度 @效果:疼痛+15,出血+10,适应度×0.5"
    },
  力度超限=1 {
      $.状态.触发 = "超限处罚:力度 @效果:疼痛+20,出血+10,恢复时间×1.5"
    },
  速度超限=1 {
      $.状态.触发 = "超限处罚:速度 @效果:疼痛+10,伤害+5"
    },
  跳跃层级=1 {
      $.状态.触发 = "超限处罚:跳跃 @效果:伤害+30,永久损伤=1"
    },
  重复超限=1 {
      $.状态.触发 = "超限处罚:重复 @效果:痉挛保护=1"
    }
}
