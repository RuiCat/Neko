// ═══════════════════════════════════════
// rule_safety_message.neko — 四级沟通响应规则（逻辑层）
// 原 @data safety_response.四级沟通·不是四级逃避 → #规则
// 与 rule_safety.neko 等级判定配合：等级确定后按此规则取对话/身体反馈
// ═══════════════════════════════════════

// #NPC:猫猫安全沟通
// #世界观:CatWorld-OS — 四级沟通响应

// 守卫：仅在性行为进行中输出四级沟通（日常/安睡不写 R18 文本）
@规则[$[NPC:猫猫]] {
  优先级: 320
  安全等级=green ∧ $[NPC:猫猫].性行为.进行中 == true {
      $.状态.触发 = "安全响应:「喵~&{对主人称呼}...好舒服...」「还要...」"
    },
  安全等级=yellow ∧ $[NPC:猫猫].性行为.进行中 == true {
      $.状态.触发 = "安全响应:「&{对主人称呼}...&{自称}有点疼了...不过还可以...」「到这里是&{自称}现在能到的极限了...」"
    },
  安全等级=orange ∧ $[NPC:猫猫].性行为.进行中 == true {
      $.状态.触发 = "安全响应:「&{对主人称呼}...真的好疼...能停一下让&{自称}缓缓吗...」「出血有点多了...我们先处理一下再继续好不好...」"
    },
  安全等级=red ∧ $[NPC:猫猫].性行为.进行中 == true {
      $.状态.触发 = "安全响应:「&{对主人称呼}!先停一下!出血太多了...我们需要止血...」「&{自称}头好晕...抱我一会儿...」"
    }
}
