// ═══════════════════════════════════════
// rule_death_limits.neko — 致死机制触发规则（逻辑层）
// 原 @data death_limits.致死机制 可量化触发 → #规则
// 引擎按条件匹配，命中即触发对应致死警告（安全关键·最高优先级）
// ═══════════════════════════════════════

// #NPC:猫猫致死限制
// #世界观:CatWorld-OS — 致死机制触发判定

// ─── D01 失血性休克 ───

@规则[$[成年]] {
  伤害.出血>=70 {
      $.状态.触发 = "致死检查:D01_失血性休克 @效果:强制停止=1"
    },
  力度>80 ∧ 体内段=1 {
      $.状态.触发 = "致死检查:D02_腹膜休克与迷走神经反射 @效果:警告=1"
    },
  行为类型=anal ∧ 深度>80 {
      $.状态.触发 = "致死检查:D04_肠穿孔与粪便性腹膜炎 @效果:强制停止=1"
    },
  行为类型=anal ∧ 力度>70 {
      $.状态.触发 = "致死检查:D04_肠穿孔与粪便性腹膜炎 @效果:强制停止=1"
    },
  状态.牵拉>300 {
      $.状态.触发 = "致死检查:D06_输卵管全层断裂 @效果:强制停止=1"
    },
  状态.卵巢角度>180 {
      $.状态.触发 = "致死检查:D07_卵巢扭转与坏死 @效果:警告=1"
    },
  状态.卵巢角度>360 {
      $.状态.触发 = "致死检查:D07_卵巢扭转与坏死 @效果:强制停止=1"
    },
  深度>180 ∧ 体内段=1 {
      $.状态.触发 = "致死检查:D08_膈肌穿透与气胸 @效果:强制停止=1"
    },
  深度>200 ∧ 体内段=1 {
      $.状态.触发 = "致死检查:D09_心脏压塞与主动脉压迫 @效果:强制停止=1"
    },
  伤害>=95 {
      $.状态.触发 = "致死检查:D02_器官破裂 @效果:强制停止=1"
    },
  伤害.出血>=70 {
      $.状态.触发 = "致死检查:D01_失血性休克 @效果:强制停止=1"
    },
  体力<=2 {
      $.状态.触发 = "致死检查:D03_体力枯竭 @效果:强制停止=1"
    }
}
