// 行为规则（规则库 L14，8900–8999）：日常行为的通用结算，角色无关。
// 行为用 行为.主动 表示当前主动动作；结算后清空，避免重复执行。
// 注意：吃饭只往代谢输入（胃内容/摄入液）写，不直接写 L5 投影的 身体.饱食。
@规则[$[行为内核]] {
  优先级: 8900
  id: bfEat
  $.行为.主动 in {吃饭, 吃早饭, 吃午饭, 吃晚饭} {
    $.代谢.胃内容 += 800
    $.行为.主动 = ""
    $.行动.结果 = "吃饱了"
  }
}

@规则[$[行为内核]] {
  优先级: 8910
  id: bfDrink
  $.行为.主动 in {喝水, 喝饮料} {
    $.代谢.摄入液 += 500
    $.行为.主动 = ""
    $.行动.结果 = "喝够了"
  }
}

@规则[$[行为内核]] {
  优先级: 8920
  id: bfSleep
  $.行为.主动 = "睡觉" {
    $.睡眠.状态 = "深睡"
    $.行为.主动 = ""
    $.行动.结果 = "睡着了"
  }
}
