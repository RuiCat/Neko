// ═══════════════════════════════════════
// rule_adaptation.neko — 适应度奖励规则（逻辑层）
// 原 @data compute.adaptation_gain.bonuses → #规则
// 引擎按条件匹配，命中即累加适应度奖励（base 公式保留在 compute @data）
// ═══════════════════════════════════════

// #NPC:猫猫适应度
// #世界观:CatWorld-OS — 适应度奖励判定逻辑

// ─── 深度奖励（原 bonuses[0..1]）───

@规则[$[NPC:猫猫]] {
  D>100 {
      $.状态.触发 = "适应度奖励:5"
    },
  D>150 {
      $.状态.触发 = "适应度奖励:10"
    },
  EL>=3 {
      $.状态.触发 = "适应度奖励:10"
    },
  EL>=6 {
      $.状态.触发 = "适应度奖励:15"
    }
}
