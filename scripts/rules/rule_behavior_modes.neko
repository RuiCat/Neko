// ═══════════════════════════════════════
// rule_behavior_modes.neko — 行为模式判定规则（逻辑层）
// 原 @data 行为模式.触发条件 文本 → #规则
// 引擎用偏向分数（BehaviorBiasEngine）+ 状态值判定模式
// 🆕 优先级设计：异常状态模式（P07-P09）优先于日常行为模式（P01-P06/P10），
//    异常状态反映生理/心理紧急情况，应最先判定（matchFirst 按文件顺序）
// ═══════════════════════════════════════

// #NPC:猫猫行为模式
// #世界观:CatWorld-OS — 行为模式判定逻辑

// ─── 异常状态模式（最高优先级）───

@规则[$[NPC:猫猫]] {
  状态.恐惧>45 ∨ 伤害.创伤>200 {
      $.状态.触发 = "模式:P09_恐惧退缩模式"
    },
  身体.体力<20 ∨ 身体.疲劳>75 ∨ 状态.疼痛>65 {
      $.状态.触发 = "模式:P07_疲惫虚弱模式"
    },
  状态.敏感>=70 ∧ 状态.兴奋>=75 ∧ 状态.快感>=60 {
      $.状态.触发 = "模式:P08_高敏兴奋模式"
    },
  撒娇倾向>=55 ∧ 傲娇倾向>=50 ∧ 傲娇倾向<60 {
      $.状态.触发 = "模式:P10_傲娇撒娇混合模式"
    },
  撒娇倾向>=65 ∧ 状态.黏人>=60 ∧ 傲娇倾向<50 {
      $.状态.触发 = "模式:P01_撒娇小猫模式"
    },
  傲娇倾向>=60 ∧ 撒娇倾向>=40 ∧ 状态.害羞>=50 {
      $.状态.触发 = "模式:P02_傲娇模式"
    },
  状态.坦率>=75 ∧ 状态.害羞<45 ∧ 关系.信赖>=80 {
      $.状态.触发 = "模式:P03_坦诚直率模式"
    },
  好奇心>=70 ∧ 状态.恐惧<35 ∧ 身体.活力>=50 {
      $.状态.触发 = "模式:P04_好奇探索模式"
    },
  状态.黏人>=75 ∧ 撒娇欲>=55 {
      $.状态.触发 = "模式:P05_黏人跟随模式"
    },
  服从倾向>=80 ∧ 状态.抗拒<20 ∧ 状态.主动<50 {
      $.状态.触发 = "模式:P06_乖巧顺从模式"
    }
}
