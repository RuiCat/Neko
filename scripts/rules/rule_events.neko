// ═══════════════════════════════════════
// rule_events.neko — 事件触发规则（逻辑层）
// 原 @data events.事件类型定义.事件分类.触发条件 文本 → #规则
// 状态判断型事件（状态变化类/生理变化类）由引擎程序化匹配；
// 语义型事件（日常/外出/互动/特殊 依赖 LLM 语义判断）保留在 @data events
// 引擎匹配规则：条件 → 事件:E-XXX（event-keeper 通过规则结果推进事件）
// ═══════════════════════════════════════

// #NPC:猫猫事件触发
// #世界观:CatWorld-OS — 事件触发判定逻辑

// ─── 状态变化类（E-STA 系列·原 @data 触发条件）───

@规则[$[NPC:猫猫]] {
  身体.饱食<30 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-STA-01"
    },
  身体.水分>60 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-STA-02"
    },
  身体.体力<20 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-STA-03"
    },
  身体.清洁<40 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-STA-04"
    },
  撒娇欲>80 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-STA-05"
    },
  器官状态.生殖.受精状态.value = true ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-PREG-01"
    },
  器官状态.生殖.怀孕状态 = true ∧ 受精后时间>=24 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-PREG-02"
    },
  器官状态.生殖.怀孕状态 = true ∧ 孕周>=1 ∧ $.状态.触发 == "" {
      $.状态.触发 = "事件:E-PREG-03"
    }
}
