// ═══════════════════════════════════════
// rule_position_rules.neko — 位置转移规则（逻辑层）
// 转移触发条件/代价分支 由 #规则 表达
// 数据（位置/接触器官/效果）在 data_position.neko（@data 位置数据）
// ═══════════════════════════════════════

// #NPC:猫猫位置规则
// #世界观:CatWorld-OS — 位置转移逻辑

// ─── 正常路径：进入 ───

@规则[$[NPC:猫猫]] {
  当前位置=P0_体外蹭蹭 ∧ 行为类型=vaginal ∧ 深度>=20 ∧ 阴道_有效开口>=物体直径 {
      $.状态.触发 = "位置转移:P1_阴道口"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=vaginal ∧ 深度>=20 ∧ 阴道_有效开口<物体直径 {
      $.状态.触发 = "位置转移:X30_阴道撕裂"
    },
  位置转移:P1_阴道口 ∧ 器官状态.基础生理.湿润度.value>=60 {
      $.状态.触发 = "分支:润滑充分 @效果:阴道.扩张度+10,兴奋+10"
    },
  位置转移:P1_阴道口 ∧ 器官状态.基础生理.湿润度.value>=30 {
      $.状态.触发 = "分支:略干涩 @效果:阴道.扩张度+5,疼痛+3"
    },
  位置转移:P1_阴道口 ∧ 器官状态.基础生理.湿润度.value<30 {
      $.状态.触发 = "分支:干燥强行 @效果:阴道.疼痛+8,阴道.损伤+3,出血+1"
    },
  当前位置=P1_阴道口 ∧ 深度>=40 {
      $.状态.触发 = "位置转移:P2_阴道内"
    },
  当前位置=P2_阴道内 ∧ 深度>=100 {
      $.状态.触发 = "位置转移:P3_宫颈口"
    },
  位置转移:P3_宫颈口 ∧ Tier<1 {
      $.状态.触发 = "分支:Tier不足 @效果:宫颈.疼痛+10,宫颈.损伤+5"
    },
  当前位置=P3_宫颈口 ∧ 物体直径>宫颈_有效开口 {
      $.状态.触发 = "位置转移:X33_宫颈顶穿 @效果:伤害+45,恐惧+30"
    },
  当前位置=P4_宫颈内 ∧ 物体直径>子宫_有效开口 {
      $.状态.触发 = "位置转移:X33_宫颈顶穿 @效果:伤害+30,出血+30,恐惧+20"
    },
  当前位置=P3_宫颈口 ∧ 深度>=120 ∧ Tier>=2 ∧ 器官状态.基础生理.湿润度.value>=60 {
      $.状态.触发 = "位置转移:P4_宫颈内"
    },
  当前位置=P4_宫颈内 ∧ 深度>=150 ∧ Tier>=2 {
      $.状态.触发 = "位置转移:P5_子宫内"
    },
  当前位置=P5_子宫内 ∧ 深度>=180 ∧ Tier>=4 {
      $.状态.触发 = "位置转移:P6_输卵管口"
    },
  当前位置=P6_输卵管口 ∧ Tier>=6 ∧ 器官状态.基础生理.湿润度.value>=70 {
      $.状态.触发 = "位置转移:P7_卵巢旁"
    },
  当前位置=P7_卵巢旁 ∧ 行为类型=马眼接触 {
      $.状态.触发 = "位置转移:X34_卵巢马眼接触"
    },
  当前位置=X34_卵巢马眼接触 ∧ 深度>=185 {
      $.状态.触发 = "位置转移:X35_卵巢入马眼"
    },
  当前位置=P7_卵巢旁 {
      $.状态.触发 = "位置转移:P7_卵巢旁 @效果:快感+10,卵巢.敏感度+10"
    },
  当前位置=P1_阴道口 ∧ 伤害>=50 {
      $.状态.触发 = "位置转移:P1_阴道口 @效果:伤害+3,出血+2,疼痛+5,恐惧+3"
    },
  当前位置=P2_阴道内 ∧ 伤害>=50 {
      $.状态.触发 = "位置转移:P2_阴道内 @效果:伤害+4,出血+3,疼痛+6,恐惧+4"
    },
  当前位置=P3_宫颈口 ∧ 伤害>=50 {
      $.状态.触发 = "位置转移:P3_宫颈口 @效果:伤害+5,出血+4,疼痛+8,恐惧+5"
    },
  当前位置=P4_宫颈内 ∧ 伤害>=50 {
      $.状态.触发 = "位置转移:P4_宫颈内 @效果:伤害+6,出血+5,疼痛+10,恐惧+6"
    },
  当前位置=P5_子宫内 ∧ 伤害>=50 {
      $.状态.触发 = "位置转移:P5_子宫内 @效果:伤害+7,出血+6,疼痛+12,恐惧+7"
    },
  当前位置=X30_阴道撕裂 ∧ 出血>=10 {
      $.状态.触发 = "位置转移:X30_阴道撕裂 @效果:出血+5,疼痛+8,恐惧+5"
    },
  当前位置=X31_肛门撕裂 ∧ 出血>=10 {
      $.状态.触发 = "位置转移:X31_肛门撕裂 @效果:出血+5,疼痛+8,恐惧+5"
    },
  当前位置=X32_口腔撕裂 ∧ 出血>=10 {
      $.状态.触发 = "位置转移:X32_口腔撕裂 @效果:出血+5,疼痛+8,恐惧+5"
    },
  当前位置=X34_卵巢马眼接触 ∧ 出血>=10 {
      $.状态.触发 = "位置转移:X34_卵巢马眼接触 @效果:出血+5,疼痛+8,恐惧+5"
    },
  当前位置=X35_卵巢入马眼 ∧ 出血>=10 {
      $.状态.触发 = "位置转移:X35_卵巢入马眼 @效果:出血+8,卵巢.损伤+10,马眼.损伤+10,疼痛+12,恐惧+8"
    },
  当前位置=X35_卵巢入马眼 ∧ 行为类型=射精 {
      $.状态.触发 = "位置转移:E7_卵巢完全外翻 @效果:外翻卵巢.精液+10,快感+15,疼痛+5"
    }
}

// ─── Tier 门槛位置停留规则（v3.8.2 新增·梦梦发现：Tier不足时持续行为无定义）───

