// ═══════════════════════════════════════
// rule_eversion_contact.neko — 外翻感觉计算修正规则（逻辑层）
// 原 @data eversion_base.感觉计算修正 → #规则
// 引擎按当前接触面匹配，返回快感/疼痛倍率（getEversionMultiplier 替代数据读取）
// ═══════════════════════════════════════

// #NPC:猫猫外翻接触修正
// #世界观:CatWorld-OS — 外翻接触面感觉倍率

@规则[$[成年]] {
  当前接触面=繖状突起浆膜面 {
      $.状态.触发 = "接触修正:快感1.5,疼痛3.0"
    },
  当前接触面=输卵管浆膜面 {
      $.状态.触发 = "接触修正:快感1.0,疼痛2.0"
    },
  当前接触面=子宫浆膜面 {
      $.状态.触发 = "接触修正:快感0.8,疼痛1.5"
    },
  当前接触面=宫颈浆膜面 {
      $.状态.触发 = "接触修正:快感0.6,疼痛1.8"
    },
  当前接触面=阴道外膜面 {
      $.状态.触发 = "接触修正:快感0.5,疼痛1.0"
    },
  当前接触面=夹层卵巢浆膜面 {
      $.状态.触发 = "接触修正:快感0.4,疼痛2.5"
    },
  当前接触面=夹层输卵管浆膜面 {
      $.状态.触发 = "接触修正:快感1.0,疼痛2.0"
    },
  当前接触面=体内段_盆腔腹膜 {
      $.状态.触发 = "接触修正:快感0.3,疼痛1.5"
    },
  当前接触面=体内段_Douglas窝腹膜 {
      $.状态.触发 = "接触修正:快感0.2,疼痛2.0"
    },
  当前接触面=体内段_腹腔浆膜 {
      $.状态.触发 = "接触修正:快感0.1,疼痛1.2"
    },
  当前接触面=体内段_前腹壁腹膜 {
      $.状态.触发 = "接触修正:快感0.0,疼痛0.8"
    }
}
