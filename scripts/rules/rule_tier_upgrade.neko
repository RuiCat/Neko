// ═══════════════════════════════════════
// rule_tier_upgrade.neko — Tier 升级规则（逻辑层）
// 原 @data progression.升级条件 文本 → #规则（行为计数变量）
// ═══════════════════════════════════════

// #NPC:猫猫Tier升级
// #世界观:CatWorld-OS — Tier 升级判定逻辑

// 注: 宫颈触碰/宫颈进入/子宫进入/EL6外翻/管口触碰 无累计计数（状态未接入自动推导），
//     原门槛条件已移除（硬编码 0 会使规则永假）；Tier 升级由 适应度+行为总数+外翻次数 驱动，
//     getTierFromAdaptation 适应度映射兜底，targetNum>tierNowNum 防降级保护在引擎侧保留。

@规则[$[成年]] {
  适应>=100 ∧ 行为总数>=5 {
      $.状态.触发 = "Tier升级:T1"
    },
  适应>=300 ∧ 行为总数>=15 {
      $.状态.触发 = "Tier升级:T2"
    },
  适应>=600 ∧ 行为总数>=30 {
      $.状态.触发 = "Tier升级:T3"
    },
  适应>=1000 ∧ 行为总数>=50 ∧ 外翻次数>=5 {
      $.状态.触发 = "Tier升级:T4"
    },
  适应>=1500 ∧ 行为总数>=70 {
      $.状态.触发 = "Tier升级:T5"
    }
}
