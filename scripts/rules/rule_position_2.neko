// ═══ 拆分自 rule_position_rules.neko · 第2部分 ═══

@规则[$[NPC:猫猫]] {
  当前位置=P3_宫颈口 ∧ Tier<2 {
      $.状态.触发 = "位置转移:P3_宫颈口 @效果:宫颈.疼痛+8,宫颈.损伤+3"
    },
  当前位置=P4_宫颈内 ∧ Tier<2 {
      $.状态.触发 = "位置转移:P4_宫颈内 @效果:宫颈.疼痛+10,宫颈.损伤+5"
    },
  当前位置=P5_子宫内 ∧ Tier<4 {
      $.状态.触发 = "位置转移:P5_子宫内 @效果:子宫.疼痛+12,子宫.损伤+5,出血+3"
    },
  当前位置=P6_输卵管口 ∧ Tier<6 {
      $.状态.触发 = "位置转移:P6_输卵管口 @效果:输卵管.疼痛+15,输卵管.损伤+8,出血+5"
    },
  当前位置=P4_宫颈内 ∧ EL>=3 {
      $.状态.触发 = "位置转移:E1_浆膜间隙入口"
    },
  当前位置=P5_子宫内 ∧ EL>=3 {
      $.状态.触发 = "位置转移:E1_浆膜间隙入口"
    },
  当前位置=E1_浆膜间隙入口 ∧ 深度>=30 {
      $.状态.触发 = "位置转移:E2_输卵管浆膜面"
    },
  当前位置=E2_输卵管浆膜面 ∧ EL>=5 {
      $.状态.触发 = "位置转移:E3_卵巢旁浆膜"
    },
  当前位置=E3_卵巢旁浆膜 ∧ EL>=7 {
      $.状态.触发 = "位置转移:E7_卵巢完全外翻"
    },
  当前位置=E7_卵巢完全外翻 ∧ 行为类型=马眼接触 {
      $.状态.触发 = "位置转移:X34_卵巢马眼接触"
    },
  当前位置=E7_卵巢完全外翻 {
      $.状态.触发 = "位置转移:E7_卵巢完全外翻 @效果:快感+15,卵巢.敏感度+10"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=anal ∧ 深度>=20 ∧ 肛道_有效开口>=物体直径 {
      $.状态.触发 = "位置转移:X1_肛道插入"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=anal ∧ 深度>=20 ∧ 肛道_有效开口<物体直径 {
      $.状态.触发 = "位置转移:X31_肛门撕裂"
    },
  当前位置=X1_肛道插入 ∧ 深度>70 {
      $.状态.触发 = "位置转移:X3_直肠穿孔 @效果:直肠.损伤+50,腹膜.损伤+30,疼痛+50,直肠.穿孔"
    },
  当前位置=X1_肛道插入 ∧ 深度<=70 {
      $.状态.触发 = "位置转移:X2_直肠深部"
    },
  位置转移:X2_直肠深部 ∧ 器官状态.基础生理.湿润度.value>=40 {
      $.状态.触发 = "分支:润滑充分 @效果:快感+10"
    },
  位置转移:X2_直肠深部 ∧ 器官状态.基础生理.湿润度.value<40 {
      $.状态.触发 = "分支:干涩 @效果:疼痛+15,肛道.损伤+8,出血+2"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=oral_giving ∧ 深度>=20 ∧ 口腔_有效开口>=物体直径 {
      $.状态.触发 = "位置转移:X4_口交 @效果:口腔.扩张度+10,口腔.敏感度+10"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=oral_receiving ∧ 深度>=20 ∧ 口腔_有效开口>=物体直径 {
      $.状态.触发 = "位置转移:X4_口交 @效果:口腔.扩张度+10,口腔.敏感度+10"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=oral_giving ∧ 深度>=20 ∧ 口腔_有效开口<物体直径 {
      $.状态.触发 = "位置转移:X32_口腔撕裂"
    },
  当前位置=P0_体外蹭蹭 ∧ 行为类型=oral_receiving ∧ 深度>=20 ∧ 口腔_有效开口<物体直径 {
      $.状态.触发 = "位置转移:X32_口腔撕裂"
    },
  当前位置=X4_口交 ∧ 深度>=60 {
      $.状态.触发 = "位置转移:X5_深喉 @效果:咽喉.敏感度+15,快感+10"
    },
  当前位置=X5_深喉 ∧ 深度>90 {
      $.状态.触发 = "位置转移:X5B_食道插入 @效果:咽喉.损伤+30,口腔.损伤+20,疼痛+40,出血+5"
    },
  位置转移:X5_深喉 ∧ 深度<=90 {
      $.状态.触发 = "分支:深喉容纳 @效果:快感+15,咽喉.敏感度+10"
    },
  当前位置=X20_猫耳抚摸 ∧ 耳朵.敏感度>=60 {
      $.状态.触发 = "位置转移:X21_猫耳敏感 @效果:猫耳.敏感度+5,兴奋+10"
    },
  当前位置=X20_猫耳抚摸 ∧ 行为类型=插入 {
      $.状态.触发 = "位置转移:X22_猫耳插入 @效果:猫耳.损伤+5,疼痛+5"
    },
  当前位置=X23_尾巴抚摸 ∧ 行为类型=牵拉 {
      $.状态.触发 = "位置转移:X24_尾巴牵拉 @效果:尾巴.损伤+10,疼痛+15"
    },
  当前位置=X25_肉垫抚摸 ∧ 部位.肉垫.敏感度>=70 {
      $.状态.触发 = "位置转移:X26_肉垫敏感 @效果:肉垫.敏感度+5,兴奋+12"
    }
}

