// ═══════════════════════════════════════
// rule_eversion_rules.neko — 外翻层级推进/回退规则（逻辑层）
// 原 @data 外翻行为映射.EL推进公式/EL回退规则 文本 → #规则
// ═══════════════════════════════════════

// #NPC:猫猫外翻推进
// #世界观:CatWorld-OS — 外翻层级推进逻辑

// ─── EL 推进 ───

@规则[$[成年]] {
  当前EL>=0 ∧ 深度>=100 ∧ 力度>=50 ∧ 持续轮次>=2 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL>=1 ∧ 深度>=130 ∧ 力度>=65 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL>=2 ∧ 深度>=160 ∧ 力度>=75 ∧ 持续轮次>=2 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL>=3 ∧ 深度>=180 ∧ 力度>=80 ∧ 宫颈管径>=8 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL>=4 ∧ 深度>=200 ∧ 力度>=85 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL>=5 ∧ 深度>=220 ∧ 力度>=90 ∧ 持续轮次>=3 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL>=6 ∧ 深度>=230 ∧ 力度>=85 ∧ 指定输卵管=1 {
      $.状态.触发 = "EL推进:1"
    },
  当前EL=7 ∧ 停止分钟>=5 {
      $.状态.触发 = "EL回退:1"
    },
  当前EL=6 ∧ 停止分钟>=10 {
      $.状态.触发 = "EL回退:1"
    },
  当前EL=5 ∧ 停止分钟>=15 {
      $.状态.触发 = "EL回退:1"
    },
  当前EL=4 ∧ 停止分钟>=20 {
      $.状态.触发 = "EL回退:1"
    },
  当前EL=3 ∧ 停止分钟>=30 {
      $.状态.触发 = "EL回退:1"
    },
  当前EL=2 ∧ 停止分钟>=60 {
      $.状态.触发 = "EL回退:1"
    },
  当前EL=1 ∧ 停止分钟>=120 {
      $.状态.触发 = "EL回退:1"
    }
}
