// ═══════════════════════════════════════
// rule_behavior_modifiers.neko — 行为类型状态修饰规则（逻辑层）
// 原 @data sexual_behavior.行为目录.状态变化 → #规则
// 引擎按行为类型匹配，返回各状态变化范围（getBehaviorModifiers 替代数据读取）
// 变化值用范围格式 "低-高"（如 5-15），引擎取随机或中值
// ═══════════════════════════════════════

// #NPC:猫猫行为修饰
// #世界观:CatWorld-OS — 行为类型状态修饰

// ─── B01 口交(主人接受) ───

@规则[$[NPC:猫猫]] {
  行为类型=oral_giving {
      $.状态.触发 = "行为修饰:湿润5-15,兴奋10-25,害羞5-20,服从5-10,体力-1-(-0.5)"
    },
  行为类型=oral_receiving {
      $.状态.触发 = "行为修饰:湿润15-30,兴奋20-40,快感15-35,害羞15-30"
    },
  行为类型=anal {
      $.状态.触发 = "行为修饰:疼痛15-40,快感10-25,兴奋15-30,湿润5-10,体力-2-(-1)"
    },
  行为类型=breast {
      $.状态.触发 = "行为修饰:兴奋5-20,快感5-15,湿润3-8,害羞10-25"
    },
  行为类型=vaginal {
      $.状态.触发 = "行为修饰:湿润10-20,兴奋10-30,快感15-35,满足5-15,体力-2-(-1)"
    },
  行为类型=manual {
      $.状态.触发 = "行为修饰:湿润10-25,兴奋15-30,快感20-40,害羞5-15,体力-1-(-0.5)"
    },
  行为类型=aftercare {
      $.状态.触发 = "行为修饰:幸福感10-25,满足5-15,信任5-15,恐惧-10-(-5),体力2-5"
    },
  行为类型=tool {
      $.状态.触发 = "行为修饰:湿润10-20,疼痛5-20,兴奋15-30,快感20-35,体力-2-(-1)"
    }
}
