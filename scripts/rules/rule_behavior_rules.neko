// ═══════════════════════════════════════
// rule_behavior_rules.neko — 行为偏向修正规则（逻辑层）
// 状态→偏向映射的特殊规则由 #规则 表达（原 @data 文本）
// 公式在 data_rules_behavior.neko @data 状态→偏向映射公式.公式表达式
// ═══════════════════════════════════════

// #NPC:猫猫行为偏向
// #世界观:CatWorld-OS — 行为偏向修正逻辑

// ─── D01 撒娇倾向 ───

@规则[$[NPC:猫猫]] {
  撒娇欲>=70 {
      $.状态.触发 = "偏向下限:撒娇>=60"
    },
  身体.体力<20 {
      $.状态.触发 = "偏向修正:撒娇+15"
    },
  傲娇倾向>=70 {
      $.状态.触发 = "偏向修正:撒娇-20"
    },
  关系.亲密>=90 {
      $.状态.触发 = "偏向倍率:傲娇*0.5"
    },
  关系.信赖>=90 {
      $.状态.触发 = "偏向修正:傲娇-20"
    },
  状态.疼痛>60 {
      $.状态.触发 = "偏向修正:主动-30"
    },
  状态.恐惧>40 {
      $.状态.触发 = "偏向修正:主动-25"
    },
  身体.体力<15 {
      $.状态.触发 = "偏向上限:主动<=40"
    },
  关系.亲密>=95 {
      $.状态.触发 = "偏向下限:坦率>=70"
    },
  当前场景 in {S006,S030} {
      $.状态.触发 = "偏向修正:坦率-15"
    },
  时间 in {深夜} {
      $.状态.触发 = "偏向修正:坦率+10"
    },
  状态.恐惧>50 {
      $.状态.触发 = "偏向倍率:好奇*0.3"
    },
  身体.疲劳>60 {
      $.状态.触发 = "偏向修正:好奇-30"
    },
  首次访问=1 {
      $.状态.触发 = "偏向修正:好奇+25"
    },
  时间 in {深夜} {
      $.状态.触发 = "偏向修正:好奇=0"
    },
  安全感<40 {
      $.状态.触发 = "偏向下限:黏人>=70"
    },
  主人同场景=0 {
      $.状态.触发 = "偏向修正:黏人+30"
    },
  好奇心>80 {
      $.状态.触发 = "偏向修正:黏人-15"
    },
  状态.疼痛>70 {
      $.状态.触发 = "偏向倍率:敏感*0.4"
    },
  身体.疲劳>70 {
      $.状态.触发 = "偏向修正:敏感-30"
    },
  R18互动=1 {
      $.状态.触发 = "偏向修正:敏感+20"
    },
  状态.抗拒>50 {
      $.状态.触发 = "偏向修正:服从-40"
    },
  状态.疼痛>80 {
      $.状态.触发 = "偏向修正:服从-30"
    },
  关系.爱意>=95 {
      $.状态.触发 = "偏向下限:服从>=80"
    }
}
