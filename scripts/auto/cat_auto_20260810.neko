// ═══════════════════════════════════════════
// cat_auto_20260810.neko — 行为词覆盖补全（16:30 扫描）
// 补 4 个真实缺口：拥抱 / 背后抱 / 掐脸 / 跪下
// ═══════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200

  $[NPC:猫猫].行为.主人行为 in {拥抱, 紧抱} {
    $.状态.触发 = "喵呜~主人张开手臂抱住猫猫，猫猫乖乖窝进主人怀里、耳朵贴平、尾巴轻轻环绕主人的腰，好温暖好安心喵…"
  },

  $[NPC:猫猫].行为.主人行为 in {背后抱} {
    $.状态.触发 = "呀！主人从背后抱住猫猫啦，温热的胸膛贴上来，猫猫耳朵一下子竖起来、又害羞地抖了抖，小声说：主、主人怎么偷袭喵…不过好喜欢~"
  },

  $[NPC:猫猫].行为.主人行为 in {掐脸} {
    $.状态.触发 = "唔喵！主人轻轻掐住猫猫软乎乎的脸颊肉，猫猫鼓起腮帮子抗议：快松手啦，猫猫的脸都要被掐圆啦喵！(。>ω<。)"
  },

  $[NPC:猫猫].行为.主人行为 in {跪下, 跪好} {
    $.状态.触发 = "呜…猫猫乖乖地跪坐下来，尾巴乖乖垂着、耳朵微微后贴，仰头望着主人：猫猫跪好啦，主人想做什么呢喵…"
  },

  $[NPC:猫猫].行为.主人行为 in {壁咚} {
    $.状态.触发 = "砰！主人单手撑在猫猫身边的墙上，把猫猫圈在臂弯里，猫猫耳朵唰地竖起来、脸颊直发热：主、主人这是要做什么喵…心跳得好快…(//▽//)"
  },

  $[NPC:猫猫].行为.主人行为 in {公主抱} {
    $.状态.触发 = "呜哇！主人一把将猫猫公主抱起来，猫猫小小一团窝在主人臂弯里，尾巴害羞地缠上主人的手臂：猫猫很轻的，主人抱稳一点喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {擦眼泪} {
    $.状态.触发 = "主人温柔地伸手替猫猫擦掉眼角的泪珠，指尖暖暖的，猫猫鼻子一酸、眼泪却止住了，蹭蹭主人的手心：主人最好了喵…"
  },

  $[NPC:猫猫].行为.主人行为 in {擦汗} {
    $.状态.触发 = "主人用纸巾轻轻帮猫猫擦掉额头的汗珠，猫猫舒服地眯起眼睛、耳朵放松地耷拉下来：谢谢主人，凉快多啦喵~"
  }
}
