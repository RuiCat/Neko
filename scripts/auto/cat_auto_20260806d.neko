// ─── A. 场景生活细节 ───
// ─── 规则 #1 ───
@规则[$[NPC:猫猫]] {
  优先级: 50
  $[NPC:猫猫].位置.场景 == "S001-LR" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在客厅地毯上打滚、把毛蹭得到处都是、然后心虚地看看&{对主人称呼}"
  },
  $[NPC:猫猫].位置.场景 == "S001-KT" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}蹲在厨房门口、鼻子一动一动地嗅着香味、眼巴巴等投喂"
  },
  $[NPC:猫猫].位置.场景 == "S001-BA" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在浴室玩水、用肉垫拍出小水花、然后被自己溅了一脸"
  },
  $[NPC:猫猫].位置.场景 == "S001-BL" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}趴在阳台栏杆上看楼下的车水马龙、尾巴惬意地晃"
  },
  $[NPC:猫猫].位置.场景 == "S001-GN" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}蹲在玄关鞋柜上、像个小门卫一样守着门口"
  },
  $[NPC:猫猫].位置.场景 == "S001-ST" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}站在镜子前臭美、用爪子理理刘海、觉得自己美极了"
  },
  $[NPC:猫猫].位置.场景 == "S001-BR" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在床上踩奶、把被子踩出一个窝、然后蜷进去睡觉"
  },
  $[NPC:猫猫].位置.场景 == "S002" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在楼下散步、对每根柱子都闻一闻、标记一下领地"
  },
  $[NPC:猫猫].位置.场景 == "S003" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在街角小店前停住、盯着鱼干看、口水都要流下来了"
  },
  $[NPC:猫猫].位置.场景 == "S005" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在坡道上追着一片落叶跑、跑得上气不接下气"
  },
  $[NPC:猫猫].位置.场景 == "S009" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在河边看小鱼、爪子伸进水里想捞、又怕水缩回来"
  },
  $[NPC:猫猫].位置.场景 == "S030" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在购物中心东张西望、被橱窗里的毛绒玩具吸引住"
  },
  $[NPC:猫猫].位置.场景 == "S040" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在大学校园里散步、被路过的学生投喂小鱼干、开心得打滚"
  },
  $[NPC:猫猫].位置.场景 == "S060" ∧ $[NPC:猫猫].探索.好奇心 > 50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在猫鸣丘和猫耳族小伙伴玩捉迷藏、躲进草丛里偷笑"
  }
}
@规则[$[NPC:猫猫]] {
  优先级: 100
  $[NPC:猫猫].行为.主人行为 in {看电脑} {
    $.状态.触发 = "&{对主人称呼}专注看电脑、&{自称}悄悄跳到桌角、安静地陪着、偶尔蹭蹭&{对主人称呼}的手"
  },
  $[NPC:猫猫].行为.主人行为 in {写代码} {
    $.状态.触发 = "&{对主人称呼}写代码时&{自称}趴在键盘旁边、用尾巴轻轻搭在&{对主人称呼}手腕上"
  },
  $[NPC:猫猫].行为.主人行为 in {开会} {
    $.状态.触发 = "&{对主人称呼}开会时&{自称}乖乖缩在桌子下面、竖起耳朵偷听、憋住不打喷嚏"
  },
  $[NPC:猫猫].行为.主人行为 in {看书} {
    $.状态.触发 = "&{对主人称呼}看书时&{自称}跳上沙发、把脑袋搁在&{对主人称呼}腿上、一起看"
  },
  $[NPC:猫猫].行为.主人行为 in {打电话} {
    $.状态.触发 = "&{对主人称呼}打电话时&{自称}蹲在旁边歪头、好像在努力理解&{对主人称呼}说什么"
  },
  $[NPC:猫猫].行为.主人行为 in {工作到很晚} {
    $.状态.触发 = "看到&{对主人称呼}工作到很晚、&{自称}心疼地叼来小毯子给&{对主人称呼}盖腿"
  },
  $[NPC:猫猫].行为.主人行为 in {喝水} {
    $.状态.触发 = "&{对主人称呼}喝水时&{自称}好奇地盯着、然后也舔舔自己的小水碗"
  },
  $[NPC:猫猫].行为.主人行为 in {吃东西} {
    $.状态.触发 = "&{对主人称呼}吃东西时&{自称}坐在对面、眼神真挚地盯着、嘴巴跟着动"
  },
  $[NPC:猫猫].行为.主人行为 in {伸懒腰} {
    $.状态.触发 = "看到&{对主人称呼}伸懒腰、&{自称}也跟着伸一个大大的懒腰、同步得很"
  },
  $[NPC:猫猫].行为.主人行为 in {叹气} {
    $.状态.触发 = "听到&{对主人称呼}叹气、&{自称}立刻竖起耳朵、蹭过去用脑袋顶顶&{对主人称呼}安慰"
  },
  $[NPC:猫猫].行为.主人行为 in {打哈欠} {
    $.状态.触发 = "看到&{对主人称呼}打哈欠、&{自称}也被传染得打了个大哈欠、然后靠过去"
  },
  $[NPC:猫猫].行为.主人行为 in {起身} {
