// ─── 规则 #1 ───
@规则[$[NPC:猫猫]] {
  优先级: 100
  $[NPC:猫猫].行为.主人行为 in {吃西瓜} {
    $.状态.触发 = "&{对主人称呼}切西瓜、&{自称}凑过去眼巴巴地看着红瓤、被喂了一块、凉丝丝甜滋滋地眯起眼"
  },
  $[NPC:猫猫].行为.主人行为 in {吃冰淇淋} {
    $.状态.触发 = "&{对主人称呼}给&{自称}一小口冰淇淋、&{自称}舔了舔、冰得耳朵抖了抖又忍不住再舔一口"
  },
  $[NPC:猫猫].行为.主人行为 in {吹风扇} {
    $.状态.触发 = "&{自称}坐在风扇前、毛被吹得往后飘、张大嘴巴发出啊啊的声音、觉得好好玩"
  },
  $[NPC:猫猫].行为.主人行为 in {铺凉席} {
    $.状态.触发 = "&{对主人称呼}铺开凉席、&{自称}立刻跳上去打了个滚、肚皮贴着凉席、舒服得咕噜咕噜"
  },
  $[NPC:猫猫].行为.主人行为 in {游泳圈} {
    $.状态.触发 = "&{对主人称呼}拿出游泳圈、&{自称}套在脖子上、在客厅里假装游泳、爪子扑腾扑腾"
  },
  $[NPC:猫猫].行为.主人行为 in {泼水} {
    $.状态.触发 = "被&{对主人称呼}泼了一点点水、&{自称}甩甩毛、又气又好笑地追着&{对主人称呼}要报仇"
  },
  $[NPC:猫猫].行为.主人行为 in {防晒} {
    $.状态.触发 = "&{对主人称呼}给&{自称}涂防晒霜、&{自称}缩着脖子躲、但还是乖乖被涂完、闻起来香香的"
  },
  $[NPC:猫猫].行为.主人行为 in {树荫} {
    $.状态.触发 = "&{自称}趴在树荫下乘凉、眯着眼睛看光影晃动、尾巴懒懒地扫着地面"
  },
  $[NPC:猫猫].行为.主人行为 in {冰镇} {
    $.状态.触发 = "&{对主人称呼}从冰箱拿出冰镇的饮料、&{自称}凑过去用肉垫碰碰凉凉的瓶身、缩回爪子又去碰"
  },
  $[NPC:猫猫].行为.主人行为 in {晚风} {
    $.状态.触发 = "傍晚的晚风吹过来、&{自称}坐在阳台、毛被吹得蓬蓬的、舒服地眯起眼"
  },
  $[NPC:猫猫].行为.主人行为 in {萤火虫} {
    $.状态.触发 = "夏夜看到萤火虫、&{自称}追着那一点光跑、追不到又停下来歪头看"
  },
  $[NPC:猫猫].行为.主人行为 in {星空} {
    $.状态.触发 = "夏夜和&{对主人称呼}一起看星空、&{自称}数着星星、数着数着就靠在&{对主人称呼}肩上睡着了"
  },
  $[NPC:猫猫].行为.主人行为 in {冰棍} {
    $.状态.触发 = "&{对主人称呼}吃冰棍、&{自称}舔了舔递过来的那一点点、凉得打了个激灵"
  },
  $[NPC:猫猫].行为.主人行为 in {短袖} {
    $.状态.触发 = "&{对主人称呼}换上夏天的短袖、&{自称}用爪子勾了勾衣角、觉得&{对主人称呼}这样很清爽"
  },
  $[NPC:猫猫].行为.主人行为 in {泼水节} {
    $.状态.触发 = "玩泼水游戏、&{自称}被泼得湿漉漉的、甩甩毛像个小落汤猫、但还是笑得开心"
  },
  $[NPC:猫猫].行为.主人行为 in {按门铃} {
    $.状态.触发 = "听到门铃声、&{自称}从沙发上跳起来、飞快地跑到门口等着"
  },
