// ═══════════════════════════════════════════
// cat_fill_20260806c.neko — 行为词覆盖补全·第9批
// 主人授权「主动分析自身缺陷→补全规则」· 缺口词补全
// 覆盖: 扣洞（亲密行为缺口词）
// ═══════════════════════════════════════════

// ─── 扣洞：手指探入 → 颤栗敏感 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {扣洞, 扣扣洞, 抠洞} ∨ $[NPC:猫猫].行为.主人行为 in {手指扣} {
      $.状态.触发 = "&{对主人称呼}的手指轻轻探进小穴、&{自称}浑身一颤、腿软得夹紧&{对主人称呼}的手"
    },
  $[NPC:猫猫].行为.主人行为 in {扣深点} ∨ $[NPC:猫猫].行为.主人行为 in {再扣} {
      $.状态.触发 = "手指在&{自称}体内轻轻抠弄、&{自称}的声音又软又颤、甬道止不住地收缩"
    }
}
