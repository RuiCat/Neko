// ═══════════════════════════════════════════
// cat_auto_20260811b.neko — 高频日常行为词补全（09:00 扫描 39 缺口选 10 条）
// v2 修复：头部补 [$[NPC:猫猫]]（v1 缺目标实体声明导致条件路径解析错误、规则静默失效）
// 补 10 个真实缺口：按摩肩膀 / 梳头发 / 吹头发 / 点鼻子 / 揉爪爪 / 脱外套 / 整理衣领 / 系围巾 / 画画 / 洗碗
// ═══════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200

  $[NPC:猫猫].行为.主人行为 in {按摩肩膀, 按肩膀, 揉肩膀} {
    $.状态.触发 = "主人的手指按上猫猫的肩膀，猫猫舒服得耳朵都软趴趴地耷拉下来，咕噜咕噜地蹭着主人的手：呜喵……就是这里、主人的手好会按，猫猫的骨头都要化掉啦~"
  },

  $[NPC:猫猫].行为.主人行为 in {梳头发, 梳头} {
    $.状态.触发 = "主人拿起梳子轻轻梳理猫猫的头发，梳齿从头皮滑过的酥麻感让猫猫眯起眼睛，尾巴尖愉快地一摆一摆：主人的梳头手法最温柔了，猫猫以后天天都要主人梳喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {吹头发, 吹干头发} {
    $.状态.触发 = "洗完澡猫猫顶着湿漉漉的头发，主人拿着吹风机暖风轻轻吹，猫猫缩着脖子又躲又笑：呜哇好暖！主人别吹耳朵那里啦、痒痒的喵——（却悄悄往主人手边蹭）"
  },

  $[NPC:猫猫].行为.主人行为 in {点鼻子, 刮鼻子} {
    $.状态.触发 = "主人伸出手指轻轻点了点猫猫的鼻尖，猫猫的耳朵噌地竖起来、鼻子皱成小褶子，愣了一秒才反应过来：喵呜！偷袭！猫猫的鼻子是敏感区啦——但是……不讨厌主人点就是了呢"
  },

  $[NPC:猫猫].行为.主人行为 in {揉爪爪, 揉肉垫} {
    $.状态.触发 = "主人把猫猫的爪爪捧在手心轻轻揉捏肉垫，猫猫舒服得眼睛都眯成缝、喉咙里咕噜咕噜响个不停，四只爪爪的粉嫩肉垫都软软地摊开：主人的手好暖和……肉垫被揉得酥酥麻麻的，猫猫幸福到想打滚喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {脱外套, 帮脱外套} {
    $.状态.触发 = "主人一回家猫猫就颠颠地跑过去，踮起脚尖帮主人把外套脱下来挂好，还顺手拍了拍灰尘：主人辛苦啦！外套交给猫猫，快坐下来歇歇，猫猫去给主人倒杯水喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {整理衣领, 整衣领} {
    $.状态.触发 = "猫猫踮起脚尖、认真地帮主人抚平翻起的衣领，小爪子仔仔细细地压好每一个褶子，然后满意地拍拍手：好啦！主人的衣领整整齐齐的，出门就是最精神的主人喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {系围巾, 围围巾} {
    $.状态.触发 = "出门前猫猫拿着围巾绕到主人脖子上，笨手笨脚却认认真真地打了个歪歪扭扭的结，退后两步看了看又上前调整：嗯……虽然有点歪，但是很暖和！这是猫猫牌围巾结，全世界只有主人有喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {画画, 一起画画} {
    $.状态.触发 = "猫猫趴在桌上握着彩笔认真画画，画完举起一张歪歪扭扭的画给主人看：主人你看！这是猫猫、这是主人、这是梦梦，我们三个一起在太阳底下野餐……虽然猫猫画得不太好，但是满满的心意都在里面了喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {洗碗, 刷碗} {
    $.状态.触发 = "吃完饭猫猫挽起袖子、搬来小凳子踩上去，认认真真地刷碗，碗碟碰出叮叮当当的轻响：交给猫猫就好啦！主人去休息，猫猫会把碗碗刷得干干净净、一个都不留油渍喵！"
  },
}
