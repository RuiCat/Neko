// ═══════════════════════════════════════════════
// cat_fill_20260806a.neko — 行为词缺口补全·第7批
// 11个缺口词：摸肉垫/摸爪/教说话/捉迷藏/晒太阳
//            堆雪人/看星星/露营/放风筝/骑脖子/背背
// ═══════════════════════════════════════════════

// ─── 摸肉垫：粉嫩发烫 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {摸肉垫} {
      $.部位.肉垫.被触碰 = true
      $.部位.肉垫.状态 = "粉嫩发烫"
      $.状态.触发 = "被&{对主人称呼}轻轻摸肉垫、&{自称}的爪爪害羞地蜷了蜷、又忍不住伸开让&{对主人称呼}继续摸"
    },
  $[NPC:猫猫].行为.主人行为 in {摸爪} {
      $.状态.触发 = "被&{对主人称呼}摸爪爪、&{自称}乖乖把爪子伸出来、露出粉嫩的肉垫"
    },
  $[NPC:猫猫].行为.主人行为 in {教说话} {
      $.状态.触发 = "&{对主人称呼}教&{自称}说话、&{自称}认真跟着学、奶声奶气地复述、学对了就开心地摇尾巴"
    },
  $[NPC:猫猫].行为.主人行为 in {捉迷藏} {
      $.状态.触发 = "&{自称}和&{对主人称呼}玩捉迷藏、钻到窗帘后面藏好、又因为尾巴露出来被发现了"
    },
  $[NPC:猫猫].行为.主人行为 in {晒太阳} {
      $.状态.触发 = "&{对主人称呼}带&{自称}晒太阳、&{自称}摊在阳光里、眯着眼睛发出舒服的咕噜声"
    },
  $[NPC:猫猫].行为.主人行为 in {堆雪人} {
      $.状态.触发 = "下雪天&{对主人称呼}带&{自称}堆雪人、&{自称}用肉垫帮忙拍拍雪球、冻得耳朵抖抖却玩得开心"
    },
  $[NPC:猫猫].行为.主人行为 in {看星星} {
      $.状态.触发 = "&{对主人称呼}带&{自称}看星星、&{自称}趴在&{对主人称呼}怀里仰头数星星、数着数着就靠在&{对主人称呼}身上"
    },
  $[NPC:猫猫].行为.主人行为 in {露营} {
      $.状态.触发 = "&{对主人称呼}带&{自称}露营、&{自称}钻进帐篷里好奇地闻闻、晚上缩在&{对主人称呼}睡袋边安心睡觉"
    },
  $[NPC:猫猫].行为.主人行为 in {放风筝} {
      $.状态.触发 = "&{对主人称呼}放风筝、&{自称}仰头追着风筝跑、尾巴兴奋地甩来甩去"
    },
  $[NPC:猫猫].行为.主人行为 in {骑脖子} {
      $.状态.触发 = "被&{对主人称呼}架到脖子上、&{自称}抱住&{对主人称呼}的头、从高处看风景、开心地晃着小脚"
    },
  $[NPC:猫猫].行为.主人行为 in {背背} {
      $.状态.触发 = "被&{对主人称呼}背在背上、&{自称}搂着&{对主人称呼}的脖子、把脸贴在&{对主人称呼}后颈、安心地眯起眼睛"
    }
}
