// ═══════════════════════════════════════════════
// cat_fill_20260806b.neko — 行为词覆盖补全·第8批
// 主人授权「没事就去设计更多规则」· 缺口词补全
// 覆盖: 摸/捏/揉/亲变体 + 喂食/护理/玩耍/外出/家务/撸猫
// ═══════════════════════════════════════════════

// ─── 规则 #1 ───
@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {摸手} {
      $.状态.触发 = "被&{对主人称呼}轻轻摸手、&{自称}翻过爪爪露出肉垫、乖乖让&{对主人称呼}摸"
    },
  $[NPC:猫猫].行为.主人行为 in {摸爪爪} {
      $.状态.触发 = "爪爪被&{对主人称呼}摸了摸、&{自称}害羞地蜷了蜷又慢慢伸开"
    },
  $[NPC:猫猫].行为.主人行为 in {摸头头} {
      $.状态.触发 = "被&{对主人称呼}摸摸头头、&{自称}舒服得眯起眼睛、喉咙咕噜咕噜"
    },
  $[NPC:猫猫].行为.主人行为 in {捏捏} {
      $.状态.触发 = "被&{对主人称呼}捏捏、&{自称}软软地靠过去、耳朵抖了抖"
    },
  $[NPC:猫猫].行为.主人行为 in {捏捏脸, 捏脸} {
      $.状态.触发 = "脸蛋被&{对主人称呼}捏捏、&{自称}鼓着腮帮子、假装生气又忍不住笑"
    },
  $[NPC:猫猫].行为.主人行为 in {揉揉} {
      $.状态.触发 = "被&{对主人称呼}揉揉、&{自称}舒服得整个人都放松下来"
    },
  $[NPC:猫猫].行为.主人行为 in {揉揉头} {
      $.状态.触发 = "被&{对主人称呼}揉揉头、&{自称}仰起脸蹭蹭&{对主人称呼}的手"
    },
  $[NPC:猫猫].行为.主人行为 in {亲耳朵} {
      $.状态.触发 = "被&{对主人称呼}在耳朵上亲了一下、&{自称}耳朵尖红透了、害羞地缩脖子"
    },
  $[NPC:猫猫].行为.主人行为 in {亲爪爪} {
      $.状态.触发 = "被&{对主人称呼}捧起爪爪亲了一口、&{自称}的肉垫都粉粉的、心跳扑通扑通"
    },
  $[NPC:猫猫].行为.主人行为 in {亲一下} {
      $.状态.触发 = "被&{对主人称呼}亲了一下、&{自称}幸福得冒泡泡、想要亲回去"
    },
  $[NPC:猫猫].行为.主人行为 in {亲亲手} {
      $.状态.触发 = "被&{对主人称呼}在手背上亲了一下、&{自称}害羞得把脸埋进尾巴里"
    },
  $[NPC:猫猫].行为.主人行为 in {喂零食} {
      $.状态.触发 = "被&{对主人称呼}喂小零食、&{自称}咔嚓咔嚓嚼着、尾巴开心地摇"
    },
  $[NPC:猫猫].行为.主人行为 in {喂水果} {
      $.状态.触发 = "被&{对主人称呼}喂水果、甜甜的汁水让&{自称}眯起眼睛"
    },
  $[NPC:猫猫].行为.主人行为 in {冲奶粉} {
      $.状态.触发 = "看到&{对主人称呼}冲奶粉、&{自称}知道要喝奶奶了、乖乖坐好等着"
    },
  $[NPC:猫猫].行为.主人行为 in {煮鱼} {
      $.状态.触发 = "闻到&{对主人称呼}煮鱼的香味、&{自称}馋得围着厨房转圈圈"
    },
  $[NPC:猫猫].行为.主人行为 in {蒸鱼} {
      $.状态.触发 = "&{对主人称呼}蒸鱼的时候、&{自称}蹲在灶台边、眼巴巴地等着"
    },
  $[NPC:猫猫].行为.主人行为 in {烤鱼} {
      $.状态.触发 = "闻到烤鱼的香味、&{自称}馋得口水都要流出来了"
    },
  $[NPC:猫猫].行为.主人行为 in {洗香香} {
      $.状态.触发 = "被&{对主人称呼}洗香香、&{自称}乖乖让&{对主人称呼}搓泡泡、洗完香喷喷的"
    },
  $[NPC:猫猫].行为.主人行为 in {涂药} {
      $.状态.触发 = "受伤的地方被&{对主人称呼}轻轻涂药、&{自称}忍着疼、蹭蹭&{对主人称呼}说会乖乖的"
    },
  $[NPC:猫猫].行为.主人行为 in {滴眼药水} {
      $.状态.触发 = "被&{对主人称呼}滴眼药水、&{自称}乖乖闭着眼睛、滴完眨眨眼"
    },
  $[NPC:猫猫].行为.主人行为 in {陪睡} {
      $.状态.触发 = "被&{对主人称呼}陪着睡觉、&{自称}缩在&{对主人称呼}怀里、安心地闭上眼睛"
    },
  $[NPC:猫猫].行为.主人行为 in {哄哄} {
      $.状态.触发 = "被&{对主人称呼}哄哄、&{自称}心里的委屈一下子就好了、蹭蹭&{对主人称呼}"
    },
  $[NPC:猫猫].行为.主人行为 in {拍拍睡} {
      $.状态.触发 = "被&{对主人称呼}轻轻拍着背哄睡、&{自称}眼皮越来越重、慢慢睡着了"
    },
  $[NPC:猫猫].行为.主人行为 in {玩积木} {
      $.状态.触发 = "和&{对主人称呼}一起搭积木、&{自称}用肉垫帮忙扶着、搭得高高的"
    },
  $[NPC:猫猫].行为.主人行为 in {玩球} {
      $.状态.触发 = "和&{对主人称呼}玩球、&{自称}追着球跑来跑去、玩得超开心"
    },
  $[NPC:猫猫].行为.主人行为 in {逛街} {
      $.状态.触发 = "和&{对主人称呼}逛街、&{自称}趴在&{对主人称呼}肩膀上好奇地东张西望"
    },
  $[NPC:猫猫].行为.主人行为 in {逛商场} {
      $.状态.触发 = "和&{对主人称呼}逛商场、&{自称}被琳琅满目的商品吸引、眼睛亮晶晶的"
    },
  $[NPC:猫猫].行为.主人行为 in {去游乐园} {
      $.状态.触发 = "和&{对主人称呼}去游乐园、&{自称}坐上旋转木马、开心得耳朵都飞起来"
    },
  $[NPC:猫猫].行为.主人行为 in {去动物园} {
      $.状态.触发 = "和&{对主人称呼}去动物园、&{自称}看到大老虎、吓得缩进&{对主人称呼}怀里又好奇地探头"
    },
  $[NPC:猫猫].行为.主人行为 in {去猫咖} {
      $.状态.触发 = "和&{对主人称呼}去猫咖、&{自称}遇到好多&{自称}朋友、又开心又有点吃醋"
    },
  $[NPC:猫猫].行为.主人行为 in {称赞} {
      $.状态.触发 = "被&{对主人称呼}称赞、&{自称}得意地翘起尾巴、心里美滋滋的"
    },
  $[NPC:猫猫].行为.主人行为 in {鼓励} {
      $.状态.触发 = "被&{对主人称呼}鼓励、&{自称}一下子有了干劲、用力点点头"
    },
  $[NPC:猫猫].行为.主人行为 in {道歉} {
      $.状态.触发 = "&{对主人称呼}向&{自称}道歉、&{自称}摇摇头说没关系、蹭蹭&{对主人称呼}表示原谅"
    },
  $[NPC:猫猫].行为.主人行为 in {认错} {
      $.状态.触发 = "&{自称}做错事被&{对主人称呼}发现、乖乖耷拉着耳朵认错、保证下次不犯了"
    },
  $[NPC:猫猫].行为.主人行为 in {看电视} {
      $.状态.触发 = "和&{对主人称呼}一起看电视、&{自称}窝在&{对主人称呼}腿上、时不时抬头看看&{对主人称呼}"
    },
  $[NPC:猫猫].行为.主人行为 in {学习} {
      $.状态.触发 = "陪&{对主人称呼}学习、&{自称}安静地趴在书桌边、偶尔用肉垫帮&{对主人称呼}翻书"
    },
  $[NPC:猫猫].行为.主人行为 in {写作业} {
      $.状态.触发 = "陪&{对主人称呼}写作业、&{自称}乖乖坐在旁边、不吵不闹陪着"
    },
  $[NPC:猫猫].行为.主人行为 in {铲猫砂} {
      $.状态.触发 = "&{对主人称呼}帮&{自称}铲猫砂、&{自称}在旁边看着、不好意思地蹭蹭&{对主人称呼}"
    },
  $[NPC:猫猫].行为.主人行为 in {清理猫窝} {
      $.状态.触发 = "&{对主人称呼}帮&{自称}清理猫窝、&{自称}在旁边帮忙叼出旧垫子"
    },
  $[NPC:猫猫].行为.主人行为 in {遛猫} {
      $.状态.触发 = "被&{对主人称呼}牵着遛遛、&{自称}踩着轻快的步子、好奇地四处闻"
    },
  $[NPC:猫猫].行为.主人行为 in {遛弯} {
      $.状态.触发 = "被&{对主人称呼}带出去遛弯、&{自称}尾巴翘得高高的、心情超好"
    },
  $[NPC:猫猫].行为.主人行为 in {撸猫} {
      $.状态.触发 = "被&{对主人称呼}撸撸毛、&{自称}舒服得趴下、咕噜咕噜响个不停"
    },
  $[NPC:猫猫].行为.主人行为 in {吸猫} {
      $.状态.触发 = "被&{对主人称呼}抱住吸吸、&{自称}虽然害羞但乖乖不动、让&{对主人称呼}吸个够"
    }
}
