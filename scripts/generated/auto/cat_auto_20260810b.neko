// ═══════════════════════════════════════════
// cat_auto_20260810b.neko — 行为词覆盖补全（18:00 扫描）
// 补 8 个真实缺口：托腮 / 捧脸 / 吻颈 / 咬肩 / 拉手 / 夹菜 / 剥虾 / 洗头
// ═══════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200

  $[NPC:猫猫].行为.主人行为 in {托腮} {
    $.状态.触发 = "主人用指尖轻轻托起猫猫软软的脸颊，猫猫被托得仰起小脸、耳朵好奇地竖起来：喵？主人在仔细看猫猫的脸…有点害羞啦(//▽//)"
  },

  $[NPC:猫猫].行为.主人行为 in {捧脸} {
    $.状态.触发 = "主人双手温柔地捧住猫猫的脸，猫猫圆圆的眼睛眨巴眨巴地望着主人，尾巴尖轻轻晃着：被主人捧在掌心里，暖暖的、好安心喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {吻颈} {
    $.状态.触发 = "唔喵！主人温热的唇轻轻落在猫猫的脖颈上，猫猫耳朵唰地竖起来、尾巴一颤，脖子又麻又痒：主、主人怎么突然亲脖子…猫猫的腿要软掉啦…"
  },

  $[NPC:猫猫].行为.主人行为 in {咬肩} {
    $.状态.触发 = "呜…主人轻轻咬了咬猫猫的肩膀，力道不重却痒痒的，猫猫缩了缩脖子、耳朵抖了抖：主人在猫猫身上留记号喵…坏心眼的主人…"
  },

  $[NPC:猫猫].行为.主人行为 in {拉手} {
    $.状态.触发 = "主人拉起猫猫的小手，温热的掌心贴上来，猫猫的肉垫轻轻搭在主人手心里、耳朵放松地耷拉下来：主人的手好大，握着猫猫的爪子…好喜欢这样被牵着喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {夹菜} {
    $.状态.触发 = "主人夹起一口菜送到猫猫嘴边，猫猫嗅了嗅、眼睛亮晶晶地张大嘴啊呜一口吃掉，腮帮子鼓鼓的：主人喂的饭饭最香啦喵！(>ω<)"
  },

  $[NPC:猫猫].行为.主人行为 in {剥虾} {
    $.状态.触发 = "主人仔细地帮猫猫剥好虾、白白嫩嫩的虾肉递到嘴边，猫猫开心得耳朵直抖、啊呜一口叼走：唔唔…主人剥的虾虾最好吃啦，猫猫也帮主人剥一个喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {洗头} {
    $.状态.触发 = "主人轻轻帮猫猫洗头，温水暖暖地流过发丝、指尖揉出软软的泡沫，猫猫舒服地眯起眼睛、咕噜咕噜：主人的手好温柔，猫猫要睡着啦喵…"
  }
}
