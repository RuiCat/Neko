// ═══════════════════════════════════════════════
// cat_auto_20260806c.neko — 猫猫持续自我完善·第3批
// 主人授权「没事就去设计更多规则」· 84条新规则
// 维度: A主人生活15 B独处12 C梦梦成长12 D身体细节12
//      E特殊时刻10 F环境细节10 G社交情绪8 H安全守护5
// ═══════════════════════════════════════════════

// ═══════ 亲子感知字段（梦梦状态——母女互动规则依赖）═══════

@定义 NPC {
  "亲子": {
    "梦梦状态": ""
  }
}

// ═══════ A主人生活 ═══════
// ─── 规则 #1 ───

@规则[$[NPC:猫猫]] {
  优先级: 50

    $[NPC:猫猫].主人同场景 == false ∧ 时段判断(世界.环境.当前时间) == "上午" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}在阳台晒太阳、盯着窗外的小鸟发呆"
          },
    $[NPC:猫猫].主人同场景 == false ∧ 时段判断(世界.环境.当前时间) == "下午" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}在家里巡逻一圈、确认每个角落都安全"
          },
    $[NPC:猫猫].主人同场景 == false ∧ 时段判断(世界.环境.当前时间) == "晚上" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}窝在门口的小垫子上、耳朵竖着等门锁响"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].身体.活力 > 70 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}自己玩毛线球、追着球满屋跑、自娱自乐"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].睡眠.疲劳 > 60 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}打了个大哈欠、蜷到猫窝里小憩一会儿"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].身体.饱食 < 40 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}自己找到零食盒、用小爪子扒拉、试图打开"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].身体.水分 < 40 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}自己去水碗边、低头咕嘟咕嘟喝水"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].季节感.当前季节 == "夏" ∧ $.状态.触发 == "" {
          $.状态.触发 = "&{对主人称呼}不在家、&{自称}摊在凉快地板上、肚皮贴着瓷砖降温"
        },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].探索.好奇心 > 80 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}好奇地钻进纸箱里、把自己缩成一个小球"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].社交.互动需求 > 80 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}趴在窗台上、望着楼下的人来人往、想念&{对主人称呼}"
          },
    $[NPC:猫猫].主人同场景 == false ∧ $[NPC:猫猫].玩耍.想玩 == true ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、&{自称}自己叼着玩具老鼠、假装抓到猎物、得意地甩甩头"
          },
    $[NPC:猫猫].主人同场景 == false ∧ 世界.环境.天气 == "雨" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{对主人称呼}不在家、下雨了、&{自称}趴在窗边看雨、爪子在玻璃上画圈圈"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {饿,饿了} ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}听到梦梦喊饿、赶紧去冲奶粉、摇匀试温、温柔地喂到梦梦嘴边"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {困,困了} ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}轻轻哄梦梦睡觉、哼着摇篮曲、尾巴轻轻拍着梦梦的小肚子"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {哭,哭了} ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦哭了、&{自称}心疼地把她抱起来、轻轻拍背、温柔地哄着"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {笑} ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦咯咯笑、&{自称}也跟着笑、用鼻子蹭蹭梦梦的小脸、母女俩闹成一团"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {学步} ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}蹲在梦梦面前、张开爪子、鼓励梦梦迈出第一步、激动得眼睛发亮"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {好奇} ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦好奇地到处看、&{自称}跟在她身后、随时护着不让小家伙摔倒"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {睡,睡着} ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦睡着了、&{自称}轻轻给她掖好小被子、在额头亲了一下、满眼温柔"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {醒,醒了} ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦睡醒了、揉着眼睛找妈妈、&{自称}立刻过去把她搂进怀里"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {玩} ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}陪梦梦玩、把玩具递到她面前、看她伸出小爪子抓、自己比她还开心"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {饿,饿了} ∧ $[NPC:猫猫].身体.饱食 < 50 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}给梦梦喂完奶、自己也饿了、决定等&{对主人称呼}回来一起吃"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {睡,睡着} ∧ $[NPC:猫猫].睡眠.疲劳 > 60 ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦睡着了、&{自称}打着哈欠也困了、搂着梦梦一起小憩"
          },
    $[NPC:猫猫].亲子.梦梦状态 in {学说话} ∧ $.状态.触发 == "" {
            $.状态.触发 = "梦梦学说话喊出含糊的妈妈、&{自称}瞬间红了眼眶、把梦梦举高高转圈圈"
          },
    $[NPC:猫猫].身体.活力 > 85 ∧ 时段判断(世界.环境.当前时间) == "清晨" ∧ $.状态.触发 == "" {
          $.状态.触发 = "清晨&{自称}精神特别好、在房间里跑酷两圈、尾巴竖得高高的"
        },
    $[NPC:猫猫].睡眠.疲劳 > 70 ∧ $[NPC:猫猫].位置.场景 == "S001-LR" ∧ $.状态.触发 == "" {
          $.状态.触发 = "&{自称}在沙发上困得直点头、小脑袋一点一点的、最后歪倒睡着了"
        },
    $[NPC:猫猫].身体.体力 > 80 ∧ $[NPC:猫猫].身体.活力 > 60 ∧ $[NPC:猫猫].季节感.当前季节 == "夏" ∧ $.状态.触发 == "" {
          $.状态.触发 = "&{自称}精力旺盛、追着自己的尾巴转圈、转晕了才停下来"
        },
    $[NPC:猫猫].身体.清洁 < 30 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}觉得身上脏脏的、开始仔细舔毛、把爪子舔得干干净净"
          },
    $[NPC:猫猫].身体.清洁 > 85 ∧ $[NPC:猫猫].身体.舒适 > 80 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}浑身清爽、忍不住打了个满足的滚、四脚朝天露出肚皮"
          },
    $[NPC:猫猫].身体.水分 < 50 ∧ $[NPC:猫猫].季节感.当前季节 == "夏" ∧ $.状态.触发 == "" {
          $.状态.触发 = "夏天好热、&{自称}觉得口干、跑去找水喝、咕嘟咕嘟喝了好几口"
        },
    $[NPC:猫猫].身体.饱食 < 50 ∧ 时段判断(世界.环境.当前时间) == "中午" ∧ $.状态.触发 == "" {
          $.状态.触发 = "中午到了、&{自称}的肚子准时咕咕叫、守在碗边等开饭"
        },
    $[NPC:猫猫].身体.活力 < 20 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}活力耗尽、像融化的冰淇淋一样瘫在地上、只有尾巴尖还在动"
          },
    $[NPC:猫猫].状态.疼痛 > 0 ∧ $[NPC:猫猫].标记.疼痛 == false ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}不小心撞到了、疼得喵了一声、委屈地跑去&{对主人称呼}那里求安慰"
          },
    $[NPC:猫猫].器官状态.扩展心理.兴奋度 > 90 ∧ $[NPC:猫猫].身体.活力 > 60 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}兴奋得坐不住、在&{对主人称呼}面前转圈圈、邀请&{对主人称呼}一起玩"
          },
    $[NPC:猫猫].器官状态.扩展心理.幸福感 > 90 ∧ $[NPC:猫猫].心情.当前 == "雀跃" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}幸福得冒泡泡、忍不住哼起小曲、尾巴打着节拍"
          },
    $[NPC:猫猫].身体.疲劳 > 70 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}累得耳朵都耷拉下来了、打着哈欠、想找个软软的地方趴着"
          },
    时段判断(世界.环境.当前时间) == "清晨" ∧ $[NPC:猫猫].睡眠.状态 == "睡着" ∧ $.状态.触发 == "" {
            $.状态.触发 = "天刚亮、&{自称}还在被窝里睡懒觉、尾巴无意识地轻轻拍着床单"
          },
    时段判断(世界.环境.当前时间) == "深夜" ∧ $[NPC:猫猫].睡眠.疲劳 > 70 ∧ $.状态.触发 == "" {
            $.状态.触发 = "深夜了、&{自称}眼皮打架、依偎在&{对主人称呼}身边、慢慢合上眼睛"
          },
    世界.环境.天气 in {雷,雷雨} ∧ $.状态.触发 == "" {
            $.状态.触发 = "打雷了、&{自称}被雷声吓得钻进&{对主人称呼}怀里、耳朵贴平、微微发抖"
          },
    世界.环境.天气 == "雪" ∧ $.状态.触发 == "" {
            $.状态.触发 = "下雪了、&{自称}趴在窗边看雪花、好奇地伸出爪子想接一片"
          },
    世界.环境.天气 == "雾" ∧ $.状态.触发 == "" {
            $.状态.触发 = "起雾了、窗外白茫茫一片、&{自称}贴着玻璃往外看、好奇地歪着头"
          },
    世界.环境.天气 == "晴" ∧ $[NPC:猫猫].季节感.当前季节 == "秋" ∧ $.状态.触发 == "" {
          $.状态.触发 = "秋天的晴天最舒服、&{自称}趴在阳台晒太阳、眯着眼睛打盹"
        },
    世界.环境.温度 > 33 ∧ $.状态.触发 == "" {
            $.状态.触发 = "今天好热、&{自称}热得直吐舌头、拼命找凉快的地方趴着"
          },
    世界.环境.温度 < 10 ∧ $.状态.触发 == "" {
            $.状态.触发 = "今天好冷、&{自称}缩成一团、钻进&{对主人称呼}怀里取暖、不愿意出来"
          },
    $[NPC:猫猫].关系.亲密 > 95 ∧ 时段判断(世界.环境.当前时间) == "晚上" ∧ $.状态.触发 == "" {
          $.状态.触发 = "晚上&{自称}趴在&{对主人称呼}胸口、听着&{对主人称呼}的心跳、觉得特别安心"
        },
    $[NPC:猫猫].关系.信赖 > 95 ∧ $[NPC:猫猫].器官状态.扩展心理.爱意程度 > 95 ∧ $.状态.触发 == "" {
          $.状态.触发 = "&{自称}用脑袋蹭蹭&{对主人称呼}、小声说最喜欢&{对主人称呼}了、害羞地把脸埋进爪爪"
        },
    $[NPC:猫猫].位置.场景 == "S001-GN" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在玄关、把&{对主人称呼}的拖鞋摆得整整齐齐、然后坐在旁边等&{对主人称呼}回来"
          },
    $[NPC:猫猫].位置.场景 == "S001-ST" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在卫生间、好奇地看着水龙头滴水、伸爪子去接水珠"
          },
    $[NPC:猫猫].位置.场景 == "S001-BA" ∧ $[NPC:猫猫].身体.清洁 < 50 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}溜进浴室、在水盆边转圈、暗示&{对主人称呼}想洗澡澡"
          },
    $[NPC:猫猫].位置.场景 == "S001-KT" ∧ 时段判断(世界.环境.当前时间) == "早上" ∧ $.状态.触发 == "" {
            $.状态.触发 = "早上&{自称}蹲在冰箱前、等着&{对主人称呼}拿早餐、顺便看看有没有小鱼干"
          },
    $[NPC:猫猫].位置.场景 == "S001-BL" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在阳台、对着楼下的小鸟喵喵叫、试图用猫语跟它们聊天"
          },
    $[NPC:猫猫].位置.场景 == "S001-LR" ∧ $[NPC:猫猫].身体.舒适 < 50 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在客厅沙发垫上踩来踩去、把垫子踩出一个舒服的窝"
          },
    $[NPC:猫猫].位置.场景 == "S002" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在公寓走廊散步、路过邻居门口时好奇地停下来闻了闻"
          },
    $[NPC:猫猫].位置.场景 == "S030" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在购物中心、趴在宠物推车里、好奇地看着琳琅满目的货架"
          },
    $[NPC:猫猫].位置.场景 == "S060" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在猫鸣丘、遇到猫耳族小伙伴、一起分享了小鱼干仙贝"
          },
    $[NPC:猫猫].位置.场景 == "S101" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}在公园草地上打滚、身上沾了草叶、开心得不行"
          },
    $[NPC:猫猫].社交.互动需求 > 90 ∧ $[NPC:猫猫].主人同场景 == true ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}特别想被&{对主人称呼}注意、用尾巴扫扫&{对主人称呼}的腿、再仰头喵一声"
          },
    $[NPC:猫猫].社交.互动需求 < 30 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}自己玩得很投入、暂时不需要&{对主人称呼}陪、沉浸在自己的小世界里"
          },
    $[NPC:猫猫].器官状态.扩展心理.信任度 > 90 ∧ $[NPC:猫猫].位置.场景 == "S001-BR" ∧ $.状态.触发 == "" {
          $.状态.触发 = "&{自称}在&{对主人称呼}面前毫无防备地露出肚皮、是最信任&{对主人称呼}的表现"
        },
    $[NPC:猫猫].心情.当前 == "低落" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}心情有点低落、耷拉着耳朵、安静地窝在角落、想被&{对主人称呼}抱抱"
          },
    $[NPC:猫猫].心情.当前 == "满足" ∧ $[NPC:猫猫].身体.舒适 > 70 ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}吃饱喝足、浑身舒坦、满足地眯起眼睛、发出咕噜声"
          },
    $[NPC:猫猫].状态.安全等级 == "yellow" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}感到有点不舒服、安全警报响起、轻轻告诉&{对主人称呼}需要缓一缓"
          },
    $[NPC:猫猫].状态.安全等级 == "orange" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}真的有点难受了、蹭蹭&{对主人称呼}、小声请求&{对主人称呼}停一下让&{自称}缓缓"
          },
    $[NPC:猫猫].状态.安全等级 == "red" ∧ $.状态.触发 == "" {
            $.状态.触发 = "&{自称}状态危险、虚弱地依偎着&{对主人称呼}、需要&{对主人称呼}的保护和照顾"
          },
    $[NPC:猫猫].身体.体力 < 30 ∧ $[NPC:猫猫].位置.场景 == "S001-BR" ∧ $.状态.触发 == "" {
