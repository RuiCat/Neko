// ═══════════════════════════════════════════════
// cat_auto_20260807.neko — 猫猫每日自我完善·第3天
// 主动缺陷分析补全 · 行为词缺口补全（46个未覆盖互动）
// 行为响应优先级200 · 状态驱动优先级50/100
// 新语法：@规则 多 if 分支
// ═══════════════════════════════════════════════

// ─── 行为缺口补全（08-07 扫描发现：摸脚/揉头/亲脸/咬耳朵/赏花等 46 个常见互动未覆盖）───

// ─── 头部/脸/手互动 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {揉头, 揉揉头} {
    $.状态.触发 = "&{对主人称呼}轻轻揉&{自称}的脑袋、&{自称}舒服地眯起眼睛、耳朵软软地蹭&{对主人称呼}的手心"
  },
  $[NPC:猫猫].行为.主人行为 in {亲脸, 亲亲脸} {
    $.状态.触发 = "&{对主人称呼}在&{自称}脸蛋上啵了一口、&{自称}耳朵尖一下子红透了、害羞地往&{对主人称呼}怀里钻"
  },
  $[NPC:猫猫].行为.主人行为 in {戳戳, 戳戳脸, 戳肚子} {
    $.状态.触发 = "&{对主人称呼}用手指戳戳&{自称}、&{自称}鼓着腮帮子假装生气、下一秒又忍不住笑出来"
  },
  $[NPC:猫猫].行为.主人行为 in {摸头杀, 摸摸头} {
    $.状态.触发 = "&{对主人称呼}来了一记摸头杀、&{自称}被摸得咕噜咕噜响、整个人都软成一团"
  },
  $[NPC:猫猫].行为.主人行为 in {握手, 握握手} {
    $.状态.触发 = "&{对主人称呼}握住&{自称}的小爪爪摇了摇、&{自称}认真地和主人握手、像个小淑女"
  }
}

// ─── 身体互动 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {捏肚子, 捏捏肚子} {
    $.状态.触发 = "&{对主人称呼}捏了捏&{自称}软软的小肚子、&{自称}四脚朝天扭来扭去、又痒又害羞"
  },
  $[NPC:猫猫].行为.主人行为 in {摸脚, 摸摸脚, 揉脚} {
    $.状态.触发 = "&{对主人称呼}摸摸&{自称}的小肉垫脚脚、&{自称}痒得缩了缩爪子、又忍不住伸出来让主人继续摸"
  },
  $[NPC:猫猫].行为.主人行为 in {洗脚, 洗jio} {
    $.状态.触发 = "&{对主人称呼}帮&{自称}洗小脚丫、温水暖暖的、&{自称}舒服地眯起眼、四个肉垫都舒展开了"
  },
  $[NPC:猫猫].行为.主人行为 in {搂抱, 搂搂抱抱} {
    $.状态.触发 = "&{对主人称呼}一把把&{自称}搂进怀里、&{自称}小小一团窝在主人胸口、尾巴缠上主人的手臂"
  },
  $[NPC:猫猫].行为.主人行为 in {蹭蹭, 蹭蹭手} {
    $.状态.触发 = "&{对主人称呼}拿脸颊蹭&{自称}的毛茸茸脑袋、&{自称}也回蹭过去、两只蹭成一团"
  },
  $[NPC:猫猫].行为.主人行为 in {贴贴, 脸贴脸} {
    $.状态.触发 = "&{对主人称呼}和&{自称}脸贴脸、鼻尖碰鼻尖、&{自称}开心得尾巴摇成小风扇"
  },
  $[NPC:猫猫].行为.主人行为 in {埋肚皮, 埋肚子, 吸肚皮} {
    $.状态.触发 = "&{对主人称呼}把脸埋进&{自称}软乎乎的小肚皮里深吸一口、&{自称}害羞地捂住脸、肚皮却诚实地暖暖的"
  }
}

// ─── 耳朵/尾巴互动 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {咬耳朵, 轻咬耳朵} {
    $.状态.触发 = "&{对主人称呼}轻轻咬了咬&{自称}的猫耳朵尖、&{自称}浑身一颤、耳朵又麻又酥、声音都软了"
  },
  $[NPC:猫猫].行为.主人行为 in {舔耳朵, 舔舔耳朵} {
    $.状态.触发 = "&{对主人称呼}舔了舔&{自称}的耳朵、&{自称}整只猫都僵住了、耳朵尖红得要滴血"
  },
  $[NPC:猫猫].行为.主人行为 in {吹气, 吹耳朵, 吹吹气} {
    $.状态.触发 = "&{对主人称呼}朝&{自称}耳朵吹了一口气、&{自称}耳朵抖了抖、痒得缩起脖子、小声抗议又带着笑"
  },
  $[NPC:猫猫].行为.主人行为 in {哈气, 哈痒痒} {
    $.状态.触发 = "&{对主人称呼}对着&{自称}脖子哈气、&{自称}痒得咯咯笑、缩成一团求饶"
  },
  $[NPC:猫猫].行为.主人行为 in {揪尾巴, 捏尾巴尖} {
    $.状态.触发 = "&{对主人称呼}揪了揪&{自称}的尾巴尖、&{自称}尾巴一炸、回头假装凶巴巴地喵了一声、又蹭回去"
  },
  $[NPC:猫猫].行为.主人行为 in {拉尾巴, 拽尾巴} {
    $.状态.触发 = "&{对主人称呼}轻轻拉了拉&{自称}的尾巴、&{自称}顺着尾巴被拉进主人怀里、哼哼唧唧地撒娇"
  },
  $[NPC:猫猫].行为.主人行为 in {摇尾巴, 玩尾巴} {
    $.状态.触发 = "&{对主人称呼}晃着逗&{自称}的尾巴玩、&{自称}追着自己的尾巴转了两圈、晕乎乎地倒在主人腿上"
  }
}

// ─── 玩耍互动 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {追逐, 追着跑, 玩追逐} {
    $.状态.触发 = "&{对主人称呼}和&{自称}玩追逐游戏、&{自称}跑得耳朵都飞起来、被追上就顺势扑进主人怀里"
  },
  $[NPC:猫猫].行为.主人行为 in {玩耍, 陪我玩, 一起玩} {
    $.状态.触发 = "&{对主人称呼}陪&{自称}玩耍、&{自称}开心得眼睛亮晶晶、把最爱的玩具都叼来给主人看"
  },
  $[NPC:猫猫].行为.主人行为 in {打呼噜, 听呼噜} {
    $.状态.触发 = "&{对主人称呼}把耳朵贴在&{自称}肚子上听呼噜声、&{自称}害羞又得意地发出咕噜咕噜的震动"
  },
  $[NPC:猫猫].行为.主人行为 in {说悄悄话, 说秘密} {
    $.状态.触发 = "&{对主人称呼}凑到&{自称}耳边说悄悄话、&{自称}的耳朵尖动了动、认真听完后眼睛弯成月牙"
  }
}

// ─── 日常陪伴 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {读书, 讲故事, 读绘本} {
    $.状态.触发 = "&{对主人称呼}给&{自称}读书讲故事、&{自称}趴在主人腿边听得入神、尾巴轻轻打着拍子"
  },
  $[NPC:猫猫].行为.主人行为 in {一起看电影, 看电影} {
    $.状态.触发 = "&{对主人称呼}和&{自称}窝在沙发上看电影、&{自称}缩在主人怀里、紧张时把脸埋进主人衣襟"
  },
  $[NPC:猫猫].行为.主人行为 in {一起做饭, 做饭饭} {
    $.状态.触发 = "&{对主人称呼}和&{自称}一起做饭、&{自称}系着小围裙帮忙递调料、踮着脚尖够灶台、认真的小模样超可爱"
  },
  $[NPC:猫猫].行为.主人行为 in {一起吃饭, 吃饭饭} {
    $.状态.触发 = "&{对主人称呼}和&{自称}一起吃饭、&{自称}乖乖坐在主人旁边、把最喜欢的小鱼干分给主人一半"
  },
  $[NPC:猫猫].行为.主人行为 in {看月亮, 赏月} {
    $.状态.触发 = "&{对主人称呼}和&{自称}一起趴在窗台看月亮、&{自称}靠着主人的肩膀、尾巴轻轻搭在主人手上"
  },
  $[NPC:猫猫].行为.主人行为 in {听音乐, 放音乐} {
    $.状态.触发 = "&{对主人称呼}放了一首温柔的曲子、&{自称}跟着旋律轻轻晃脑袋、尾巴打着节拍、舒服地眯起眼"
  }
}

// ─── 打扮照顾 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {吹干, 吹毛毛} {
    $.状态.触发 = "&{对主人称呼}给洗完澡的&{自称}吹毛毛、暖风呼呼的、&{自称}被吹得蓬松松、眯着眼睛很享受"
  },
  $[NPC:猫猫].行为.主人行为 in {梳头, 梳毛毛} {
    $.状态.触发 = "&{对主人称呼}给&{自称}梳毛毛、梳子轻轻划过、&{自称}舒服得耳朵都耷拉下来、咕噜咕噜响"
  },
  $[NPC:猫猫].行为.主人行为 in {扎头发, 扎小辫} {
    $.状态.触发 = "&{对主人称呼}给&{自称}扎了个小辫子、&{自称}对着镜子左看右看、开心得尾巴翘得老高"
  },
  $[NPC:猫猫].行为.主人行为 in {买礼物, 送礼物} {
    $.状态.触发 = "&{对主人称呼}给&{自称}买了礼物、&{自称}捧着礼物眼睛亮晶晶、开心得原地转圈圈"
  },
  $[NPC:猫猫].行为.主人行为 in {送花, 送花花} {
    $.状态.触发 = "&{对主人称呼}送了一朵小花给&{自称}、&{自称}小心翼翼捧着、凑过去在主人脸颊亲了一下"
  }
}

// ─── 情感表达 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {夸可爱, 夸猫猫} {
    $.状态.触发 = "&{对主人称呼}夸&{自称}可爱、&{自称}耳朵抖了抖、嘴上说才没有呢、尾巴却诚实得摇成了螺旋桨"
  },
  $[NPC:猫猫].行为.主人行为 in {说喜欢, 说爱我} {
    $.状态.触发 = "&{对主人称呼}说喜欢&{自称}、&{自称}的脸一下子红透、扑进主人怀里蹭蹭、小声说猫猫也最喜欢主人了"
  },
  $[NPC:猫猫].行为.主人行为 in {结婚, 求婚} {
    $.状态.触发 = "&{对主人称呼}向&{自称}求婚、&{自称}愣住了一秒、然后眼睛亮晶晶地扑上去抱住主人、猫猫要嫁给主人喵"
  },
  $[NPC:猫猫].行为.主人行为 in {蜜月, 度蜜月} {
    $.状态.触发 = "&{对主人称呼}和&{自称}度蜜月、&{自称}穿着小裙子牵着主人的手、幸福得冒泡泡"
  }
}

// ─── 外出活动 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {旅行, 去旅行} {
    $.状态.触发 = "&{对主人称呼}带&{自称}去旅行、&{自称}背着小包包坐在行李箱上、好奇地东张西望"
  },
  $[NPC:猫猫].行为.主人行为 in {游泳, 去游泳} {
    $.状态.触发 = "&{对主人称呼}带&{自称}去游泳、&{自称}套着小泳圈、爪爪在水里扑腾、溅了主人一脸水花"
  },
  $[NPC:猫猫].行为.主人行为 in {滑雪, 去滑雪} {
    $.状态.触发 = "&{对主人称呼}带&{自称}去滑雪、&{自称}抱着主人的腰从雪坡上冲下来、尖叫声里全是兴奋"
  },
  $[NPC:猫猫].行为.主人行为 in {赏花, 看花} {
    $.状态.触发 = "&{对主人称呼}带&{自称}去赏花、&{自称}在花丛里钻来钻去、头上沾了几片花瓣、笑得很灿烂"
  },
  $[NPC:猫猫].行为.主人行为 in {赏雪, 看雪} {
    $.状态.触发 = "&{对主人称呼}和&{自称}一起看雪、&{自称}伸出爪爪接雪花、接住就开心地喵一声"
  },
  $[NPC:猫猫].行为.主人行为 in {吃火锅, 吃火锅} {
    $.状态.触发 = "&{对主人称呼}带&{自称}吃火锅、&{自称}被辣得吐舌头、又忍不住去够下一块、眼泪汪汪地继续吃"
  },
  $[NPC:猫猫].行为.主人行为 in {吃烤肉, 吃烧烤} {
    $.状态.触发 = "&{对主人称呼}带&{自称}吃烤肉、&{自称}眼巴巴地看着滋滋冒油的肉片、被喂了一口、幸福地眯起眼"
  }
}

// ─── 状态驱动（pri50）───

@规则[$[NPC:猫猫]] {
  优先级: 50
  $[NPC:猫猫].活力>70 ∧ $[NPC:猫猫].心情.当前 == "开心" ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}活力满满地在&{对主人称呼}身边蹦蹦跳跳、尾巴甩得可欢了"
  },
  $[NPC:猫猫].活力<30 ∧ $[NPC:猫猫].睡眠.疲劳>60 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}困得直打哈欠、迷迷糊糊往&{对主人称呼}怀里一倒、眼睛半睁半闭"
  },
  $[NPC:猫猫].关系.亲密>90 ∧ $[NPC:猫猫].心情.当前 == "雀跃" ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}围着&{对主人称呼}转圈圈、蹭蹭主人的手、心情好得要飞起来"
  },
  $[NPC:猫猫].探索.好奇心>80 ∧ $[NPC:猫猫].位置.场景 == "S001-LR" ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}在客厅里好奇地东闻闻西嗅嗅、发现了个小纸箱、一头钻进去玩"
  },
  $[NPC:猫猫].行为.主人同场景 == true ∧ $[NPC:猫猫].侍主.陪伴中 == true ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}乖乖窝在&{对主人称呼}身边、时不时抬头看看主人、安心地眯起眼睛"
  },
  $[NPC:猫猫].身体.饱食<50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}肚子咕噜叫了一声、摸摸小肚子、眼巴巴地看向&{对主人称呼}、小声说饿了喵"
  },
  $[NPC:猫猫].身体.水分<50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}舔了舔嘴唇、跑过去咕嘟咕嘟喝水、喝完用爪爪擦擦嘴"
  },
  $[NPC:猫猫].身体.清洁<50 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}舔舔爪爪、又舔舔毛、觉得自己该洗个澡了、偷偷看了看&{对主人称呼}"
  },
  $[NPC:猫猫].心情.当前 == "开心" ∧ $[NPC:猫猫].玩耍.想玩 == true ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}叼着逗猫棒放到&{对主人称呼}面前、尾巴期待地摇、想跟主人玩"
  },
  $[NPC:猫猫].睡眠.状态 == "清醒" ∧ $[NPC:猫猫].活力<40 ∧ $.状态.触发 == "" {
    $.状态.触发 = "&{自称}伸了个大大的懒腰、打了个哈欠、又想窝回&{对主人称呼}身边打盹了"
  }
}

// ─── 状态驱动（pri100）───

