// 环境感受结算（L12，优先级 8530–8539）：客观环境温度 → 主观舒适度与感受词。
@规则[$[环境感受内核]] {
  优先级: 8530
  id: enComfort
  $.代谢.流逝分钟 > 0 {
    $.环境感受.舒适度 = 环境舒适下一步()
  }
}

@规则[$[环境感受内核]] {
  优先级: 8531
  id: enHot
  $.代谢.环境温 >= 280 ∧ $.环境感受.当前感受 != "热" {
    $.环境感受.当前感受 = "热"
  }
}

@规则[$[环境感受内核]] {
  优先级: 8532
  id: enComfortable
  $.代谢.环境温 >= 240 ∧ $.代谢.环境温 < 280 ∧ $.环境感受.当前感受 != "舒适" {
    $.环境感受.当前感受 = "舒适"
  }
}

@规则[$[环境感受内核]] {
  优先级: 8533
  id: enCool
  $.代谢.环境温 >= 200 ∧ $.代谢.环境温 < 240 ∧ $.环境感受.当前感受 != "微凉" {
    $.环境感受.当前感受 = "微凉"
  }
}

@规则[$[环境感受内核]] {
  优先级: 8534
  id: enCold
  $.代谢.环境温 < 200 ∧ $.环境感受.当前感受 != "冷" {
    $.环境感受.当前感受 = "冷"
  }
}
