// 睡眠 tick（优先级 700，早于行为/代谢）。
@规则[$[睡眠内核]] {
  优先级: 700
  id: bSleepFatigue
  $.代谢.流逝分钟 > 0 {
    $.睡眠.疲劳 = 睡眠疲劳下一步()
    $.睡眠.睡眠债 = 睡眠债下一步()
  }
}

// 自动作息（可配置）：疲劳≥90 自动深睡；睡眠债≤5 自动清醒。
@规则[$[睡眠内核]] {
  优先级: 710
  id: bSleepAutoDown
  $.睡眠.自动作息 = true ∧ $.睡眠.状态 = "清醒" ∧ $.睡眠.疲劳 >= 90 {
    $.睡眠.状态 = "深睡"
  }
}

@规则[$[睡眠内核]] {
  优先级: 711
  id: bSleepAutoWake
  $.睡眠.自动作息 = true ∧ $.睡眠.状态 = "深睡" ∧ $.睡眠.睡眠债 <= 5 {
    $.睡眠.状态 = "清醒"
  }
}
