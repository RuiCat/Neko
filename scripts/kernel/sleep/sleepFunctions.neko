// 睡眠计算单元：按 流逝分钟 折算作息；深睡恢复，清醒累积。
@函数 睡眠疲劳下一步() -> int {
  值 = {e}.睡眠.疲劳
  状态 = {e}.睡眠.状态
  if 状态 == "深睡" {
    值 = 值 - 2
  } else if 状态 == "浅睡" {
    值 = 值 - 1
  } else {
    值 = 值 + {e}.代谢.流逝分钟 / 60
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 睡眠债下一步() -> int {
  值 = {e}.睡眠.睡眠债
  状态 = {e}.睡眠.状态
  if 状态 == "深睡" {
    值 = 值 - 3
  } else if 状态 == "浅睡" {
    值 = 值 - 1
  } else {
    值 = 值 + {e}.代谢.流逝分钟 / 120
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
