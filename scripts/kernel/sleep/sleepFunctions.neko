// 睡眠计算单元：按 流逝分钟 折算作息；深睡恢复，清醒累积。
// 判据以「清醒」为准：任何非清醒状态都按睡眠恢复，避免旧数据里的 "睡眠" 等非法枚举
// 落进清醒分支、把疲劳一路顶到 100 锁死。
@函数 睡眠疲劳下一步() -> int {
  值 = {e}.睡眠.疲劳
  状态 = {e}.睡眠.状态
  if 状态 == "清醒" {
    值 = 值 + {e}.代谢.流逝分钟 / 60
  } else if 状态 == "深睡" {
    值 = 值 - 2
  } else {
    值 = 值 - 1
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 睡眠债下一步() -> int {
  值 = {e}.睡眠.睡眠债
  状态 = {e}.睡眠.状态
  if 状态 == "清醒" {
    值 = 值 + {e}.代谢.流逝分钟 / 120
  } else if 状态 == "深睡" {
    值 = 值 - 3
  } else {
    值 = 值 - 1
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
