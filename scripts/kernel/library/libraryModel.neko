// 资料库内核（内容层的类型账本）：旧语料里的模板库按条目拆成实例，规则引擎按类型读取。
// 通用容器 资料库 保留给暂时无法归类的条目；具体类别用下面的专用模板。
@定义 资料库 {
  "名称": "",
  "类别": "",
  "条目": {}
}

// 任务模板：一条可被任务推进引擎消费的任务定义。
@定义 任务模板 {
  "名称": "",
  "类别": "任务",
  "阶段": [],
  "条件": {},
  "奖励": {},
  "对话": {}
}

// 行为模板：一条行为流程定义（前置 / 花费 / 产出 / 步骤 / 效果）。
// 执行语义由后续行为流程引擎读取；这里只定义字段。
@定义 行为模板 {
  "名称": "",
  "类别": "行为",
  "场景": "",
  "需要物品": [],
  "花费[int,min:0,max:1000000]": 0,
  "产出": {},
  "步骤": [],
  "效果": {}
}

// 性行为流程：多阶段流程定义（阶段/步骤/对话），供流程引擎按阶段推进。
@定义 性行为流程 {
  "名称": "",
  "类别": "流程",
  "类型": "",
  "阶段流程": [],
  "步骤": [],
  "对话": {}
}

// 性行为事件：一次事件的结构化记录（阶段流程/对话/结果），与流程分开存放。
@定义 性行为事件 {
  "名称": "",
  "类别": "事件",
  "阶段流程": [],
  "阶段": "",
  "对话": {},
  "结果": ""
}
