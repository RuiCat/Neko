// 路径计算单元（L3 子层）。口/肛/阴道三条路径先做参数化，新增路径只加一个分支。
@函数 路径应力下一步() -> int {
  if {e}.行为.应激输出 > 0 {
    返回 {e}.行为.应激输出
  }
  返回 {e}.路径.应力
}

@函数 路径阈值() -> int {
  值 = {e}.路径.阈值 + {e}.基础.属性.感知 / 20 - {e}.基础.属性.幸运 / 20
  返回 int(值)
}

@函数 路径破口判定() -> bool {
  if {e}.路径.类型 == "无" {
    返回 false
  }
  返回 {e}.路径.应力 >= {e}.路径.屏障阈值
}

@函数 路径屏障下一步() -> int {
  完整 = {e}.路径.屏障完整性
  if {e}.路径.破口 == true {
    完整 = 完整 - {e}.路径.应力 / 10
  }
  if 完整 < 0 {
    完整 = 0
  }
  返回 int(完整)
}

@函数 路径污染下一步() -> int {
  污 = {e}.路径.污染
  if {e}.路径.破口 == true {
    污 = 污 + {e}.路径.菌量
  }
  if 污 > 100 {
    污 = 100
  }
  返回 int(污)
}

@函数 路径出血速率() -> int {
  返回 int({e}.路径.出血系数 * {e}.路径.应力 / 100)
}

@函数 路径应力折算() -> int {
  深 = {e}.路径.穿透深度
  if {e}.路径.破口 == true {
    深 = {e}.路径.应力 / 2
  }
  if 深 > 100 {
    深 = 100
  }
  返回 int(深)
}
