// 路径计算单元（L3 子层）。口/肛/阴道三条路径先做参数化，新增路径只加一个分支。
@函数 路径应力下一步() -> int {
  值 = {e}.路径.应力
  if {e}.行为.应激输出 > 值 {
    值 = {e}.行为.应激输出
  }
  插入 = 路径插入应力()
  if 插入 > 值 {
    值 = 插入
  }
  返回 int(值)
}

// 器官性状的被动撑开应力：按路径类型取对应器官（阴道/口；其余路径暂 0）。
@函数 路径插入应力() -> int {
  类型 = {e}.路径.类型
  值 = 0
  if 类型 == "阴道" {
    值 = {e}.器官性状.阴道.插入应力
  }
  if 类型 == "口" {
    值 = {e}.器官性状.口.插入应力
  }
  返回 int(值)
}

// 器官性状的破口：破口时强制路径破口，不依赖应力是否过阈值。
@函数 路径器官破口() -> bool {
  类型 = {e}.路径.类型
  if 类型 == "阴道" {
    返回 {e}.器官性状.阴道.破口
  }
  if 类型 == "口" {
    返回 {e}.器官性状.口.破口
  }
  返回 false
}

// 器官性状的泄漏量：破口后漏出的内容量，供 L3 记污染。
@函数 路径泄漏量() -> int {
  类型 = {e}.路径.类型
  if 类型 == "阴道" {
    返回 {e}.器官性状.阴道.泄漏量
  }
  if 类型 == "口" {
    返回 {e}.器官性状.口.泄漏量
  }
  返回 0
}

@函数 路径阈值() -> int {
  值 = {e}.路径.阈值 + {e}.基础.属性.感知 / 20 - {e}.基础.属性.幸运 / 20
  返回 int(值)
}

@函数 路径破口判定() -> bool {
  if {e}.路径.类型 == "无" {
    返回 false
  }
  if 路径器官破口() == true {
    返回 true
  }
  返回 {e}.路径.应力 >= {e}.路径.屏障阈值
}

@函数 路径屏障下一步() -> int {
  完整 = {e}.路径.屏障完整性
  if {e}.路径.破口 == true {
    完整 = 完整 - {e}.路径.应力 / 10
  }
  if 完整 < 0 {
    完整 = 0
  }
  返回 int(完整)
}

@函数 路径污染下一步() -> int {
  污 = {e}.路径.污染
  if {e}.路径.破口 == true {
    污 = 污 + {e}.路径.菌量 + 路径泄漏量() / 10
  }
  if 污 > 100 {
    污 = 100
  }
  返回 int(污)
}

@函数 路径出血速率() -> int {
  返回 int({e}.路径.出血系数 * {e}.路径.应力 / 100)
}

@函数 路径应力折算() -> int {
  深 = {e}.路径.穿透深度
  if {e}.路径.破口 == true {
    深 = {e}.路径.应力 / 2
  }
  if 深 > 100 {
    深 = 100
  }
  返回 int(深)
}
