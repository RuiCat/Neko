// 伤害 tick（L3，优先级 4000 段）。出血速率由上层事件写入，这里只做累积与分级。
@规则[$[伤害内核]] {
  优先级: 4200
  id: l3Bleeding
  $.代谢.流逝分钟 > 0 {
    $.伤害.失血量 = 伤害失血下一步()
    $.伤害.休克 = 伤害休克下一步()
    $.伤害.疼痛 = 伤害疼痛下一步()
    $.伤害.感染 = 伤害感染下一步()
    $.伤害.多器官衰竭 = 伤害器官衰竭()
    $.伤害.死亡 = 伤害死亡判定()
    $.伤害.后遗症 = 伤害后遗症()
  }
}

@规则[$[伤害内核]] {
  优先级: 4210
  id: l3BleedDecay
  $.路径.破口 = false {
    $.伤害.出血速率 = 伤害出血衰减()
  }
}

@规则[$[伤害内核]] {
  优先级: 4220
  id: l3WoundHeal
  $.伤害.伤口.伤口数 > 0 ∧ $.伤害.伤口.愈合进度 < 100 ∧ $.代谢.流逝分钟 > 0 {
    $.伤害.伤口.愈合进度 = 伤口愈合下一步({e}.伤害.伤口.愈合进度, {e}.伤害.伤口.严重度, {e}.伤害.伤口.污染, {e}.代谢.流逝分钟)
  }
}

@规则[$[伤害内核]] {
  优先级: 4225
  id: l3WoundClose
  $.伤害.伤口.伤口数 > 0 ∧ $.伤害.伤口.愈合进度 >= 100 {
    $.伤害.伤口.严重度 = 0
    $.伤害.伤口.污染 = 0
    $.伤害.伤口.愈合进度 = 0
    $.伤害.伤口.伤口数 = 0
  }
}
