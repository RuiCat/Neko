// 伤害结算单元（L3）。
@函数 伤害失血下一步() -> int {
  量 = {e}.伤害.失血量 + {e}.伤害.出血速率 * {e}.代谢.流逝分钟 / 60
  if 量 < 0 {
    量 = 0
  }
  if 量 > 100 {
    量 = 100
  }
  返回 int(量)
}

@函数 伤害休克下一步() -> int {
  失 = {e}.伤害.失血量
  if 失 < 15 {
    返回 0
  }
  值 = (失 - 15) * 2
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 伤害疼痛下一步() -> int {
  值 = {e}.伤害.失血量 * 2 + {e}.路径.应力 / 2
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 伤害感染下一步() -> int {
  值 = {e}.伤害.感染
  if {e}.路径.破口 == true {
    值 = 值 + {e}.路径.污染 / 10
  } else {
    值 = 值 - (1 + {e}.基础.属性.体质 / 50)
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

// 器官功能缺损：五个关键器官功能缺损的加权均值（按 器官基础.*.质量占比，缺省 0 时退化为等权）。
// 它只描述「此刻的功能缺损」，主要由灌注决定（功能 = 完整性 × 灌注 / 100），
// 因此不能直接当作 MODS —— 脱水导致灌注 47 时它必然 53，但那不是器官衰竭。
@函数 伤害器官缺损() -> int {
  分 = (100 - {e}.器官.脑.功能) * {e}.器官基础.脑.质量占比
  分 = 分 + (100 - {e}.器官.心.功能) * {e}.器官基础.心.质量占比
  分 = 分 + (100 - {e}.器官.肺.功能) * {e}.器官基础.肺.质量占比
  分 = 分 + (100 - {e}.器官.肝.功能) * {e}.器官基础.肝.质量占比
  分 = 分 + (100 - {e}.器官.肾.功能) * {e}.器官基础.肾.质量占比
  总 = {e}.器官基础.脑.质量占比 + {e}.器官基础.心.质量占比 + {e}.器官基础.肺.质量占比
  总 = 总 + {e}.器官基础.肝.质量占比 + {e}.器官基础.肾.质量占比
  if 总 <= 0 {
    总 = 5
  }
  返回 int(分 / 总)
}

// 旧名兼容：等价于缺损均值，不参与 MODS 累积（保留给外部/旧内容调用）。
@函数 伤害器官衰竭() -> int {
  返回 伤害器官缺损()
}

// 多器官衰竭（MODS）：独立的损伤累积量，不再是「100 − 灌注」的快照。
// 各驱动阈值读 判定阈值.应激*；终局判定读 判定阈值.死亡*。
// 驱动（任一成立即累积）：五器官结构性应力 > 0（真实组织损伤）、感染 ≥60、休克 ≥60、灌注 <40。
// 恢复：四个驱动都不成立时每 tick −1。
// 阈值取 40 而非 50：纯脱水的地板灌注约 47，整数除法后不产生累积，
// 只有合并失血等把灌注压到 40 以下才进入衰竭语义（此时缺器官功能也确实崩了）。
@函数 伤害器官衰竭下一步() -> int {
  值 = {e}.伤害.多器官衰竭
  应力 = {e}.器官.脑.应力
  应力 = 应力 + {e}.器官.心.应力
  应力 = 应力 + {e}.器官.肺.应力
  应力 = 应力 + {e}.器官.肝.应力
  应力 = 应力 + {e}.器官.肾.应力
  // 肠/食管屏障：路径规则实际写入的是这两个（五关键器官的应力恒为 0，见 pathTick 3990）。
  // 黏膜屏障破坏 → 细菌移位 → 脓毒 → MODS，是真实链条，按半权重计入。
  屏障 = {e}.器官.直肠.应力 + {e}.器官.食管.应力
  驱动 = 0
  if 应力 > 0 {
    值 = 值 + 应力 / 25
    驱动 = 1
  }
  if 屏障 > 0 {
    值 = 值 + 屏障 / 50
    驱动 = 1
  }
  if {e}.伤害.感染 >= {e}.判定阈值.应激感染 {
    值 = 值 + 1
    驱动 = 1
  }
  if {e}.伤害.休克 >= {e}.判定阈值.应激休克 {
    值 = 值 + 2
    驱动 = 1
  }
  if {e}.循环.灌注 < {e}.判定阈值.应激灌注 {
    值 = 值 + ({e}.判定阈值.应激灌注 - {e}.循环.灌注) / 5
    驱动 = 1
  }
  if 驱动 == 0 {
    值 = 值 - 1
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

// 必需器官失效：由 器官基础.<器官>.必需 驱动，不再硬编码器官列表。
// 当前必需=true 的器官：脑/心/肺/肝/肾/皮肤（baseModel 数据决定；改数据即改判定）。
@函数 伤害必需器官失效() -> bool {
  if {e}.器官基础.脑.必需 == true ∧ {e}.器官.脑.完整性 <= 0 {
    返回 true
  }
  if {e}.器官基础.心.必需 == true ∧ {e}.器官.心.完整性 <= 0 {
    返回 true
  }
  if {e}.器官基础.肺.必需 == true ∧ {e}.器官.肺.完整性 <= 0 {
    返回 true
  }
  if {e}.器官基础.肝.必需 == true ∧ {e}.器官.肝.完整性 <= 0 {
    返回 true
  }
  if {e}.器官基础.肾.必需 == true ∧ {e}.器官.肾.完整性 <= 0 {
    返回 true
  }
  if {e}.器官基础.皮肤.必需 == true ∧ {e}.器官.皮肤.完整性 <= 0 {
    返回 true
  }
  返回 false
}

// 终局判定：休克 100 / MODS ≥90 / 灌注 ≤5 任一成立即死亡。
@函数 伤害死亡判定() -> bool {
  if {e}.伤害.休克 >= {e}.判定阈值.死亡休克 {
    返回 true
  }
  if {e}.伤害.多器官衰竭 >= {e}.判定阈值.死亡衰竭 {
    返回 true
  }
  if {e}.循环.灌注 <= {e}.判定阈值.死亡灌注 {
    返回 true
  }
  if 伤害必需器官失效() == true {
    返回 true
  }
  if {e}.基础.年龄 > {e}.种族参数.寿命 {
    返回 true
  }
  返回 false
}

// 后遗症：一旦写入不再覆盖；按感染/失血/关键器官完整性判定。
@函数 伤害后遗症() -> str {
  旧 = {e}.伤害.后遗症
  if 旧 != "" {
    返回 旧
  }
  if {e}.伤害.感染 >= {e}.判定阈值.后遗症感染 {
    返回 "脓毒后遗症"
  }
  if {e}.伤害.失血量 >= 80 {
    返回 "慢性贫血"
  }
  if {e}.器官.脑.完整性 < 30 {
    返回 "神经损伤"
  }
  return ""
}

// 无破口时出血速率自然衰减（分娩出血等一次性写入据此收口）。
@函数 伤害出血衰减() -> int {
  值 = {e}.伤害.出血速率 - 5
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

// 摄入中毒风险折算：规则里不写「路径 / 常数」算术（会被存成字符串），统一收进函数。
@函数 感染摄入下一步(当前:int, 风险:int) -> int {
  返回 int(当前 + 风险 / 2)
}

@函数 疼痛摄入下一步(当前:int, 风险:int) -> int {
  返回 int(当前 + 风险 / 10)
}

// 伤口愈合：进度百分比；基准 25%/天（严重度>50 降为 15%/天），污染按 100/(100+污染) 折减。
// 只做结算，不创建伤口；伤口由上层写入 伤害.伤口.*（数量/严重度/污染）。
@函数 伤口愈合下一步(进度:int, 严重度:int, 污染:int, 分钟:int) -> int {
  速率 = 25
  if 严重度 > 50 {
    速率 = 15
  }
  if 污染 > 0 {
    速率 = int(速率 * 100 / (100 + 污染))
  }
  增量 = int(速率 * 分钟 / 1440)
  值 = 进度 + 增量
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
