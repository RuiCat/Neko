// 伤害结算单元（L3）。
@函数 伤害失血下一步() -> int {
  量 = {e}.伤害.失血量 + {e}.伤害.出血速率 * {e}.代谢.流逝分钟 / 60
  if 量 < 0 {
    量 = 0
  }
  if 量 > 100 {
    量 = 100
  }
  返回 int(量)
}

@函数 伤害休克下一步() -> int {
  失 = {e}.伤害.失血量
  if 失 < 15 {
    返回 0
  }
  值 = (失 - 15) * 2
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 伤害疼痛下一步() -> int {
  值 = {e}.伤害.失血量 * 2 + {e}.路径.应力 / 2
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 伤害感染下一步() -> int {
  值 = {e}.伤害.感染
  if {e}.路径.破口 == true {
    值 = 值 + {e}.路径.污染 / 10
  } else {
    值 = 值 - (1 + {e}.基础.属性.体质 / 50)
  }
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

// 多器官衰竭：五个关键器官功能缺损的均值。
// 多器官衰竭：按 器官基础.*.质量占比 加权（缺省 0 时退化为等权）。
@函数 伤害器官衰竭() -> int {
  分 = (100 - {e}.器官.脑.功能) * {e}.器官基础.脑.质量占比
  分 = 分 + (100 - {e}.器官.心.功能) * {e}.器官基础.心.质量占比
  分 = 分 + (100 - {e}.器官.肺.功能) * {e}.器官基础.肺.质量占比
  分 = 分 + (100 - {e}.器官.肝.功能) * {e}.器官基础.肝.质量占比
  分 = 分 + (100 - {e}.器官.肾.功能) * {e}.器官基础.肾.质量占比
  总 = {e}.器官基础.脑.质量占比 + {e}.器官基础.心.质量占比 + {e}.器官基础.肺.质量占比
  总 = 总 + {e}.器官基础.肝.质量占比 + {e}.器官基础.肾.质量占比
  if 总 <= 0 {
    总 = 5
  }
  返回 int(分 / 总)
}

// 必需器官（基础.必需=true 的五个）任一完整性归零即失效。
@函数 伤害必需器官失效() -> bool {
  if {e}.器官.脑.完整性 <= 0 {
    返回 true
  }
  if {e}.器官.心.完整性 <= 0 {
    返回 true
  }
  if {e}.器官.肺.完整性 <= 0 {
    返回 true
  }
  if {e}.器官.肝.完整性 <= 0 {
    返回 true
  }
  if {e}.器官.肾.完整性 <= 0 {
    返回 true
  }
  返回 false
}

// 终局判定：休克 100 / MODS ≥90 / 灌注 ≤5 任一成立即死亡。
@函数 伤害死亡判定() -> bool {
  if {e}.伤害.休克 >= 100 {
    返回 true
  }
  if {e}.伤害.多器官衰竭 >= 90 {
    返回 true
  }
  if {e}.循环.灌注 <= 5 {
    返回 true
  }
  if 伤害必需器官失效() == true {
    返回 true
  }
  if {e}.基础.年龄 > {e}.种族参数.寿命 {
    返回 true
  }
  返回 false
}

// 后遗症：一旦写入不再覆盖；按感染/失血/关键器官完整性判定。
@函数 伤害后遗症() -> str {
  旧 = {e}.伤害.后遗症
  if 旧 != "" {
    返回 旧
  }
  if {e}.伤害.感染 >= 70 {
    返回 "脓毒后遗症"
  }
  if {e}.伤害.失血量 >= 80 {
    返回 "慢性贫血"
  }
  if {e}.器官.脑.完整性 < 30 {
    返回 "神经损伤"
  }
  return ""
}

// 无破口时出血速率自然衰减（分娩出血等一次性写入据此收口）。
@函数 伤害出血衰减() -> int {
  值 = {e}.伤害.出血速率 - 5
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

// 摄入中毒风险折算：规则里不写「路径 / 常数」算术（会被存成字符串），统一收进函数。
@函数 感染摄入下一步(当前:int, 风险:int) -> int {
  返回 int(当前 + 风险 / 2)
}

@函数 疼痛摄入下一步(当前:int, 风险:int) -> int {
  返回 int(当前 + 风险 / 10)
}
