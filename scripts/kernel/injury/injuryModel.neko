// 伤害内核（L3）：出血 / 失血 / 休克 / 感染。只做结算，不判定来源。
@定义 伤害内核 {
  "伤害": {
    "出血速率[int,min:0,max:200]": 0,
    "失血量[int,min:0,max:100]": 0,
    "休克[int,min:0,max:100,@事件休克]": 0,
    "感染[int,min:0,max:100,@事件脓毒]": 0,
    "疼痛[int,min:0,max:100]": 0,
    "多器官衰竭[int,min:0,max:100]": 0,
    "死亡[bool,@事件死亡]": false,
    "后遗症[str]": ""
  }
}
