// 路径内核（L3 子层）：一条行为路径上的屏障状态。
// 类型决定阈值/菌量/出血系数；应力由上层行为写入，本层只做结算。
@定义 路径内核 {
  "路径": {
    "类型[str]": "无",
    "应力[int,min:0,max:100]": 0,
    "屏障阈值[int,min:0,max:100]": 100,
    "屏障完整性[int,min:0,max:100]": 100,
    "破口[bool]": false,
    "污染[int,min:0,max:100]": 0,
    "穿透深度[int,min:0,max:100]": 0,
    "阈值[int,min:0,max:100]": 100,
    "菌量[int,min:0,max:20]": 0,
    "出血系数[int,min:0,max:100]": 0
  }
}
