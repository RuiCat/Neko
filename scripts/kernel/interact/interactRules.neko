// 交互结算（L6 物品层，7100–7290 段）：角色 × 素材的多主体规则。
// 结算顺序：拾取/放下/给予/查看/使用/穿戴 → 吃/喝 → 兜底失败（7900）。
// 物品侧字段由 $2 写入，角色侧字段由 $1 写入；吃/喝/用/穿之前必须已拾取（先持有再使用）。
// 多主体条件不使用括号分组的 ∨（该写法在条件解析里不成立），需要「二选一」时拆成两条规则。
// 多主体规则头必须用全角逗号 `，` 分隔（parserRule.go:71 只按 `，` 切分）。
@规则[$1[交互内核]，$2[素材]] {
  优先级: 7100
  id: ixPickup
  $1.交互.动作 = "拾取" ∧ $2.名称 = $1.交互.目标 ∧ $2.持有人 = "" ∧ $2.所属场景 = $1.位置.场景 ∧ $1.基础.名字 != "" {
    $2.持有人 = $1.基础.名字
    $1.交互.状态 = "完成"
    $1.交互.结果 = "拿在手里"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

@规则[$1[交互内核]，$2[素材]] {
  优先级: 7110
  id: ixDrop
  $1.交互.动作 in {放下, 丢弃} ∧ $2.名称 = $1.交互.目标 ∧ $2.持有人 = $1.基础.名字 {
    $2.持有人 = ""
    $2.所属场景 = $1.位置.场景
    $1.交互.状态 = "完成"
    $1.交互.结果 = "放回了场景"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

@规则[$1[交互内核]，$2[素材]] {
  优先级: 7120
  id: ixGive
  $1.交互.动作 = "给予" ∧ $2.名称 = $1.交互.目标 ∧ $2.持有人 = $1.基础.名字 ∧ $1.交互.对象 != "" {
    $2.持有人 = $1.交互.对象
    $1.交互.状态 = "完成"
    $1.交互.结果 = "交给了对方"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
    $1.交互.对象 = ""
  }
}

@规则[$1[交互内核]，$2[素材]] {
  优先级: 7130
  id: ixInspect
  $1.交互.动作 = "查看" ∧ $2.名称 = $1.交互.目标 ∧ $2.持有人 = $1.基础.名字 {
    $1.交互.状态 = "完成"
    $1.交互.结果 = $2.描述
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

@规则[$1[交互内核]，$2[素材]] {
  优先级: 7135
  id: ixInspectScene
  $1.交互.动作 = "查看" ∧ $2.名称 = $1.交互.目标 ∧ $2.持有人 = "" ∧ $2.所属场景 = $1.位置.场景 {
    $1.交互.状态 = "完成"
    $1.交互.结果 = $2.描述
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

// 通用使用：耐久 -1；具体效果（药物/刀/绳索）由上层按 标签/效果 再结算。
@规则[$1[交互内核]，$2[素材]] {
  优先级: 7140
  id: ixUse
  $1.交互.动作 = "使用" ∧ $2.名称 = $1.交互.目标 ∧ $2.可用 = true ∧ $2.持有人 = $1.基础.名字 {
    $2.耐久 -= 1
    $1.交互.状态 = "完成"
    $1.交互.结果 = "用过了"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

@规则[$1[交互内核]，$2[衣物]] {
  优先级: 7150
  id: ixWear
  $1.交互.动作 = "穿戴" ∧ $2.名称 = $1.交互.目标 ∧ $2.衣物.已穿戴 = false ∧ $2.持有人 = $1.基础.名字 {
    $2.衣物.已穿戴 = true
    $1.交互.状态 = "完成"
    $1.交互.结果 = "穿好了"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

@规则[$1[交互内核]，$2[衣物]] {
  优先级: 7160
  id: ixWearOff
  $1.交互.动作 = "脱下" ∧ $2.名称 = $1.交互.目标 ∧ $2.衣物.已穿戴 = true {
    $2.衣物.已穿戴 = false
    $1.交互.状态 = "完成"
    $1.交互.结果 = "脱下来了"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

// 吃：数量 -1，热量进胃内容（下个 tick 由 L0 吸收），中毒风险按「肠道感染」入账。
@规则[$1[交互内核]，$2[食物]] {
  优先级: 7200
  id: ixEat
  $1.交互.动作 = "吃" ∧ $2.名称 = $1.交互.目标 ∧ $2.数量 > 0 ∧ $2.食物.可食 = true ∧ $2.持有人 = $1.基础.名字 {
    $2.数量 -= 1
    $1.器官性状.胃.内容 = 内容追加($1.器官性状.胃.内容, "食物", $2.食物.水分, $2.食物.热量, $2.食物.水分, 220)
    $1.伤害.感染 = 感染摄入下一步($1.伤害.感染, $2.食物.中毒风险)
    $1.伤害.疼痛 = 疼痛摄入下一步($1.伤害.疼痛, $2.食物.中毒风险)
    $1.交互.状态 = "完成"
    $1.交互.结果 = "吃掉了"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

// 喝：水分进摄入液（下个 tick 由 L0 结算体液），酒精直接进代谢.酒精。
@规则[$1[交互内核]，$2[饮品]] {
  优先级: 7210
  id: ixDrink
  $1.交互.动作 = "喝" ∧ $2.名称 = $1.交互.目标 ∧ $2.数量 > 0 ∧ $2.饮品.可饮 = true ∧ $2.持有人 = $1.基础.名字 {
    $2.数量 -= 1
    $1.器官性状.胃.内容 = 内容追加($1.器官性状.胃.内容, "水", $2.饮品.水分, 0, $2.饮品.水分, $2.饮品.温度)
    $1.代谢.酒精 += $2.饮品.酒精
    $1.交互.状态 = "完成"
    $1.交互.结果 = "喝完了"
    $1.交互.动作 = ""
    $1.交互.目标 = ""
  }
}

// 兜底：动作还在 = 没有素材对得上（目标不存在/不可用/不在同一场景），标记失败并清空意图。
@规则[$[交互内核]] {
  优先级: 7900
  id: ixUnresolved
  $.交互.动作 in {拾取, 放下, 丢弃, 给予, 查看, 使用, 穿戴, 脱下, 吃, 喝} {
    $.交互.状态 = "失败"
    $.交互.结果 = "无法完成：目标不可用"
    $.交互.动作 = ""
    $.交互.目标 = ""
    $.交互.对象 = ""
  }
}
