// 交互内核：角色「下一步做什么」的意图与结算结果。
// 上层（行为/LLM/脚本）只写 动作/目标/对象/数量；本层在同一个 tick 内校验并结算，
// 结算后清空意图，避免同一动作被重复执行。目标用素材的 名称（同场景内唯一）。
@定义 交互内核 {
  "交互": {
    "动作": "",
    "目标": "",
    "对象": "",
    "数量[int,min:1,max:99]": 1,
    "状态": "空闲",
    "结果": "",
    "推送": {
      "待发": "",
      "消息": "",
      "通道": "主会话",
      "版本[int,min:0,max:1000000]": 0,
      "时间[int,min:0,max:1000000]": 0
    }
  }
}
