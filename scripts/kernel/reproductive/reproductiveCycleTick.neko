// 周期推进（L4，优先级 5100）：把 代谢.流逝分钟 折算成日进度，推进周期日 / 周期相位并重算受孕窗口。
// 顺序敏感：先写周期分钟，再派生周期日 / 相位 / 窗口——后面三个都读周期分钟的新值。
@规则[$[生殖内核]] {
  优先级: 5100
  id: l4Cycle
  $.代谢.流逝分钟 > 0 ∧ $.生殖.怀孕状态 = "未孕" {
    $.生殖.周期分钟 = 生殖周期分钟下一步()
    $.生殖.周期日 = 生殖周期日下一步()
    $.生殖.周期相位 = 生殖周期相位下一步()
    $.生殖.受孕窗口 = 生殖受孕窗口下一步()
  }
}
