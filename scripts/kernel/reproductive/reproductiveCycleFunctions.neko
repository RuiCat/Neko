// 周期计算单元（L4）：按 代谢.流逝分钟 折算日进度，给出周期日 / 相位 / 受孕窗口的下一步值。
// 只读，不写字段；写入由 reproductiveCycleTick 负责。
// 周期长度取 种族参数.周期天（犬娘 21 / 狐娘 24 / 精灵 35），不再写死 28。

// 周期天兜底：部分组合或旧实体可能缺失该字段，缺失时按人族 28 天。
@函数 生殖周期天() -> int {
  天 = {e}.种族参数.周期天
  if 天 < 1 {
    返回 28
  }
  返回 int(天)
}

// 周期按「累积分钟」推进，不按「每 tick 多少天」。
// 旧实现用 int(流逝分钟 / 1440)：默认 tick 60 分钟时恒为 0，周期永远停在周期日 0，
// 受孕窗口也就永远不成立。改为累积 生殖.周期分钟，跨 tick 累加后整除成天，
// 并在一个周期长度处取模循环。1440 分钟/tick 时行为与旧实现一致。
@函数 生殖周期分钟下一步() -> int {
  总 = 生殖周期天() * 1440
  值 = {e}.生殖.周期分钟 + {e}.代谢.流逝分钟
  值 = 值 % 总
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 生殖周期日下一步() -> int {
  日 = int({e}.生殖.周期分钟 / 1440)
  if 日 < 0 {
    日 = 0
  }
  if 日 >= 生殖周期天() {
    日 = 生殖周期天() - 1
  }
  返回 int(日)
}

@函数 生殖周期相位下一步() -> int {
  相位 = int({e}.生殖.周期日 * 100 / 生殖周期天())
  if 相位 < 0 {
    相位 = 0
  }
  if 相位 > 99 {
    相位 = 99
  }
  返回 int(相位)
}

// 受孕窗口按周期长度的比例给出：36%–58%（28 天 → 第 10–16 天，与原实现一致）。
// 注意：`.neko` 的 `/` 是浮点除法，边界必须套 int() 才能得到向下取整的整日。
// 21 天 → 7–12；24 天 → 8–13；35 天 → 12–20。
@函数 生殖受孕窗口下一步() -> bool {
  日 = {e}.生殖.周期日
  起点 = int(生殖周期天() * 36 / 100)
  终点 = int(生殖周期天() * 58 / 100)
  返回 日 >= 起点 and 日 <= 终点
}
