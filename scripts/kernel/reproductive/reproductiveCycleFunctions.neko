// 周期计算单元（L4）：按 代谢.流逝分钟 折算日进度，给出周期日 / 相位 / 受孕窗口的下一步值。
// 只读，不写字段；写入由 reproductiveCycleTick 负责。
@函数 生殖周期日下一步() -> int {
  增量 = int({e}.代谢.流逝分钟 / 1440)
  日 = {e}.生殖.周期日 + 增量
  日 = 日 % 28
  if 日 < 0 {
    日 = 0
  }
  返回 int(日)
}

@函数 生殖周期相位下一步() -> int {
  相位 = int({e}.生殖.周期日 * 100 / 28)
  if 相位 < 0 {
    相位 = 0
  }
  if 相位 > 99 {
    相位 = 99
  }
  返回 int(相位)
}

@函数 生殖受孕窗口下一步() -> bool {
  日 = {e}.生殖.周期日
  返回 日 >= 10 and 日 <= 16
}
