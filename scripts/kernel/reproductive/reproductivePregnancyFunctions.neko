// 妊娠计算单元（L4）：孕周推进与孕期状态词。
// 时间口径：流逝分钟每满 1440（1 天）推进 1 个孕周单位。
// 引擎约束：流逝分钟 单 tick ≤1440，模板又没有分钟累加字段，按「7 天 = 1 周」会每次整除为 0、
// 永远不推进；因此本层采用「1 天 = 1 孕周单位」的压缩口径。若需医学口径，需冻结新的累加字段。
@函数 生殖孕期分钟下一步() -> int {
  状态 = {e}.生殖.怀孕状态
  值 = {e}.生殖.孕期分钟
  if 状态 == "早孕" ∨ 状态 == "中孕" ∨ 状态 == "晚孕" {
    值 = 值 + {e}.代谢.流逝分钟
  }
  if 值 > 604800 {
    值 = 604800
  }
  返回 int(值)
}

@函数 生殖孕周由分钟() -> int {
  返回 int({e}.生殖.孕期分钟 / 10080)
}

@函数 生殖孕周下一步() -> int {
  周 = {e}.生殖.孕周 + int({e}.代谢.流逝分钟 / 1440)
  if 周 > 42 {
    周 = 42
  }
  返回 int(周)
}

@函数 生殖孕期状态下一步() -> str {
  周 = {e}.生殖.孕周
  if 周 >= 40 {
    返回 "产后"
  }
  if 周 >= 28 {
    返回 "晚孕"
  }
  if 周 >= 14 {
    返回 "中孕"
  }
  返回 "早孕"
}

// 孕期附加能量需求（kcal/日）：中孕 +340、晚孕 +452、哺乳 +500（2021 EER 量级）。
@函数 生殖能量需求() -> int {
  状态 = {e}.生殖.怀孕状态
  if 状态 == "中孕" {
    返回 340
  }
  if 状态 == "晚孕" {
    返回 452
  }
  if 状态 == "产后" {
    返回 500
  }
  返回 0
}

// 孕期血容量扩张：中孕 130%、晚孕 145%，产后回落 100%。
@函数 生殖血容量系数() -> int {
  状态 = {e}.生殖.怀孕状态
  if 状态 == "中孕" {
    返回 130
  }
  if 状态 == "晚孕" {
    返回 145
  }
  return 100
}

// ---- 妊娠并发症 ----
@函数 生殖子痫下一步() -> int {
  if {e}.生殖.怀孕状态 == "未孕" {
    返回 0
  }
  值 = {e}.生殖.子痫前期
  if {e}.生殖.孕周 >= 28 {
    值 = 值 + 2
  } else if {e}.生殖.孕周 >= 20 {
    值 = 值 + 1
  } else {
    值 = 值 - 1
  }
  if {e}.循环.收缩压 >= 140 {
    值 = 值 + 2
  }
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 生殖早剥下一步() -> int {
  if {e}.生殖.怀孕状态 == "未孕" {
    返回 0
  }
  值 = {e}.生殖.胎盘早剥
  if {e}.路径.应力 >= 70 {
    值 = 值 + {e}.路径.应力 / 20
  } else {
    值 = 值 - 1
  }
  if 值 < 0 {
    值 = 0
  }
  return int(值)
}

@函数 生殖破裂下一步() -> int {
  if {e}.生殖.怀孕状态 == "未孕" {
    返回 0
  }
  值 = {e}.生殖.子宫破裂
  if {e}.器官.子宫.完整性 < 40 {
    值 = 值 + 10
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 生殖并发症出血() -> int {
  值 = {e}.伤害.出血速率
  if {e}.生殖.胎盘早剥 >= 50 ∧ 值 < 30 {
    值 = 30
  }
  if {e}.生殖.子宫破裂 >= 50 ∧ 值 < 60 {
    值 = 60
  }
  返回 int(值)
}

@函数 生殖并发症文本() -> str {
  if {e}.生殖.子宫破裂 >= 50 {
    返回 "子宫破裂"
  }
  if {e}.生殖.胎盘早剥 >= 50 {
    返回 "胎盘早剥"
  }
  if {e}.生殖.子痫前期 >= 60 {
    返回 "子痫前期"
  }
  return ""
}
