// 妊娠推进（L4，优先级 5200–5220）：孕期推进孕周；5400 按孕周迁移状态词（孕周≥40 → 产后）。
// 拆成三条单条件规则：引擎对「∧ + 括号内 ∨」的复合条件实测不稳，单条件最可靠。
@规则[$[生殖内核]] {
  优先级: 5190
  id: l4PregnancyMinutes
  $.代谢.流逝分钟 > 0 {
    $.生殖.孕期分钟 = 生殖孕期分钟下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5200
  id: l4WeeksEarly
  $.生殖.怀孕状态 = "早孕" {
    $.生殖.孕周 = 生殖孕周由分钟()
  }
}

@规则[$[生殖内核]] {
  优先级: 5210
  id: l4WeeksMid
  $.生殖.怀孕状态 = "中孕" {
    $.生殖.孕周 = 生殖孕周由分钟()
  }
}

@规则[$[生殖内核]] {
  优先级: 5220
  id: l4WeeksLate
  $.生殖.怀孕状态 = "晚孕" {
    $.生殖.孕周 = 生殖孕周由分钟()
  }
}

@规则[$[生殖内核]] {
  优先级: 5400
  id: l4PregnancyStage
  $.生殖.怀孕状态 = "早孕" {
    $.生殖.怀孕状态 = 生殖孕期状态下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5410
  id: l4PregnancyStageMid
  $.生殖.怀孕状态 = "中孕" {
    $.生殖.怀孕状态 = 生殖孕期状态下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5420
  id: l4PregnancyStageLate
  $.生殖.怀孕状态 = "晚孕" {
    $.生殖.怀孕状态 = 生殖孕期状态下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5350
  id: l4PregnancyPhysiology
  $.代谢.流逝分钟 > 0 {
    $.生殖.能量需求 = 生殖能量需求()
    $.生殖.血容量系数 = 生殖血容量系数()
  }
}

// 分娩出血：进入产后且未结算时一次性给出血速率（20 mL/min），随后由伤害层累积。
@规则[$[生殖内核]] {
  优先级: 5450
  id: l4DeliveryBleed
  $.生殖.怀孕状态 = "产后" ∧ $.生殖.分娩已结算 = false {
    $.生殖.分娩出血 = 20
    $.伤害.出血速率 = 20
    $.生殖.分娩已结算 = true
  }
}

@规则[$[生殖内核]] {
  优先级: 5320
  id: l4Preeclampsia
  $.代谢.流逝分钟 > 0 {
    $.生殖.子痫前期 = 生殖子痫下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5330
  id: l4Abruption
  $.代谢.流逝分钟 > 0 {
    $.生殖.胎盘早剥 = 生殖早剥下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5340
  id: l4UterineRupture
  $.代谢.流逝分钟 > 0 {
    $.生殖.子宫破裂 = 生殖破裂下一步()
  }
}

@规则[$[生殖内核]] {
  优先级: 5360
  id: l4ComplicationText
  $.代谢.流逝分钟 > 0 {
    $.生殖.并发症 = 生殖并发症文本()
    $.伤害.出血速率 = 生殖并发症出血()
  }
}
