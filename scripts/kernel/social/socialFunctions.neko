// 社交域计算单元（L12）。互动需求随时间累积，被主人互动消耗则下降。
@函数 社交需求下一步() -> int {
  值 = {e}.社交.互动需求 + int({e}.代谢.流逝分钟 / 30) - {e}.社交.主人互动 / 10
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 社交主人互动衰减() -> int {
  值 = {e}.社交.主人互动 - int({e}.代谢.流逝分钟 / 60)
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 社交孤单() -> int {
  值 = {e}.社交.互动需求 - 60
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
