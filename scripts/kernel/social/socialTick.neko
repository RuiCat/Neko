// 社交结算（L12，优先级 8510–8519）。
// 互动需求累积 → 想被摸/孤单派生；主人互动每 tick 衰减，由上层在互动时写入。
@规则[$[社交内核]] {
  优先级: 8510
  id: soNeed
  $.代谢.流逝分钟 > 0 {
    $.社交.互动需求 = 社交需求下一步()
    $.社交.主人互动 = 社交主人互动衰减()
    $.社交.孤单 = 社交孤单()
  }
}

@规则[$[社交内核]] {
  优先级: 8515
  id: soWantTouch
  $.社交.互动需求 >= 70 ∧ $.社交.想被摸 = false {
    $.社交.想被摸 = true
  }
}

@规则[$[社交内核]] {
  优先级: 8516
  id: soNoWantTouch
  $.社交.互动需求 < 40 ∧ $.社交.想被摸 = true {
    $.社交.想被摸 = false
  }
}
