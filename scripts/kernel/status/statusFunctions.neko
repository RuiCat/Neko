// 状态词与标记计算单元（L5）。只读下层字段（伤害 / 代谢 / 身体），不写任何字段。
@函数 状态身体分类() -> str {
  if {e}.伤害.死亡 == true {
    返回 "死亡"
  }
  休克 = {e}.伤害.休克
  if 休克 >= 80 {
    返回 "濒危"
  }
  if 休克 >= 40 {
    返回 "休克"
  }
  if {e}.生殖.并发症 == "子痫前期" {
    返回 "子痫"
  }
  if {e}.伤害.感染 >= 60 {
    返回 "脓毒"
  }
  if {e}.伤害.失血量 >= 30 {
    返回 "虚弱"
  }
  if {e}.代谢.体温 >= 390 {
    返回 "昏厥"
  }
  if {e}.代谢.血糖 < 50 {
    返回 "昏厥"
  }
  if {e}.身体.体力 < 30 {
    返回 "疲惫"
  }
  返回 "正常"
}

@函数 状态标记疼痛() -> bool {
  if {e}.伤害.失血量 >= 30 {
    返回 true
  }
  返回 false
}

@函数 状态标记饥饿() -> bool {
  if {e}.代谢.饥饿 >= 60 {
    返回 true
  }
  返回 false
}

@函数 状态标记口渴() -> bool {
  if {e}.代谢.口渴 >= 60 {
    返回 true
  }
  返回 false
}

@函数 状态标记疲劳() -> bool {
  if {e}.身体.体力 < 30 {
    返回 true
  }
  返回 false
}

@函数 状态疼痛投影() -> int {
  值 = {e}.伤害.疼痛
  值 = 值 * (100 - {e}.基础.属性.意志 / 2) / 100
  if 值 < 0 {
    值 = 0
  }
  return int(值)
}

@函数 状态精力() -> int {
  值 = 100 - {e}.睡眠.疲劳
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 状态昏迷判定() -> bool {
  if {e}.状态.身体 == "昏厥" {
    返回 true
  }
  if {e}.代谢.血糖 < 50 {
    返回 true
  }
  if {e}.伤害.休克 >= 80 {
    返回 true
  }
  返回 false
}
