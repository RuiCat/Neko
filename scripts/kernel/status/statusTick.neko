// 状态投影 tick（L5，优先级 9500 段）。只读下层，只写 状态.身体 / 标记.*。
// 9800 之前跑，读取的是本 tick 已结算完成的 L0–L4 与本层 9000 段的 身体.体力。
@规则[$[状态内核]] {
  优先级: 9500
  id: l5StatusBody
  $.代谢.流逝分钟 > 0 {
    $.状态.身体 = 状态身体分类()
  }
}

@规则[$[状态内核]] {
  优先级: 9600
  id: l5StatusMarks
  $.代谢.流逝分钟 > 0 {
    $.标记.疼痛 = 状态标记疼痛()
    $.标记.饥饿 = 状态标记饥饿()
    $.标记.口渴 = 状态标记口渴()
    $.标记.疲劳 = 状态标记疲劳()
  }
}

// 规范状态账本：由 L5 单向派生写入（旧字段继续双写，读取以 角色状态.* 为准）。
@规则[$[状态内核]] {
  优先级: 9700
  id: l5CanonicalState
  $.代谢.流逝分钟 > 0 {
    $.角色状态.体力 = 代谢投影体力()
    $.角色状态.饱食 = 代谢投影饱食()
    $.角色状态.水分 = 代谢投影水分()
    $.角色状态.饥饿 = 代谢投影饥饿()
    $.角色状态.口渴 = 代谢投影口渴()
    $.角色状态.疼痛 = 状态疼痛投影()
    $.角色状态.疲劳 = $.睡眠.疲劳
    $.角色状态.精力 = 状态精力()
    $.角色状态.身体状态 = $.状态.身体
    $.角色状态.昏迷 = 状态昏迷判定()
  }
}
