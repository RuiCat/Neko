// 判定阈值内核：把散落在各层的「魔法阈值」收成一处可调数据。
// 只存数值，不含逻辑；消费方（L3 伤害 / L5 状态 / L7 行动）通过 `{e}.判定阈值.*` 读取。
// 默认值等于收拢前的脚本常量，因此行为不变；调难度改这里即可，不用翻函数。
//
// 分组说明：
//   濒危/休克/衰竭/脓毒/虚脱 —— 状态词分档（statusFunctions）
//   死亡*                     —— 终局判定（injuryFunctions）
//   应激*                     —— MODS 累积驱动（injuryFunctions）
//   中断*                     —— 行动状态机的打断条件（actionTick）
//   后遗症感染                —— 后遗症首次写定（injuryFunctions）
//   老年比例/衰退比例          —— 相对 种族参数.寿命 的百分比，不再是写死的 60/40 岁
@定义 判定阈值内核 {
  "判定阈值": {
    "濒危休克[int,min:0,max:100]": 80,
    "休克[int,min:0,max:100]": 40,
    "衰竭[int,min:0,max:100]": 60,
    "脓毒[int,min:0,max:100]": 60,
    "虚脱灌注[int,min:0,max:100]": 40,
    "剧痛[int,min:0,max:100]": 70,
    "疼痛[int,min:0,max:100]": 40,

    "死亡休克[int,min:0,max:100]": 100,
    "死亡衰竭[int,min:0,max:100]": 90,
    "死亡灌注[int,min:0,max:100]": 5,

    "应激感染[int,min:0,max:100]": 60,
    "应激休克[int,min:0,max:100]": 60,
    "应激灌注[int,min:0,max:100]": 40,

    "中断休克[int,min:0,max:100]": 50,
    "中断紧迫度[int,min:0,max:100]": 90,

    "后遗症感染[int,min:0,max:100]": 70,

    "老年比例[int,min:1,max:100]": 75,
    "衰退比例[int,min:1,max:100]": 50
  }
}
