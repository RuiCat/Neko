// 体液 tick（L0，优先级 1200 段）。
@规则[$[代谢内核]] {
  优先级: 1190
  id: m0FluidIn
  $.代谢.流逝分钟 > 0 {
    $.代谢.摄入液 = 摄入液下一步({e}.代谢.摄入液, {e}.器官性状.胃.吸收输出液体, {e}.器官性状.肠道.吸收输出液体)
  }
}

@规则[$[代谢内核]] {
  优先级: 1200
  id: m0Fluid
  $.代谢.流逝分钟 > 0 {
    $.代谢.尿量 = 代谢尿量下一步()
    $.代谢.体液 = 代谢体液下一步()
    $.代谢.血钠 = 代谢血钠下一步()
    $.代谢.渗透压 = 代谢渗透压下一步()
    $.代谢.血液 = 代谢血量估算()
    $.代谢.摄入液 = 0
  }
}
