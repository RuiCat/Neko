// 能量与血糖 tick（L0，优先级 1000 段）。
// 只用 `=` + 函数：`-=` 接函数/路径会被解析成字面量（parserRule.go:125）。
@规则[$[代谢内核]] {
  优先级: 990
  id: m0AbsorbIn
  $.代谢.流逝分钟 > 0 {
    $.代谢.摄入能量 = 摄入能量下一步({e}.代谢.摄入能量, {e}.器官性状.胃.吸收输出能量, {e}.器官性状.肠道.吸收输出能量)
  }
}

@规则[$[代谢内核]] {
  优先级: 1000
  id: m0Energy
  $.代谢.流逝分钟 > 0 {
    $.代谢.本tick吸收 = 代谢吸收热量()
    $.代谢.胃内容 = 代谢胃内容下一步()
    $.代谢.能量储备 = 代谢能量储备下一步()
    $.代谢.血糖 = 代谢血糖下一步()
    $.代谢.摄入能量 = 0
    $.代谢.酒精 = 代谢酒精下一步()
  }
}

// 低血糖：肝糖原动员
@规则[$[代谢内核]] {
  优先级: 1100
  id: m0Glycogen
  $.代谢.血糖 < 70 ∧ $.代谢.糖原肝 > 0 {
    $.代谢.糖原肝 -= 5
    $.代谢.血糖 += 10
  }
}
