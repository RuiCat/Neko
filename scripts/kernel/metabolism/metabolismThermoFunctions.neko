// 体温域计算单元（L0）。
@函数 代谢出汗调节() -> int {
  目标 = {e}.种族参数.基础体温
  差 = {e}.代谢.体温 - 目标
  if 差 <= 0 {
    返回 0
  }
  值 = 差 * 20
  if 值 > 5000 {
    值 = 5000
  }
  返回 int(值)
}

@函数 代谢寒战调节() -> int {
  差 = {e}.种族参数.基础体温 - {e}.代谢.体温
  if 差 < 5 {
    返回 0
  }
  值 = 差 * 10
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 代谢体温下一步() -> int {
  分钟 = {e}.代谢.流逝分钟
  当前 = {e}.代谢.体温
  环境 = {e}.代谢.环境温
  产热 = 代谢消耗热量()
  散热 = ({e}.代谢.体温 - 环境) * 分钟 / 127 + {e}.代谢.出汗 * 3
  目标 = {e}.种族参数.基础体温 + {e}.伤害.感染 / 50
  新温 = 当前 + (产热 - 散热) / 45 - (当前 - 目标) / 20
  if 新温 < 320 {
    新温 = 320
  }
  if 新温 > 430 {
    新温 = 430
  }
  返回 int(新温)
}
