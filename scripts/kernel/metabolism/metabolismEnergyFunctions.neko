// 能量域计算单元（L0）。规则只做 `字段 = 函数()`，算术全部集中在此。
@函数 代谢吸收热量() -> int {
  分钟 = {e}.代谢.流逝分钟
  胃 = {e}.代谢.胃内容 + {e}.代谢.摄入能量
  吸收 = int(胃 * 分钟 / 240)
  if 吸收 > 胃 {
    吸收 = 胃
  }
  返回 吸收
}

// L0 直接读 L4 的怀孕状态，避免「L4 在本 tick 后段才写、L0 用上一 tick 旧值」的滞后。
@函数 代谢孕期需求() -> int {
  状态 = {e}.生殖.怀孕状态
  if 状态 == "中孕" {
    返回 340
  }
  if 状态 == "晚孕" {
    返回 452
  }
  if 状态 == "产后" {
    返回 500
  }
  返回 0
}

@函数 代谢消耗热量() -> int {
  返回 int(({e}.代谢.基础代谢 + {e}.代谢.活动代谢 + {e}.行为.能耗输出 + 代谢孕期需求()) * {e}.基础.代谢修正 / 1000 * {e}.代谢.流逝分钟 / 1440)
}

@函数 代谢胃内容下一步() -> int {
  胃 = {e}.代谢.胃内容 + {e}.代谢.摄入能量
  吸收 = {e}.代谢.本tick吸收
  if 吸收 > 胃 {
    吸收 = 胃
  }
  返回 胃 - 吸收
}

@函数 代谢能量储备下一步() -> int {
  储备 = {e}.代谢.能量储备 + {e}.代谢.本tick吸收 - 代谢消耗热量()
  if 储备 < 0 {
    储备 = 0
  }
  返回 储备
}

@函数 代谢血糖下一步() -> int {
  分钟 = {e}.代谢.流逝分钟
  糖 = {e}.代谢.血糖 + {e}.代谢.本tick吸收 / 20 - 2 * 分钟 / 60 - {e}.代谢.酒精 / 50
  if 糖 < 20 {
    糖 = 20
  }
  if 糖 > 600 {
    糖 = 600
  }
  返回 int(糖)
}

@函数 代谢酒精下一步() -> int {
  值 = {e}.代谢.酒精 - (1 + {e}.器官.肝.功能 / 50)
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}
