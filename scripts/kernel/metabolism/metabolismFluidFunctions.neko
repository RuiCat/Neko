// 体液域计算单元（L0）。所有水量统一为「本 tick」口径：日均量 × 流逝分钟 / 1440，
// 再乘 种族参数.体型系数（千分比，1000=基准）做体型缩放。
// 口径备忘：旧版 尿量 未按分钟折算，60 分钟 tick 下等于 19 L/天（真实约 1.5 L/天），
// 体液单向下滑把灌注拖到 47，多器官衰竭因此被动上涨。见 docs/metabolism-architecture.md §5。

// 体型系数：用体重/体积整体缩放水量。种族参数.体型系数 为千分比（1000=基准），
// 五个预设种族当前都是 1000，因此接入后数值不变；改数据即可让大体型种族真正吃喝更多。
@函数 代谢体型系数() -> int {
  值 = {e}.种族参数.体型系数
  if 值 < 1 {
    返回 1000
  }
  返回 int(值)
}

// 基线补水（食物水 + 代谢水）：不依赖喝水动作。与「每天喝一次水（+500 mL）」配平，
// 完全不喝时约 40+ 天见底，而不是每 tick 掉 800 mL。
@函数 代谢基础摄入() -> int {
  返回 int(1800 * {e}.代谢.流逝分钟 / 1440) * 代谢体型系数() / 1000
}

@函数 代谢流失液体() -> int {
  分钟 = {e}.代谢.流逝分钟
  不感蒸发 = int(800 * 分钟 / 1440) * 代谢体型系数() / 1000
  返回 {e}.代谢.尿量 + {e}.代谢.出汗 + 不感蒸发
}

@函数 代谢体液下一步() -> int {
  水 = {e}.代谢.体液 + {e}.代谢.摄入液 + 代谢基础摄入() - 代谢流失液体()
  if 水 < 20000 {
    水 = 20000
  }
  if 水 > 60000 {
    水 = 60000
  }
  返回 水
}

// 孕期血容量扩张直接读 L4 状态，避免跨层滞后。
@函数 代谢血容量系数() -> int {
  状态 = {e}.生殖.怀孕状态
  if 状态 == "中孕" {
    返回 130
  }
  if 状态 == "晚孕" {
    返回 145
  }
  返回 100
}

@函数 代谢血量估算() -> int {
  返回 int({e}.代谢.体液 * 100 / 840 * 代谢血容量系数() / 100 * (100 - {e}.伤害.失血量) / 100)
}

// 血钠：脱水升高、过水稀释，正常水合时向 140 回归。
// 旧版是单向棘轮 `钠 + (42000-体液)/2000`：整数除法下体液只要比 42000 多一点就每 tick −1，
// 一路砸到下限 110（稀释性低钠），体液低时则单向升到 170。这里加 ±2000 mL 死区，
// 并让无偏差时回到 140，避免量化误差被逐 tick 累积。
@函数 代谢血钠下一步() -> int {
  值 = {e}.代谢.血钠
  偏差 = 42000 - {e}.代谢.体液
  if 偏差 > 2000 {
    值 = 值 + (偏差 - 2000) / 4000
  } else if 偏差 < -2000 {
    值 = 值 - (0 - 偏差 - 2000) / 4000
  } else if 值 < 140 {
    值 = 值 + 1
  } else if 值 > 140 {
    值 = 值 - 1
  }
  if 值 < 110 {
    值 = 110
  }
  if 值 > 170 {
    值 = 170
  }
  返回 int(值)
}

@函数 代谢渗透压下一步() -> int {
  值 = {e}.代谢.血钠 * 2 + {e}.代谢.血糖 / 18
  if 值 < 250 {
    值 = 250
  }
  if 值 > 340 {
    值 = 340
  }
  返回 int(值)
}

// 肾功能：日均尿量 1500 mL，按灌注与抗利尿调节后折算成本 tick 量（读上一 tick 的灌注）。
// 少尿下限 400 mL/天：严重脱水时尿量不归零，避免「尿量 0 → 不再失水」的假稳态。
@函数 代谢尿量下一步() -> int {
  日量 = 1500 * {e}.循环.灌注 / 100
  if {e}.代谢.体液 < 42000 {
    日量 = 日量 * {e}.代谢.体液 / 42000
  }
  日量 = 日量 * 代谢体型系数() / 1000
  if 日量 < 400 {
    日量 = 400
  }
  返回 int(日量 * {e}.代谢.流逝分钟 / 1440)
}
