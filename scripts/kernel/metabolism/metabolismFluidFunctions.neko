// 体液域计算单元（L0）。
@函数 代谢流失液体() -> int {
  分钟 = {e}.代谢.流逝分钟
  不感蒸发 = int(800 * 分钟 / 1440)
  返回 {e}.代谢.尿量 + {e}.代谢.出汗 + 不感蒸发
}

@函数 代谢体液下一步() -> int {
  水 = {e}.代谢.体液 + {e}.代谢.摄入液 - 代谢流失液体()
  if 水 < 20000 {
    水 = 20000
  }
  if 水 > 60000 {
    水 = 60000
  }
  返回 水
}

// 孕期血容量扩张直接读 L4 状态，避免跨层滞后。
@函数 代谢血容量系数() -> int {
  状态 = {e}.生殖.怀孕状态
  if 状态 == "中孕" {
    返回 130
  }
  if 状态 == "晚孕" {
    返回 145
  }
  返回 100
}

@函数 代谢血量估算() -> int {
  返回 int({e}.代谢.体液 * 100 / 840 * 代谢血容量系数() / 100 * (100 - {e}.伤害.失血量) / 100)
}

@函数 代谢血钠下一步() -> int {
  值 = {e}.代谢.血钠 + (42000 - {e}.代谢.体液) / 2000
  if 值 < 110 {
    值 = 110
  }
  if 值 > 170 {
    值 = 170
  }
  返回 int(值)
}

@函数 代谢渗透压下一步() -> int {
  值 = {e}.代谢.血钠 * 2 + {e}.代谢.血糖 / 18
  if 值 < 250 {
    值 = 250
  }
  if 值 > 340 {
    值 = 340
  }
  返回 int(值)
}

// 肾功能：尿量随灌注与脱水状态调节（读上一 tick 的灌注）。
@函数 代谢尿量下一步() -> int {
  值 = 800 * {e}.循环.灌注 / 100
  if {e}.代谢.体液 < 40000 {
    值 = 值 * {e}.代谢.体液 / 42000
  }
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}
