// 规划状态机（L8，优先级 8100–8199）。
// 紧迫度每 tick 重算；行动层（8000 段）读上一 tick 的值做中断判定。
@规则[$[规划内核]] {
  优先级: 8100
  id: plUrgency
  $.代谢.流逝分钟 >= 0 {
    $.规划.紧迫度 = 规划紧迫度()
  }
}

@规则[$[规划内核]] {
  优先级: 8110
  id: plReset
  $.规划.目标 = "" ∧ $.规划.阶段 != "空闲" {
    $.规划.阶段 = "空闲"
    $.规划.进度 = 0
    $.规划.结果 = ""
  }
}

@规则[$[规划内核]] {
  优先级: 8120
  id: plStart
  $.规划.目标 != "" ∧ $.规划.阶段 != "执行" {
    $.规划.阶段 = "执行"
  }
}

@规则[$[规划内核]] {
  优先级: 8130
  id: plReplan
  $.规划.重规划 = true {
    $.规划.阶段 = "评估"
    $.规划.重规划 = false
    $.规划.结果 = "需要重规划"
  }
}

@规则[$[规划内核]] {
  优先级: 8140
  id: plDone
  $.规划.进度 >= 100 {
    $.规划.阶段 = "达成"
    $.规划.结果 = "达成"
    $.规划.目标 = ""
    $.规划.进度 = 0
  }
}

@规则[$[规划内核]] {
  优先级: 8150
  id: plAbandon
  $.规划.优先级 <= 0 ∧ $.规划.阶段 = "执行" {
    $.规划.阶段 = "放弃"
    $.规划.结果 = "放弃"
    $.规划.目标 = ""
  }
}
