// 成长域计算单元（L12）。升级所需 = 等级 * 100；一次 tick 最多升一级。
// 成长可升级：条件里不要写 `$.x >= $.y`（RHS 的 $ 不会被重写成 {e}），用函数比较。
@函数 成长可升级() -> bool {
  if {e}.成长.等级 >= {e}.成长.等级上限 {
    返回 false
  }
  返回 {e}.成长.经验 >= {e}.成长.升级所需
}

@函数 成长升级所需() -> int {
  返回 int({e}.成长.等级 * 100)
}

@函数 成长经验下一步() -> int {
  if {e}.成长.经验 < {e}.成长.升级所需 {
    返回 {e}.成长.经验
  }
  if {e}.成长.等级 >= {e}.成长.等级上限 {
    返回 {e}.成长.升级所需
  }
  返回 int({e}.成长.经验 - {e}.成长.升级所需)
}

@函数 成长等级下一步() -> int {
  if {e}.成长.经验 < {e}.成长.升级所需 {
    返回 {e}.成长.等级
  }
  if {e}.成长.等级 >= {e}.成长.等级上限 {
    返回 {e}.成长.等级
  }
  返回 int({e}.成长.等级 + 1)
}

@函数 成长特性点下一步() -> int {
  if {e}.成长.经验 < {e}.成长.升级所需 {
    返回 {e}.成长.特性点
  }
  if {e}.成长.等级 >= {e}.成长.等级上限 {
    返回 {e}.成长.特性点
  }
  返回 int({e}.成长.特性点 + 1)
}
