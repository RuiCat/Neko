// 生命轴 tick（L1，优先级 2000 段）。只读代谢，不写代谢。
@规则[$[循环内核]] {
  优先级: 2000
  id: l1Vitals
  $.代谢.流逝分钟 > 0 {
    $.循环.心率 = 循环心率下一步()
    $.循环.每搏量 = 循环每搏量下一步()
    $.循环.输出量 = 循环输出量下一步()
    $.循环.收缩压 = 循环收缩压下一步()
    $.循环.舒张压 = 循环舒张压下一步()
    $.循环.灌注 = 循环灌注下一步()
    $.呼吸.呼吸频率 = 呼吸频率下一步()
    $.呼吸.血氧 = 呼吸血氧下一步()
    $.呼吸.二氧化碳 = 呼吸二氧化碳下一步()
    $.内分泌.皮质醇 = 内分泌皮质醇下一步()
    $.内分泌.催产素 = $.行为.催产素量
  }
}
