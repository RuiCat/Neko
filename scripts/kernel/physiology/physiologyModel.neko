// 生命轴内核（L1）：循环 / 呼吸 / 内分泌。各自独立模板，角色按需组合。
@定义 循环内核 {
  "循环": {
    "心率[int,min:30,max:220]": 72,
    "每搏量[int,min:20,max:200]": 70,
    "输出量[int,min:20,max:200]": 50,
    "收缩压[int,min:60,max:220]": 118,
    "舒张压[int,min:30,max:140]": 76,
    "灌注[int,min:0,max:100]": 100
  }
}

@定义 呼吸内核 {
  "呼吸": {
    "呼吸频率[int,min:4,max:60]": 14,
    "血氧[int,min:50,max:100]": 98,
    "二氧化碳[int,min:20,max:70]": 40
  }
}

@定义 内分泌内核 {
  "内分泌": {
    "皮质醇[int,min:0,max:300]": 60,
    "催产素[int,min:0,max:100]": 10
  }
}
