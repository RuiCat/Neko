// 生命轴计算单元（L1）。只读 L0（代谢），不写回。
@函数 循环心率下一步() -> int {
  失血 = 5000 - {e}.代谢.血液
  失血加 = 失血 / 40
  if 失血加 < 0 {
    失血加 = 0
  }
  体温加 = 0
  if {e}.代谢.体温 > 372 {
    体温加 = ({e}.代谢.体温 - 372) * 3
  }
  率 = {e}.种族参数.基础心率 + 失血加 + 体温加 + {e}.行为.心率增量 + {e}.伤害.疼痛 / 20
  if 率 < 40 {
    率 = 40
  }
  if 率 > 200 {
    率 = 200
  }
  返回 int(率)
}

@函数 循环每搏量下一步() -> int {
  失血 = 5000 - {e}.代谢.血液
  量 = 70 - 失血 / 100
  if 量 < 20 {
    量 = 20
  }
  返回 int(量)
}

@函数 循环输出量下一步() -> int {
  返回 int({e}.循环.心率 * {e}.循环.每搏量 / 100)
}

@函数 循环收缩压下一步() -> int {
  压 = 118 - (5000 - {e}.代谢.血液) / 25
  if 压 < 60 {
    压 = 60
  }
  if 压 > 220 {
    压 = 220
  }
  返回 int(压)
}

@函数 循环舒张压下一步() -> int {
  压 = 76 - (5000 - {e}.代谢.血液) / 40
  if 压 < 30 {
    压 = 30
  }
  返回 int(压)
}

@函数 循环灌注下一步() -> int {
  值 = {e}.代谢.血液 * 100 / 5000
  失血值 = 100 - {e}.伤害.失血量
  if 失血值 < 值 {
    值 = 失血值
  }
  if 值 > 100 {
    值 = 100
  }
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 呼吸频率下一步() -> int {
  率 = {e}.种族参数.基础呼吸 + ({e}.呼吸.二氧化碳 - 40) * 2
  if {e}.代谢.体温 > 372 {
    率 = 率 + ({e}.代谢.体温 - 372) * 2
  }
  if 率 < 4 {
    率 = 4
  }
  返回 int(率)
}

@函数 呼吸二氧化碳下一步() -> int {
  值 = {e}.呼吸.二氧化碳
  if {e}.呼吸.血氧 < 90 {
    值 = 值 - 2
  } else {
    值 = 值 + 1
  }
  if 值 < 20 {
    值 = 20
  }
  if 值 > 70 {
    值 = 70
  }
  返回 int(值)
}

@函数 呼吸血氧下一步() -> int {
  值 = 98 - (100 - {e}.循环.灌注) / 2 - (100 - {e}.器官.肺.功能) / 4
  if 值 < 50 {
    值 = 50
  }
  返回 int(值)
}

@函数 内分泌皮质醇下一步() -> int {
  值 = 60 + (100 - {e}.循环.灌注)
  if 值 > 300 {
    值 = 300
  }
  返回 int(值)
}

@函数 循环灌注优先() -> int {
  值 = {e}.循环.灌注 + 15
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
