// 交易域计算单元（L10）。货币结算只在本实体账上做；对手账不动（无三主体写）。
@函数 交易付款() -> int {
  值 = {e}.交易.货币 - {e}.交易.报价
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 交易收款() -> int {
  值 = {e}.交易.货币 + {e}.交易.报价
  if 值 > 1000000 {
    值 = 1000000
  }
  返回 int(值)
}

@函数 交易声誉下一步() -> int {
  值 = {e}.交易.声誉 + 1
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
