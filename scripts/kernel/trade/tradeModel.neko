// 交易内核（L10）：货币、买卖意向与声誉。
// 上层写 意向/标的/报价/对象；本层在 tick 内校验并成交（单件交易，拆批不支持）。
@定义 交易内核 {
  "交易": {
    "货币[int,min:0,max:1000000]": 100,
    "意向": "",
    "标的": "",
    "数量[int,min:1,max:99]": 1,
    "报价[int,min:0,max:1000000]": 0,
    "对象": "",
    "成交额[int,min:0,max:1000000]": 0,
    "结果": "",
    "声誉[int,min:0,max:100]": 50
  }
}
