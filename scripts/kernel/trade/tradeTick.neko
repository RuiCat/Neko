// 交易结算（L10，优先级 8300–8390）。多主体：$1 角色，$2 素材。
// 单件交易：只有 素材.数量 = 1 才能成交（拆批不支持）。报价 0 时先按标价折算。
// 已知边界：货币只在本角色账上增减，不写对手账；素材.持有人 的转移是契约允许的唯一跨层写。
@规则[$1[交易内核]，$2[素材]] {
  优先级: 8300
  id: trQuoteBuy
  $1.交易.意向 = "买" ∧ $1.交易.标的 = $2.名称 ∧ $1.交易.报价 = 0 ∧ $2.价格 > 0 {
    $1.交易.报价 = $2.价格
  }
}

@规则[$1[交易内核]，$2[素材]] {
  优先级: 8310
  id: trBuy
  $1.交易.意向 = "买" ∧ $1.交易.标的 = $2.名称 ∧ $1.交易.报价 > 0 ∧ $1.交易.货币 >= $1.交易.报价 ∧ $2.数量 = 1 ∧ $2.持有人 != $1.基础.名字 {
    $1.交易.货币 = 交易付款()
    $1.交易.成交额 = $1.交易.报价
    $2.持有人 = $1.基础.名字
    $1.交易.结果 = "成交"
    $1.交易.声誉 = 交易声誉下一步()
    $1.交易.意向 = ""
    $1.交易.标的 = ""
    $1.交易.对象 = ""
    $1.交易.报价 = 0
  }
}

@规则[$1[交易内核]，$2[素材]] {
  优先级: 8315
  id: trQuoteSell
  $1.交易.意向 = "卖" ∧ $1.交易.标的 = $2.名称 ∧ $2.持有人 = $1.基础.名字 ∧ $1.交易.报价 = 0 ∧ $2.价格 > 0 {
    $1.交易.报价 = $2.价格
  }
}

@规则[$1[交易内核]，$2[素材]] {
  优先级: 8320
  id: trSell
  $1.交易.意向 = "卖" ∧ $1.交易.标的 = $2.名称 ∧ $2.持有人 = $1.基础.名字 ∧ $1.交易.报价 > 0 ∧ $2.数量 = 1 ∧ $1.交易.对象 != "" {
    $1.交易.货币 = 交易收款()
    $1.交易.成交额 = $1.交易.报价
    $2.持有人 = $1.交易.对象
    $1.交易.结果 = "成交"
    $1.交易.声誉 = 交易声誉下一步()
    $1.交易.意向 = ""
    $1.交易.标的 = ""
    $1.交易.对象 = ""
    $1.交易.报价 = 0
  }
}

@规则[$[交易内核]] {
  优先级: 8390
  id: trFail
  $.交易.意向 != "" {
    $.交易.结果 = "未达成"
    $.交易.意向 = ""
    $.交易.标的 = ""
    $.交易.对象 = ""
    $.交易.报价 = 0
  }
}
