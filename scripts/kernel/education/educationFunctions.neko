// 教育域计算单元（L9）。效率 = 100 + 智力/4 - 疲劳/8 + 师承 30，夹 10–300。
@函数 教育学习效率() -> int {
  值 = 100 + {e}.基础.属性.智力 / 4 - {e}.睡眠.疲劳 / 8
  if {e}.教育.师从 != "" {
    值 = 值 + 30
  }
  if 值 < 10 {
    值 = 10
  }
  if 值 > 300 {
    值 = 300
  }
  返回 int(值)
}

@函数 教育进度下一步() -> int {
  值 = {e}.教育.学习进度
  if {e}.教育.专注 <= 0 {
    返回 值
  }
  增 = {e}.教育.学习效率 * {e}.教育.专注 * {e}.代谢.流逝分钟 / 60000
  值 = 值 + int(增)
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 教育已学下一步() -> int {
  值 = {e}.教育.已学分钟 + {e}.代谢.流逝分钟
  if 值 > 525600 {
    值 = 525600
  }
  返回 int(值)
}

@函数 教育熟练下一步() -> int {
  值 = {e}.教育.熟练 + 10
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
