// 教育内核（L9）：科目熟练度、学习进度与师承。
// 上层写 科目/专注/师从；本层按「行动=学习」推进进度并派生水平。
@定义 教育内核 {
  "教育": {
    "科目": "",
    "熟练[int,min:0,max:100]": 0,
    "学习进度[int,min:0,max:100]": 0,
    "学习效率[int,min:10,max:300]": 100,
    "专注[int,min:0,max:100]": 50,
    "师从": "",
    "已学分钟[int,min:0,max:525600]": 0,
    "水平": "入门"
  }
}
