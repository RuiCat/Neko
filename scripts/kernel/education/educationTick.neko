// 教育结算（L9，优先级 8200–8249）。
// 只在「行动.当前 = 学习」时推进；进度满一档 → 熟练 +10（上限 100）。
@规则[$[教育内核]] {
  优先级: 8200
  id: edEfficiency
  $.代谢.流逝分钟 >= 0 {
    $.教育.学习效率 = 教育学习效率()
  }
}

@规则[$[教育内核]] {
  优先级: 8210
  id: edProgress
  $.行动.当前 = "学习" ∧ $.代谢.流逝分钟 > 0 {
    $.教育.学习进度 = 教育进度下一步()
    $.教育.已学分钟 = 教育已学下一步()
  }
}

@规则[$[教育内核]] {
  优先级: 8220
  id: edLevelUp
  $.教育.学习进度 >= 100 {
    $.教育.学习进度 = 0
    $.教育.熟练 = 教育熟练下一步()
  }
}

// 水平派生：四条互斥规则（条件里不用括号分组，用 ∧ 纵向限定区间）。
@规则[$[教育内核]] {
  优先级: 8230
  id: edMaster
  $.教育.熟练 >= 95 ∧ $.教育.水平 != "大师" {
    $.教育.水平 = "大师"
  }
}

@规则[$[教育内核]] {
  优先级: 8235
  id: edExpert
  $.教育.熟练 >= 80 ∧ $.教育.熟练 < 95 ∧ $.教育.水平 != "精通" {
    $.教育.水平 = "精通"
  }
}

@规则[$[教育内核]] {
  优先级: 8240
  id: edSkilled
  $.教育.熟练 >= 50 ∧ $.教育.熟练 < 80 ∧ $.教育.水平 != "熟练" {
    $.教育.水平 = "熟练"
  }
}

@规则[$[教育内核]] {
  优先级: 8245
  id: edNovice
  $.教育.熟练 < 50 ∧ $.教育.水平 != "入门" {
    $.教育.水平 = "入门"
  }
}
