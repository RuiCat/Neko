// 记忆内核（L11）：短期/长期负荷、情绪印记与回忆强度。
// 上层追加 最近事件、置 巩固；本层负责衰减、巩固与遗忘。
@定义 记忆内核 {
  "记忆": {
    "短期负荷[int,min:0,max:100]": 0,
    "长期负荷[int,min:0,max:100]": 0,
    "回忆强度[int,min:0,max:100]": 0,
    "情绪印记[int,min:0,max:100]": 0,
    "遗忘速率[int,min:1,max:100]": 10,
    "遗忘阈值[int,min:0,max:100]": 10,
    "巩固[bool]": false,
    "最近事件": [],
    "最近场景": "",
    "上次互动": ""
  }
}
