// 记忆结算（L11，优先级 8400–8459）。
// 顺序：巩固 → 短期衰减 → 长期遗忘 → 印记衰减 → 遗忘清零 → 回忆强度。
@规则[$[记忆内核]] {
  优先级: 8400
  id: meConsolidate
  $.记忆.巩固 = true {
    $.记忆.长期负荷 = 记忆巩固长期()
    $.记忆.短期负荷 = 记忆巩固短期()
    $.记忆.巩固 = false
  }
}

@规则[$[记忆内核]] {
  优先级: 8410
  id: meDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.短期负荷 = 记忆短期下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8420
  id: meLongDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.长期负荷 = 记忆长期下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8430
  id: meMarkDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.情绪印记 = 记忆印记下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8440
  id: meForget
  $.记忆.短期负荷 < $.记忆.遗忘阈值 ∧ $.记忆.短期负荷 > 0 {
    $.记忆.短期负荷 = 0
  }
}

@规则[$[记忆内核]] {
  优先级: 8450
  id: meRecall
  $.代谢.流逝分钟 >= 0 {
    $.记忆.回忆强度 = 记忆回忆强度()
  }
}
