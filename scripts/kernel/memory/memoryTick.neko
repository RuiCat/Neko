// 记忆结算（L11，优先级 8400–8459）。
// 顺序：印记/通道入账 → 巩固 → 短期衰减 → 长期遗忘 → 印记衰减 → 遗忘清零 → 回忆强度。
@规则[$[记忆内核]] {
  优先级: 8405
  id: meConsolidate
  $.记忆.巩固 = true {
    $.记忆.长期负荷 = 记忆巩固长期()
    $.记忆.短期负荷 = 记忆巩固短期()
    $.记忆.巩固 = false
  }
}

@规则[$[记忆内核]] {
  优先级: 8401
  id: meMarkEvent
  $.情感.待印记 > 0 {
    $.记忆.情绪印记 = 记忆累加({e}.记忆.情绪印记, {e}.情感.待印记)
    $.记忆.情绪印记源 = $.情感.情绪
    $.记忆.印记效价 = $.情感.效价
    $.情感.待印记 = 0
  }
}

@规则[$[记忆内核]] {
  优先级: 8402
  id: meMarkRelation
  $.情感.待记忆 > 0 ∧ $.情感.记忆类别 = "关系" {
    $.记忆.关系记忆 = 记忆累加({e}.记忆.关系记忆, {e}.情感.待记忆)
    $.情感.待记忆 = 0
  }
}

@规则[$[记忆内核]] {
  优先级: 8403
  id: meMarkEventMem
  $.情感.待记忆 > 0 ∧ $.情感.记忆类别 = "事件" {
    $.记忆.事件记忆 = 记忆累加({e}.记忆.事件记忆, {e}.情感.待记忆)
    $.情感.待记忆 = 0
  }
}

@规则[$[记忆内核]] {
  优先级: 8404
  id: meMarkSelf
  $.情感.待记忆 > 0 ∧ $.情感.记忆类别 = "自我" {
    $.记忆.自我记忆 = 记忆累加({e}.记忆.自我记忆, {e}.情感.待记忆)
    $.情感.待记忆 = 0
  }
}

@规则[$[记忆内核]] {
  优先级: 8460
  id: meTypedDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.关系记忆 = 记忆关系下一步()
    $.记忆.事件记忆 = 记忆事件下一步()
    $.记忆.自我记忆 = 记忆自我下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8470
  id: meComposite
  $.代谢.流逝分钟 >= 0 {
    $.记忆.综合强度 = 记忆综合强度()
  }
}

@规则[$[记忆内核]] {
  优先级: 8410
  id: meDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.短期负荷 = 记忆短期下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8420
  id: meLongDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.长期负荷 = 记忆长期下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8430
  id: meMarkDecay
  $.代谢.流逝分钟 > 0 {
    $.记忆.情绪印记 = 记忆印记下一步()
  }
}

@规则[$[记忆内核]] {
  优先级: 8440
  id: meForget
  $.记忆.短期负荷 < $.记忆.遗忘阈值 ∧ $.记忆.短期负荷 > 0 {
    $.记忆.短期负荷 = 0
  }
}

@规则[$[记忆内核]] {
  优先级: 8450
  id: meRecall
  $.代谢.流逝分钟 >= 0 {
    $.记忆.回忆强度 = 记忆回忆强度()
  }
}
