// 记忆域计算单元（L11）。衰减按分钟折算，下限 0。
@函数 记忆短期下一步() -> int {
  减 = int({e}.记忆.遗忘速率 * {e}.代谢.流逝分钟 / 600)
  值 = {e}.记忆.短期负荷 - 减
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 记忆巩固长期() -> int {
  值 = {e}.记忆.长期负荷 + {e}.记忆.短期负荷 / 2
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 记忆巩固短期() -> int {
  返回 int({e}.记忆.短期负荷 - {e}.记忆.短期负荷 / 2)
}

@函数 记忆长期下一步() -> int {
  减 = int({e}.代谢.流逝分钟 / 720)
  值 = {e}.记忆.长期负荷 - 减
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 记忆印记下一步() -> int {
  减 = int({e}.代谢.流逝分钟 / 1440)
  值 = {e}.记忆.情绪印记 - 减
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 记忆回忆强度() -> int {
  返回 int(({e}.记忆.长期负荷 + {e}.记忆.情绪印记) / 2)
}

@函数 记忆累加(现值:int, 增量:int) -> int {
  值 = 现值 + 增量
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 记忆关系下一步() -> int {
  减 = int({e}.代谢.流逝分钟 / 2880)
  值 = {e}.记忆.关系记忆 - 减
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 记忆事件下一步() -> int {
  减 = int({e}.代谢.流逝分钟 / 1440)
  值 = {e}.记忆.事件记忆 - 减
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 记忆自我下一步() -> int {
  减 = int({e}.代谢.流逝分钟 / 4320)
  值 = {e}.记忆.自我记忆 - 减
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 记忆综合强度() -> int {
  返回 int(({e}.记忆.长期负荷 + {e}.记忆.情绪印记 + {e}.记忆.关系记忆 + {e}.记忆.事件记忆 + {e}.记忆.自我记忆) / 5)
}
