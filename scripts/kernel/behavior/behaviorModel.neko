// 行为内核（L0.5）：性行为/自慰/运动等事件的输入状态与派生输出。
// 本层只写 行为.*；代谢/循环/路径/生殖在下游读取派生输出。
@定义 行为内核 {
  "行为": {
    "主动[str]": "",
    "类型[str]": "无",
    "唤起[int,min:0,max:100]": 0,
    "强度[int,min:0,max:100]": 0,
    "润滑[int,min:0,max:100]": 0,
    "经验[int,min:0,max:100]": 0,
    "酒精[int,min:0,max:100]": 0,
    "伙伴数[int,min:0,max:5]": 0,
    "体内暴露[bool]": false,
    "应激输出[int,min:0,max:100]": 0,
    "能耗输出[int,min:0,max:500]": 0,
    "心率增量[int,min:0,max:120]": 0,
    "催产素量[int,min:0,max:100]": 0
  }
}
