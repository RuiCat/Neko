// 行为计算单元（L0.5）。只读 行为.*，输出四个派生量；下游按需消费。
@函数 行为应激() -> int {
  if {e}.行为.类型 == "无" {
    返回 0
  }
  值 = {e}.行为.强度 * 100 / (100 + {e}.行为.润滑 / 2)
  值 = 值 + {e}.行为.唤起 / 10 - {e}.行为.经验 / 10 + {e}.行为.酒精 / 10 - {e}.基础.属性.敏捷 / 20
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 行为能耗() -> int {
  if {e}.行为.类型 == "无" {
    返回 0
  }
  返回 int({e}.行为.唤起 / 10 + {e}.行为.强度 / 5)
}

@函数 行为心率增量() -> int {
  if {e}.行为.类型 == "无" {
    返回 0
  }
  返回 int({e}.行为.唤起 / 4 + {e}.行为.强度 / 5)
}

@函数 行为催产素() -> int {
  if {e}.行为.类型 == "无" {
    返回 0
  }
  返回 int({e}.行为.唤起 / 2)
}

@函数 行为唤起下一步() -> int {
  值 = {e}.行为.唤起
  if {e}.行为.类型 == "无" {
    值 = 值 - 10
  }
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 行为唤起增长() -> int {
  值 = {e}.行为.唤起
  if {e}.行为.类型 != "无" {
    值 = 值 + {e}.基础.属性.魅力 / 50
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 行为经验下一步() -> int {
  值 = {e}.行为.经验
  if {e}.行为.类型 != "无" {
    值 = 值 + {e}.基础.属性.智力 / 50
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}
