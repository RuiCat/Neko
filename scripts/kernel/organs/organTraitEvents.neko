// 敏感度修正事件（L2，3020 段写入值字段时触发）：每个来源独立事件，处理器只记录最近变化。
// 条件用「变化量 != 0」，3020 每 tick 的幂等写入不会触发处理器。
@函数 敏感度训练事件() {
  状态.触发 = "敏感度变化:训练"
}

@函数 敏感度药物事件() {
  状态.触发 = "敏感度变化:药物"
}

@函数 敏感度伤害事件() {
  状态.触发 = "敏感度变化:伤害"
}

@函数 敏感度周期事件() {
  状态.触发 = "敏感度变化:周期"
}

@函数 敏感度性反应事件() {
  状态.触发 = "敏感度变化:性反应"
}

@事件:事件敏感度训练 {
  条件: 变化量 != 0
  处理器: 敏感度训练事件
}

@事件:事件敏感度药物 {
  条件: 变化量 != 0
  处理器: 敏感度药物事件
}

@事件:事件敏感度伤害 {
  条件: 变化量 != 0
  处理器: 敏感度伤害事件
}

@事件:事件敏感度周期 {
  条件: 变化量 != 0
  处理器: 敏感度周期事件
}

@事件:事件敏感度性反应 {
  条件: 变化量 != 0
  处理器: 敏感度性反应事件
}
