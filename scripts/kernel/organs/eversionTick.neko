// 外翻拓扑 tick（L2，优先级 3030–3055）：逐级正翻 → 支撑损伤 → 逐级还原 → 拒绝非法动作。
// 单一状态源 = 外翻.翻出点；容器名义拓扑不改，面状态与有效关系由函数派生/写回。
@规则[$[器官内核]] {
  优先级: 3030
  id: evInvertE1
  $.外翻.指令 = "外翻" ∧ $.外翻.翻出点 = "" {
    $.外翻.翻出点 = "阴道"
    $.外翻.结果 = 阴道面外翻()
    $.外翻.结果 = "完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3031
  id: evInvertE2
  $.外翻.指令 = "外翻" ∧ $.外翻.翻出点 = "阴道" {
    $.外翻.翻出点 = "宫颈"
    $.外翻.结果 = 阴道面外翻()
    $.外翻.结果 = 宫颈面外翻()
    $.外翻.结果 = "完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3032
  id: evInvertE3
  $.外翻.指令 = "外翻" ∧ $.外翻.翻出点 = "宫颈" {
    $.外翻.翻出点 = "子宫"
    $.外翻.结果 = 阴道面外翻()
    $.外翻.结果 = 宫颈面外翻()
    $.外翻.结果 = 子宫面外翻()
    $.外翻.结果 = "完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3033
  id: evInvertE4
  $.外翻.指令 = "外翻" ∧ $.外翻.翻出点 = "子宫" {
    $.外翻.翻出点 = "输卵管"
    $.外翻.结果 = 阴道面外翻()
    $.外翻.结果 = 宫颈面外翻()
    $.外翻.结果 = 子宫面外翻()
    $.外翻.结果 = 输卵管面外翻()
    $.外翻.结果 = "完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3034
  id: evInvertE5
  $.外翻.指令 = "外翻" ∧ $.外翻.翻出点 = "输卵管" {
    $.外翻.翻出点 = "卵巢"
    $.外翻.结果 = 阴道面外翻()
    $.外翻.结果 = 宫颈面外翻()
    $.外翻.结果 = 子宫面外翻()
    $.外翻.结果 = 输卵管面外翻()
    $.外翻.结果 = 卵巢面外翻()
    $.外翻.结果 = "完成"
    $.外翻.指令 = ""
  }
}

// 支撑门槛：只在该级刚翻出后的首次"完成"上结算一次，结果改写为"损伤"防止重复。
@规则[$[器官内核]] {
  优先级: 3035
  id: evDamageE1
  $.外翻.结果 = "完成" ∧ $.外翻.翻出点 = "阴道" ∧ $.外翻.支撑 < 60 {
    $.外翻.后遗症 = true
    $.外翻.支撑 -= 5
    $.器官.阴道.完整性 -= 10
    $.外翻.结果 = "损伤"
  }
}

@规则[$[器官内核]] {
  优先级: 3036
  id: evDamageE2
  $.外翻.结果 = "完成" ∧ $.外翻.翻出点 = "宫颈" ∧ $.外翻.支撑 < 55 {
    $.外翻.后遗症 = true
    $.外翻.支撑 -= 5
    $.器官.宫颈.完整性 -= 10
    $.外翻.结果 = "损伤"
  }
}

@规则[$[器官内核]] {
  优先级: 3037
  id: evDamageE3
  $.外翻.结果 = "完成" ∧ $.外翻.翻出点 = "子宫" ∧ $.外翻.支撑 < 45 {
    $.外翻.后遗症 = true
    $.外翻.支撑 -= 5
    $.器官.子宫.完整性 -= 10
    $.外翻.结果 = "损伤"
  }
}

@规则[$[器官内核]] {
  优先级: 3038
  id: evDamageE4
  $.外翻.结果 = "完成" ∧ $.外翻.翻出点 = "输卵管" ∧ $.外翻.支撑 < 35 {
    $.外翻.后遗症 = true
    $.外翻.支撑 -= 5
    $.器官.输卵管.完整性 -= 10
    $.外翻.结果 = "损伤"
  }
}

@规则[$[器官内核]] {
  优先级: 3039
  id: evDamageE5
  $.外翻.结果 = "完成" ∧ $.外翻.翻出点 = "卵巢" ∧ $.外翻.支撑 < 25 {
    $.外翻.后遗症 = true
    $.外翻.支撑 -= 5
    $.器官.卵巢.完整性 -= 10
    $.外翻.结果 = "损伤"
  }
}

// 逐级还原：每次退一级，恢复刚退出翻转段的器官面状态。
@规则[$[器官内核]] {
  优先级: 3040
  id: evReduceE1
  $.外翻.指令 = "还原" ∧ $.外翻.翻出点 = "阴道" {
    $.外翻.翻出点 = ""
    $.外翻.结果 = 阴道面正常()
    $.外翻.结果 = "还原完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3041
  id: evReduceE2
  $.外翻.指令 = "还原" ∧ $.外翻.翻出点 = "宫颈" {
    $.外翻.翻出点 = "阴道"
    $.外翻.结果 = 宫颈面正常()
    $.外翻.结果 = "还原完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3042
  id: evReduceE3
  $.外翻.指令 = "还原" ∧ $.外翻.翻出点 = "子宫" {
    $.外翻.翻出点 = "宫颈"
    $.外翻.结果 = 子宫面正常()
    $.外翻.结果 = "还原完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3043
  id: evReduceE4
  $.外翻.指令 = "还原" ∧ $.外翻.翻出点 = "输卵管" {
    $.外翻.翻出点 = "子宫"
    $.外翻.结果 = 输卵管面正常()
    $.外翻.结果 = "还原完成"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3044
  id: evReduceE5
  $.外翻.指令 = "还原" ∧ $.外翻.翻出点 = "卵巢" {
    $.外翻.翻出点 = "输卵管"
    $.外翻.结果 = 卵巢面正常()
    $.外翻.结果 = "还原完成"
    $.外翻.指令 = ""
  }
}

// 拒绝非法动作：已到顶继续外翻 / 未外翻就还原。
@规则[$[器官内核]] {
  优先级: 3050
  id: evRejectTop
  $.外翻.指令 = "外翻" ∧ $.外翻.翻出点 = "卵巢" {
    $.外翻.结果 = "拒绝：已到顶"
    $.外翻.指令 = ""
  }
}

@规则[$[器官内核]] {
  优先级: 3051
  id: evRejectNone
  $.外翻.指令 = "还原" ∧ $.外翻.翻出点 = "" {
    $.外翻.结果 = "拒绝：未外翻"
    $.外翻.指令 = ""
  }
}
