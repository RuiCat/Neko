// ---- 有效关系（名义拓扑 + 翻出点派生）----
@函数 阴道有效下游() -> str {
  if 外翻段包含(1) == true {
    返回 "翻转腔"
  }
  返回 {e}.容器.阴道.下游
}

@函数 宫颈有效下游() -> str {
  if 外翻段包含(2) == true {
    返回 "翻转腔"
  }
  返回 {e}.容器.宫颈.下游
}

@函数 子宫有效下游() -> str {
  if 外翻段包含(3) == true {
    返回 "翻转腔"
  }
  返回 {e}.容器.子宫.下游
}

@函数 输卵管有效下游() -> str {
  if 外翻段包含(4) == true {
    返回 "翻转腔"
  }
  返回 {e}.容器.输卵管.下游
}

// 卵巢是实质器官：只有被膜面，无内腔面。
@函数 卵巢面外翻() -> str {
  器官性状.卵巢.面状态.被膜面.朝向 = "体外"
  器官性状.卵巢.面状态.被膜面.暴露 = true
  器官性状.卵巢.面状态.被膜面.可见 = true
  返回 "完成"
}

@函数 卵巢面正常() -> str {
  器官性状.卵巢.面状态.被膜面.朝向 = "体腔"
  器官性状.卵巢.面状态.被膜面.暴露 = false
  器官性状.卵巢.面状态.被膜面.可见 = false
  返回 "完成"
}
