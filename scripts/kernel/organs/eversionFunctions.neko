// 外翻拓扑计算单元（L2，3030 段）：级别、段包含、面状态写回、有效关系、门槛。
// 单一状态源 = 外翻.翻出点；名义拓扑（容器.上游/下游/可插入）不改，有效关系由本文件函数派生。
@函数 外翻级别(名:str) -> int {
  if 名 == "阴道" {
    返回 1
  }
  if 名 == "宫颈" {
    返回 2
  }
  if 名 == "子宫" {
    返回 3
  }
  if 名 == "输卵管" {
    返回 4
  }
  if 名 == "卵巢" {
    返回 5
  }
  返回 0
}

// 该级别是否落在当前翻转段内（翻出点级别 >= 器官级别）。
@函数 外翻段包含(级别:int) -> bool {
  return 外翻级别({e}.外翻.翻出点) >= 级别
}

@函数 外翻门槛(级别:int) -> int {
  if 级别 <= 1 {
    返回 60
  }
  if 级别 == 2 {
    返回 55
  }
  if 级别 == 3 {
    返回 45
  }
  if 级别 == 4 {
    返回 35
  }
  返回 25
}

@函数 外翻下一级(当前:str) -> str {
  级别 = 外翻级别(当前)
  if 级别 == 0 {
    返回 "阴道"
  }
  if 级别 == 1 {
    返回 "宫颈"
  }
  if 级别 == 2 {
    返回 "子宫"
  }
  if 级别 == 3 {
    返回 "输卵管"
  }
  if 级别 == 4 {
    返回 "卵巢"
  }
  返回 ""
}

@函数 外翻上一级(当前:str) -> str {
  级别 = 外翻级别(当前)
  if 级别 <= 1 {
    返回 ""
  }
  if 级别 == 2 {
    返回 "阴道"
  }
  if 级别 == 3 {
    返回 "宫颈"
  }
  if 级别 == 4 {
    返回 "子宫"
  }
  返回 "输卵管"
}

// 后遗症判定：支撑低于门槛时留下不可逆标记。
@函数 外翻后遗症(现有:bool, 支撑:int, 门槛:int) -> bool {
  if 现有 == true {
    返回 true
  }
  返回 支撑 < 门槛
}

// ---- 面状态写回（翻转：内腔面朝体外、外表面朝翻转腔）----
@函数 阴道面外翻() -> str {
  器官性状.阴道.面状态.内腔面.朝向 = "体外"
  器官性状.阴道.面状态.内腔面.暴露 = true
  器官性状.阴道.面状态.内腔面.可见 = true
  器官性状.阴道.面状态.外表面.朝向 = "翻转腔"
  器官性状.阴道.面状态.外表面.暴露 = false
  器官性状.阴道.面状态.外表面.可见 = false
  返回 "完成"
}

