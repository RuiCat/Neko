  器官性状.阴道.面状态.内腔面.朝向 = "腔内"
  器官性状.阴道.面状态.内腔面.暴露 = false
  器官性状.阴道.面状态.内腔面.可见 = false
  器官性状.阴道.面状态.外表面.朝向 = "体腔"
  器官性状.阴道.面状态.外表面.暴露 = false
  器官性状.阴道.面状态.外表面.可见 = false
  返回 "完成"
}

