  器官性状.宫颈.面状态.内腔面.朝向 = "体外"
  器官性状.宫颈.面状态.内腔面.暴露 = true
  器官性状.宫颈.面状态.内腔面.可见 = true
  器官性状.宫颈.面状态.外表面.朝向 = "翻转腔"
  器官性状.宫颈.面状态.外表面.暴露 = false
