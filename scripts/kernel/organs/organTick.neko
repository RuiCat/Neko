// 器官账本 tick（L2，优先级 3000 段）。灌注来自 L1，功能由完整性×灌注派生。
@规则[$[器官内核]] {
  优先级: 3000
  id: l2Organs
  $.代谢.流逝分钟 > 0 {
    $.器官.脑.灌注 = {e}.循环.灌注
    $.器官.心.灌注 = {e}.循环.灌注
    $.器官.肺.灌注 = {e}.循环.灌注
    $.器官.肝.灌注 = {e}.循环.灌注
    $.器官.肾.灌注 = {e}.循环.灌注
    $.器官.子宫.灌注 = {e}.循环.灌注
    $.器官.阴道.灌注 = {e}.循环.灌注
    $.器官.宫颈.灌注 = {e}.循环.灌注
    $.器官.直肠.灌注 = {e}.循环.灌注
    $.器官.膀胱.灌注 = {e}.循环.灌注

    $.器官.脑.完整性 = 脑完整性下一步()
    $.器官.心.完整性 = 心完整性下一步()
    $.器官.肺.完整性 = 肺完整性下一步()
    $.器官.肝.完整性 = 肝完整性下一步()
    $.器官.肾.完整性 = 肾完整性下一步()
    $.器官.子宫.完整性 = 子宫完整性下一步()
    $.器官.阴道.完整性 = 阴道完整性下一步()
    $.器官.宫颈.完整性 = 宫颈完整性下一步()
    $.器官.直肠.完整性 = 直肠完整性下一步()
    $.器官.膀胱.完整性 = 膀胱完整性下一步()
    $.器官.皮肤.完整性 = 皮肤完整性下一步()
    $.器官.食管.完整性 = 食管完整性下一步()

    $.器官.脑.功能 = 脑功能值()
    $.器官.心.功能 = 心功能值()
    $.器官.肺.功能 = 肺功能值()
    $.器官.肝.功能 = 肝功能值()
    $.器官.肾.功能 = 肾功能值()
    $.器官.子宫.功能 = 子宫功能值()
    $.器官.阴道.功能 = 阴道功能值()
    $.器官.宫颈.功能 = 宫颈功能值()
    $.器官.直肠.功能 = 直肠功能值()
    $.器官.膀胱.功能 = 膀胱功能值()
  }
}

@规则[$[器官内核]] {
  优先级: 3010
  id: l2OrgansExtra
  $.代谢.流逝分钟 > 0 {
    $.器官.胃.灌注 = $.循环.灌注
    $.器官.小肠.灌注 = $.循环.灌注
    $.器官.大肠.灌注 = $.循环.灌注
    $.器官.肌肉.灌注 = $.循环.灌注
    $.器官.骨.灌注 = $.循环.灌注
    $.器官.胰.灌注 = $.循环.灌注
    $.器官.脾.灌注 = $.循环.灌注
    $.器官.甲状腺.灌注 = $.循环.灌注
    $.器官.肾上腺.灌注 = $.循环.灌注
    $.器官.垂体.灌注 = $.循环.灌注
    $.器官.卵巢.灌注 = $.循环.灌注
    $.器官.输卵管.灌注 = $.循环.灌注
    $.器官.乳腺.灌注 = $.循环.灌注

    $.器官.胃.完整性 = 胃完整性下一步()
    $.器官.小肠.完整性 = 小肠完整性下一步()
    $.器官.大肠.完整性 = 大肠完整性下一步()
    $.器官.肌肉.完整性 = 肌肉完整性下一步()
    $.器官.骨.完整性 = 骨完整性下一步()
    $.器官.胰.完整性 = 胰完整性下一步()
    $.器官.脾.完整性 = 脾完整性下一步()
    $.器官.甲状腺.完整性 = 甲状腺完整性下一步()
    $.器官.肾上腺.完整性 = 肾上腺完整性下一步()
    $.器官.垂体.完整性 = 垂体完整性下一步()
    $.器官.卵巢.完整性 = 卵巢完整性下一步()
    $.器官.输卵管.完整性 = 输卵管完整性下一步()
    $.器官.乳腺.完整性 = 乳腺完整性下一步()

    $.器官.胃.功能 = 胃功能值()
    $.器官.小肠.功能 = 小肠功能值()
    $.器官.大肠.功能 = 大肠功能值()
    $.器官.肌肉.功能 = 肌肉功能值()
    $.器官.骨.功能 = 骨功能值()
    $.器官.胰.功能 = 胰功能值()
    $.器官.脾.功能 = 脾功能值()
    $.器官.甲状腺.功能 = 甲状腺功能值()
    $.器官.肾上腺.功能 = 肾上腺功能值()
    $.器官.垂体.功能 = 垂体功能值()
    $.器官.卵巢.功能 = 卵巢功能值()
    $.器官.输卵管.功能 = 输卵管功能值()
    $.器官.乳腺.功能 = 乳腺功能值()
  }
}
