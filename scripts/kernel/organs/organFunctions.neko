// 器官账本计算单元（L2）。
// 引擎的动作值不解析函数实参里的 $ 路径，所以每个器官一个无参函数，在 @函数 内部读字段。
@函数 脑功能值() -> int {
  返回 int({e}.器官.脑.完整性 * {e}.器官.脑.灌注 / 100)
}

@函数 心功能值() -> int {
  返回 int({e}.器官.心.完整性 * {e}.器官.心.灌注 / 100)
}

@函数 肺功能值() -> int {
  返回 int({e}.器官.肺.完整性 * {e}.器官.肺.灌注 / 100)
}

@函数 肝功能值() -> int {
  返回 int({e}.器官.肝.完整性 * {e}.器官.肝.灌注 / 100)
}

@函数 肾功能值() -> int {
  返回 int({e}.器官.肾.完整性 * {e}.器官.肾.灌注 / 100)
}

@函数 子宫功能值() -> int {
  if {e}.器官基础.子宫.存在 != true {
    返回 0
  }
  返回 int({e}.器官.子宫.完整性 * {e}.器官.子宫.灌注 / 100)
}

