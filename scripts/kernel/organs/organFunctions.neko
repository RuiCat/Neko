}

@函数 脑完整性下一步() -> int {
  应力 = {e}.器官.脑.应力
  完整 = {e}.器官.脑.完整性
  if 应力 > 0 {
    完整 = 完整 - 应力 / 10
  } else {
    完整 = 完整 + 1 + {e}.基础.属性.体质 / 50
  }
  if 完整 < 0 {
    完整 = 0
  }
  if 完整 > 100 {
    完整 = 100
  }
  返回 int(完整)
}

