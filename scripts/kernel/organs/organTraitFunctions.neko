// 器官性状计算单元（L2，3020 段）：敏感度合成、容量/直径/内容量派生、被动撑开。
// 规则只做「字段 = 函数(...)」；函数实参由引擎 resolver 解析 {e}.路径（已用 .local/probe2 验证）。
@函数 敏感度合成(基础:int, 训练:int, 药物:int, 伤害:int, 周期:int, 性反应:int) -> int {
  值 = 基础 + 训练 + 药物 + 伤害 + 周期 + 性反应
  if 值 < 0 {
    值 = 0
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 器官容量(静息容量:int, 弹性:int, 扩张度:int) -> int {
  值 = 静息容量 * (100 + 弹性 * 扩张度 / 100) / 100
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 器官直径(静息直径:int, 最大直径:int, 扩张度:int) -> int {
  值 = 静息直径 + (最大直径 - 静息直径) * 扩张度 / 100
  if 值 < 静息直径 {
    值 = 静息直径
  }
  if 值 > 最大直径 {
    值 = 最大直径
  }
  返回 int(值)
}

@函数 器官内容量(内容:list) -> int {
  总 = 0
  for 条 in 内容 {
    总 = 总 + 条.量
  }
  返回 int(总)
}

@函数 撑开应力(对象直径:int, 当前直径:int, 最大直径:int) -> int {
  if 对象直径 <= 当前直径 {
    返回 0
  }
  上限 = 最大直径
  if 上限 <= 当前直径 {
    上限 = 当前直径 + 1
  }
  值 = (对象直径 - 当前直径) * 100 / (上限 - 当前直径)
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 撑开破口(对象直径:int, 最大直径:int, 完整性:int) -> bool {
  if 对象直径 <= 最大直径 {
    返回 false
  }
  返回 完整性 <= 100 - (对象直径 - 最大直径) * 2
}

// 修正剩余：-1 = 永久；>=0 = 分钟倒计时，归零后由 修正值下一步 把值清空。
@函数 修正剩余下一步(剩余:int, 流逝:int) -> int {
  if 剩余 < 0 {
    返回 -1
  }
  值 = 剩余 - 流逝
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 修正值下一步(值:int, 剩余:int) -> int {
  if 剩余 == 0 {
    返回 0
  }
  返回 int(值)
}

// 破口时把当前内容量记为泄漏量；无破口归零。
// 破口时按 50% 漏出（持续破口会逐 tick 继续漏），非一次清空。
@函数 泄漏量下一步(破口:bool, 内容量:int) -> int {
  if 破口 == true {
    返回 int(内容量 / 2)
  }
  返回 0
}

// 内容条目追加：规则用动态实参构造条目，避免在规则里写含路径的 JSON 字面量。
@函数 内容追加(内容:list, 物质:str, 量:int, 能量:int, 水分:int, 温度:int) -> list {
  新 = []
  for 条 in 内容 {
    新.append(条)
  }
  条 = {"物质": 物质, "量": 量, "能量": 能量, "水分": 水分, "温度": 温度}
  新.append(条)
  返回 新
}

@函数 容器合并(甲:list, 乙:list) -> list {
  新 = []
  for 条 in 甲 {
    新.append(条)
  }
  for 条 in 乙 {
    新.append(条)
  }
  返回 新
}

// 按比例（0-100）取出/保留内容条目；比例取整到条目量，小于 1 丢弃。
@函数 内容转移(内容:list, 比例:int) -> list {
  新 = []
  for 条 in 内容 {
    取 = 条.量 * 比例 / 100
    if 取 > 0 {
      新.append({"物质": 条.物质, "量": 取, "能量": 条.能量 * 比例 / 100, "水分": 条.水分 * 比例 / 100, "温度": 条.温度})
    }
  }
  返回 新
}

@函数 内容保留(内容:list, 比例:int) -> list {
  新 = []
  for 条 in 内容 {
    留 = 条.量 - 条.量 * 比例 / 100
    if 留 > 0 {
      新.append({"物质": 条.物质, "量": 留, "能量": 条.能量 - 条.能量 * 比例 / 100, "水分": 条.水分 - 条.水分 * 比例 / 100, "温度": 条.温度})
    }
  }
  返回 新
}

@函数 内容吸收(内容:list, 比例:int) -> list {
  新 = []
  for 条 in 内容 {
    留 = 条.量 - 条.量 * 比例 / 100
    if 留 > 0 {
      新.append({"物质": 条.物质, "量": 留, "能量": 条.能量 - 条.能量 * 比例 / 100, "水分": 条.水分 - 条.水分 * 比例 / 100, "温度": 条.温度})
    }
  }
  返回 新
}

@函数 内容能量(内容:list) -> int {
  总 = 0
  for 条 in 内容 {
    总 = 总 + 条.能量
  }
  返回 int(总)
}

@函数 内容水分(内容:list) -> int {
  总 = 0
  for 条 in 内容 {
    总 = 总 + 条.水分
  }
  返回 int(总)
}

@函数 吸收比例(吸收率:int, 流逝:int) -> int {
  值 = 吸收率 * 流逝 / 60
  if 值 > 50 {
    值 = 50
  }
  返回 int(值)
}

@函数 蠕动比例(蠕动:int, 流逝:int) -> int {
  值 = 蠕动 * 流逝 / 600
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 溢出量下一步(内容量:int, 容量:int, 泄漏:int) -> int {
  if 内容量 > 容量 {
    返回 int(泄漏 + 内容量 - 容量)
  }
  返回 int(泄漏)
}

@函数 摄入能量下一步(当前:int, 胃输出:int, 肠输出:int) -> int {
  返回 int(当前 + 胃输出 + 肠输出)
}

@函数 摄入液下一步(当前:int, 胃输出:int, 肠输出:int) -> int {
  返回 int(当前 + 胃输出 + 肠输出)
}

// 吸收输出：规则里不写「函数调用 * 函数调用 / 100」这类算术，统一收进函数。
@函数 吸收能量输出(内容:list, 吸收率:int, 流逝:int) -> int {
  比例 = 吸收比例(吸收率, 流逝)
  返回 int(内容能量(内容) * 比例 / 100)
}

@函数 吸收液体输出(内容:list, 吸收率:int, 流逝:int) -> int {
  比例 = 吸收比例(吸收率, 流逝)
  返回 int(内容水分(内容) * 比例 / 100)
}

@函数 内容吸收比例(内容:list, 吸收率:int, 流逝:int) -> list {
  比例 = 吸收比例(吸收率, 流逝)
  返回 内容吸收(内容, 比例)
}

@函数 溢出判定(内容量:int, 容量:int) -> bool {
  返回 内容量 > 容量
}

// 溢出裁剪：按容量保留条目（可截断最后一条），返回不超过容量的内容列表。
@函数 内容限容(内容:list, 容量:int) -> list {
  新 = []
  已用 = 0
  for 条 in 内容 {
    余 = 容量 - 已用
    if 余 <= 0 {
      返回 新
    }
    留 = 条.量
    if 留 > 余 {
      留 = 余
    }
    if 留 > 0 {
      比 = 留 * 100 / 条.量
      新.append({"物质": 条.物质, "量": 留, "能量": 条.能量 * 比 / 100, "水分": 条.水分 * 比 / 100, "温度": 条.温度})
    }
    已用 = 已用 + 留
  }
  返回 新
}
