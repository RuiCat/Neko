    $.器官性状.食道.敏感度 = 敏感度合成({e}.器官性状.食道.敏感度基础, {e}.器官性状.食道.敏感度修正.训练.值, {e}.器官性状.食道.敏感度修正.药物.值, {e}.器官性状.食道.敏感度修正.伤害.值, {e}.器官性状.食道.敏感度修正.周期.值, {e}.器官性状.食道.敏感度修正.性反应.值)
    $.器官性状.食道.容量 = 器官容量({e}.器官性状.食道.静息容量, {e}.器官性状.食道.弹性, {e}.器官性状.食道.扩张度)
    $.器官性状.食道.当前直径 = 器官直径({e}.器官性状.食道.静息直径, {e}.器官性状.食道.最大直径, {e}.器官性状.食道.扩张度)
