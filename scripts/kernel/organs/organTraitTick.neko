// 器官性状 tick（L2，优先级 3020–3060）：修正过期 → 派生 → 撑开 → 泄漏 → 溢出 → 吸收 → 传输。
// 派生字段由本段函数唯一写入；传输/吸收只改器官性状自己的内容字段。
@规则[$[器官内核]] {
  优先级: 3020
  id: l2TraitDerive
  $.代谢.流逝分钟 > 0 {
    $.器官性状.口.敏感度修正.药物.剩余 = 修正剩余下一步({e}.器官性状.口.敏感度修正.药物.剩余, {e}.代谢.流逝分钟)
    $.器官性状.口.敏感度修正.伤害.剩余 = 修正剩余下一步({e}.器官性状.口.敏感度修正.伤害.剩余, {e}.代谢.流逝分钟)
    $.器官性状.口.敏感度修正.性反应.剩余 = 修正剩余下一步({e}.器官性状.口.敏感度修正.性反应.剩余, {e}.代谢.流逝分钟)
    $.器官性状.口.敏感度修正.药物.值 = 修正值下一步({e}.器官性状.口.敏感度修正.药物.值, {e}.器官性状.口.敏感度修正.药物.剩余)
    $.器官性状.口.敏感度修正.伤害.值 = 修正值下一步({e}.器官性状.口.敏感度修正.伤害.值, {e}.器官性状.口.敏感度修正.伤害.剩余)
    $.器官性状.口.敏感度修正.性反应.值 = 修正值下一步({e}.器官性状.口.敏感度修正.性反应.值, {e}.器官性状.口.敏感度修正.性反应.剩余)
    $.器官性状.口.敏感度 = 敏感度合成({e}.器官性状.口.敏感度基础, {e}.器官性状.口.敏感度修正.训练.值, {e}.器官性状.口.敏感度修正.药物.值, {e}.器官性状.口.敏感度修正.伤害.值, {e}.器官性状.口.敏感度修正.周期.值, {e}.器官性状.口.敏感度修正.性反应.值)
    $.器官性状.口.容量 = 器官容量({e}.器官性状.口.静息容量, {e}.器官性状.口.弹性, {e}.器官性状.口.扩张度)
    $.器官性状.口.当前直径 = 器官直径({e}.器官性状.口.静息直径, {e}.器官性状.口.最大直径, {e}.器官性状.口.扩张度)
    $.器官性状.口.内容量 = 器官内容量({e}.器官性状.口.内容)
    $.器官性状.口.插入应力 = 撑开应力({e}.器官性状.口.对象直径, {e}.器官性状.口.当前直径, {e}.器官性状.口.最大直径)
    $.器官性状.口.破口 = 撑开破口({e}.器官性状.口.对象直径, {e}.器官性状.口.最大直径, {e}.器官.口.完整性)
    $.器官性状.口.泄漏量 = 泄漏量下一步({e}.器官性状.口.破口, {e}.器官性状.口.内容量)
    $.器官性状.口.泄漏量 = 溢出量下一步({e}.器官性状.口.内容量, {e}.器官性状.口.容量, {e}.器官性状.口.泄漏量)
    $.器官性状.口.内容 = 内容限容({e}.器官性状.口.内容, {e}.器官性状.口.容量)
    $.器官性状.口.内容量 = 器官内容量({e}.器官性状.口.内容)
    $.器官性状.食道.敏感度修正.药物.剩余 = 修正剩余下一步({e}.器官性状.食道.敏感度修正.药物.剩余, {e}.代谢.流逝分钟)
    $.器官性状.食道.敏感度修正.伤害.剩余 = 修正剩余下一步({e}.器官性状.食道.敏感度修正.伤害.剩余, {e}.代谢.流逝分钟)
    $.器官性状.食道.敏感度修正.性反应.剩余 = 修正剩余下一步({e}.器官性状.食道.敏感度修正.性反应.剩余, {e}.代谢.流逝分钟)
