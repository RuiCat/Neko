@规则[$[器官内核]] {
  优先级: 3060
  id: l2Move0
  $.器官性状.口.内容量 > 0 ∧ $.器官性状.口.蠕动 > 0 {
    $.器官性状.食道.内容 = 容器合并({e}.器官性状.食道.内容, 内容转移({e}.器官性状.口.内容, 蠕动比例({e}.器官性状.口.蠕动, {e}.代谢.流逝分钟)))
    $.器官性状.口.内容 = 内容保留({e}.器官性状.口.内容, 蠕动比例({e}.器官性状.口.蠕动, {e}.代谢.流逝分钟))
  }
}

