@规则[$[器官内核]] {
  优先级: 3025
  id: l2LeakClearMouth
  $.器官性状.口.破口 = true ∧ $.器官性状.口.内容量 > 0 {
    $.器官性状.口.内容 = 内容保留({e}.器官性状.口.内容, 50)
    $.器官性状.口.内容量 = 器官内容量({e}.器官性状.口.内容)
  }
}

