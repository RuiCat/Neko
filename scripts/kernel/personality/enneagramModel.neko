// 九型人格内核（L12）：静态类型 + 侧翼 + 动态健康层级。
// 类型/侧翼是数据（0 = 未设定，由角色数据写入）；中心/整合/分裂/核心恐惧/欲望/防御由类型派生；
// 压力值/成长值由社交、伤害、情感、记忆派生；健康层级 1（最健康）..9（最不健康）。
@定义 九型人格内核 {
  "九型": {
    "类型[int,min:0,max:9]": 0,
    "类型名[str]": "",
    "侧翼[str]": "",
    "中心[str]": "",
    "整合方向[int,min:0,max:9]": 0,
    "分裂方向[int,min:0,max:9]": 0,
    "核心恐惧[str]": "",
    "核心欲望[str]": "",
    "防御机制[str]": "",
    "健康层级[int,min:1,max:9]": 5,
    "压力值[int,min:0,max:100]": 0,
    "成长值[int,min:0,max:100]": 0,
    "应激反应[str]": "",
    "上次类型[int,min:0,max:9]": 0
  }
}
