// 九型人格域计算单元（L12，8535–8539）。
// 只做「类型 → 静态档案」与「压力/成长 → 健康层级」的纯计算，不写实体字段。

@函数 九型类型名(类型:int) -> str {
  if 类型 == 1 { 返回 "完美型" }
  if 类型 == 2 { 返回 "助人型" }
  if 类型 == 3 { 返回 "成就型" }
  if 类型 == 4 { 返回 "浪漫型" }
  if 类型 == 5 { 返回 "观察型" }
  if 类型 == 6 { 返回 "忠诚型" }
  if 类型 == 7 { 返回 "活跃型" }
  if 类型 == 8 { 返回 "领袖型" }
  if 类型 == 9 { 返回 "和平型" }
  返回 ""
}

@函数 九型中心(类型:int) -> str {
  if 类型 == 1 { 返回 "本能" }
  if 类型 == 8 { 返回 "本能" }
  if 类型 == 9 { 返回 "本能" }
  if 类型 == 2 { 返回 "情感" }
  if 类型 == 3 { 返回 "情感" }
  if 类型 == 4 { 返回 "情感" }
  if 类型 == 5 { 返回 "思维" }
  if 类型 == 6 { 返回 "思维" }
  if 类型 == 7 { 返回 "思维" }
  返回 ""
}

// 整合方向：压力低、状态好时吸收的方向。
@函数 九型整合(类型:int) -> int {
  if 类型 == 1 { 返回 7 }
  if 类型 == 2 { 返回 4 }
  if 类型 == 3 { 返回 6 }
  if 类型 == 4 { 返回 1 }
  if 类型 == 5 { 返回 8 }
  if 类型 == 6 { 返回 9 }
  if 类型 == 7 { 返回 5 }
  if 类型 == 8 { 返回 2 }
  if 类型 == 9 { 返回 3 }
  返回 0
}

// 分裂方向：压力高、状态差时滑落的方向。
@函数 九型分裂(类型:int) -> int {
  if 类型 == 1 { 返回 4 }
  if 类型 == 2 { 返回 8 }
  if 类型 == 3 { 返回 9 }
  if 类型 == 4 { 返回 2 }
  if 类型 == 5 { 返回 7 }
  if 类型 == 6 { 返回 3 }
  if 类型 == 7 { 返回 1 }
  if 类型 == 8 { 返回 5 }
  if 类型 == 9 { 返回 6 }
  返回 0
}

@函数 九型恐惧(类型:int) -> str {
  if 类型 == 1 { 返回 "做错、腐化、不完美" }
  if 类型 == 2 { 返回 "不被需要、不被爱" }
  if 类型 == 3 { 返回 "没有价值、失败" }
  if 类型 == 4 { 返回 "没有自我、平庸" }
  if 类型 == 5 { 返回 "无能、被耗尽" }
  if 类型 == 6 { 返回 "失去支持、不确定" }
  if 类型 == 7 { 返回 "被剥夺、被困在痛苦里" }
  if 类型 == 8 { 返回 "被控制、被伤害" }
  if 类型 == 9 { 返回 "失去连接、冲突" }
  返回 ""
}

@函数 九型欲望(类型:int) -> str {
  if 类型 == 1 { 返回 "正确、完好" }
  if 类型 == 2 { 返回 "被爱、被需要" }
  if 类型 == 3 { 返回 "有价值、被认可" }
  if 类型 == 4 { 返回 "独特、真实的自我" }
  if 类型 == 5 { 返回 "有能力、理解世界" }
  if 类型 == 6 { 返回 "安全、确定" }
  if 类型 == 7 { 返回 "满足、自由" }
  if 类型 == 8 { 返回 "自主、掌控" }
  if 类型 == 9 { 返回 "内在平静、和谐" }
  返回 ""
}

@函数 九型防御(类型:int) -> str {
  if 类型 == 1 { 返回 "反应形成" }
  if 类型 == 2 { 返回 "压抑需求" }
  if 类型 == 3 { 返回 "认同" }
  if 类型 == 4 { 返回 "内投" }
  if 类型 == 5 { 返回 "隔离" }
  if 类型 == 6 { 返回 "投射" }
  if 类型 == 7 { 返回 "合理化" }
  if 类型 == 8 { 返回 "否认" }
  if 类型 == 9 { 返回 "麻醉" }
  返回 ""
}

// 压力 = 孤单/2 + 疼痛/3 + 情绪印记/5 + 负效价/4，夹在 0..100。
@函数 九型压力下一步() -> int {
  值 = {e}.社交.孤单 / 2 + {e}.伤害.疼痛 / 3 + {e}.记忆.情绪印记 / 5
  if {e}.情感.效价 < 0 {
    值 = 值 + (0 - {e}.情感.效价) / 4
  }
  if 值 < 0 { 值 = 0 }
  if 值 > 100 { 值 = 100 }
  返回 int(值)
}

// 成长 = 长期记忆/2 + 主人互动/2，夹在 0..100。
@函数 九型成长下一步() -> int {
  值 = {e}.记忆.长期负荷 / 2 + {e}.社交.主人互动 / 2
  if 值 < 0 { 值 = 0 }
  if 值 > 100 { 值 = 100 }
  返回 int(值)
}

// 层级 = 5 - 成长/25 + 压力/25，夹在 1..9：成长推向 1，压力推向 9。
@函数 九型层级下一步() -> int {
  值 = 5 - {e}.九型.成长值 / 25 + {e}.九型.压力值 / 25
  if 值 < 1 { 值 = 1 }
  if 值 > 9 { 值 = 9 }
  返回 int(值)
}

@函数 九型应激() -> str {
  if {e}.九型.健康层级 <= 3 { 返回 "整合" }
  if {e}.九型.健康层级 >= 7 { 返回 "分裂" }
  返回 "常态"
}

// 类型有效，且（首次推导 / 类型被改写）时需要重算静态档案。
@函数 九型需推导() -> bool {
  if {e}.九型.类型 <= 0 { 返回 false }
  if {e}.九型.中心 == "" { 返回 true }
  返回 {e}.九型.上次类型 != {e}.九型.类型
}
