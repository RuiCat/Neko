// 九型人格结算（L12，8535–8539）。
// 8535 静态档案：类型变化时重算中心/整合/分裂/恐惧/欲望/防御；
// 8536 动态层级：每 tick 由社交/伤害/情感/记忆派生压力、成长、健康层级与应激反应。
@规则[$[九型人格内核]] {
  优先级: 8535
  id: enDerive
  九型需推导() == true {
    $.九型.类型名 = 九型类型名({e}.九型.类型)
    $.九型.中心 = 九型中心({e}.九型.类型)
    $.九型.整合方向 = 九型整合({e}.九型.类型)
    $.九型.分裂方向 = 九型分裂({e}.九型.类型)
    $.九型.核心恐惧 = 九型恐惧({e}.九型.类型)
    $.九型.核心欲望 = 九型欲望({e}.九型.类型)
    $.九型.防御机制 = 九型防御({e}.九型.类型)
    $.九型.上次类型 = $.九型.类型
  }
}

@规则[$[九型人格内核]] {
  优先级: 8536
  id: enDynamics
  $.九型.类型 > 0 {
    $.九型.压力值 = 九型压力下一步()
    $.九型.成长值 = 九型成长下一步()
    $.九型.健康层级 = 九型层级下一步()
    $.九型.应激反应 = 九型应激()
  }
}
