// 人格内核（L12，静态倾向）：大五人格 + MBTI + 气质类型 + 情绪稳定性。
// 只提供状态位，不产生行为；决策层按这些值调整语气/行动倾向。
@定义 人格内核 {
  "人格": {
    "开放性[int,min:0,max:100]": 50,
    "尽责性[int,min:0,max:100]": 50,
    "外向性[int,min:0,max:100]": 50,
    "宜人性[int,min:0,max:100]": 50,
    "神经质[int,min:0,max:100]": 50,
    "MBTI": "",
    "气质类型": "",
    "稳定性[int,min:0,max:100]": 50
  }
}
