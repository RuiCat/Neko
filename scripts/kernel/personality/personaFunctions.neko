// 人设域计算单元（L12，8590–8592）。
// 表达倾向 = 九型健康层级/中心 + 当前情绪 + 人格 MBTI 的合成标签，给决策层一个可读提示。

@函数 人设表达倾向() -> str {
  基调 = "平和"
  if {e}.九型.健康层级 <= 3 { 基调 = "松弛" }
  if {e}.九型.健康层级 >= 7 { 基调 = "紧绷" }
  if {e}.九型.中心 == "情感" { 基调 = 基调 + "·共情" }
  if {e}.九型.中心 == "思维" { 基调 = 基调 + "·分析" }
  if {e}.九型.中心 == "本能" { 基调 = 基调 + "·直接" }
  if {e}.情感.情绪 != "" and {e}.情感.情绪 != "平静" { 基调 = 基调 + "·" + {e}.情感.情绪 }
  if {e}.人格.MBTI != "" { 基调 = 基调 + "·" + {e}.人格.MBTI }
  返回 基调
}

@函数 人设需同步自称() -> bool {
  if {e}.人设.自称 == "" { 返回 false }
  返回 {e}.人设.自称 != {e}.自称
}

@函数 人设需同步主人称呼() -> bool {
  if {e}.人设.对主人称呼 == "" { 返回 false }
  返回 {e}.人设.对主人称呼 != {e}.对主人称呼
}
