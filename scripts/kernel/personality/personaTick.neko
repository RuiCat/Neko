// 人设结算（L12，8590–8592）。
// 8590 表达倾向；8591/8592 把 人设.* 同步到 DSH 桥接读取的顶层路径（单向、非空才写）。
@规则[$[人设内核]] {
  优先级: 8590
  id: peTone
  $.人设.表达倾向 != 人设表达倾向() {
    $.人设.表达倾向 = 人设表达倾向()
  }
}

@规则[$[人设内核]] {
  优先级: 8591
  id: peSelfName
  人设需同步自称() == true {
    $.自称 = $.人设.自称
  }
}

@规则[$[人设内核]] {
  优先级: 8592
  id: peOwnerName
  人设需同步主人称呼() == true {
    $.对主人称呼 = $.人设.对主人称呼
  }
}
