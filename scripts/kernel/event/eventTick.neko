// 事件状态机（L13，优先级 8540–8579）。角色无关：任何组合了事件内核的实体都可推进。
// 上层只写 事件.当前（事件模板 id）与 推进=true；本层读模板推进阶段。
@规则[$[事件内核]] {
  优先级: 8540
  id: evStart
  $.事件.当前 != "" ∧ $.事件.阶段数 = 0 {
    $.事件.阶段数 = 事件阶段数()
    $.事件.阶段 = 0
    $.事件.阶段名 = 事件当前阶段名()
    $.事件.对话 = 事件当前对话()
    $.事件.结果 = ""
  }
}

@规则[$[事件内核]] {
  优先级: 8550
  id: evAdvance
  $.事件.推进 = true ∧ $.事件.阶段数 > 0 ∧ 事件是否最后阶段() = false {
    $.事件.阶段 = 事件下一阶段()
    $.事件.阶段名 = 事件当前阶段名()
    $.事件.对话 = 事件当前对话()
    $.事件.推进 = false
  }
}

@规则[$[事件内核]] {
  优先级: 8560
  id: evFinish
  $.事件.推进 = true ∧ $.事件.阶段数 > 0 ∧ 事件是否最后阶段() = true {
    $.事件.结果 = "结束"
    $.事件.当前 = ""
    $.事件.阶段 = 0
    $.事件.阶段数 = 0
    $.事件.阶段名 = ""
    $.事件.对话 = ""
    $.事件.推进 = false
  }
}

@规则[$[事件内核]] {
  优先级: 8570
  id: evReset
  $.事件.当前 = "" ∧ $.事件.阶段数 > 0 {
    $.事件.阶段 = 0
    $.事件.阶段数 = 0
    $.事件.阶段名 = ""
    $.事件.对话 = ""
  }
}
