// 事件域计算单元（L13）。事件模板按实体 id 读取（模板实例是普通实体）。
@函数 事件阶段数() -> int {
  名 = {e}.事件.当前
  if 名 == "" {
    返回 0
  }
  列表 = 名.阶段流程
  返回 len(列表)
}

@函数 事件当前阶段名() -> str {
  名 = {e}.事件.当前
  if 名 == "" {
    返回 ""
  }
  列表 = 名.阶段流程
  项 = 列表[{e}.事件.阶段]
  返回 项.阶段
}

@函数 事件当前对话() -> str {
  名 = {e}.事件.当前
  if 名 == "" {
    返回 ""
  }
  列表 = 名.阶段流程
  项 = 列表[{e}.事件.阶段]
  行 = 项.对话
  if len(行) == 0 {
    返回 ""
  }
  返回 行[0]
}

@函数 事件下一阶段() -> int {
  返回 int({e}.事件.阶段 + 1)
}

@函数 事件是否最后阶段() -> bool {
  返回 {e}.事件.阶段 + 1 >= {e}.事件.阶段数
}
