// 世界时段规则（业务在脚本层）：时间字符串 → 阶段标签，每个 tick 自校准。
// 兼容 world_clock 工具写入的 RFC3339 时间（小时位于第 11–13 字节）。
@函数 时段判断(时间:str) -> str {
  小时 = int(时间[11:13])
  if 小时 >= 6 ∧ 小时 < 10 {
    返回 "清晨"
  }
  if 小时 >= 10 ∧ 小时 < 14 {
    返回 "上午"
  }
  if 小时 >= 14 ∧ 小时 < 18 {
    返回 "下午"
  }
  if 小时 >= 18 ∧ 小时 < 22 {
    返回 "傍晚"
  }
  if 小时 >= 22 {
    返回 "深夜"
  }
  返回 "凌晨"
}

@函数 世界时段() -> str {
  return 时段判断({e}.环境.当前时间)
}

@规则[$[世界]] {
  优先级: 600
  id: wPhase
  $.环境.当前时间 != "" ∧ $.状态.阶段 != 世界时段() {
    $.状态.阶段 = 世界时段()
  }
}
