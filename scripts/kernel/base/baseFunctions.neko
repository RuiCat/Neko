// B 层派生计算：属性、性成熟、可孕、代谢修正、年龄进位。
// 属性 = clamp(50 + 种族修正 + 特征加成 + 年龄修正, 1, 100)。
// 年龄修正是「未成年 / 老年」两档，分界由 寿命 × 判定阈值.老年比例 决定。
// 种族修正读 种族参数.属性修正.*（由 baseInitTick 按种族写入），脚本里不再出现种族名；
// 特征加成读部位模板自己的字段（猫耳.灵敏 / 猫尾.平衡 / 尖耳.感知）。
// 见 docs/base-data-definition.md。

// 年龄阈值按 种族参数.寿命 的比例给出，不再写死 60/40 岁。
// 80 岁人族 → 老年 60、衰退 40（与原实现一致）；500 岁精灵 → 老年 375、衰退 250。
@函数 基础老年年龄() -> int {
  寿 = {e}.种族参数.寿命
  if 寿 < 1 {
    寿 = 80
  }
  返回 int(寿 * {e}.判定阈值.老年比例 / 100)
}

@函数 基础衰退年龄() -> int {
  寿 = {e}.种族参数.寿命
  if 寿 < 1 {
    寿 = 80
  }
  返回 int(寿 * {e}.判定阈值.衰退比例 / 100)
}

@函数 基础属性体质() -> int {
  值 = 50
  值 = 值 + {e}.种族参数.属性修正.体质
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    值 = 值 + (-10)
  } else if {e}.基础.年龄 > 基础老年年龄() {
    值 = 值 + (-15)
  }
  if 值 < 1 {
    值 = 1
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 基础属性感知() -> int {
  值 = 50
  值 = 值 + {e}.种族参数.属性修正.感知
  if {e}.猫耳.灵敏 > 0 {
    值 = 值 + {e}.猫耳.灵敏 / 10
  }
  if {e}.狐耳.灵敏 > 0 {
    值 = 值 + {e}.狐耳.灵敏 / 10
  }
  if {e}.犬耳.灵敏 > 0 {
    值 = 值 + {e}.犬耳.灵敏 / 10
  }
  if {e}.尖耳.感知 > 0 {
    值 = 值 + {e}.尖耳.感知
  }
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    值 = 值 + (0)
  } else if {e}.基础.年龄 > 基础老年年龄() {
    值 = 值 + (-5)
  }
  if 值 < 1 {
    值 = 1
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 基础属性敏捷() -> int {
  值 = 50
  值 = 值 + {e}.种族参数.属性修正.敏捷
  if {e}.猫尾.平衡 > 0 {
    值 = 值 + {e}.猫尾.平衡 / 2
  }
  if {e}.狐尾.平衡 > 0 {
    值 = 值 + {e}.狐尾.平衡 / 2
  }
  if {e}.犬尾.平衡 > 0 {
    值 = 值 + {e}.犬尾.平衡 / 2
  }
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    值 = 值 + (-10)
  } else if {e}.基础.年龄 > 基础老年年龄() {
    值 = 值 + (-10)
  }
  if 值 < 1 {
    值 = 1
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

