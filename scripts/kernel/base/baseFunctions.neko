@函数 基础性成熟下一步() -> bool {
  返回 {e}.基础.年龄 >= {e}.种族参数.成熟年龄
}

@函数 基础可孕下一步() -> bool {
  if {e}.基础.性成熟 != true {
    返回 false
  }
  if {e}.基础.性别 != "女" ∧ {e}.基础.性别 != "双性" {
    返回 false
  }
  返回 {e}.基础.年龄 <= {e}.种族参数.生育上限
}

@函数 基础代谢修下一步() -> int {
  系数 = 1000
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    系数 = 1100
  } else if {e}.基础.年龄 > 基础衰退年龄() {
    系数 = 1000 - ({e}.基础.年龄 - 基础衰退年龄()) * 5
    if 系数 < 800 {
      系数 = 800
    }
  }
  值 = {e}.种族参数.代谢系数 * 系数 / 1000
  if 值 < 500 {
    值 = 500
  }
  if 值 > 2000 {
    值 = 2000
  }
  返回 int(值)
}

@函数 基础年龄分钟下一步() -> int {
  值 = {e}.基础.年龄分钟 + {e}.代谢.流逝分钟
  if 值 > 525600 {
    值 = 525600
  }
  返回 int(值)
}

@函数 基础年龄下一步() -> int {
  值 = {e}.基础.年龄 + 1
  if 值 > 800 {
    值 = 800
  }
  返回 int(值)
}

@函数 基础年龄分钟进位() -> int {
  值 = {e}.基础.年龄分钟 - 525600
  if 值 < 0 {
    值 = 0
  }
  返回 int(值)
}

@函数 基础寿终判定() -> bool {
  if {e}.基础.年龄 > {e}.种族参数.寿命 {
    返回 true
  }
  返回 false
}
