// B 层派生计算：属性、性成熟、可孕、代谢修正、年龄进位。
// 属性 = clamp(50 + 种族修正 + 年龄修正, 1, 100)；种族与年龄修正见 docs/base-data-definition.md。

@函数 基础属性体质() -> int {
  值 = 50
  if {e}.基础.种族 == "猫娘" {
    值 = 值 + (-5)
  }
  if {e}.基础.种族 == "犬娘" {
    值 = 值 + (5)
  }
  if {e}.基础.种族 == "狐娘" {
    值 = 值 + (0)
  }
  if {e}.基础.种族 == "人族" {
    值 = 值 + (0)
  }
  if {e}.基础.种族 == "精灵" {
    值 = 值 + (-8)
  }
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    值 = 值 + (-10)
  } else if {e}.基础.年龄 > 60 {
    值 = 值 + (-15)
  }
  if 值 < 1 {
    值 = 1
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 基础属性感知() -> int {
  值 = 50
  if {e}.猫耳.灵敏 > 0 {
    值 = 值 + {e}.猫耳.灵敏 / 10
  }
  if {e}.狐耳.灵敏 > 0 {
    值 = 值 + {e}.狐耳.灵敏 / 10
  }
  if {e}.犬耳.灵敏 > 0 {
    值 = 值 + {e}.犬耳.灵敏 / 10
  }
  if {e}.尖耳.感知 > 0 {
    值 = 值 + {e}.尖耳.感知
  }
  if {e}.基础.种族 == "猫娘" {
    值 = 值 + (10)
  }
  if {e}.基础.种族 == "犬娘" {
    值 = 值 + (12)
  }
  if {e}.基础.种族 == "狐娘" {
    值 = 值 + (8)
  }
  if {e}.基础.种族 == "人族" {
    值 = 值 + (0)
  }
  if {e}.基础.种族 == "精灵" {
    值 = 值 + (10)
  }
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    值 = 值 + (0)
  } else if {e}.基础.年龄 > 60 {
    值 = 值 + (-5)
  }
  if 值 < 1 {
    值 = 1
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 基础属性敏捷() -> int {
  值 = 50
  if {e}.猫尾.平衡 > 0 {
    值 = 值 + {e}.猫尾.平衡 / 2
  }
  if {e}.狐尾.平衡 > 0 {
    值 = 值 + {e}.狐尾.平衡 / 2
  }
  if {e}.犬尾.平衡 > 0 {
    值 = 值 + {e}.犬尾.平衡 / 2
  }
  if {e}.基础.种族 == "猫娘" {
    值 = 值 + (15)
  }
  if {e}.基础.种族 == "犬娘" {
    值 = 值 + (8)
  }
  if {e}.基础.种族 == "狐娘" {
    值 = 值 + (12)
  }
  if {e}.基础.种族 == "人族" {
    值 = 值 + (0)
  }
  if {e}.基础.种族 == "精灵" {
    值 = 值 + (10)
  }
  if {e}.基础.年龄 < {e}.种族参数.成熟年龄 {
    值 = 值 + (-10)
  } else if {e}.基础.年龄 > 60 {
    值 = 值 + (-10)
  }
  if 值 < 1 {
    值 = 1
  }
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

