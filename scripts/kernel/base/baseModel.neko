// B 层（基础数据，优先级 500–899）：身份/体型/属性、种族参数、器官静态账本、规范状态账本。
// 只写 基础.* / 种族参数.* / 器官基础.*；角色状态.* 由 L5 投影写。
// 种族默认空 = 未设定；由修饰模板写入（traits/traitRules.neko）：
//   组合了 猫娘/犬娘/狐娘/精灵/人族 修饰 → 该种族，种族来源 "trait"
//   没有任何种族修饰（裸 角色基础、只加外形特征）→ 人族，种族来源 "default"
// 已认领：由种族修饰规则写入，标记「种族参数已按某个种族落值」，避免重复结算。
// 生命阶段由 幼年/成年 修饰写入，与种族正交、可叠加。
// 年龄已知：年龄 > 0 即视为已知（由 bInitAgeKnown 在初始化时推导）；
// 内容层也可以显式写 年龄已知 覆盖——所以要区分「显式设过」与「还没推导」
// （年龄已知显式 = true 表示内容层自己写过 年龄已知，推导规则不覆盖）。
// 种族差异一律走数据：种族参数.*（含 属性修正.*），脚本里不出现种族名。
@定义 基础内核 {
  "基础": {
    "名字[str]": "",
    "昵称[str]": "",
    "自称[str]": "",
    "对主人称呼[str]": "",
    "年龄[int,min:0,max:200]": 0,
    "年龄分钟[int,min:0,max:525600]": 0,
    "年龄已知[bool]": false,
    "年龄已知显式[bool]": false,
    "自动增龄[bool]": false,
    "生日月[int,min:1,max:12]": 1,
    "生日日[int,min:1,max:31]": 1,
    "性别[str]": "未知",
    "生命阶段[str]": "",
    "种族[str]": "",
    "种族来源[str]": "",
    "身高[int,min:20,max:300]": 170,
    "体重[int,min:200,max:300000]": 60000,
    "已初始化[bool]": false,
    "性成熟[bool]": false,
    "可孕[bool]": false,
    "代谢修正[int,min:500,max:2000]": 1000,
    "属性": {
      "体质[int,min:1,max:100]": 50,
      "感知[int,min:1,max:100]": 50,
      "敏捷[int,min:1,max:100]": 50,
      "智力[int,min:1,max:100]": 50,
      "魅力[int,min:1,max:100]": 50,
      "意志[int,min:1,max:100]": 50,
      "幸运[int,min:1,max:100]": 50
    },
    "特性": []
  },
  "种族参数": {
    "类别[str]": "人族",
    "成熟年龄[int,min:1,max:100]": 18,
    "寿命[int,min:1,max:1000]": 80,
    "基础体温[int,min:320,max:430]": 368,
    "基础心率[int,min:30,max:220]": 72,
    "基础呼吸[int,min:4,max:60]": 14,
    "代谢系数[int,min:500,max:2000]": 1000,
    "孕期周[int,min:1,max:90]": 40,
    "周期天[int,min:1,max:60]": 28,
    "体型系数[int,min:500,max:2000]": 1000,
    "生育上限[int,min:1,max:100]": 50,
    "已认领[bool]": false,
    "属性修正": {
      "体质[int,min:-50,max:50]": 0,
      "感知[int,min:-50,max:50]": 0,
      "敏捷[int,min:-50,max:50]": 0,
      "智力[int,min:-50,max:50]": 0,
      "魅力[int,min:-50,max:50]": 0,
      "意志[int,min:-50,max:50]": 0,
      "幸运[int,min:-50,max:50]": 0
    }
  },
  "器官基础": {
    "脑": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 200, "必需[bool]": true},
    "心": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 50, "必需[bool]": true},
    "肺": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 100, "必需[bool]": true},
    "肝": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 260, "必需[bool]": true},
    "肾": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 40, "必需[bool]": true},
    "胃": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 100, "必需[bool]": false},
    "小肠": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 200, "必需[bool]": false},
    "大肠": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 150, "必需[bool]": false},
    "皮肤": {"存在[bool]": true, "类别[str]": "屏障", "质量占比[int,min:0,max:10000]": 800, "必需[bool]": true},
    "肌肉": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 4000, "必需[bool]": false},
    "骨": {"存在[bool]": true, "类别[str]": "支撑", "质量占比[int,min:0,max:10000]": 1500, "必需[bool]": false},
    "胰": {"存在[bool]": true, "类别[str]": "腺体", "质量占比[int,min:0,max:10000]": 15, "必需[bool]": false},
    "脾": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 20, "必需[bool]": false},
    "甲状腺": {"存在[bool]": true, "类别[str]": "腺体", "质量占比[int,min:0,max:10000]": 2, "必需[bool]": false},
    "肾上腺": {"存在[bool]": true, "类别[str]": "腺体", "质量占比[int,min:0,max:10000]": 1, "必需[bool]": false},
    "垂体": {"存在[bool]": true, "类别[str]": "腺体", "质量占比[int,min:0,max:10000]": 1, "必需[bool]": false},
    "子宫": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 20, "必需[bool]": false},
    "阴道": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 5, "必需[bool]": false},
    "宫颈": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 3, "必需[bool]": false},
    "直肠": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 30, "必需[bool]": false},
    "膀胱": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 10, "必需[bool]": false},
    "食管": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 10, "必需[bool]": false},
    "卵巢": {"存在[bool]": true, "类别[str]": "实质", "质量占比[int,min:0,max:10000]": 2, "必需[bool]": false},
    "输卵管": {"存在[bool]": true, "类别[str]": "空腔", "质量占比[int,min:0,max:10000]": 1, "必需[bool]": false},
    "乳腺": {"存在[bool]": true, "类别[str]": "腺体", "质量占比[int,min:0,max:10000]": 50, "必需[bool]": false}
  },
  "角色状态": {
    "体力[int,min:0,max:100]": 75,
    "饱食[int,min:0,max:100]": 82,
    "水分[int,min:0,max:100]": 60,
    "饥饿[int,min:0,max:100]": 0,
    "口渴[int,min:0,max:100]": 0,
    "疼痛[int,min:0,max:100]": 0,
    "疲劳[int,min:0,max:100]": 0,
    "精力[int,min:0,max:100]": 100,
    "清洁[int,min:0,max:100]": 85,
    "舒适[int,min:0,max:100]": 60,
    "睡眠[str]": "清醒",
    "情绪[str]": "平静",
    "情绪强度[int,min:0,max:10]": 0,
    "身体状态[str]": "正常",
    "昏迷[bool]": false,
    "最近事件[str]": ""
  }
}
