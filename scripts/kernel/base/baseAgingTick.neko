// B 层增龄（600–620，默认关闭）：年龄分钟累加、满 525600 进位、进位后重算派生。
@规则[$[基础内核]] {
  优先级: 600
  id: bAgeMinutes
  $.基础.自动增龄 = true {
    $.基础.年龄分钟 = 基础年龄分钟下一步()
  }
}

@规则[$[基础内核]] {
  优先级: 610
  id: bAgeCarry
  $.基础.年龄分钟 >= 525600 {
    $.基础.年龄 = 基础年龄下一步()
    $.基础.年龄分钟 = 基础年龄分钟进位()
  }
}

@规则[$[基础内核]] {
  优先级: 620
  id: bAgeDerive
  $.基础.自动增龄 = true {
    $.基础.性成熟 = 基础性成熟下一步()
    $.基础.可孕 = 基础可孕下一步()
    $.基础.代谢修正 = 基础代谢修下一步()
  }
}
