// B 层初始化（590 段收尾）：属性 → 性别专属器官 → 派生落值。
//
// 种族/生命阶段不在这里判定：它们是**修饰模板**（traits/traitsModel.neko），
// 由同名规则在 469–482 段把状态写到自身（traits/traitRules.neko），早于本文件。
// 本文件只消费已经写好的 种族参数.*，不再按种族名分支。
// 490：年龄已知推导。年龄 > 0 即视为已知——上层消费层（性成熟/可孕/代谢修正/增龄）
// 全靠这个开关，而它默认 false 且从无规则写入，导致「20 岁也不会性成熟」。
// 内容层显式写过 年龄已知 时（年龄已知显式=true）不覆盖。
@规则[$[基础内核]] {
  优先级: 490
  id: bInitAgeKnown
  $.基础.年龄已知显式 = false ∧ $.基础.年龄 > 0 ∧ $.基础.年龄已知 = false {
    $.基础.年龄已知 = true
  }
}

@规则[$[基础内核]] {
  优先级: 520
  id: bInitAttributes
  $.基础.已初始化 = false {
    $.基础.属性.体质 = 基础属性体质()
    $.基础.属性.感知 = 基础属性感知()
    $.基础.属性.敏捷 = 基础属性敏捷()
    $.基础.属性.智力 = 基础属性智力()
    $.基础.属性.魅力 = 基础属性魅力()
    $.基础.属性.意志 = 基础属性意志()
    $.基础.属性.幸运 = 基础属性幸运()
  }
}

@规则[$[基础内核]] {
  优先级: 530
  id: bInitOrgansFemale
  $.基础.已初始化 = false ∧ ($.基础.性别 = "女" ∨ $.基础.性别 = "双性") {
    $.器官基础.子宫.存在 = true
    $.器官基础.阴道.存在 = true
    $.器官基础.宫颈.存在 = true
    $.器官基础.卵巢.存在 = true
    $.器官基础.输卵管.存在 = true
    $.器官基础.乳腺.存在 = true
  }
}

@规则[$[基础内核]] {
  优先级: 531
  id: bInitOrgansMale
  $.基础.已初始化 = false ∧ ($.基础.性别 = "男" ∨ $.基础.性别 = "无性") {
    $.器官基础.子宫.存在 = false
    $.器官基础.阴道.存在 = false
    $.器官基础.宫颈.存在 = false
    $.器官基础.卵巢.存在 = false
    $.器官基础.输卵管.存在 = false
    $.器官基础.乳腺.存在 = false
  }
}

@规则[$[基础内核]] {
  优先级: 590
  id: bInitDone
  $.基础.已初始化 = false {
    $.基础.性成熟 = 基础性成熟下一步()
    $.基础.可孕 = 基础可孕下一步()
    $.基础.代谢修正 = 基础代谢修下一步()
    $.基础.已初始化 = true
  }
}
