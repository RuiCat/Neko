// B 层初始化（500–590）：种族参数 → 属性 → 性别专属器官 → 派生落值。
// 种族清单：猫娘/犬娘/狐娘/人族/精灵；新增种族 = 加一条 5xx 规则。
@规则[$[基础内核]] {
  优先级: 500
  id: bInitRace500
  $.基础.已初始化 = false ∧ $.基础.种族 = "猫娘" {
    $.种族参数.类别 = "猫科亚人"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 80
    $.种族参数.基础体温 = 368
    $.种族参数.基础心率 = 72
    $.种族参数.基础呼吸 = 14
    $.种族参数.代谢系数 = 1000
    $.种族参数.孕期周 = 40
    $.种族参数.周期天 = 28
    $.种族参数.体型系数 = 1000
    $.种族参数.生育上限 = 50
    $.基础.特性 = ["猫耳","猫尾","肉垫"]
  }
}

@规则[$[基础内核]] {
  优先级: 501
  id: bInitRace501
  $.基础.已初始化 = false ∧ $.基础.种族 = "犬娘" {
    $.种族参数.类别 = "犬科亚人"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 70
    $.种族参数.基础体温 = 380
    $.种族参数.基础心率 = 80
    $.种族参数.基础呼吸 = 16
    $.种族参数.代谢系数 = 1100
    $.种族参数.孕期周 = 63
    $.种族参数.周期天 = 21
    $.种族参数.体型系数 = 1100
    $.种族参数.生育上限 = 45
    $.基础.特性 = ["犬耳","犬尾","嗅觉敏锐"]
  }
}

@规则[$[基础内核]] {
  优先级: 502
  id: bInitRace502
  $.基础.已初始化 = false ∧ $.基础.种族 = "狐娘" {
    $.种族参数.类别 = "狐科亚人"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 90
    $.种族参数.基础体温 = 378
    $.种族参数.基础心率 = 76
    $.种族参数.基础呼吸 = 15
    $.种族参数.代谢系数 = 1050
    $.种族参数.孕期周 = 52
    $.种族参数.周期天 = 24
    $.种族参数.体型系数 = 1050
    $.种族参数.生育上限 = 48
    $.基础.特性 = ["狐耳","狐尾","大尾"]
  }
}

@规则[$[基础内核]] {
  优先级: 504
  id: bInitRace504
  $.基础.已初始化 = false ∧ $.基础.种族 = "人族" {
    $.种族参数.类别 = "人族"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 80
    $.种族参数.基础体温 = 368
    $.种族参数.基础心率 = 72
    $.种族参数.基础呼吸 = 14
    $.种族参数.代谢系数 = 1000
    $.种族参数.孕期周 = 40
    $.种族参数.周期天 = 28
    $.种族参数.体型系数 = 1000
    $.种族参数.生育上限 = 50
    $.基础.特性 = []
  }
}

@规则[$[基础内核]] {
  优先级: 505
  id: bInitRace505
  $.基础.已初始化 = false ∧ $.基础.种族 = "精灵" {
    $.种族参数.类别 = "精灵"
    $.种族参数.成熟年龄 = 40
    $.种族参数.寿命 = 500
    $.种族参数.基础体温 = 366
    $.种族参数.基础心率 = 64
    $.种族参数.基础呼吸 = 12
    $.种族参数.代谢系数 = 900
    $.种族参数.孕期周 = 60
    $.种族参数.周期天 = 35
    $.种族参数.体型系数 = 900
    $.种族参数.生育上限 = 120
    $.基础.特性 = ["尖耳","长寿"]
  }
}

@规则[$[基础内核]] {
  优先级: 520
  id: bInitAttributes
  $.基础.已初始化 = false {
    $.基础.属性.体质 = 基础属性体质()
    $.基础.属性.感知 = 基础属性感知()
    $.基础.属性.敏捷 = 基础属性敏捷()
    $.基础.属性.智力 = 基础属性智力()
    $.基础.属性.魅力 = 基础属性魅力()
    $.基础.属性.意志 = 基础属性意志()
    $.基础.属性.幸运 = 基础属性幸运()
  }
}

@规则[$[基础内核]] {
  优先级: 530
  id: bInitOrgansFemale
  $.基础.已初始化 = false ∧ ($.基础.性别 = "女" ∨ $.基础.性别 = "双性") {
    $.器官基础.子宫.存在 = true
    $.器官基础.阴道.存在 = true
    $.器官基础.宫颈.存在 = true
    $.器官基础.卵巢.存在 = true
    $.器官基础.输卵管.存在 = true
    $.器官基础.乳腺.存在 = true
  }
}

@规则[$[基础内核]] {
  优先级: 531
  id: bInitOrgansMale
  $.基础.已初始化 = false ∧ ($.基础.性别 = "男" ∨ $.基础.性别 = "无性") {
    $.器官基础.子宫.存在 = false
    $.器官基础.阴道.存在 = false
    $.器官基础.宫颈.存在 = false
    $.器官基础.卵巢.存在 = false
    $.器官基础.输卵管.存在 = false
    $.器官基础.乳腺.存在 = false
  }
}

@规则[$[基础内核]] {
  优先级: 590
  id: bInitDone
  $.基础.已初始化 = false {
    $.基础.性成熟 = 基础性成熟下一步()
    $.基础.可孕 = 基础可孕下一步()
    $.基础.代谢修正 = 基础代谢修下一步()
    $.基础.已初始化 = true
  }
}
