// 情感内核（L12）：连续情感（效价/唤醒）+ 离散情绪 + 依恋。
// 上层通过 事件效价/事件唤醒/事件情绪/事件源/记忆类别 注入一次情绪事件；
// 本层负责触发、回落、情绪标签、印记请求与巩固请求。好感度仍由 关系 实体持有。
@定义 情感内核 {
  "情感": {
    "情绪[str]": "平静",
    "效价[int,min:-100,max:100]": 0,
    "唤醒[int,min:0,max:100]": 30,
    "强度[int,min:0,max:100]": 0,
    "余温[int,min:0,max:100]": 0,
    "依恋[int,min:0,max:100]": 50,
    "基线[int,min:-100,max:100]": 0,
    "触发源[str]": "",
    "事件效价[int,min:-100,max:100]": 0,
    "事件唤醒[int,min:-100,max:100]": 0,
    "事件情绪[str]": "",
    "事件源[str]": "",
    "记忆类别[str]": "事件",
    "待印记[int,min:0,max:100]": 0,
    "待记忆[int,min:0,max:100]": 0,
    "固化标记[bool]": false
  }
}
