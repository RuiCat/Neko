// 情感域计算单元（L12，8521–8526）。
// 连续量按 tick 向基线回落；离散情绪由事件标签或效价/唤醒八象限给出。

@函数 情感基线() -> int {
  if {e}.人格.开放性 == 0 { 返回 0 }
  值 = ({e}.人格.外向性 - 50) / 4 + ({e}.人格.宜人性 - 50) / 4 - ({e}.人格.神经质 - 50) / 4
  if 值 < -30 { 值 = -30 }
  if 值 > 30 { 值 = 30 }
  返回 int(值)
}

@函数 情感效价下一步() -> int {
  if {e}.人格.开放性 == 0 { 返回 0 }
  目标 = ({e}.人格.外向性 - 50) / 4 + ({e}.人格.宜人性 - 50) / 4 - ({e}.人格.神经质 - 50) / 4
  if 目标 < -30 { 目标 = -30 }
  if 目标 > 30 { 目标 = 30 }
  值 = {e}.情感.效价
  if 值 > 目标 { 值 = 值 - 1 }
  if 值 < 目标 { 值 = 值 + 1 }
  返回 int(值)
}

@函数 情感唤醒下一步() -> int {
  值 = {e}.情感.唤醒
  if 值 > 30 { 值 = 值 - 1 }
  if 值 < 30 { 值 = 值 + 1 }
  返回 int(值)
}

@函数 情感强度下一步() -> int {
  值 = {e}.情感.强度 - 1
  if 值 < 0 { 值 = 0 }
  返回 int(值)
}

@函数 情感余温下一步() -> int {
  值 = {e}.情感.余温 - 1
  if 值 < 0 { 值 = 0 }
  返回 int(值)
}

@函数 情感依恋下一步() -> int {
  目标 = ({e}.社交.主人互动 + {e}.记忆.长期负荷) / 2
  值 = {e}.情感.依恋
  if 值 > 目标 { 值 = 值 - 1 }
  if 值 < 目标 { 值 = 值 + 1 }
  返回 int(值)
}

@函数 情感有事件() -> bool {
  if {e}.情感.事件效价 != 0 { 返回 true }
  if {e}.情感.事件唤醒 != 0 { 返回 true }
  if {e}.情感.事件情绪 != "" { 返回 true }
  返回 false
}

@函数 情感下一步情绪() -> str {
  if {e}.情感.事件情绪 != "" { 返回 {e}.情感.事件情绪 }
  效 = {e}.情感.效价
  醒 = {e}.情感.唤醒
  if 效 >= 30 and 醒 >= 60 { 返回 "兴奋" }
  if 效 >= 30 and 醒 >= 30 { 返回 "愉快" }
  if 效 >= 30 { 返回 "安心" }
  if 效 <= -30 and 醒 >= 60 { 返回 "愤怒" }
  if 效 <= -30 and 醒 >= 30 { 返回 "焦虑" }
  if 效 <= -30 { 返回 "低落" }
  if 醒 >= 60 { 返回 "紧张" }
  if 醒 <= 20 { 返回 "疲惫" }
  返回 "平静"
}

@函数 情感效价触发() -> int {
  值 = {e}.情感.效价 + {e}.情感.事件效价
  if 值 < -100 { 值 = -100 }
  if 值 > 100 { 值 = 100 }
  返回 int(值)
}

@函数 情感唤醒触发() -> int {
  值 = {e}.情感.唤醒 + {e}.情感.事件唤醒
  if 值 < 0 { 值 = 0 }
  if 值 > 100 { 值 = 100 }
  返回 int(值)
}

@函数 情感强度触发() -> int {
  值 = {e}.情感.强度 + (abs({e}.情感.事件效价) + abs({e}.情感.事件唤醒)) / 2
  if {e}.情感.事件情绪 != "" { 值 = 值 + 20 }
  if 值 < 0 { 值 = 0 }
  if 值 > 100 { 值 = 100 }
  返回 int(值)
}

@函数 情感余温触发() -> int {
  值 = {e}.情感.余温
  if {e}.情感.强度 > 值 { 值 = {e}.情感.强度 }
  返回 int(值)
}

@函数 情感待印记() -> int {
  if {e}.情感.强度 < 60 { 返回 0 }
  返回 int({e}.情感.强度 / 4)
}

@函数 情感待记忆() -> int {
  if {e}.情感.强度 < 70 { 返回 0 }
  返回 int({e}.情感.强度 / 3)
}

@函数 情感记忆类别() -> str {
  if {e}.情感.记忆类别 == "关系" { 返回 "关系" }
  if {e}.情感.记忆类别 == "自我" { 返回 "自我" }
  返回 "事件"
}
