// 情感结算（L12，8521–8526）。
// 8521 回落 → 8522 平静复位 → 8523 事件触发 → 8524 印记请求 → 8525 巩固请求 → 8526 解除固化标记。
@规则[$[情感内核]] {
  优先级: 8521
  id: emDecay
  $.代谢.流逝分钟 > 0 {
    $.情感.基线 = 情感基线()
    $.情感.效价 = 情感效价下一步()
    $.情感.唤醒 = 情感唤醒下一步()
    $.情感.强度 = 情感强度下一步()
    $.情感.余温 = 情感余温下一步()
    $.情感.依恋 = 情感依恋下一步()
  }
}

@规则[$[情感内核]] {
  优先级: 8522
  id: emCalm
  $.情感.强度 <= 15 ∧ $.情感.情绪 != "平静" ∧ 情感有事件() == false {
    $.情感.情绪 = "平静"
  }
}

@规则[$[情感内核]] {
  优先级: 8523
  id: emTrigger
  情感有事件() == true {
    $.情感.效价 = 情感效价触发()
    $.情感.唤醒 = 情感唤醒触发()
    $.情感.强度 = 情感强度触发()
    $.情感.余温 = 情感余温触发()
    $.情感.情绪 = 情感下一步情绪()
    $.情感.触发源 = $.情感.事件源
    $.情感.记忆类别 = 情感记忆类别()
    $.情感.事件效价 = 0
    $.情感.事件唤醒 = 0
    $.情感.事件情绪 = ""
    $.情感.事件源 = ""
  }
}

@规则[$[情感内核]] {
  优先级: 8524
  id: emImprint
  情感待印记() > 0 {
    $.情感.待印记 = 情感待印记()
    $.情感.待记忆 = 情感待记忆()
  }
}

@规则[$[情感内核]] {
  优先级: 8525
  id: emConsolidate
  $.情感.强度 >= 80 ∧ $.情感.固化标记 = false ∧ $.记忆.遗忘阈值 > 0 {
    $.记忆.巩固 = true
    $.情感.固化标记 = true
  }
}

@规则[$[情感内核]] {
  优先级: 8526
  id: emReset
  $.情感.强度 < 40 ∧ $.情感.固化标记 = true {
    $.情感.固化标记 = false
  }
}
