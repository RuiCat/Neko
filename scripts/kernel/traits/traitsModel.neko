// 种族特征内核（组合式）：每个特征一个独立模板，只含自己的字段。
// 角色类型用 `@实体 类型 [父, 特征…] {}` 组合；不与 角色基础/各内核字段重叠。
@定义 猫耳 {
  "猫耳": {"灵敏[int,min:0,max:100]": 50}
}

@定义 猫尾 {
  "猫尾": {"平衡[int,min:0,max:100]": 10}
}

@定义 肉垫 {
  "肉垫": {"静音[int,min:0,max:100]": 20}
}

@定义 犬耳 {
  "犬耳": {"灵敏[int,min:0,max:100]": 55}
}

@定义 犬尾 {
  "犬尾": {"平衡[int,min:0,max:100]": 8}
}

@定义 狐耳 {
  "狐耳": {"灵敏[int,min:0,max:100]": 55}
}

@定义 狐尾 {
  "狐尾": {"平衡[int,min:0,max:100]": 12}
}

@定义 尖耳 {
  "尖耳": {"感知[int,min:0,max:100]": 15}
}

// ---- 修饰模板：种族 ----
// 只声明「我是谁」的标识字段。数值状态由 traitRules 里的同名规则写到自身。
// 种族修饰之间彼此独立：猫娘不继承人族、人族也不特殊——裸 角色基础 走默认人族
// 只是「没有种族修饰时的兜底」，不是继承关系。
// 只要求自身满足 角色基础 的字段定义（组合时已保证）。
@定义 人族 {
  "种族标识[str]": "人族"
}

@定义 猫娘 {
  "种族标识[str]": "猫娘"
}

@定义 犬娘 {
  "种族标识[str]": "犬娘"
}

@定义 狐娘 {
  "种族标识[str]": "狐娘"
}

@定义 精灵 {
  "种族标识[str]": "精灵"
}

// ---- 修饰模板：生命阶段（与种族正交，可叠加在任意种族之上）----
@定义 幼年 {
  "阶段标识[str]": "幼年"
}

@定义 成年 {
  "阶段标识[str]": "成年"
}
