// 修饰模板的状态写入（优先级 470–479，早于 baseInit 的 500）。
//
// 模型：修饰模板（种族 / 生命阶段）只声明标识字段；下面的规则把「这个修饰意味着什么」
// 写到**自身**。所以 猫娘 不依赖 人族，它只是要求自身已经具备 角色基础 的字段，
// 然后修改自己的 种族参数 / 基础 / 特性。叠加多个修饰时各写各的字段，互不覆盖。
//
// 幂等：写完后置 种族参数.已认领 = true，后续 tick 不再重算。
// 种族判定看 种族标识（修饰模板自带字段），不看 基础.种族 字符串——
// 没有种族修饰时 种族标识 为空，由 469 的默认规则落在人族。

// 476：没有任何种族修饰认领过 → 人族默认值（裸 角色基础 就是人族）。
// 放在 470–474 之后：有种族修饰时前面已经置 已认领=true，这里自然不触发。
// 注意不要用「种族标识为空」判断——没有种族修饰时该字段根本不存在，
// 缺失路径在条件里恒为假，会导致默认值永远不生效。
@规则[$[角色基础]] {
  优先级: 476
  id: traitRaceDefault
  $.种族参数.已认领 = false {
    $.基础.种族 = "人族"
    $.基础.种族来源 = "default"
    $.种族参数.类别 = "人族"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 80
    $.种族参数.基础体温 = 368
    $.种族参数.基础心率 = 72
    $.种族参数.基础呼吸 = 14
    $.种族参数.代谢系数 = 1000
    $.种族参数.孕期周 = 40
    $.种族参数.周期天 = 28
    $.种族参数.体型系数 = 1000
    $.种族参数.生育上限 = 50
    $.基础.特性 = []
    $.种族参数.属性修正.体质 = 0
    $.种族参数.属性修正.感知 = 0
    $.种族参数.属性修正.敏捷 = 0
    $.种族参数.属性修正.智力 = 0
    $.种族参数.属性修正.魅力 = 0
    $.种族参数.属性修正.意志 = 0
    $.种族参数.属性修正.幸运 = 0
    $.种族参数.已认领 = true
  }
}

// 470：人族修饰（显式组合，等价于默认，但来源标记为 trait）
@规则[$[角色基础]] {
  优先级: 470
  id: traitRaceHuman
  $.种族标识 = "人族" ∧ $.种族参数.已认领 = false {
    $.基础.种族 = "人族"
    $.基础.种族来源 = "trait"
    $.种族参数.类别 = "人族"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 80
    $.种族参数.基础体温 = 368
    $.种族参数.基础心率 = 72
    $.种族参数.基础呼吸 = 14
    $.种族参数.代谢系数 = 1000
    $.种族参数.孕期周 = 40
    $.种族参数.周期天 = 28
    $.种族参数.体型系数 = 1000
    $.种族参数.生育上限 = 50
    $.基础.特性 = []
    $.种族参数.属性修正.体质 = 0
    $.种族参数.属性修正.感知 = 0
    $.种族参数.属性修正.敏捷 = 0
    $.种族参数.属性修正.智力 = 0
    $.种族参数.属性修正.魅力 = 0
    $.种族参数.属性修正.意志 = 0
    $.种族参数.属性修正.幸运 = 0
    $.种族参数.已认领 = true
  }
}

// 471：猫娘
@规则[$[角色基础]] {
  优先级: 471
  id: traitRaceCat
  $.种族标识 = "猫娘" ∧ $.种族参数.已认领 = false {
    $.基础.种族 = "猫娘"
    $.基础.种族来源 = "trait"
    $.种族参数.类别 = "猫科亚人"
    $.种族参数.成熟年龄 = 18
    $.种族参数.寿命 = 80
    $.种族参数.基础体温 = 368
    $.种族参数.基础心率 = 72
    $.种族参数.基础呼吸 = 14
    $.种族参数.代谢系数 = 1000
    $.种族参数.孕期周 = 40
    $.种族参数.周期天 = 28
    $.种族参数.体型系数 = 1000
    $.种族参数.生育上限 = 50
    $.基础.特性 = ["猫耳", "猫尾", "肉垫"]
    $.种族参数.属性修正.体质 = -5
    $.种族参数.属性修正.感知 = 10
    $.种族参数.属性修正.敏捷 = 15
    $.种族参数.属性修正.智力 = 0
    $.种族参数.属性修正.魅力 = 10
    $.种族参数.属性修正.意志 = 0
    $.种族参数.属性修正.幸运 = 0
    $.种族参数.已认领 = true
  }
}

