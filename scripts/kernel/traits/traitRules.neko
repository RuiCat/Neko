// 480：生命阶段修饰——与种族正交，写在种族规则之后。
// 幼年只是「把自身状态标成幼年」，不覆盖种族；性成熟由 基础性成熟下一步() 按 成熟年龄 判定。
@规则[$[角色基础]] {
  优先级: 480
  id: traitStageYoung
  $.阶段标识 = "幼年" {
    $.基础.生命阶段 = "幼年"
  }
}

@规则[$[角色基础]] {
  优先级: 481
  id: traitStageAdult
  $.阶段标识 = "成年" ∧ $.基础.生命阶段 = "" {
    $.基础.生命阶段 = "成年"
  }
}

// 482：没有阶段修饰时按年龄补默认阶段（不覆盖显式修饰）。
@规则[$[角色基础]] {
  优先级: 482
  id: traitStageDefault
  $.基础.生命阶段 = "" ∧ $.基础.性别 != "" {
    $.基础.生命阶段 = "成年"
  }
}
