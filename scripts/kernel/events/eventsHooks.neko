// 通用事件钩子：只把「发生了什么」写成结构化事实，文案由表现层决定。
// 依赖字段注解 @事件休克 / @事件死亡 / @事件分娩。
@函数 事件休克(变化量:int) {
  {e}.角色状态.最近事件 = "休克"
}

@函数 事件死亡() {
  {e}.角色状态.最近事件 = "死亡"
}

@函数 事件分娩() {
  {e}.角色状态.最近事件 = "分娩"
}

@事件:事件休克 {
  条件: 新值 >= 40
  处理器: 事件休克
}

@事件:事件死亡 {
  条件: 新值 = true
  处理器: 事件死亡
}

@事件:事件分娩 {
  条件: 新值 = "产后"
  处理器: 事件分娩
}

@事件:事件脓毒 {
  条件: 新值 >= 60
  处理器: 事件脓毒
}

@事件:事件并发症 {
  条件: 新值 != ""
  处理器: 事件并发症
}

@函数 事件脓毒() {
  {e}.角色状态.最近事件 = "脓毒"
}

@函数 事件并发症() {
  {e}.角色状态.最近事件 = "并发症"
}
