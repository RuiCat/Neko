// 素材域计算单元（L6 物品层，7000 段）。规则只做 `字段 = 函数()`。
// 变质速度按世界时钟的每 tick 分钟数折算：保质期 = 从新鲜到完全腐坏的分钟数。
@函数 食物腐败下一步() -> int {
  期 = {e}.食物.保质期
  if 期 <= 0 {
    返回 {e}.食物.腐败
  }
  分钟 = 世界.状态.每tick分钟
  增 = 100 * 分钟 / 期
  if 增 < 1 {
    增 = 1
  }
  值 = {e}.食物.腐败 + 增
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

// 腐败过 70 判定不可食；中毒风险随腐败升高（0-100 线性折算到原风险的 2 倍）。
@函数 食物可食判定() -> bool {
  if {e}.食物.腐败 >= 70 {
    返回 false
  }
  return true
}

@函数 食物中毒风险下一步() -> int {
  if {e}.食物.腐败 < 30 {
    返回 {e}.食物.中毒风险
  }
  值 = {e}.食物.中毒风险 + {e}.食物.腐败 / 10
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

@函数 饮品腐败下一步() -> int {
  期 = {e}.饮品.保质期
  if 期 <= 0 {
    返回 {e}.饮品.腐败
  }
  分钟 = 世界.状态.每tick分钟
  增 = 100 * 分钟 / 期
  if 增 < 1 {
    增 = 1
  }
  值 = {e}.饮品.腐败 + 增
  if 值 > 100 {
    值 = 100
  }
  返回 int(值)
}

// 腐败过 70 判定不可饮（水/酒同样按保质期算，0 表示不会坏）。
@函数 饮品可饮判定() -> bool {
  if {e}.饮品.腐败 >= 70 {
    返回 false
  }
  return true
}
