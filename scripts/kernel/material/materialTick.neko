// 素材被动结算（L6 物品层，7000 段）：变质、耗尽、磨损。
// 物品层只写素材自己的字段，不跨实体写角色；交互结算在 scripts/interact/。
@规则[$[食物内核]] {
  优先级: 7000
  id: mtSpoilFood
  $.食物.保质期 > 0 ∧ $.食物.腐败 < 100 {
    $.食物.腐败 = 食物腐败下一步()
    $.食物.可食 = 食物可食判定()
    $.食物.中毒风险 = 食物中毒风险下一步()
  }
}

@规则[$[饮品内核]] {
  优先级: 7010
  id: mtSpoilDrink
  $.饮品.保质期 > 0 ∧ $.饮品.腐败 < 100 {
    $.饮品.腐败 = 饮品腐败下一步()
    $.饮品.可饮 = 饮品可饮判定()
  }
}

// 数量归零即不可用，并从持有人手里脱落（避免空壳占着背包）。
// 放在交互结算（7100–7290）之后，吃/喝当 tick 就把数量归零的物品标记掉。
@规则[$[素材]] {
  优先级: 7260
  id: mtDeplete
  $.数量 <= 0 ∧ $.可用 = true {
    $.可用 = false
    $.持有人 = ""
  }
}

// 耐久归零的工具不可用。
@规则[$[工具内核]] {
  优先级: 7270
  id: mtWearOut
  $.耐久 <= 0 ∧ $.可用 = true {
    $.可用 = false
  }
}
