// 素材内核：场景中的物品/食物/饮品/工具/容器/衣物的实例形状。
// 每个素材是一个独立实体；名称在同一场景内唯一，作为交互句柄（角色 交互.目标）。
// 单位：重量 g / 体积 mL / 热量 kcal / 水分 mL / 耐久 0-100 / 时间 分钟。
@定义 素材 {
  "类型": "物品",
  "类别": "杂物",
  "名称": "",
  "所属场景": "",
  "持有人": "",
  "可用": true,
  "描述": "",
  "数量[int,min:0,max:99]": 1,
  "重量[int,min:0,max:100000]": 100,
  "体积[int,min:0,max:100000]": 100,
  "耐久[int,min:0,max:100]": 100,
  "品质[int,min:0,max:100]": 50,
  "价格[int,min:0,max:1000000]": 0,
  "标签": [],
  "效果": []
}

// 食物内核：可食用素材的营养与变质账本。热量/水分按「一份」计。
@定义 食物内核 {
  "食物": {
    "热量[int,min:0,max:5000]": 0,
    "水分[int,min:0,max:2000]": 0,
    "饱腹[int,min:0,max:100]": 0,
    "口味": "无味",
    "烹饪": "生",
    "可食[bool]": true,
    "中毒风险[int,min:0,max:100]": 0,
    "保质期[int,min:0,max:100000]": 0,
    "腐败[int,min:0,max:100]": 0
  }
}

// 饮品内核：可饮用素材。与食物分开是因为入口是「喝」，且要结算酒精。
@定义 饮品内核 {
  "饮品": {
    "水分[int,min:0,max:2000]": 0,
    "热量[int,min:0,max:2000]": 0,
    "酒精[int,min:0,max:100]": 0,
    "咖啡因[int,min:0,max:200]": 0,
    "温度[int,min:-100,max:1000]": 220,
    "可饮[bool]": true,
    "保质期[int,min:0,max:100000]": 0,
    "腐败[int,min:0,max:100]": 0
  }
}

// 工具内核：有用途标签与磨损的素材（刀具/绳索/灯/餐具…）。
@定义 工具内核 {
  "工具": {
    "用途": [],
    "最大耐久[int,min:1,max:1000]": 100,
    "磨损[int,min:0,max:1000]": 0,
    "可修理[bool]": true
  }
}

// 容器内核：可盛放液体的素材（杯/瓶/桶）。
@定义 容器内核 {
  "容器": {
    "容量[int,min:0,max:50000]": 500,
    "当前量[int,min:0,max:50000]": 0,
    "内容": "",
    "密封[bool]": false,
    "保温[int,min:-100,max:1000]": 0
  }
}

// 衣物内核：可穿着的素材（部位/保暖/防护）。
@定义 衣物内核 {
  "衣物": {
    "部位": "",
    "保暖[int,min:-50,max:100]": 0,
    "防护[int,min:0,max:100]": 0,
    "已穿戴[bool]": false
  }
}

// 实例类型：继承 素材 的公有账本，各自追加自己的内核。
// 类别字段仍由数据层按语义写入（食物/饮品/工具/容器/衣物/杂物），规则只认类型。
@实体 食物 [素材, 食物内核] {}
@实体 饮品 [素材, 饮品内核] {}
@实体 工具 [素材, 工具内核] {}
@实体 容器 [素材, 容器内核] {}
@实体 衣物 [素材, 衣物内核] {}
