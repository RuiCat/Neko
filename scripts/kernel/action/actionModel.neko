// 行动内核（L7）：当前动作的状态机与耗时。
// 上层只写 当前/目标/对象/总分钟/被打断；本层推进进度、判定完成与中断。
@定义 行动内核 {
  "行动": {
    "当前": "",
    "阶段": "空闲",
    "目标": "",
    "对象": "",
    "进度[int,min:0,max:100]": 0,
    "已用分钟[int,min:0,max:1440]": 0,
    "总分钟[int,min:0,max:1440]": 0,
    "被打断[bool]": false,
    "中断原因": "",
    "结果": "",
    "能耗[int,min:0,max:500]": 0
  }
}
