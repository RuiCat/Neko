// 行动状态机（L7，优先级 8000–8099）。
// 顺序：重置 → 启动 → 中断（手动/紧迫度/休克）→ 推进 → 完成 → 能耗。
@规则[$[行动内核]] {
  优先级: 8000
  id: acReset
  $.行动.当前 = "" ∧ $.行动.阶段 != "空闲" {
    $.行动.阶段 = "空闲"
    $.行动.进度 = 0
    $.行动.已用分钟 = 0
    $.行动.总分钟 = 0
    $.行动.结果 = ""
  }
}

@规则[$[行动内核]] {
  优先级: 8010
  id: acStart
  $.行动.当前 != "" ∧ $.行动.阶段 != "执行" {
    $.行动.阶段 = "执行"
    $.行动.已用分钟 = 0
    $.行动.进度 = 0
    $.行动.结果 = ""
    $.行动.中断原因 = ""
  }
}

// 上层主动打断：置 被打断=true 后本 tick 生效，随后自动复位。
@规则[$[行动内核]] {
  优先级: 8020
  id: acBreakManual
  $.行动.被打断 = true {
    $.行动.阶段 = "中断"
    $.行动.中断原因 = "被打断"
    $.行动.当前 = ""
    $.行动.进度 = 0
    $.行动.被打断 = false
  }
}

// 生理需求：规划层（8100 段）算出的紧迫度，行动层下一 tick 读到。
@规则[$[行动内核]] {
  优先级: 8030
  id: acBreakUrgent
  $.规划.紧迫度 >= 90 ∧ $.行动.阶段 = "执行" {
    $.行动.阶段 = "中断"
    $.行动.中断原因 = "生理需求"
    $.行动.当前 = ""
    $.行动.进度 = 0
  }
}

@规则[$[行动内核]] {
  优先级: 8040
  id: acBreakShock
  $.伤害.休克 >= 50 ∧ $.行动.阶段 = "执行" {
    $.行动.阶段 = "中断"
    $.行动.中断原因 = "休克"
    $.行动.当前 = ""
    $.行动.进度 = 0
  }
}

@规则[$[行动内核]] {
  优先级: 8050
  id: acAdvance
  $.行动.阶段 = "执行" ∧ $.代谢.流逝分钟 > 0 {
    $.行动.已用分钟 = 行动已用下一步()
    $.行动.进度 = 行动进度下一步()
  }
}

@规则[$[行动内核]] {
  优先级: 8060
  id: acComplete
  $.行动.阶段 = "执行" ∧ $.行动.进度 >= 100 {
    $.行动.阶段 = "完成"
    $.行动.结果 = "完成"
    $.行动.当前 = ""
    $.行动.进度 = 0
  }
}

@规则[$[行动内核]] {
  优先级: 8070
  id: acEnergy
  $.行动.阶段 != "空闲" {
    $.行动.能耗 = 行动能耗()
  }
}
