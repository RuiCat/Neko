// 行动状态机（L7，优先级 8000–8099）。
// 顺序：重置 → 启动 → 中断（手动/紧迫度/休克）→ 推进 → 完成 → 能耗。
//
// 完成时**不立即清空 行动.当前**：本 tick 下游（教育 8200、交易 8300 等）还要读它结算。
// 清空交给下一 tick 的 acReset（它会先于 acStart 跑，所以不会误重启同一动作）。
@规则[$[行动内核]] {
  优先级: 8000
  id: acReset
  $.行动.当前 = "" ∧ $.行动.阶段 != "空闲" {
    $.行动.阶段 = "空闲"
    $.行动.进度 = 0
    $.行动.已用分钟 = 0
    $.行动.总分钟 = 0
    $.行动.结果 = ""
  }
}

// 动作已完成 → 回空闲并清空当前。必须拆成独立规则：引擎对「括号内 ∨」的复合条件
// 实测不成立（脚本里多处注释警告过），写成一条恒为假会让动作永远停在「完成」。
@规则[$[行动内核]] {
  优先级: 8001
  id: acResetDone
  $.行动.阶段 = "完成" {
    $.行动.阶段 = "空闲"
    $.行动.当前 = ""
    $.行动.进度 = 0
    $.行动.已用分钟 = 0
    $.行动.总分钟 = 0
    $.行动.结果 = ""
  }
}

@规则[$[行动内核]] {
  优先级: 8010
  id: acStart
  $.行动.当前 != "" ∧ $.行动.阶段 != "执行" {
    $.行动.阶段 = "执行"
    $.行动.已用分钟 = 0
    $.行动.进度 = 0
    $.行动.结果 = ""
    $.行动.中断原因 = ""
  }
}

// 上层主动打断：置 被打断=true 后本 tick 生效，随后自动复位。
@规则[$[行动内核]] {
  优先级: 8020
  id: acBreakManual
  $.行动.被打断 = true {
    $.行动.阶段 = "中断"
    $.行动.中断原因 = "被打断"
    $.行动.当前 = ""
    $.行动.进度 = 0
    $.行动.被打断 = false
  }
}

// 生理需求：规划层（8100 段）算出的紧迫度，行动层下一 tick 读到。
@规则[$[行动内核]] {
  优先级: 8030
  id: acBreakUrgent
  $.规划.紧迫度 >= $.判定阈值.中断紧迫度 ∧ $.行动.阶段 = "执行" {
    $.行动.阶段 = "中断"
    $.行动.中断原因 = "生理需求"
    $.行动.当前 = ""
    $.行动.进度 = 0
  }
}

@规则[$[行动内核]] {
  优先级: 8040
  id: acBreakShock
  $.伤害.休克 >= $.判定阈值.中断休克 ∧ $.行动.阶段 = "执行" {
    $.行动.阶段 = "中断"
    $.行动.中断原因 = "休克"
    $.行动.当前 = ""
    $.行动.进度 = 0
  }
}

@规则[$[行动内核]] {
  优先级: 8050
  id: acAdvance
  $.行动.阶段 = "执行" ∧ $.代谢.流逝分钟 > 0 {
    $.行动.已用分钟 = 行动已用下一步()
    $.行动.进度 = 行动进度下一步()
  }
}

@规则[$[行动内核]] {
  优先级: 8060
  id: acComplete
  $.行动.阶段 = "执行" ∧ $.行动.进度 >= 100 {
    $.行动.阶段 = "完成"
    $.行动.结果 = "完成"
    $.行动.进度 = 0
  }
}

@规则[$[行动内核]] {
  优先级: 8070
  id: acEnergy
  $.行动.阶段 != "空闲" {
    $.行动.能耗 = 行动能耗()
  }
}
