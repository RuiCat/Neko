// 行动域计算单元（L7）。规则只做 `字段 = 函数()`。
// 总分钟 0 视为 60：一个 tick 的默认时长。
@函数 行动耗时() -> int {
  总 = {e}.行动.总分钟
  if 总 <= 0 {
    返回 60
  }
  返回 总
}

@函数 行动已用下一步() -> int {
  总 = 行动耗时()
  已 = {e}.行动.已用分钟 + {e}.代谢.流逝分钟
  if 已 > 总 {
    已 = 总
  }
  返回 int(已)
}

// 注意：本函数在 acAdvance 里排在「已用分钟」写入之后，直接读已写入的新值，
// 不能再调用 行动已用下一步（会把流逝分钟加两遍、提前判定完成）。
@函数 行动进度下一步() -> int {
  总 = 行动耗时()
  返回 int({e}.行动.已用分钟 * 100 / 总)
}

@函数 行动能耗() -> int {
  当前 = {e}.行动.当前
  if 当前 == "" {
    返回 0
  }
  值 = 行动耗时() / 6 + {e}.行动.已用分钟 / 12
  if 值 > 500 {
    值 = 500
  }
  返回 int(值)
}
