// 食物内容层：具体食物实例（@data 类型:实体ID）。
// 由 `neko-data apply` 物化成实体；不要在这里写 @规则/@函数（内核在 scripts/kernel/）。
@data 食物:苹果 {
  "名称": "苹果",
  "类别": "食物",
  "数量": 3,
  "重量": 180,
  "价格": 5,
  "描述": "一颗脆苹果",
  "食物": { "热量": 95, "水分": 85, "饱腹": 20, "保质期": 10080, "可食": true }
}

