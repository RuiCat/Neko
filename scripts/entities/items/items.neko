// 物品内容层：工具/容器/衣物的具体实例（@data 类型:实体ID）。
@data 工具:小刀 {
  "名称": "小刀",
  "类别": "工具",
  "数量": 1,
  "重量": 80,
  "价格": 25,
  "耐久": 3,
  "描述": "一把折叠小刀",
  "工具": { "用途": ["切割"], "最大耐久": 3, "可修理": true }
}

@data 容器:水杯 {
  "名称": "水杯",
  "类别": "容器",
  "数量": 1,
  "重量": 200,
  "价格": 10,
  "描述": "一个白瓷杯",
  "容器": { "容量": 300, "当前量": 0, "密封": false }
}

@data 衣物:外套 {
  "名称": "外套",
  "类别": "衣物",
  "数量": 1,
  "重量": 600,
  "价格": 120,
  "描述": "一件薄外套",
  "衣物": { "部位": "上身", "保暖": 15, "防护": 5 }
}
