// 器官账本 tick（L2，优先级 3000 段）。灌注来自 L1，功能由完整性×灌注派生。
@规则[$[代谢内核]] {
  优先级: 3000
  id: l2Organs
  $.代谢.流逝分钟 > 0 {
    $.器官.脑.灌注 = $.循环.灌注
    $.器官.心.灌注 = $.循环.灌注
    $.器官.肺.灌注 = $.循环.灌注
    $.器官.肝.灌注 = $.循环.灌注
    $.器官.肾.灌注 = $.循环.灌注
    $.器官.子宫.灌注 = $.循环.灌注
    $.器官.阴道.灌注 = $.循环.灌注
    $.器官.宫颈.灌注 = $.循环.灌注
    $.器官.直肠.灌注 = $.循环.灌注
    $.器官.膀胱.灌注 = $.循环.灌注

    $.器官.脑.功能 = 器官功能值($.器官.脑.完整性, $.器官.脑.灌注)
    $.器官.心.功能 = 器官功能值($.器官.心.完整性, $.器官.心.灌注)
    $.器官.肺.功能 = 器官功能值($.器官.肺.完整性, $.器官.肺.灌注)
    $.器官.肝.功能 = 器官功能值($.器官.肝.完整性, $.器官.肝.灌注)
    $.器官.肾.功能 = 器官功能值($.器官.肾.完整性, $.器官.肾.灌注)
    $.器官.子宫.功能 = 器官功能值($.器官.子宫.完整性, $.器官.子宫.灌注)
    $.器官.阴道.功能 = 器官功能值($.器官.阴道.完整性, $.器官.阴道.灌注)
    $.器官.宫颈.功能 = 器官功能值($.器官.宫颈.完整性, $.器官.宫颈.灌注)
    $.器官.直肠.功能 = 器官功能值($.器官.直肠.完整性, $.器官.直肠.灌注)
    $.器官.膀胱.功能 = 器官功能值($.器官.膀胱.完整性, $.器官.膀胱.灌注)

    $.器官.脑.完整性 = 器官修复下一步($.器官.脑.完整性)
    $.器官.心.完整性 = 器官修复下一步($.器官.心.完整性)
    $.器官.肺.完整性 = 器官修复下一步($.器官.肺.完整性)
    $.器官.肝.完整性 = 器官修复下一步($.器官.肝.完整性)
    $.器官.肾.完整性 = 器官修复下一步($.器官.肾.完整性)
    $.器官.子宫.完整性 = 器官修复下一步($.器官.子宫.完整性)
    $.器官.阴道.完整性 = 器官修复下一步($.器官.阴道.完整性)
    $.器官.宫颈.完整性 = 器官修复下一步($.器官.宫颈.完整性)
    $.器官.直肠.完整性 = 器官修复下一步($.器官.直肠.完整性)
    $.器官.膀胱.完整性 = 器官修复下一步($.器官.膀胱.完整性)
  }
}
