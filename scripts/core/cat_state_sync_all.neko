// ═══════════════════════════════════════════════
// cat_state_sync_all.neko — 梦梦状态同步到猫猫（宝宝影响妈妈）
// 多主体：$1 = 梦梦，$2 = 猫猫
// 2026-08-13 重建
// ═══════════════════════════════════════════════

@规则[$1[NPC:梦梦]，$2[NPC:猫猫]] {
  优先级: 100
  $1.状态.情绪 = "开心" ∧ $1.位置.场景 = $2.位置.场景 {
    $2.亲子.梦梦状态 = "开心地玩耍"
  },
  $1.状态.情绪 in {难过, 恐惧} {
    $2.状态.情绪 = "关心"
    $2.亲子.梦梦状态 = "情绪不好要安抚"
    $2.状态.触发 = "猫猫察觉到梦梦情绪不对、赶紧过去把她抱进怀里安抚"
  },
  $1.身体.体力 < 30 {
    $2.亲子.梦梦状态 = "体力不足要休息"
    $2.状态.触发 = "猫猫发现梦梦没精神、把她裹进小毯子里抱紧"
  },
  $1.状态.安全等级 = "red" {
    $2.状态.情绪 = "关心"
    $2.状态.触发 = "猫猫立刻把梦梦护在身后、警惕地竖起耳朵张望四周"
  }
}
