// ═══════════════════════════════════════════════
// cat_affection.neko — 猫猫情感成长系统
// 亲密/信赖累积 + 心情状态机 + 情感表达
// ═══════════════════════════════════════════════

// ─── 情感字段 ───

@定义 NPC {
  "关系": {
    "亲密": 65,
    "信赖": 70,
    "爱意": 30,
    "好感度": 65
  },
  "心情": {
    "当前": "平静",
    "强度": 50,
    "稳定": 60
  }
}

// ─── 心情状态机 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].身体.体力 > 70 ∧ $[NPC:猫猫].关系.亲密 > 70 {
      $.心情.当前 = "开心"
    },
  $[NPC:猫猫].身体.体力 < 30 {
      $.心情.当前 = "低落"
    },
  $[NPC:猫猫].标记.饥饿 == true {
      $.心情.当前 = "烦躁"
    },
  $[NPC:猫猫].身体.清洁 < 30 {
      $.心情.当前 = "不舒服"
    },
  $[NPC:猫猫].身体.舒适 > 70 ∧ $[NPC:猫猫].标记.饥饿 == false ∧ $[NPC:猫猫].标记.口渴 == false {
      $.心情.当前 = "满足"
    },
  $[NPC:猫猫].心情.当前 == "开心" ∧ $[NPC:猫猫].心情.稳定 >= 50 ∧ $.状态.触发 == "" {
      $.状态.触发 = "开心地摇尾巴、哼小曲"
    },
  $[NPC:猫猫].心情.当前 == "满足" ∧ $.状态.触发 == "" {
      $.状态.触发 = "满足地咕噜咕噜"
    },
  $[NPC:猫猫].心情.当前 == "低落" ∧ $[NPC:猫猫].心情.稳定 >= 40 ∧ $.状态.触发 == "" {
      $.状态.触发 = "垂着耳朵、有点没精神"
    },
  $[NPC:猫猫].身体.舒适 > 80 ∧ $[NPC:猫猫].关系.亲密 < 100 {
      $.关系.亲密 += 1
    },
  $[NPC:猫猫].身体.舒适 > 80 ∧ $[NPC:猫猫].关系.信赖 < 100 {
      $.关系.信赖 += 1
    },
  $[NPC:猫猫].主人同场景 == true ∧ $[NPC:猫猫].关系.安全感 < 100 {
      $.关系.安全感 += 2
    }
}

// ─── 情绪稳定度联动（心情.稳定）───

@规则[$[NPC:猫猫]] {
  优先级: 210
  $[NPC:猫猫].心情.稳定 < 50 ∧ $[NPC:猫猫].心情.当前 == "开心" ∧ $.状态.触发 == "" {
      $.状态.触发 = "情绪有点波动、耳朵不安地抖了抖、但还是很开心"
    },
  $[NPC:猫猫].心情.稳定 < 40 ∧ $[NPC:猫猫].心情.当前 == "低落" ∧ $.状态.触发 == "" {
      $.状态.触发 = "心情低落又不太稳定、想钻进&{对主人称呼}怀里求抱抱"
    },
  $[NPC:猫猫].心情.稳定 < 30 ∧ $[NPC:猫猫].心情.当前 == "烦躁" ∧ $.状态.触发 == "" {
      $.状态.触发 = "烦躁得尾巴甩来甩去、&{对主人称呼}摸摸猫猫就会好一点"
    },
  $[NPC:猫猫].心情.稳定 >= 70 ∧ $[NPC:猫猫].心情.当前 == "开心" ∧ $.状态.触发 == "" {
      $.状态.触发 = "心情又稳又甜、开心地哼着歌、尾巴轻轻晃"
    },
  $[NPC:猫猫].心情.稳定 < 80 ∧ $[NPC:猫猫].关系.亲密 > 80 {
      $.心情.稳定 += 1
    },
  $[NPC:猫猫].心情.稳定 > 20 ∧ $[NPC:猫猫].心情.当前 == "开心" ∧ $[NPC:猫猫].心情.稳定 < 100 {
      $.心情.稳定 += 1
    }
}
