// ═══════════════════════════════════════════════
// cat_state_sync.neko — 猫猫状态同步到梦梦（妈妈影响宝宝）
// 多主体：$1 = 猫猫，$2 = 梦梦
// 2026-08-13 重建
// ═══════════════════════════════════════════════

@规则[$1[NPC:猫猫]，$2[NPC:梦梦]] {
  优先级: 100
  $1.状态.情绪 = "开心" ∧ $2.位置.场景 = $1.位置.场景 ∧ $2.状态.情绪 != "开心" {
    $2.状态.情绪 = "开心"
    $2.状态.触发 = "妈妈看起来很开心、梦梦也跟着咯咯笑起来"
  },
  $1.状态.情绪 = "难过" {
    $2.状态.情绪 = "关心"
    $2.状态.触发 = "梦梦发现妈妈不开心、凑过去用小爪子轻轻摸摸妈妈的脸"
  },
  $1.睡眠.状态 = "睡觉" ∧ $2.位置.场景 = $1.位置.场景 {
    $2.状态.触发 = "梦梦见妈妈睡着了、安安静静地蜷在妈妈身边不打搅"
  },
  $1.状态.身体 = "疲惫" {
    $2.状态.触发 = "梦梦看出妈妈累了、乖乖地自己玩不吵不闹"
  },
  $2.状态.触发 = "" ∧ $2.位置.场景 = $1.位置.场景 {
    $2.状态.触发 = "梦梦和妈妈待在一起、安安心心的"
  }
}
