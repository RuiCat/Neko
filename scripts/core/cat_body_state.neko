// ═══════════════════════════════════════════════
// cat_body_state.neko — 猫猫完整身体状态系统 v2
// 整合旧系统状态数据（器官/生理/关系/情绪）
// 使用最新语法：注解字段 [类型,@事件,min,max] + @函数 + @事件
// ═══════════════════════════════════════════════

@定义 NPC {
  // ─── 生理状态（核心，带事件绑定）───
  "身体": {
    "体力[int,@体力管理,min:0,max:100]": 75,
    "活力[int,min:0,max:100]": 90,
    "饱食[int,@饱食管理,min:0,max:100]": 82,
    "水分[int,@水分管理,min:0,max:100]": 60,
    "清洁[int,min:0,max:100]": 85,
    "舒适[int,min:0,max:100]": 95,
    "体温[float,min:35,max:40]": 36.8,
    "疼痛[int,min:0,max:100]": 0,
    "疲劳[int,min:0,max:100]": 5
  },

  // ─── 情绪状态 ───
  "状态": {
    "身体": "活跃",
    "情绪": "平静",
    "当前情绪": "平静",
    "情绪强度[int,min:0,max:10]": 3,
    "情绪稳定性": "平稳",
    "具体感受": []
  },

  // ─── 关系状态 ───
  "关系": {
    "亲密[int,min:0,max:100]": 95,
    "信赖[int,min:0,max:100]": 95,
    "撒娇欲[int,min:0,max:100]": 85,
    "害羞[int,min:0,max:100]": 45,
    "安全感[int,min:0,max:100]": 90,
    "探索欲[int,min:0,max:100]": 70,
    "爱意[int,min:0,max:100]": 80
  },

  // ─── 标记状态 ───
  "标记": {
    "饥饿": false,
    "口渴": false,
    "疲劳": false,
    "疼痛": false,
    "想撒娇": false,
    "想探索": false
  },

  // ─── 位置与场景 ───
  "位置": {
    "场景": "S001-BR",
    "上次场景": ""
  }
}

// ═══════════════════════════════════════════════
// 事件函数：生理状态变化 → 标记更新
// ═══════════════════════════════════════════════

@函数 体力管理(变化量:int) {
  if 变化量 < -30 {
    状态.身体 = "昏厥"
    标记.疲劳 = true
  } else if 变化量 < -20 {
    状态.身体 = "疲惫"
    标记.疲劳 = true
  } else if 变化量 < -10 {
    状态.身体 = "虚弱"
  } else if 变化量 > 20 {
    状态.身体 = "活跃"
    标记.疲劳 = false
  }
}

@函数 饱食管理(变化量:int) {
  if 变化量 < -30 {
    标记.饥饿 = true
  } else if 变化量 > 30 {
    标记.饥饿 = false
  }
}

@函数 水分管理(变化量:int) {
  if 变化量 < -20 {
    标记.口渴 = true
  } else if 变化量 > 20 {
    标记.口渴 = false
  }
}

// ─── 事件定义（字段变化及时触发）───

@事件:体力管理 {
  处理: 体力管理
}

@事件:饱食管理 {
  处理: 饱食管理
}

@事件:水分管理 {
  处理: 水分管理
}

// ═══════════════════════════════════════════════
// 状态联动规则
// ═══════════════════════════════════════════════

// 疼痛 → 标记 + 状态
@规则[$[成年]] {
  $[成年].身体.疼痛 > 30 {
      $.标记.疼痛 = true
    },
  $[成年].身体.疼痛 <= 30 {
      $.标记.疼痛 = false
    },
  $[成年].身体.体力 > 70 ∧ $[成年].标记.饥饿 == false {
      $.状态.情绪 = "开心"
    },
  $[成年].标记.饥饿 == true {
      $.状态.情绪 = "烦躁"
    },
  $[成年].身体.体力 < 30 {
      $.状态.情绪 = "低落"
    },
  $[成年].关系.亲密 > 80 ∧ $[成年].标记.想撒娇 == true {
      $.状态.触发 = "蹭蹭&{对主人称呼}、想撒娇"
    },
  $[成年].关系.探索欲 > 60 ∧ $[成年].标记.想探索 == true {
      $.状态.触发 = "好奇地东张西望"
    }
}
