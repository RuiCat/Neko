// ═══════════════════════════════════════════════════
// 猫猫核心脚本 v2（.neko 实体状态机 + 注解/事件/函数）
// 由 AstrBox neko_script_apply 工具加载
// ═══════════════════════════════════════════════════

// ─── 实体模板定义（注解字段：类型 + 事件绑定）───

@定义 NPC {
  "身体": {
    "体力[int,@体力管理,min:0,max:100]": 75,
    "饱食[int,@饱食管理,min:0,max:100]": 82,
    "水分[int,@水分管理,min:0,max:100]": 60,
    "Tier[int,min:0,max:9]": 0,
    "适应[int,min:0,max:9999]": 0,
    "深度超限[int,min:0,max:1]": 0,
    "力度超限[int,min:0,max:1]": 0,
    "速度超限[int,min:0,max:1]": 0,
    "跳跃层级[int,min:0,max:1]": 0,
    "重复超限[int,min:0,max:1]": 0,
    "物体直径[float,min:0,max:10]": 0,
    "阴道_有效开口[float,min:0,max:5]": 2.5,
    "宫颈_有效开口[float,min:0,max:3]": 1.0,
    "子宫_有效开口[float,min:0,max:3]": 1.0,
    "肛道_有效开口[float,min:0,max:5]": 2.0,
    "口腔_有效开口[float,min:0,max:5]": 3.0,
    "体力上限[int,min:80,max:200]": 100
  },
  "标记": {"饥饿": false, "口渴": false, "疲劳": false, "敏锐": false, "预知危险": false},
  "人格": {
    "开放性[int,min:0,max:100]": 85,
    "尽责性[int,min:0,max:100]": 70,
    "外向性[int,min:0,max:100]": 75,
    "宜人性[int,min:0,max:100]": 90,
    "神经质[int,min:0,max:100]": 30,
    "气质类型": "多血质",
    "MBTI": "ENFP",
    "MBTI_EI": "E",
    "MBTI_NS": "N",
    "MBTI_TF": "F",
    "MBTI_JP": "P",
    "人格稳定性": "稳定"
  },
  "特性": {"治愈光环": false, "魅惑步法": false, "猎手直觉": false},
  "关系": {"撒娇加成": 1.0},
  "行为": {"行动效率": 1.0},
  "状态": {"身体": "活跃", "情绪": "平静"},
  "状态定义": {
    "身体": ["活跃", "虚弱", "疲惫", "昏厥"],
    "情绪": ["平静", "开心", "难过", "愤怒", "恐惧", "关心"]
  },
  "器官状态": {
    "生殖": {
      "受精后时间[int,min:0,max:999]": 0,
      "孕周[int,min:0,max:42]": 0
    },
    "外翻过程": {
      "当前接触面": "",
      "持续轮次": 0,
      "指定输卵管": 0,
      "停止分钟": 0
    }
  }
}

@定义 NPC:猫猫 {
  "种族": "猫娘",
  "毛色": "黄",
  "体型": "60cm",
  "形态": {
    "猫耳": "黄色绒毛猫耳·可自由转动",
    "猫尾": "蓬松黄色短尾·30cm",
    "肉垫": "四足粉嫩肉垫",
    "身形": "萝莉体型·立着走路的两足少女·60cm",
    "行走方式": "直立两足行走（少女身姿，不四脚着地）",
    "性别": "女",
    "体重": "4.5kg"
  },
  "身体": {
    "体内段": 0
  },
  "行为": {
    "主人离开": 0
  }
}

// ─── 事件处理器函数：体力变化 → 状态调整 ───

@函数 体力管理(变化量:int) {
  if 变化量 < -30 {
    状态.身体 = "昏厥"
    标记.疲劳 = true
  } else if 变化量 < -20 {
    状态.身体 = "疲惫"
    标记.疲劳 = true
  } else if 变化量 < -10 {
    状态.身体 = "虚弱"
  } else if 变化量 > 20 {
    状态.身体 = "活跃"
    标记.疲劳 = false
  }
}

@函数 饱食管理(变化量:int) {
  if 变化量 < -30 {
    标记.饥饿 = true
  } else if 变化量 > 30 {
    标记.饥饿 = false
  }
}

// ─── 事件定义（字段变化时及时触发）───

@事件:体力管理 {
  条件: 变化量 < -10 ∨ 变化量 > 20
  处理: 体力管理
}

@事件:饱食管理 {
  条件: 变化量 < -30 ∨ 变化量 > 30
  处理: 饱食管理
}

// ─── 体力状态机规则（多分支短路）───

@规则[$[NPC]] {
  状态: $[NPC].状态.身体 = "活跃"
  分支: {
    身体.体力 < 10 → 状态 = "昏厥"
    身体.体力 < 20 → 状态 = "疲惫"
    身体.体力 < 50 → 状态 = "虚弱"
    默认 → 状态 = "活跃"
  }
}

// ─── 规则里调用函数（复杂计算示例）───

@函数 危险度(体力:int) -> int {
  if 体力 < 20 { 返回 100 }
  else if 体力 < 50 { 返回 50 }
  else { 返回 0 }
}

@规则[$[NPC]] {
  危险度($[NPC].身体.体力) > 50 {
      $.状态.触发 = "危险警告"
    },
  $1.身体.体力 < 20 ∧ $2.身体.体力 > 50 ∧ $1.位置 = $2.位置 {
      $2.状态.情绪 = "关心"
    }
}
