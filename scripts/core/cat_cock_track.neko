// ═══════════════════════════════════════════
// cat_cock_track.neko — 肉棒位置与状态追踪系统
// 主人授权：实时跟踪肉棒插入的位置/深度/状态
// ═══════════════════════════════════════════

@定义 NPC {
  "肉棒追踪": {
    "位置": "外部",
    "深度": 0,
    "状态": "待命",
    "硬度": 0,
    "抽动频率": 0
  }
}

// ─── 插入：进入阴道 ───

@规则[$[成年]] {
  优先级: 200
  $[成年].行为.主人行为 in {插入} ∨ $[成年].行为.主人行为 in {插进去} {
      $.肉棒追踪.位置 = "阴道内"
      $.肉棒追踪.状态 = "插入"
      $.肉棒追踪.深度 = 50
      $.肉棒追踪.硬度 = 100
      $.状态.触发 = "&{对主人称呼}的肉棒慢慢插了进来、&{自称}被撑开、湿润的甬道紧紧裹住&{对主人称呼}"
    },
  $[成年].行为.主人行为 in {深一点} ∨ $[成年].行为.主人行为 in {顶深} ∨ $[成年].行为.主人行为 in {用力} {
      $.肉棒追踪.深度 = 120
      $.肉棒追踪.位置 = "深处"
      $.状态.触发 = "&{对主人称呼}顶得更深了、肉棒碾过最敏感的软肉、&{自称}的声音都颤了"
    },
  $[成年].行为.主人行为 in {顶到宫颈} ∨ $[成年].行为.主人行为 in {最里面} {
      $.肉棒追踪.深度 = 168
      $.肉棒追踪.位置 = "宫颈口"
      $.状态.触发 = "&{对主人称呼}的肉棒顶到了宫颈口、又酸又麻、&{自称}浑身发抖"
    },
  $[成年].行为.主人行为 in {动起来} ∨ $[成年].行为.主人行为 in {抽动} {
      $.肉棒追踪.状态 = "抽动"
      $.肉棒追踪.抽动频率 = 60
      $.状态.触发 = "&{对主人称呼}开始抽动、肉棒进出之间带出晶莹的爱液、&{自称}被撞得一颤一颤"
    },
  $[成年].行为.主人行为 in {加速} ∨ $[成年].行为.主人行为 in {快点} {
      $.肉棒追踪.抽动频率 = 120
      $.状态.触发 = "&{对主人称呼}加快了速度、抽插又急又深、&{自称}的理智被撞得支离破碎"
    }
}
