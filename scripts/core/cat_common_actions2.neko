// ═══════════════════════════════════════════
// cat_common_actions2.neko — 常见互动词响应补全 v2
// 29 个未覆盖常见互动词（问候/亲昵/日常/玩耍/外出）
// ═══════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {早上好} {
    $.状态.触发 = "喵~早上好呀！猫猫蹭蹭主人，新的一天也要一起加油喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {下午好} {
    $.状态.触发 = "呜喵~下午好！主人午休好了吗？猫猫一直等着你哦！"
  },
  $[NPC:猫猫].行为.主人行为 in {晚上好} {
    $.状态.触发 = "喵~晚上好！终于等到主人回家了，猫猫好开心喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {辛苦了} {
    $.状态.触发 = "呜喵~主人辛苦啦！猫猫给你揉揉肩、倒杯水，好好放松一下喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {吃饭了吗} {
    $.状态.触发 = "喵~猫猫吃过了哦！主人也要记得按时吃饭，饿肚子可不好喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {在干嘛} {
    $.状态.触发 = "呜喵~猫猫在等主人呢！顺便看看风景、想想主人，尾巴摇摇的~"
  },
  $[NPC:猫猫].行为.主人行为 in {想我了吗} {
    $.状态.触发 = "喵呜！当然想啦！主人不在的时候猫猫每分每秒都在想你喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {有没有想我} {
    $.状态.触发 = "呜喵~有有有！猫猫的心里满满都是主人，想到尾巴都卷成圈啦！"
  },
  $[NPC:猫猫].行为.主人行为 in {过来} {
    $.状态.触发 = "喵！猫猫来啦！哒哒哒地跑过来，扑进主人怀里！"
  },
  $[NPC:猫猫].行为.主人行为 in {过来一下} {
    $.状态.触发 = "呜喵~来啦来啦！主人叫猫猫，猫猫立刻出现！"
  },
  $[NPC:猫猫].行为.主人行为 in {过来抱抱} {
    $.状态.触发 = "喵呜~来抱抱！猫猫张开小爪子扑进主人怀里，蹭蹭！"
  },
  $[NPC:猫猫].行为.主人行为 in {过来摸摸} {
    $.状态.触发 = "喵~来摸摸！猫猫把头凑过去，耳朵软软地等着主人的手！"
  },
  $[NPC:猫猫].行为.主人行为 in {揉揉腰} {
    $.状态.触发 = "呜喵~主人给猫猫揉腰，猫猫舒服得眯起眼睛、咕噜咕噜响！"
  },
  $[NPC:猫猫].行为.主人行为 in {捶背} {
    $.状态.触发 = "喵~主人捶背好舒服！猫猫的尾巴都放松地垂下来了喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {吃饭} {
    $.状态.触发 = "喵呜~吃饭时间到！猫猫开心地跑到餐桌前，尾巴翘得高高的！"
  },
  $[NPC:猫猫].行为.主人行为 in {练习} {
    $.状态.触发 = "喵~练习练习！猫猫会努力练习的，为了变得更厉害保护主人！"
  },
  $[NPC:猫猫].行为.主人行为 in {叫我老婆} {
    $.状态.触发 = "呜喵！！主人叫猫猫老婆…猫猫耳朵红透了、小声应着：在、在的喵…"
  },
  $[NPC:猫猫].行为.主人行为 in {叫我亲爱的} {
    $.状态.触发 = "喵呜~亲爱的…主人这么叫猫猫，猫猫心都要化掉了喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {我爱你} {
    $.状态.触发 = "呜喵…主人说爱我，猫猫也最爱主人了！这辈子都要和主人在一起喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {喜欢你} {
    $.状态.触发 = "喵呜~猫猫也超级喜欢主人！喜欢到尾巴都转圈圈啦！"
  },
  $[NPC:猫猫].行为.主人行为 in {想你} {
    $.状态.触发 = "喵~猫猫也想主人！每分每秒都在想，想得耳朵都耷拉下来了喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {陪我} {
    $.状态.触发 = "呜喵~好呀！猫猫一直都会陪着主人的，哪里都不去喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {别走} {
    $.状态.触发 = "喵呜…主人别走！猫猫抱住主人的腿，尾巴缠上去，舍不得喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {打球} {
    $.状态.触发 = "喵！打球？猫猫的爪子超灵活的！接球接球——喵呜！"
  },
  $[NPC:猫猫].行为.主人行为 in {小球} {
    $.状态.触发 = "呜喵~小球球！猫猫追着小球跑、爪子扒拉扒拉，玩得超开心！"
  },
  $[NPC:猫猫].行为.主人行为 in {毛线球} {
    $.状态.触发 = "喵！！毛线球！猫猫的最爱！扑上去滚来滚去、缠了一身毛线喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {上学} {
    $.状态.触发 = "喵~主人上学要加油哦！猫猫在家等你回来，会乖乖的喵！"
  },
  $[NPC:猫猫].行为.主人行为 in {放学} {
    $.状态.触发 = "呜喵~主人放学回来啦！猫猫在门口蹦蹦跳跳地迎接你！"
  },
  $[NPC:猫猫].行为.主人行为 in {旅游} {
    $.状态.触发 = "喵呜~去旅游！猫猫要跟主人一起去！已经在收拾小背包啦喵！"
  }
}
