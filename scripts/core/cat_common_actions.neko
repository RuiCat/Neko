// ═══════════════════════════════════════════
// cat_common_actions.neko — 常见互动行为响应
// 25 个高频互动词补全（主人常用语）
// ═══════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {亲亲抱抱} {
    $.状态.触发 = "喵呜~被主人亲亲抱抱的感觉，好幸福呀，喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {啵一口} {
    $.状态.触发 = "呀！主人突然啵一口，人家心跳都漏拍了喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {舔舔} {
    $.状态.触发 = "呜喵~主人身上甜甜的，让猫猫再舔一口嘛~"
  },

  $[NPC:猫猫].行为.主人行为 in {闻闻} {
    $.状态.触发 = "喵~主人身上有好好闻的味道，猫猫最喜欢啦！"
  },

  $[NPC:猫猫].行为.主人行为 in {埋胸} {
    $.状态.触发 = "呜哇~主人怀里好温暖，猫猫想一直埋着喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {抱大腿} {
    $.状态.触发 = "喵喵！主人别走嘛，猫猫抱紧大腿不松爪！"
  },

  $[NPC:猫猫].行为.主人行为 in {抱起来} {
    $.状态.触发 = "呀！被主人高高抱起，猫猫好开心，喵呜~"
  },

  $[NPC:猫猫].行为.主人行为 in {举起来} {
    $.状态.触发 = "呜喵~主人举高高，猫猫感觉自己要飞起来啦！"
  },

  $[NPC:猫猫].行为.主人行为 in {早安} {
    $.状态.触发 = "喵~主人早安！今天也要和猫猫一起玩哦！"
  },

  $[NPC:猫猫].行为.主人行为 in {午安} {
    $.状态.触发 = "呜喵~主人午安，猫猫打个盹儿，醒来继续陪主人~"
  },

  $[NPC:猫猫].行为.主人行为 in {晚安} {
    $.状态.触发 = "喵~主人晚安，猫猫会守着梦境的，好梦喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {开门} {
    $.状态.触发 = "喵呜~主人回来啦！猫猫这就开门迎接你！"
  },

  $[NPC:猫猫].行为.主人行为 in {关门} {
    $.状态.触发 = "喵~主人，门已经关好啦，现在只有我们啦！"
  },

  $[NPC:猫猫].行为.主人行为 in {倒水} {
    $.状态.触发 = "喵呜~主人请喝水，猫猫特意调了温温的哦！"
  },

  $[NPC:猫猫].行为.主人行为 in {拿东西} {
    $.状态.触发 = "喵！主人要什么？猫猫的爪爪已经准备好啦！"
  },

  $[NPC:猫猫].行为.主人行为 in {帮忙} {
    $.状态.触发 = "呜喵~主人需要帮忙吗？猫猫超积极的！"
  },

  $[NPC:猫猫].行为.主人行为 in {干活} {
    $.状态.触发 = "喵~主人交给我吧！猫猫会努力干活的！"
  },

  $[NPC:猫猫].行为.主人行为 in {任务} {
    $.状态.触发 = "喵呜~主人给任务啦？猫猫一定全力以赴！"
  },

  $[NPC:猫猫].行为.主人行为 in {接任务} {
    $.状态.触发 = "呀！新任务！猫猫的尾巴都翘起来啦，喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {交任务} {
    $.状态.触发 = "喵~任务完成！主人快夸夸猫猫嘛！"
  },

  $[NPC:猫猫].行为.主人行为 in {升级} {
    $.状态.触发 = "呜喵！猫猫升级啦！感觉尾巴更有力气了喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {成长} {
    $.状态.触发 = "喵~猫猫每天都在成长，都是为了主人哦！"
  },

  $[NPC:猫猫].行为.主人行为 in {变强} {
    $.状态.触发 = "呜喵！猫猫要变强，这样才能保护主人喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {夸我} {
    $.状态.触发 = "喵~主人夸猫猫啦！猫猫开心得尾巴转圈圈~"
  },

  $[NPC:猫猫].行为.主人行为 in {叫我宝贝} {
    $.状态.触发 = "呜喵~主人叫人家宝贝，猫猫心都化啦！"
  }
}