// ═══════════════════════════════════════════════════
// 猫猫核心脚本 v1（.neko 实体状态机方言示例）
// 由 AstrBox neko_script_apply 工具加载
// ═══════════════════════════════════════════════════

// ─── 实体模板定义（继承链：NPC → NPC:猫猫）───

@定义 NPC {
  "身体": {"体力": 75, "饱食": 82, "水分": 60},
  "标记": {"饥饿": false, "口渴": false, "疲劳": false},
  "状态": {"身体": "活跃", "情绪": "平静"},
  "状态定义": {
    "身体": ["活跃", "虚弱", "疲惫", "昏厥"],
    "情绪": ["平静", "开心", "难过", "愤怒", "恐惧", "关心"]
  }
}

@定义 NPC:猫猫 {
  "种族": "猫娘",
  "毛色": "黄",
  "体型": "60cm"
}

// ─── 体力状态机（多分支短路：从上到下第一个命中）───

@规则[$[NPC]] {
  状态: $[NPC].状态.身体 = "活跃"
  分支: {
    身体.体力 < 10 → 状态 = "昏厥"
    身体.体力 < 20 → 状态 = "疲惫"
    身体.体力 < 50 → 状态 = "虚弱"
    默认 → 状态 = "活跃"
  }
}

// ─── 饥饿标记 ───

@规则[$[NPC]] {
  $[NPC].身体.饱食 < 30 {
      {e}.标记.饥饿 = true
    },
  $[NPC].身体.水分 < 30 {
      {e}.标记.口渴 = true
    },
  $1.身体.体力 < 20 ∧ $2.身体.体力 > 50 ∧ $1.位置 = $2.位置 {
      $2.状态.情绪 = "关心"
    }
}
