// ═══════════════════════════════════════════
// cat_reaction_timer.neko — 反应节拍器
// 每 tick 递减倒计时；归零时抽取下一次间隔（随机 tick 数）。
// 反应内容由调用方按 反应.类型 决定；本文件不定义任何语义。
// 依赖：@函数 随机(a,b)（internal/function/builtins.go）。
// ═══════════════════════════════════════════

@定义 NPC {
  "反应": {
    "启用": false,
    "倒计时": 0,
    "轮次": 0,
    "类型": ""
  }
}

// 下一次反应的间隔（tick 数，1~5）。
@函数 反应间隔() -> int {
  返回 随机(1, 5)
}

@规则[$[成年]] {
  $.反应.启用 == true ∧ $.反应.倒计时 > 0 {
      $.反应.倒计时 -= 1
    },
  $.反应.启用 == true ∧ $.反应.倒计时 <= 0 {
      $.反应.倒计时 = 反应间隔()
      $.反应.轮次 += 1
    }
}
