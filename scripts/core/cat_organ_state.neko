// ═══════════════════════════════════════════════
// cat_organ_state.neko — 完整器官状态模型 v2
// 管状器官分两面：粘膜面(内侧)/浆膜面(外侧)
// 实质性器官（卵巢）：无管腔无口，外翻后游离，不在浆膜间隙内
// ═══════════════════════════════════════════════

@定义 器官状态 {
  "阴道": {
    "位置": "体内", "朝外面": "粘膜面",
    "管腔": {"开放": true, "有效开口": 2.5},
    "浆膜面": {"接触": "", "外露": false},
    "粘膜面": {"可见": false, "接触": ""}
  },
  "宫颈": {
    "位置": "体内", "朝外面": "粘膜面",
    "管腔": {"开放": true, "有效开口": 1.0},
    "浆膜面": {"接触": "", "外露": false},
    "粘膜面": {"可见": false, "接触": ""}
  },
  "子宫": {
    "位置": "体内", "朝外面": "粘膜面",
    "管腔": {"开放": true, "有效开口": 1.0},
    "浆膜面": {"接触": "", "外露": false},
    "粘膜面": {"可见": false, "接触": ""}
  },
  "输卵管_左": {
    "位置": "体内", "朝外面": "浆膜面",
    "管腔": {"开放": false, "有效开口": 0, "是否内腔入口": true},
    "繊状突起": {"浆膜面": {"接触": "", "外露": false}, "粘膜面": {"可见": false}}
  },
  "输卵管_右": {
    "位置": "体内", "朝外面": "浆膜面",
    "管腔": {"开放": false, "有效开口": 0, "是否内腔入口": true},
    "繊状突起": {"浆膜面": {"接触": "", "外露": false}, "粘膜面": {"可见": false}}
  },
  "卵巢_左": {
    "类型": "实质性器官",       // 无管腔无口
    "位置": "体内",
    "被膜面": {"外露": false, "接触": ""},
    "韧带": {"状态": "正常", "拉长": false},
    "可进入": false,           // 无腔无口，不可插入
    "是否在浆膜间隙内": false
  },
  "卵巢_右": {
    "类型": "实质性器官",
    "位置": "体内",
    "被膜面": {"外露": false, "接触": ""},
    "韧带": {"状态": "正常", "拉长": false},
    "可进入": false,
    "是否在浆膜间隙内": false
  },
  "浆膜间隙": {
    "存在": false,
    "龟头入口": "",
    "路径": [],
    "体外": false
  }
}
