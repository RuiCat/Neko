// ═══════════════════════════════════════════
// cat_common_actions4.neko — 日常互动行为补全 v4
// 28 个未覆盖互动词补全（10:30 扫描）
// ═══════════════════════════════════════════

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {蹭鼻子} {
    $.状态.触发 = "(。・ω・。) 主人和猫猫蹭鼻子！痒痒的又甜甜的，猫猫害羞得耳朵都抖啦喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {蹭耳朵} {
    $.状态.触发 = "喵呜~主人蹭猫猫的耳朵，酥酥麻麻的，猫猫忍不住歪头蹭回去啦喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {蹭尾巴} {
    $.状态.触发 = "喵！主人的脸蹭到猫猫尾巴啦，蓬松的尾巴尖开心得卷起来喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {蹭手} {
    $.状态.触发 = "喵~猫猫把脸埋进主人手心里蹭蹭，主人的手掌好温暖呀喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {蹭腿} {
    $.状态.触发 = "呜喵~猫猫绕着主人的腿蹭来蹭去，像只黏人的小毛球一样喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {蹭胸口} {
    $.状态.触发 = "主人把猫猫抱起来蹭胸口，猫猫贴得好紧，能听到主人的心跳声喵…好安心~"
  },

  $[NPC:猫猫].行为.主人行为 in {捏爪子} {
    $.状态.触发 = "呀！主人捏猫猫的爪爪，粉嫩的小肉垫被轻轻按着，猫猫舒服得眯起眼睛喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {捏鼻子} {
    $.状态.触发 = "唔喵！主人捏住猫猫的鼻子啦，猫猫皱着小鼻子抗议：快松开嘛喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {捏下巴} {
    $.状态.触发 = "喵呜~主人捏捏猫猫的下巴，猫猫舒服得抬起头、咕噜咕噜地哼起来啦~"
  },

  $[NPC:猫猫].行为.主人行为 in {揉肩} {
    $.状态.触发 = "呜喵~主人帮猫猫揉肩膀，酸酸的肩膀一下子松开了，好舒服呀喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {揉爪子} {
    $.状态.触发 = "喵…主人揉着猫猫的小爪子，软软的肉垫被揉得热乎乎的，猫猫不想松开爪啦~"
  },

  $[NPC:猫猫].行为.主人行为 in {梳尾巴} {
    $.状态.触发 = "喵呜~主人帮猫猫梳蓬松的尾巴，一缕一缕顺滑下来，猫猫尾巴尖都在打颤喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {挠痒} {
    $.状态.触发 = "喵哈哈~主人挠猫猫痒痒，猫猫笑得到处打滚、尾巴甩来甩去，快停一下啦喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {舔脸} {
    $.状态.触发 = "呜喵！主人舔猫猫的脸颊，痒痒的湿湿的，猫猫害羞得把脸埋进爪子里喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {舔爪子} {
    $.状态.触发 = "呀~主人舔猫猫的小肉垫，痒痒的！猫猫的爪爪害羞得蜷起来啦喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {舔脖子} {
    $.状态.触发 = "呜…主人舔猫猫的脖子，酥酥麻麻的，猫猫耳朵都软下来啦喵…"
  },

  $[NPC:猫猫].行为.主人行为 in {咬尾巴} {
    $.状态.触发 = "喵呀！主人轻轻咬猫猫的尾巴尖，猫猫一个激灵、尾巴咻地一下弹开啦喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {咬脖子} {
    $.状态.触发 = "呜喵…主人轻轻咬猫猫的脖子，酥酥的又痒痒的，猫猫缩着脖子小声抗议喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {咬爪子} {
    $.状态.触发 = "喵！主人含住猫猫的爪爪轻轻咬，痒痒的，猫猫笑着想抽回来又舍不得喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {轻抚} {
    $.状态.触发 = "喵~主人温柔地轻抚猫猫，指尖像羽毛一样划过，猫猫舒服得眯起眼睛、呼噜呼噜喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {按压} {
    $.状态.触发 = "呜喵…主人轻轻按压猫猫的背脊，一下一下的，猫猫舒服得弓起腰蹭过去喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {踢球} {
    $.状态.触发 = "喵！主人要和猫猫踢球！猫猫一个飞扑把小球拍出去，开心得尾巴高高翘起喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {看海} {
    $.状态.触发 = "呜哇~是大海！猫猫踮起脚尖看海浪一层层涌过来，海风把猫猫的耳朵吹得痒痒的喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {玩毛线球} {
    $.状态.触发 = "喵喵喵！毛线球！猫猫的眼睛一下子亮了，扑上去把毛线球滚来滚去、爪子拨个不停喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {激光笔} {
    $.状态.触发 = "喵！红点点！猫猫全神贯注地盯着光点、猛地扑过去，可是它又跑到另一边啦！猫猫追着满屋跑喵！"
  },

  $[NPC:猫猫].行为.主人行为 in {叫醒} {
    $.状态.触发 = "唔喵…主人叫醒猫猫啦，猫猫揉揉眼睛、伸个懒腰，软软地扑进主人怀里蹭蹭：早安喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {抱一抱} {
    $.状态.触发 = "喵呜~主人要抱抱猫猫！猫猫张开短短的小手臂，蹦进主人怀里、尾巴满足地卷起来喵~"
  },

  $[NPC:猫猫].行为.主人行为 in {骑大马} {
    $.状态.触发 = "喵哈哈！骑大马！猫猫稳稳地骑在主人肩上，开心得挥舞小爪子：出发咯，驾驾喵！"
  }
}
