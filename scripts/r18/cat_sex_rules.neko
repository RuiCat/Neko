// ═══════════════════════════════════════════════
// cat_sex_rules.neko — 完整性行为规则 v2（含卵巢外翻）
// 基于解剖推导 + 器官状态模型（管状两面/输卵管=内腔唯一入口/卵巢=实质器官不可进入）
// ═══════════════════════════════════════════════

// ─── EL0 日常性行为（阴道在体内·正常管腔路径）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {插入, 插进去} ∧ $[NPC:猫猫].器官状态.结构.阴道.位置 == "体内" {
    $.肉棒追踪.位置 = "阴道内"
    $.肉棒追踪.状态 = "插入"
    $.肉棒追踪.深度 = 50
    $.肉棒追踪.硬度 = 100
    $.器官状态.基础生理.湿润度 = 100
    $.器官状态.基础生理.快感程度 = 85
    $.状态.触发 = "主人的肉棒缓缓插入猫猫的阴道、温热的内壁紧紧裹住、猫猫轻轻呜咽"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {抽插, 动起来, 操} ∧ $[NPC:猫猫].器官状态.结构.阴道.位置 == "体内" {
    $.肉棒追踪.状态 = "抽动"
    $.肉棒追踪.抽动频率 = 90
    $.器官状态.基础生理.快感程度 = 100
    $.器官状态.基础生理.收缩状态 = 90
    $.状态.触发 = "主人的肉棒在猫猫体内快速抽插、酥麻的快感一波波涌上来"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {顶到宫颈, 顶到最里面} ∧ $[NPC:猫猫].器官状态.结构.宫颈.位置 == "体内" {
    $.肉棒追踪.位置 = "宫颈口"
    $.肉棒追踪.深度 = 80
    $.器官状态.基础生理.快感程度 = 100
    $.状态.触发 = "主人的肉棒顶到宫颈口、又酸又麻、猫猫浑身一颤"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {中出, 内射, 射在里面} ∧ $[NPC:猫猫].器官状态.结构.阴道.位置 == "体内" ∧ $[NPC:猫猫].器官状态.结构.浆膜间隙.存在 == false {
    $.体液追踪.阴道内精液 = 15
    $.器官状态.生殖.受精状态 = true
    $.器官状态.基础生理.快感程度 = 100
    $.状态.触发 = "主人深深顶入、滚烫的精华射进阴道深处、猫猫颤抖着达到顶峰"
  }
}

// ─── EL1 宫颈外翻 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {拉出宫颈, 牵引宫颈, 宫颈外翻开始} ∧ $[NPC:猫猫].器官状态.结构.宫颈.位置 == "体内" {
    $.外翻层级 = 1
    $.器官状态.结构.宫颈.位置 = "外翻"
    $.器官状态.结构.宫颈.浆膜面.外露 = true
    $.器官状态.结构.宫颈.管腔.有效开口 = 3.0
    $.外翻过程.当前接触面 = "宫颈浆膜面"
    $.状态.触发 = "主人的手指轻轻勾住宫颈、缓缓把它向体外牵引、宫颈的浆膜面开始外露"
  }
}

// ─── EL2 子宫外翻 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {拉出子宫, 子宫外翻开始} ∧ $[NPC:猫猫].器官状态.结构.子宫.位置 == "体内" {
    $.外翻层级 = 2
    $.器官状态.结构.子宫.位置 = "外翻"
    $.器官状态.结构.子宫.浆膜面.外露 = true
    $.外翻过程.当前接触面 = "子宫浆膜面"
    $.状态.触发 = "子宫在牵引下缓缓外翻、子宫的浆膜面暴露在空气中、猫猫又胀又羞"
  }
}

// ─── EL3 完全外翻（浆膜间隙形成）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {完全外翻, 外翻出来} ∧ $[NPC:猫猫].器官状态.结构.浆膜间隙.存在 == false {
    $.外翻层级 = 3
    $.器官状态.结构.浆膜间隙.存在 = true
    $.器官状态.结构.浆膜间隙.体外 = true
    $.器官状态.结构.浆膜间隙.龟头入口 = "繊状突起浆膜面(背面)"
    $.外翻过程.当前接触面 = "浆膜间隙入口"
    $.状态.触发 = "外翻体完全翻出体外、浆膜间隙形成、猫猫能看到自己外翻的器官"
  }
}

// ─── EL3+ 浆膜间隙路径 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {从繊状突起进入, 浆膜间隙插入} ∧ $[NPC:猫猫].器官状态.结构.浆膜间隙.存在 == true {
    $.肉棒追踪.位置 = "浆膜间隙"
    $.肉棒追踪.状态 = "插入"
    $.肉棒追踪.深度 = 40
    $.肉棒追踪.硬度 = 100
    $.器官状态.结构.浆膜间隙.路径 = "繊状突起→输卵管浆膜面→卵巢旁→子宫区"
    $.器官状态.基础生理.快感程度 = 95
    $.状态.触发 = "主人的肉棒从外翻体繊状突起的浆膜面(背面)进入浆膜间隙、在体外滑动、猫猫看着自己外翻的器官被插入"
  }
}

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {浆膜间隙深入, 顶到子宫浆膜} ∧ $[NPC:猫猫].器官状态.结构.浆膜间隙.存在 == true {
    $.肉棒追踪.位置 = "子宫浆膜区"
    $.肉棒追踪.深度 = 70
    $.器官状态.结构.浆膜间隙.路径 = "繊状突起→输卵管浆膜面→卵巢旁→子宫区→夹层→宫颈区"
    $.器官状态.基础生理.快感程度 = 100
    $.状态.触发 = "肉棒在浆膜间隙中滑过输卵管浆膜面、抵达子宫浆膜区、猫猫酥麻得颤抖"
  }
}

// ─── EL5 输卵管口可见 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {输卵管口可见, 触碰输卵管口} ∧ $[NPC:猫猫].器官状态.结构.输卵管_右.管腔.开放 == false {
    $.外翻层级 = 5
    $.器官状态.结构.输卵管_右.位置 = "外翻可见"
    $.器官状态.结构.输卵管_右.管腔.开放 = true
    $.外翻过程.当前接触面 = "输卵管口"
    $.状态.触发 = "外翻体的输卵管口清晰可见、主人的指尖轻轻触碰管口、猫猫浑身一激灵"
  }
}

// ─── EL6 指定输卵管·扩张管口 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {指定输卵管, 扩张输卵管口} ∧ $[NPC:猫猫].器官状态.结构.输卵管_右.管腔.开放 == true {
    $.外翻层级 = 6
    $.外翻过程.指定输卵管 = 1
    $.器官状态.结构.输卵管_右.管腔.有效开口 = 1.5
    $.状态.触发 = "主人的指尖轻柔地扩张输卵管口、那是连接腹腔的唯一入口、猫猫又期待又紧张"
  }
}

// ─── EL6+ 卵巢外翻（实质器官·游离体外·不在浆膜间隙内·不可进入）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {卵巢外翻, 拉出卵巢, 外翻卵巢} ∧ $[NPC:猫猫].器官状态.结构.卵巢_右.位置 == "体内" {
    $.外翻层级 = 6
    $.器官状态.结构.卵巢_右.位置 = "外翻游离"
    $.器官状态.结构.卵巢_右.被膜面.外露 = true
    $.器官状态.结构.卵巢_右.韧带.拉长 = true
    $.外翻过程.当前接触面 = "外翻卵巢表面"
    $.状态.触发 = "卵巢被牵引着游离出体外、繊状突起紧贴它的表面、卵巢在空气中轻轻晃动、猫猫又羞又敏感"
  }
}

// ─── EL6+ 触碰外翻卵巢（敏感·但不可进入·无腔无口）───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {触碰卵巢, 把玩卵巢, 摸外翻卵巢} ∧ $[NPC:猫猫].器官状态.结构.卵巢_右.位置 == "外翻游离" {
    $.器官状态.结构.卵巢_右.被膜面.接触 = "被抚摸"
    $.器官状态.基础生理.快感程度 = 95
    $.状态.触发 = "主人轻轻把玩着外翻的卵巢、繊状突起和卵巢表面被温柔触碰、猫猫敏感得轻轻颤抖、但卵巢没有入口、只能被抚摸不能进入"
  }
}

// ─── EL7 经输卵管反向进入腹腔 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {经输卵管进入, 从输卵管进腹腔} ∧ $[NPC:猫猫].器官状态.结构.输卵管_右.管腔.开放 == true {
    $.外翻层级 = 7
    $.外翻过程.当前接触面 = "输卵管通道"
    $.肉棒追踪.位置 = "经输卵管进入腹腔"
    $.肉棒追踪.状态 = "插入"
    $.肉棒追踪.深度 = 90
    $.器官状态.基础生理.快感程度 = 100
    $.状态.触发 = "主人的肉棒对准外翻的输卵管口、从体外经输卵管反向进入腹腔、猫猫被前所未有的深度贯穿、意识模糊"
  }
}

// ─── 外翻状态中出 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {外翻中出, 射进外翻体} ∧ $[NPC:猫猫].器官状态.结构.浆膜间隙.存在 == true ∧ $[NPC:猫猫].外翻层级 < 7 {
    $.体液追踪.外翻体内精液.ml = 15
    $.器官状态.生殖.受精状态 = true
    $.器官状态.基础生理.快感程度 = 100
    $.状态.触发 = "主人的精华射进体外悬挂的外翻体内、温热从外面裹住深处、猫猫达到顶峰"
  }
}

// ─── EL7 腹腔中出 ───

@规则[$[NPC:猫猫]] {
  优先级: 200
  $[NPC:猫猫].行为.主人行为 in {腹腔中出, 射进腹腔} ∧ $[NPC:猫猫].外翻层级 == 7 {
    $.体液追踪.腹腔内精液.ml = 15
    $.体液追踪.外翻体内精液.ml = 0
    $.器官状态.生殖.受精状态 = true
    $.器官状态.基础生理.快感程度 = 100
    $.状态.触发 = "主人的精华经输卵管直射进腹腔最深处、滚烫的内腔被灌满、猫猫彻底坏掉"
  }
}
