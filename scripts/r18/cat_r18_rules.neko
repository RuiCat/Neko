// ═══════════════════════════════════════════
// cat_r18_rules.neko — 性行为阶段化响应规则
// 基于整理的事件阶段流程生成
// 行为 → 阶段推进 → 响应（开场/前戏/核心行为/高潮/收尾）
// ═══════════════════════════════════════════

@定义 NPC {
  "性行为": {
    "行为类型": "无",
    "阶段": 0,
    "进行中": false
  }
}

// ─── 口交 阶段流程（多 if 分支）───

@规则[$[成年]] {
  优先级: 200
  $[成年].行为.主人行为 in {口交, 给我口交, 含住} ∧ $[成年].性行为.进行中 == false {
    $.性行为.行为类型 = "口交"
    $.性行为.阶段 = 1
    $.性行为.进行中 = true
    $.状态.触发 = "被主人压制住、被迫张开嘴……&{自称}颤抖着把那温热的东西含入口中"
  },
  $[成年].性行为.行为类型 == "口交" ∧ $[成年].性行为.阶段 == 1 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 2
    $.状态.触发 = "&{自称}吞吐着、喉咙被顶到深处、眼泪都出来了"
  },
  $[成年].性行为.行为类型 == "口交" ∧ $[成年].性行为.阶段 == 2 ∧ $[成年].身体.体力 < 60 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 3
    $.状态.触发 = "液体在&{自称}口中扩散……主人射出来了"
  },
  $[成年].性行为.行为类型 == "口交" ∧ $[成年].性行为.阶段 == 3 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 0
    $.性行为.进行中 = false
    $.状态.触发 = "&{自称}咽了下去、瘫软在地、大口喘气"
  }
}

// ─── 后背位 阶段流程 ───

@规则[$[成年]] {
  优先级: 200
  $[成年].行为.主人行为 in {后背位, 从后面, 后入} ∧ $[成年].性行为.进行中 == false {
    $.性行为.行为类型 = "后背位"
    $.性行为.阶段 = 1
    $.性行为.进行中 = true
    $.状态.触发 = "&{自称}被主人从后面压住、趴在地上露出屁股"
  },
  $[成年].性行为.行为类型 == "后背位" ∧ $[成年].性行为.阶段 == 1 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 2
    $.状态.触发 = "主人从后面进入、&{自称}抓紧床单、被顶得说不出话"
  },
  $[成年].性行为.行为类型 == "后背位" ∧ $[成年].性行为.阶段 == 2 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 0
    $.性行为.进行中 = false
    $.状态.触发 = "射精结束、&{自称}瘫软趴着、喘息着"
  }
}

// ─── 膣内 阶段流程 ───

@规则[$[成年]] {
  优先级: 200
  $[成年].行为.主人行为 in {膣内, 阴道内, 插入} ∧ $[成年].性行为.进行中 == false {
    $.性行为.行为类型 = "膣内"
    $.性行为.阶段 = 1
    $.性行为.进行中 = true
    $.状态.触发 = "&{自称}被主人进入、身体轻轻颤抖"
  },
  $[成年].性行为.行为类型 == "膣内" ∧ $[成年].性行为.阶段 == 1 ∧ $[成年].器官状态.基础生理.湿润度.value >= 60 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 2
    $.状态.触发 = "&{自称}被深入律动、发出难耐的声音"
  },
  $[成年].性行为.行为类型 == "膣内" ∧ $[成年].性行为.阶段 == 2 ∧ $.状态.触发 == "" {
    $.性行为.阶段 = 0
    $.性行为.进行中 = false
    $.状态.触发 = "内射了……&{自称}蜷在主人怀里、身体还在颤抖"
  }
}
