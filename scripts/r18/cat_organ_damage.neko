// ═══════════════════════════════════════════
// cat_organ_damage.neko — 成年 NPC 器官损伤状态机
// 主语：$[成年]（分类含「成年」的实体，当前为梦梦成年）。
// 输入：各器官「应力」，由调用方写入；本文件不判定应力来源。
// 结算：应力 → 完整性 → 出血速率 → 失血量 → 休克；
//       完整性归零 → 功能 0 + 缺失 true（不可逆）。
// ═══════════════════════════════════════════

@定义 NPC {
  "器官损伤": {
    "阴道":   {"应力": 0, "完整性": 100, "出血速率": 0, "功能": 100, "缺失": false},
    "宫颈":   {"应力": 0, "完整性": 100, "出血速率": 0, "功能": 100, "缺失": false},
    "子宫":   {"应力": 0, "完整性": 100, "出血速率": 0, "功能": 100, "缺失": false},
    "输卵管": {"应力": 0, "完整性": 100, "出血速率": 0, "功能": 100, "缺失": false},
    "卵巢":   {"应力": 0, "完整性": 100, "出血速率": 0, "功能": 100, "缺失": false},
    "腹膜":   {"应力": 0, "完整性": 100, "出血速率": 0, "功能": 100, "缺失": false}
  },
  "伤害": {
    "失血量[int,min:0,max:100]": 0,
    "休克[int,min:0,max:100]": 0
  }
}

// ─── 应力结算：每 tick 消耗 1 点应力、扣 2 点完整性 ───

@规则[$[成年]] {
  $.器官损伤.阴道.应力 > 0 {
      $.器官损伤.阴道.应力 -= 1
      $.器官损伤.阴道.完整性 -= 2
    },
  $.器官损伤.阴道.完整性 <= 0 {
      $.器官损伤.阴道.完整性 = 0
      $.器官损伤.阴道.功能 = 0
      $.器官损伤.阴道.缺失 = true
      $.器官损伤.阴道.出血速率 = 3
    }
}

@规则[$[成年]] {
  $.器官损伤.宫颈.应力 > 0 {
      $.器官损伤.宫颈.应力 -= 1
      $.器官损伤.宫颈.完整性 -= 2
    },
  $.器官损伤.宫颈.完整性 <= 0 {
      $.器官损伤.宫颈.完整性 = 0
      $.器官损伤.宫颈.功能 = 0
      $.器官损伤.宫颈.缺失 = true
      $.器官损伤.宫颈.出血速率 = 3
    }
}

@规则[$[成年]] {
  $.器官损伤.子宫.应力 > 0 {
      $.器官损伤.子宫.应力 -= 1
      $.器官损伤.子宫.完整性 -= 2
    },
  $.器官损伤.子宫.完整性 <= 0 {
      $.器官损伤.子宫.完整性 = 0
      $.器官损伤.子宫.功能 = 0
      $.器官损伤.子宫.缺失 = true
      $.器官损伤.子宫.出血速率 = 3
    }
}

@规则[$[成年]] {
  $.器官损伤.输卵管.应力 > 0 {
      $.器官损伤.输卵管.应力 -= 1
      $.器官损伤.输卵管.完整性 -= 2
    },
  $.器官损伤.输卵管.完整性 <= 0 {
      $.器官损伤.输卵管.完整性 = 0
      $.器官损伤.输卵管.功能 = 0
      $.器官损伤.输卵管.缺失 = true
      $.器官损伤.输卵管.出血速率 = 3
    }
}

@规则[$[成年]] {
  $.器官损伤.卵巢.应力 > 0 {
      $.器官损伤.卵巢.应力 -= 1
      $.器官损伤.卵巢.完整性 -= 2
    },
  $.器官损伤.卵巢.完整性 <= 0 {
      $.器官损伤.卵巢.完整性 = 0
      $.器官损伤.卵巢.功能 = 0
      $.器官损伤.卵巢.缺失 = true
      $.器官损伤.卵巢.出血速率 = 3
    }
}

@规则[$[成年]] {
  $.器官损伤.腹膜.应力 > 0 {
      $.器官损伤.腹膜.应力 -= 1
      $.器官损伤.腹膜.完整性 -= 2
    },
  $.器官损伤.腹膜.完整性 <= 0 {
      $.器官损伤.腹膜.完整性 = 0
      $.器官损伤.腹膜.功能 = 0
      $.器官损伤.腹膜.缺失 = true
      $.器官损伤.腹膜.出血速率 = 3
    }
}

// ─── 失血量：任一器官在出血，每 tick 累积 ───

@规则[$[成年]] {
  $.器官损伤.阴道.出血速率 > 0 ∨ $.器官损伤.宫颈.出血速率 > 0 ∨ $.器官损伤.子宫.出血速率 > 0 ∨ $.器官损伤.输卵管.出血速率 > 0 ∨ $.器官损伤.卵巢.出血速率 > 0 ∨ $.器官损伤.腹膜.出血速率 > 0 {
      $.伤害.失血量 += 3
    }
}

// ─── 休克：失血量阈值 → 休克程度 ───

@规则[$[成年]] {
  $.伤害.失血量 > 40 {
      $.伤害.休克 = 50
    },
  $.伤害.失血量 > 70 {
      $.伤害.休克 = 90
    },
  $.伤害.失血量 > 90 {
      $.伤害.休克 = 100
    }
}
