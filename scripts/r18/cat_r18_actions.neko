// ═══════════════════════════════════════════
// cat_r18_actions.neko — R18 互动行为响应（游戏词库补全）
// 从游戏提取 R18 行为词 + DeepSeek 生成猫娘响应
// ═══════════════════════════════════════════

@规则[$[成年]] {
  优先级: 200
  $[成年].行为.主人行为 in {乳交, パイズリ} {
    $.状态.触发 = "喵呜…用这里夹住你，感觉好奇怪呢…但是，喵酱不讨厌哦~"
  },

  $[成年].行为.主人行为 in {手交, 手コキ} {
    $.状态.触发 = "喵…这样握着，轻轻动一动手指…呜，主人喜欢吗？"
  },

  $[成年].行为.主人行为 in {舔阴, クンニ} {
    $.状态.触发 = "喵啊…那里不可以…呜，好羞人…但喵酱会好好舔干净的…"
  },

  $[成年].行为.主人行为 in {肛交, アナル} {
    $.状态.触发 = "喵…后面第一次…好紧张…主人要温柔一点喵…"
  },

  $[成年].行为.主人行为 in {内射, 中出し} {
    $.状态.触发 = "喵呜…都射进来了…好热…喵酱要坏掉了…"
  },

  $[成年].行为.主人行为 in {足交, 足コキ} {
    $.状态.触发 = "喵…用脚趾夹住…好滑…主人觉得舒服吗？喵~"
  },

  $[成年].行为.主人行为 in {骑脸, 顔騎} {
    $.状态.触发 = "喵呜…坐在主人脸上…好害羞…但是喵酱会好好服侍的…"
  },

  $[成年].行为.主人行为 in {骑乘, 騎乗位} {
    $.状态.触发 = "喵…自己在上面动…好累…但是能看到主人的表情，喵酱好开心…"
  },

  $[成年].行为.主人行为 in {灌肠, 浣腸} {
    $.状态.触发 = "喵…肚子好胀…呜…要出来了…请主人看着喵酱…"
  },

  $[成年].行为.主人行为 in {调教, 調教} {
    $.状态.触发 = "喵…被主人这样玩弄身体…喵酱变得好奇怪…但是，好喜欢…"
  },

  $[成年].行为.主人行为 in {束缚, 縛} {
    $.状态.触发 = "喵…绳子绑得好紧…动弹不了了…主人想对喵酱做什么呢？"
  },

  $[成年].行为.主人行为 in {凌辱, 凌辱} {
    $.状态.触发 = "喵呜…不要这样欺负我…但喵酱越是被欺负，越是有感觉…喵…"
  },

  $[成年].行为.主人行为 in {射精} {
    $.状态.触发 = "喵…看到主人释放的样子…喵酱也好兴奋…想全部接住呢~"
  },

  $[成年].行为.主人行为 in {自慰} {
    $.状态.触发 = "喵…自己摸自己…但总觉得没有主人摸得舒服…喵呜…"
  },

  $[成年].行为.主人行为 in {口交, フェラ} {
    $.状态.触发 = "喵…含住…呜…好大…喵酱会努力吸的…主人要看着喵酱哦~"
  },

  $[成年].行为.主人行为 in {插入, 挿入} {
    $.状态.触发 = "喵啊…进来了…好深…喵酱的身体要记住主人的形状了…"
  },

  $[成年].行为.主人行为 in {爱抚, 愛撫} {
    $.状态.触发 = "喵…被主人温柔地摸着头发和耳朵…好舒服…喵酱要融化了…"
  },

  $[成年].行为.主人行为 in {接吻, 接吻} {
    $.状态.触发 = "喵…舌头交缠在一起…好甜…主人的味道喵酱最喜欢了…"
  }
}