  "1F口交第1次": {
    "阶段流程": [
      {"阶段": "开场", "对话": ["我喜欢新人那股青涩劲儿。", "这方面我很期待，拜托了。", "呕，什么破嗜好，真是的。", "虽然打心底厌恶，但这也是工作，是为了从这奴隶生活中解放出来。", "那么那个・・・去房间吧。", "嗯？", "就在这里做啊。这里。", "这里！？", "不，可是……还有别人在。", "那样的话，不太好吧？", "所以才要不被发现啊。", "来，这边，钻到桌子下面去。", "说着，男人敲了敲桌子，引导他钻到下面。", "在男人的胯间就位后，被拉下的裤子中，那勃起的东西", "被送到了眼前。", "一股热烘烘的酸臭味钻入鼻腔。", "呜咕", "喂，别发出大声。"]},
      {"阶段": "核心行为", "对话": ["默默地含住。", "男人的手放在我的头上，做出往他那边按的动作。", "头被轻轻拍了拍，我无奈地听从了他的指示。", "呜・・・唔嗯。", "那根被逼着舔过无数遍的肉棒的味道。", "让人不由自主想干呕的温热感和说不清的触感。", "好恶心。", "明明觉得恶心，小腹却隐隐作痛。", "尽管这种心情一直没变，却对身体起反应这件事感到厌恶。", "这种不习惯的感觉。", "绝妙地笨拙……真不错啊。", "男人小声说道。"]},
      {"阶段": "收尾", "对话": ["明明赶紧射出来就能结束，却做不到。", "要做到需要技巧，但一想到不想拥有那种技巧，", "实在令人恼火。", "下巴开始累了。呼吸也很痛苦。"]},
      {"阶段": "核心行为", "对话": ["随之动作也变得更差。", "男人叹了口气，凑近脸小声对我说。", "没办法，张开嘴就那么等着。", "这样我就原谅你，要把全部喝得干干净净哦。", "噗啊……呜。", "眼前男人开始撸动肉棒。我张开嘴，等待着它被吐出"]},
      {"阶段": "开场", "对话": ["的那一刻。男人抓住我的头，把龟头前端抵在我的嘴上。", "要来了。", "堵着的东西像要一口气冲出，仿佛要发出“噗”的一声的势头"]},
      {"阶段": "核心行为", "对话": ["浓厚的块状物进入口中。黏糊糊的，腥臭的气味在嘴里", "扩散。忍不住想吐出来，但要是弄洒了，不知道会遭遇什么", "那可不是闹着玩的。", "唔……咕呜呜。", "呜嗯。", "缠在喉咙上，想咳却咳不出来的不适感。", "拼命地把唾液咽了又咽，硬是把它灌向深处。", "咳，呜。", "喂，站起来。", "过来这里。"]},
      {"阶段": "收尾", "对话": ["诶，这就……结束了？", "用嘴做虽然结束了，但还有时间吧。", "啊，因为是新人所以不知道吗。", "这、这家伙……。"]}
    ],
    "CG数": 2,
