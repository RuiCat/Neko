  "地下室逃脱失败后背位1": {
    "阶段流程": [
      {"阶段": "开场", "对话": ["这样说着，男人向我扑了过来。手脚被绑着的我"]},
      {"阶段": "前戏", "对话": ["毫无抵抗之力，轻易地趴在地上，露出屁股。", "好痛……。", "你是因为没人搭理，寂寞了才出来的吗？", "怎么可能！白痴！", "我说啊，大腿根都湿成这样了，那样可没有说服力", "所以说啊。你看啊。", "唔……！"]},
      {"阶段": "核心行为", "对话": ["男人的手指碰到了我的那里。然后，是插进来的感觉。", "就像被陌生人把手指捅进嘴里一样的不快感。", "尽管如此，我的腿间还是接纳了那根手指。", "你看，都滑溜溜的吧。", "就算不进去，光看也能看出亮晶晶的。", "哈哈哈。", "唔、咕咕……", "抱歉抱歉。我会好好让你舒服的，别生气了。", "呜……什么？", "啊！？哇！？", "和手指不同的触感。在皮肤上爬行、像要黏住一样的触感……", "被舔着。手指撑开，舌头探进内侧。", "虽然也有恐惧和厌恶，但比那些更先来的是惊讶。", "你、你在干什么啊！！", "变……变态！！", "嗯—？", "但是，很舒服不是吗？比如这里，你喜欢的吧。", "身体反射性地收紧。那里“噗”地溢出润滑液。", "虽然不想承认，但确实很舒服。", "虽然绝对不想说出口。", "不、不是……不是的。", "……没、没有。", "你否定得可真没底气呢。", "老实点吧。", "你看，这里……阴蒂都鼓起来了。", "不……要。", "不行。不行不行。"]},
      {"阶段": "收尾", "对话": ["男人用手指翻开包皮，用舌头摩擦般刺激着。", "不由得腰浮了起来。也许是知道问了我也只会否认，什么也不说", "只是继续刺激着。", "哈啊……啊呜。", "唔……嗯。", "如果说了舒服……他大概就会停下来吧。", "闪过这样的念头。我什么也没说，男人也什么也没说", "只是感觉变得越来越敏感。", "小腹深处渐渐蔓延开一阵酥麻。", "唔……不妙。"]},
      {"阶段": "开场", "对话": ["反射性地扭腰想要逃离快感，男人便抓住了我的腰。", "逃不掉。"]},
      {"阶段": "高潮", "对话": ["我确信，在达到高潮之前是逃不掉了。", "只能下定决心。要被这家伙的舌头弄到高潮了。", "呜、呜呜……呜呜呜呜。", "呜呀。", "唔。", "无法成声的呜咽从嘴里漏出。脑袋变得昏昏沉沉。"]},
      {"阶段": "收尾", "对话": ["不……行了。别那样摩擦同一个地方……", "不然的话，就……", "啊！", "……呼、呜呜！！", "呀啊、啊。"]},
      {"阶段": "高潮", "对话": ["抵抗也是徒劳，我被弄到了高潮。", "难看地抬起屁股，浑身颤抖。", "力气一泄的瞬间，我啪嗒一声趴倒在地上。", "呼啊…啊。", "哈…哈、哈。", "很舒服吧。乖啦乖啦。"]},
      {"阶段": "前戏", "对话": ["男人似乎对自己的技巧很满意，抚摸着我的头离开了。", "唔…说不出的挫败感。"]}
    ],
    "CG数": 15,
    "状态操作": ["[6, 6, 1]", "[2, 2, 0]"]
  },
  "地下室逃脱失败后背位1_2": {
    "阶段流程": [
      {"阶段": "开场", "对话": ["这样说着，男人向我扑了过来。手脚被绑着的我"]},
      {"阶段": "前戏", "对话": ["毫无抵抗之力，轻易地趴在地上，露出屁股。", "好痛……。", "怎么，撅着屁股是在勾引我吗？", "行啊，我就赏你一发。", "不、不需要！！", "说了不需要那种东西！！", "别客气。", "我会把你弄成没有这东西就活不下去的身体。", "不要！那种……！", "唔……！", "你这儿可是口水都流出来了哦。", "看，明明一副想要想要的样子。", "唔、咕咕……", "只要接受了就能轻松了。", "在这里再怎么逞强，也不会有任何改变，", "干脆接受吧。", "唔……啊，啊啊啊啊不要啊。", "呼，啊—感觉真不错啊。", "哦？怎么搞的，明明那么抗拒，现在倒是挺老实的嘛。"]},
      {"阶段": "开场", "对话": ["反正挣扎也没用吧。", "快点射啊。射完就滚出去。", "啊？你是说自己没感觉吗？", "随你硬撑，但你注意到了吗？你刚才"]},
      {"阶段": "高潮", "对话": ["就一直浅浅地高潮了吧。", "哈….哈啊？！", "才没有舒服好吗！？你在说什…唔、呃。", "哈啊？", "啊啊好好，原来是这种玩法啊。", "行啊，你爱怎么装没感觉就怎么装。", "那我就随心所欲地干个痛快吧。", "唔…呜呜。", "随、随你便啦…哦。", "哈哈，声音都已经发飘了呢。", "是这里？还是这里呢？"]},
      {"阶段": "核心行为", "对话": ["男人用腰使劲地顶弄过来。", "确实很舒服，但也算不上什么。", "说大话倒是厉害，结果就这点本事吗…哦？", "啊！？", "脊背一阵发麻的感觉。和之前不一样，很奇怪的感受。", "我不由自主地，和男人对上了视线。", "是这里啊。", "很舒服吧？这种敏感的地方。", "诶！？", "啊！？….诶啊！？", "并不是猛烈地进出，而是摩擦着腔壁般的动作。", "那玩意儿在肉壁上每来回一次，就会忍不住发出奇怪的声音。", "舒服的感觉，变成快乐了…？", "我想看的就是你这副表情啊。", "你找到了身为雌性的快感了呢？", "哈？", "…诶，啊？？", "为、为什…为什么？这，为什么？", "不明白。这份感情，凭我的脑袋无法处理。", "这是什么？明明是被强迫的，明明被搞得乱七八糟，竟然还高兴吗？", "完全搞不懂。", "你想要怀上我的孩子了吧？", "嘿….啊。", "哇啊啊啊！？", "不行。刚才那一瞬，我差点就要承认了。", "不对劲。绝对有哪里不对劲…", "反正，又不会怀孕就是了。", "要是能怀孕的话，生意也好做啊…哎呀真可惜。", "对这种，只把我当宠物看待的家伙…", "我绝对不会屈服。我，绝不向这种家伙低头。", "大概…绝对大概！！", "喂，别摆那么可怕的表情嘛。真是的。…交配中的", "雌性就是性子野，让人最兴奋啊。", "虽然没法让你怀孕挺抱歉的，不过我会往里面灌得满满的。", "唔啊・・・。", "喂，接好了！", "也许是因为身体变得敏感，阴道内那噗通噗通的脉动感都传了", "过来。边射着，男人还一直不停挺动腰部。"]},
      {"阶段": "高潮", "对话": ["射出的精液咕嘟一声从缝隙溢出，顺着大腿流下。", "虽然身体瘦弱，但这种敏感程度可是很受欢迎的哦。", "运气好的话，说不定能卖出高价呢。", "这个男人无论如何，都只把我当作商品来看待吧。", "差点就要沉溺在快感之中了，但多亏了这一点，我恢复了清醒。", "虽然不想做，但必须道谢啊……。"]}
    ],
