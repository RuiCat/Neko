  "自慰与手淫（着衣）": {
    "阶段流程": [
      {"阶段": "开场", "对话": ["躺在床上，凝视着天花板。", "手不知不觉地触碰胯间。理所当然地什么都没有。一边回想起已失去的"]},
      {"阶段": "收尾", "对话": ["东西，一边用手指摩擦着小小的突起。", "嗯……这也挺舒服的。", "啊，糟了。", "我坐起身，从衣柜里拿出毛巾垫在屁股下面。", "要是频繁弄脏床单会被唠叨的……", "干这行买卖，反正几乎每天都换，我觉得应该没什么吧，但又不是我", "洗的，所以也不好太强硬。", "这样就好了。", "再次躺回床上，调整好姿势。", "隔着布料摩擦小小的突起，另一只手触碰乳头。", "变成这副身体后才注意到……有六个。", "兽人大概是多产型的吧。", "一边转着无关的念头，一边随心所欲地玩弄乳头。", "这么多处的话，手不够用啊。", "要是同时被玩弄这些地方会怎么样呢……我沉浸在这样的妄想中。", "哈啊……嗯。", "果然还是上面两个最敏感。", "这么想来，下面的只是辅助用途吗，还是退化后作为痕迹", "残留下来了呢。", "……嘛，舒服就行了吧。"]},
      {"阶段": "前戏", "对话": ["每当小腹用力时，爱液漏出的感觉。用手指触摸的话，其实量并没有那么多，", "但光凭感觉，就好像哗啦啦流个不停似的。"]},
      {"阶段": "核心行为", "对话": ["弯曲手指，插入阴道。虽然舒服，但不够满足。", "哈啊，好想要小鸡鸡啊。", "不是那种只顾自己爽的恶心色鬼，而是那种", "感觉很好、可以撒娇的小鸡鸡。", "……哈，我到底在想什么。", "感觉自己在不断被侵蚀。"]},
      {"阶段": "高潮", "对话": ["别想多余的事，赶紧高潮然后结束吧。"]},
      {"阶段": "核心行为", "对话": ["我加快手指的动作，以声音响彻房间的气势刺激阴蒂和阴道。", "要来了……要来了。", "来了。", "嗯！！", "……呼啊。"]},
      {"阶段": "高潮", "对话": ["我仰起身体，达到了高潮。", "嗯，满足了。", "……满足……并没有。", "哈啊，真伤脑筋。", "之后，一直做到那里火辣辣地疼，但后来的定期检查", "时被狠狠骂了一顿。"]}
    ],
    "CG数": 1,
    "状态操作": []
  },
  "杰米尼_贫民窟口交": {
    "阶段流程": [
      {"阶段": "开场", "对话": ["唔。", "那臭味让人不由自主地想别过脸去。"]},
      {"阶段": "核心行为", "对话": ["没洗过的鸡巴的腥臭味钻进鼻腔。打了个冷战", "・・・・？？？", "怎么了。", "要停下吗？", "好臭……但是，不这么做不行。", "战栗不已。", "我、我干。", "只是稍微……需要准备。", "是吗，随你便吧。", "我可没工夫一直等下去。", "咦……？", "回过神来，我正用手指慰藉着自己。刚才开始那里就一直悸动", "得受不了。是身体在反射性地想要转移注意力吧。正想要", "进入状态。", "哈啊……哈啊。", "哈、嗯。嗯噗……噗啊。", "将肉棒一口气吞到喉咙深处。好痛苦……", "但是，又觉得痛苦似乎掩盖住了气味。男人淫笑着，", "按住我的头。缓缓地前后动。", "唔……唔。", "嗯咕……嗯。", "哦哦，感觉不错啊。", "这样的话马上就能射了。", "男人想多品味一会儿嘴里的感觉，放慢了速度。"]},
      {"阶段": "收尾", "对话": ["对巴不得赶紧结束的我来说，简直受不了。"]},
      {"阶段": "高潮", "对话": ["快点射吧……我用一只手搭在肉棒上，催促他射精。", "哦，要出来了。", "不行了……哦啊。", "男人拔出肉棒，咕嘟咕嘟地吐出白浊液体。", "温热、刺鼻的气味和缠住喉咙的黏液。真恶心。"]}
    ],
    "CG数": 12,
    "状态操作": []
  }
}