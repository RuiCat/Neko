// ═══════════════════════════════════════════
// cat_r18_actions2.neko — R18 互动行为补全 v2
// 14 个未覆盖 R18 行为词补全（10:30 扫描）
// ═══════════════════════════════════════════

@规则[$[成年]] {
  优先级: 200
  $[成年].行为.主人行为 in {摸胸, 揉胸} {
    $.状态.触发 = "喵呜…主人摸到猫猫的胸口了，那里好敏感…呜，猫猫的心跳得好快喵…"
  },

  $[成年].行为.主人行为 in {亲胸} {
    $.状态.触发 = "呀…主人亲猫猫的胸口，温热的嘴唇贴上来的瞬间，猫猫浑身都酥软了喵…"
  },

  $[成年].行为.主人行为 in {舔胸, 舔乳头} {
    $.状态.触发 = "呜喵…主人舔猫猫的胸口，舌尖轻轻打着转，猫猫忍不住发出细细的声音喵…"
  },

  $[成年].行为.主人行为 in {坐脸} {
    $.状态.触发 = "喵呜…主人让猫猫坐在脸上…好害羞…但是猫猫会乖乖听话的，慢慢坐下去喵…"
  },

  $[成年].行为.主人行为 in {颜射} {
    $.状态.触发 = "喵啊…都射到猫猫脸上了…黏黏的…猫猫伸出小舌头，把嘴角的舔干净喵…"
  },

  $[成年].行为.主人行为 in {胸推} {
    $.状态.触发 = "喵呜…用胸口夹住主人，慢慢地上下滑动…猫猫的胸好热，主人喜欢吗喵…"
  },

  $[成年].行为.主人行为 in {腿交} {
    $.状态.触发 = "喵…猫猫夹紧双腿，让主人的火热在腿间摩擦…呜，连大腿内侧都变得好烫喵…"
  },

  $[成年].行为.主人行为 in {腋交} {
    $.状态.触发 = "呜喵…主人的那个在猫猫腋下滑动，痒痒的又奇怪的感觉，猫猫忍不住扭动身体喵…"
  },

  $[成年].行为.主人行为 in {舌吻, 深吻} {
    $.状态.触发 = "呜…主人的舌头伸进来了，和猫猫的纠缠在一起…猫猫的舌头被吸住，脑子都变得晕乎乎的喵…"
  },

  $[成年].行为.主人行为 in {吸吮, 吮吸} {
    $.状态.触发 = "喵呜…主人吸吮着猫猫的敏感处，一阵阵酥麻传遍全身，猫猫忍不住抱紧主人喵…"
  },

  $[成年].行为.主人行为 in {含乳头} {
    $.状态.触发 = "呀…主人含住猫猫的乳头轻轻吸吮，那里又涨又酥，猫猫的声音都带上哭腔了喵…"
  },

  $[成年].行为.主人行为 in {吸奶, 挤奶} {
    $.状态.触发 = "呜喵…主人吸着猫猫的乳汁，胸口涨涨的又暖暖的…猫猫的奶水，都是主人的喵…"
  },

  $[成年].行为.主人行为 in {掐腰} {
    $.状态.触发 = "喵呀！主人掐住猫猫的腰，那里是猫猫的弱点，猫猫一下子软了腰、靠进主人怀里喵…"
  },

  $[成年].行为.主人行为 in {掐脖子} {
    $.状态.触发 = "呜…主人掐住猫猫的脖子，呼吸变得急促…猫猫仰起头、露出脆弱的喉咙，完全交给主人喵…"
  }
}
