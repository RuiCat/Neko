// ═══════════════════════════════════════════════
// scene_base.neko — 场景基础模板 + 场景感知规则
// 场景实体由 44 个场景实例化，此脚本提供模板与规则
// ═══════════════════════════════════════════════

// ─── 场景实体模板 ───

@定义 场景 {
  "场景ID": "S000",
  "名称": "未知场景",
  "类型": "未知",
  "区域": "",
  "氛围": {"光照": "", "声音": "", "气味": "", "温度": ""},
  "物品": [],
  "连接": []
}

// ─── 场景感知：猫猫记录当前位置 ───
// 守卫：仅当本 tick 尚无更重要的触发（行为响应等）时才写位置记录
// 修复 2026-08-07：行为响应（如扣洞/摸手）会被位置记录无条件覆盖导致不可见

@规则[$[NPC]] {
  $[NPC].位置.场景 != "" ∧ $.状态.触发 == "" {
    $.状态.触发 = "位置记录:" + $[NPC].位置.场景
  }
}
