// ═══════════════════════════════════════════════
// scene_move.neko — 场景关联 + 移动 + 素材管理
// 猫猫通过场景关联移动，物品随实体迁移
// ═══════════════════════════════════════════════

// ─── 场景移动函数（executor 兼容语法）───

@函数 场景移动(目标场景:str) -> str {
  当前场景 = {e}.位置.场景
  可达 = {e}.位置.可达
  if 可达 contains 目标场景 {
    {e}.位置.上次场景 = 当前场景
    {e}.位置.场景 = 目标场景
    {e}.状态.触发 = "移动到了" + 目标场景
    返回 "移动成功"
  } else {
    返回 "无法移动"
  }
}

// ─── 场景查询：计算当前场景的可达列表 → 存到猫猫 ───

@函数 更新可达(场景ID:str) -> str {
  场景实体 = 场景ID
  连接 = 场景实体.连接
  可达 = []
  for 项 in 连接 {
    可达.append(项)
  }
  {e}.位置.可达 = 可达
  返回 "可达更新:" + 可达
}

// ─── 猫猫移动到相邻场景（世界场景变化时自动跟随）───

@规则[$[NPC]，世界] {
  世界.环境.所在场景 != $[NPC].位置.场景 ∧ $[NPC].位置.场景 != "" {
    $.位置.场景 = $世界.环境.所在场景
  }
}

// ─── 猫猫移动到场景（通过关联图，素材随行）───

