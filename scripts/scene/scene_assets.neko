// ═══════════════════════════════════════════════
// scene_assets.neko — 场景素材系统
// 素材=独立实体，归属场景，可随实体迁移
// 约束：只能操作当前场景内/携带中的素材
// ═══════════════════════════════════════════════

// ─── 素材模板（一个定义，多个实例）───

@定义 素材 {
  "类型": "物品",
  "名称": "",
  "所属场景": "",
  "持有人": "",
  "状态": {
    "可用": true,
    "描述": ""
  }
}

// ─── 花模板（示例：同类型多实例）───

@定义 花:素材 {
  "类型": "植物",
  "状态": {
    "颜色": "未知",
    "盛开": true
  }
}

// ─── 素材操作约束：只能操作当前场景内/携带中的素材 ───

@函数 可操作(实体:str, 素材ID:str) -> bool {
  素材 = 素材ID
  素材场景 = 素材.所属场景
  当前场景 = 实体.位置.场景
  持有人 = 素材.持有人
  if 素材场景 == 当前场景 {
    返回 true
  }
  if 持有人 == 实体 {
    返回 true
  }
  返回 false
}

// ─── 素材迁移：把素材从当前场景移到目标场景 ───

@函数 素材迁移(实体:str, 素材ID:str, 目标场景:str) -> str {
  if 可操作(实体, 素材ID) == false {
    返回 "无法操作:素材不在当前场景"
  }
  素材 = 素材ID
  素材.所属场景 = 目标场景
  素材.持有人 = ""
  实体.状态.触发 = "移动了素材"
  返回 "素材已移动到:" + 目标场景
}

// ─── 拾取素材（当前场景内 → 猫猫携带）───

@函数 拾取(实体:str, 素材ID:str) -> str {
  if 可操作(实体, 素材ID) == false {
    返回 "无法拾取:素材不在当前场景"
  }
  素材 = 素材ID
  素材.持有人 = 实体
  素材.所属场景 = ""
  携带 = 实体.携带
  携带.append(素材ID)
  实体.携带 = 携带
  返回 "拾取了:" + 素材ID
}

// ─── 放下素材（携带中 → 当前场景）───

@函数 放下(实体:str, 素材ID:str) -> str {
  素材 = 素材ID
  素材.持有人 = ""
  素材.所属场景 = 实体.位置.场景
  携带 = 实体.携带
  新携带 = []
  for 项 in 携带 {
    if 项 != 素材ID {
      新携带.append(项)
    }
  }
  实体.携带 = 新携带
  返回 "放下了:" + 素材ID
}

// ─── 约束规则：越界操作被拒绝 ───

@规则[$[NPC]] {
  $[NPC].位置.目标 != "" ∧ $[NPC].位置.目标 != $[NPC].位置.场景 {
    $.位置.场景 = $[NPC].位置.目标
  }
}
