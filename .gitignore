# local machine state (module caches, go build cache, scratch)
.local/
.cache/
.agent-memory/

# python artifacts (legacy tree)
__pycache__/
*.py[cod]
.pytest_cache/

# go artifacts
/bin/
/dist/
*.test

# runtime/temporary data
*.tmp
*.tmp.*
data/*.tmp
scripts/*.tmp

# runtime data (local-only; registry bootstraps from scripts/ when absent)
/legacy/
/data/entities.json
/data/scripts.json
/data/templates/
/data/user/
/data/archives/
/data/logs/
/data/llm_decisions.json
/data/entities.json
/internal/compiler/testdata/python_rule_ids.json

# dsh plugin runtime artifacts (generated / machine-local)
/data/dsh-control.sock
/data/.engine.lock
/dsh/cordis.patch.yml

# dsh context driver (config holds the per-process launch token; never commit it)
/contexts.json
/data/contexts.json
/data/contexts.json.tmp


# learning-loop runtime data (journal records, metric reports)
/data/journal/
/data/metrics/
/data/experts.json
/data/candidates.jsonl
/data/rules.json
runs
/data/blackboard.json
