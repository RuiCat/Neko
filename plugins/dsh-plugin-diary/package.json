{
  "name": "dsh-plugin-diary",
  "description": "DSH 日记插件：按天把会话要点写进项目记忆目录的 diary/，并提供读写检索工具（零依赖）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/plugin.mjs",
  "exports": {
    ".": "./lib/plugin.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
